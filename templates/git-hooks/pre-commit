#!/usr/bin/env bash
# gatedloop git pre-commit hook (enforce-at-the-effect, design D1/D2).
#
# Layer 2 of the four-layer enforcement model (AUTOMATION.md). It fires on the
# COMMIT OBJECT being created, not on the phrasing of the invocation, so it
# catches every commit-creating path a `PreToolUse` string matcher cannot see:
# `git commit`, a `python -c` subprocess, a written-then-run script, `sh -c`,
# or a library that talks to git directly (the observed #2 bypass). It runs
# the same `gates discipline check-commit` the tool hook runs (lock-and-ledger-
# hygiene D4), so the two layers share one implementation: ledger-grade and
# planning-grade commits are allowed on every path, and anything else needs the
# O(1) `ci` marker compare — it NEVER re-runs `ci` under a hook timeout.
#
# Scoped to a declared agent session (git-layer-enforcement D1): `gates
# discipline agent-session` exits 0 when a variable `discipline.agent-env`
# lists is set (default `[CLAUDECODE]`, inherited by every subprocess the
# session spawns), else 1, and on 1 this hook is a transparent no-op. A human
# terminal, IDE, or CI runner has no such variable — the gate exists to hold an
# autonomous loop to its invariant, and outside a session no such loop is
# running the commit. This fails toward the human no-op, never toward blocking
# a human (design Risks). It is deliberate scope, not a silent skip of
# `fail-loud-gates`.
set -uo pipefail

# Resolve the shim (git-layer-enforcement D2): ${CLAUDE_PLUGIN_ROOT}
# (plugin-relative-paths), then `gates` on PATH, then the path `gates hook
# install` recorded on the line below — the one line it writes into this copy.
# This hook is a COPY under .git/hooks, not inside the plugin, so a
# "../bin/gates" escape would not resolve; the recorded path lets it find the
# shim on a host with no plugin environment at all.
GATES_INSTALLED=''
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -x "${CLAUDE_PLUGIN_ROOT}/bin/gates" ]; then
  GATES="${CLAUDE_PLUGIN_ROOT}/bin/gates"
elif command -v gates >/dev/null 2>&1; then
  GATES="gates"
elif [ -n "${GATES_INSTALLED}" ] && [ -x "${GATES_INSTALLED}" ]; then
  GATES="${GATES_INSTALLED}"
else
  # Nothing finds the shim, so a session cannot be told from a human: fail
  # toward the human (design Risks). `gates doctor` reports this copy stale.
  echo "gatedloop: the pre-commit hook could not resolve the gates shim (no plugin root, no \`gates\` on PATH, no recorded path) — the commit is not gated. Run \`gates hook install\` to record the current path." >&2
  exit 0
fi

"${GATES}" discipline agent-session </dev/null
session=$?
if [ "${session}" -eq 1 ]; then
  exit 0
elif [ "${session}" -ne 0 ]; then
  echo "gatedloop: commit denied — \`gates discipline agent-session\` failed (exit ${session}), so whether this commit is gated cannot be decided." >&2
  exit 1
fi

# hook-correctness D7: a branch another worktree also holds is refused before
# the marker check -- the commit would move the ref under that checkout.
if ! wt_out="$("${GATES}" discipline check-worktree 2>&1)"; then
  echo "${wt_out}" >&2
  exit 1
fi

tree="$(git write-tree 2>/dev/null)"
if [ -z "${tree}" ]; then
  echo "gatedloop: could not compute the staged tree (git write-tree failed) — denying the commit until the git state is resolved." >&2
  exit 1
fi

# lock-and-ledger-hygiene D4: the tool-level hook's own check. It prints its
# verdict (ledger-grade, planning-grade, or the marker match) on success; on
# failure, its denial -- including the stale diagnosis naming which paths
# differ from the tree `ci` passed on (hook-correctness D4), the most useful
# line of the denial.
# unblock-authored-lock D1: check-commit names the grade that allowed the
# commit in a one-token file; the lock below is skipped on `ledger` by
# reading that token, never by matching the printed line.
verdict_file="$(mktemp "${TMPDIR:-/tmp}/gatedloop-verdict.XXXXXX" 2>/dev/null)"
if [ -z "${verdict_file}" ]; then
  echo "gatedloop: could not create a temporary file for the commit verdict — denying the commit." >&2
  exit 1
fi
trap 'rm -f "${verdict_file}"' EXIT

if ! commit_out="$("${GATES}" discipline check-commit "${tree}" --verdict-file "${verdict_file}" 2>&1)"; then
  echo "${commit_out}" >&2
  echo "gatedloop: commit denied at the git layer — the staged tree does not satisfy \`gates discipline check-commit\`." >&2
  echo "gatedloop: run \`gates run ci\` and stage exactly what it tested, then commit again." >&2
  echo "gatedloop: rephrasing the commit (a subprocess, a script, a library) will not get past this hook — it fires on the commit object itself, not the command string (issue #2)." >&2
  exit 1
fi
echo "${commit_out}"

# A ledger-grade commit stages only `.gatedloop/runs/**`: a ledger row cannot
# change a test, so the lock has nothing to judge in it (as in the tool hook).
if [ "$(cat "${verdict_file}" 2>/dev/null)" = "ledger" ]; then
  exit 0
fi

# split-test-author D4: the same authored-test lock the tool hook applies,
# after the commit check, as in hooks/gate-commit.sh.
if ! tests_out="$("${GATES}" tests check 2>&1)"; then
  echo "${tests_out}" >&2
  echo "gatedloop: commit denied at the git layer — the authored tests are locked; see above." >&2
  exit 1
fi

exit 0
