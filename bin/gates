#!/usr/bin/env python3
"""gatedloop — the deterministic gate/surface shim.

Reads `.gates.yaml` and runs a project's gates and live-checks by their
ABSTRACT name, so the workflow never hard-codes a project's stack. Design D7:
blocking gates (ci, live-check) must never be silently skipped, so gate
execution and surface selection are done here, deterministically, not by an
agent reading YAML. The convention-review judgement (an LLM) still consumes
the rules this shim resolves — the shim determinizes selection, not judgement.

Commands:
  gates validate                 Validate .gates.yaml (schema-ish + refs). Exit 1 on any error.
  gates run <gate> [args...]     Run a declared gate; exit with its code.
                                 `run live-check` runs every hot surface's live-check.
                                 `run eval <dataset> <score>` fills {dataset}/{score}.
  gates surfaces [--changed ...] Print the hot surfaces for the changed-file set.
  gates rules [--changed ...]    Print the applicable rule-ids/prose for the changed set
                                 (feed this to the convention-review agent).
  gates conventions sync         Regenerate openspec/config.yaml's `rules:` block from
                                 conventions.rules-doc, keyed by the active schema's
                                 artifact ids. `gates validate` fails loudly if it drifts.

Changed-file set defaults to `git diff --name-only HEAD` + staged + untracked.
Override with `--changed a.py b.ts` or `--all` (match every surface).

Dependency: PyYAML if the manifest is .gates.yaml. A .gates.json manifest
needs no third-party dep.

"""
from __future__ import annotations

import argparse
import contextlib
import fnmatch
import hashlib
import importlib.util
import io
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REQUIRED_GATES = ("ci",)
# Reserved exit code for a failed precondition (design D3 of
# gate-preconditions): EX_TEMPFAIL from BSD sysexits -- "temporary failure,
# retry later". Distinct from both a green gate (0) and an ordinary gate
# failure (whatever the gate body itself returns) -- the shim's stderr line
# and the ledger row's `outcome` field are the authoritative discriminators
# if a gate body happens to also exit 75; the exit code is the cheap
# first-class signal. Adopters who declare `requires` are told the shim
# owns 75 (SETUP.md's gate contract).
PRECONDITION_EXIT_CODE = 75
# The OpenSpec CLI version this shim was last verified against (F5). `gates
# doctor` compares the installed `openspec --version` to it and WARNS on a
# mismatch — never a hard failure, because a pre-1.0, fast-moving CLI's version
# drift is informative, not conclusive (design D4). Bump this when the shim is
# re-verified against a newer OpenSpec release.
TESTED_OPENSPEC_VERSION = "1.14.3"
# The `gatesVersion` this shim writes and validates. `gates doctor` reports a
# manifest whose version differs so an adopter knows to migrate.
EXPECTED_GATES_VERSION = 1
GATES_NAMES = (".gates.yaml", ".gates.yml", ".gates.json")
MANIFEST_NAMES = GATES_NAMES


# ---------- loading -------------------------------------------------------

def _repo_root() -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        if out:
            return Path(out)
    except Exception:
        pass
    return Path.cwd()


def _first_existing(root: Path, names: tuple[str, ...]) -> Path | None:
    for name in names:
        p = root / name
        if p.exists():
            return p
    return None


def _find_manifest(root: Path) -> tuple[Path | None, Path | None]:
    """Resolve the manifest — only the current filenames (`remove-harness-compat`
    retired the `.harness.*` fallback). Returns `(chosen, None)`; the second
    slot is kept so callers don't need to change, but nothing is ever ignored
    anymore since there is no legacy name left to defer to.
    """
    gates_path = _first_existing(root, GATES_NAMES)
    return gates_path, None


# ---------- the earlier name (rename-to-gatedloop D2/D3) --------------------
#
# The plugin was Specloop until 0.7.0. Its committed state in an adopter's
# repository carried that name: the `.specloop/` state directory, the
# `x-specloop-*` change-metadata keys, `specloop/<gate>` commit statuses, the
# `specloop.*` built-in rule ids, the composed git-hook markers and a schema's
# top-level `specloop:` flow block. Through 0.8.x every reader took either
# spelling; from 0.9.0 (`remove-specloop-forwarders`) nothing reads the
# earlier one. What is left is `gates migrate-name`, the scan doctor's `name`
# row and the `rename` adoption item read, and the refusal of a project still
# holding `.specloop/` (its design D2). Every literal of the earlier name in
# this shim lives in this region, so the allow-list test (design D6 of
# `rename-to-gatedloop`) can hold the rest of the file to the new name.

NAME = "gatedloop"
EARLIER_NAME = "specloop"
STATE_DIR_NAME = f".{NAME}"
EARLIER_STATE_DIR_NAME = f".{EARLIER_NAME}"
# The durable ledger: stripped from every normalized tree and read from any
# committed tree.
LEDGER_PREFIXES = (f"{STATE_DIR_NAME}/runs",)
STATE_PREFIXES = (f"{STATE_DIR_NAME}/",)
EARLIER_STATUS_CONTEXT_PREFIX = f"{EARLIER_NAME}/"
EARLIER_HOOK_BEGIN = f"# >>> {EARLIER_NAME} pre-commit (enforce-at-the-effect) >>>"
EARLIER_HOOK_END = f"# <<< {EARLIER_NAME} pre-commit (enforce-at-the-effect) <<<"
EARLIER_HOOK_TEMPLATE_MARK = f"# {EARLIER_NAME} git pre-commit hook (enforce-at-the-effect"
EARLIER_EXPIRY = "0.9.0"


def _state_dirs_conflict(root: Path) -> str | None:
    """The refusal for a project holding both state directories, or None:
    writing either would split the ledger, and reading one would hide the
    other (design D2)."""
    if (root / STATE_DIR_NAME).is_dir() and (root / EARLIER_STATE_DIR_NAME).is_dir():
        return (f"{NAME}: this project holds both {EARLIER_STATE_DIR_NAME}/ and "
                f"{STATE_DIR_NAME}/, so its ledger would split. Move anything you need "
                f"from {STATE_DIR_NAME}/ into {EARLIER_STATE_DIR_NAME}/, remove "
                f"{STATE_DIR_NAME}/, then run gates migrate-name.")
    return None


def _earlier_state_refusal(root: Path) -> str | None:
    """The refusal for a project still holding the earlier state directory,
    or None (remove-specloop-forwarders D2). Nothing reads `.specloop/` from
    0.9.0, so running on would start an empty `.gatedloop/` beside it and
    split the ledger. Every command but `gates doctor` and `gates
    migrate-name` refuses instead, naming the way out."""
    conflict = _state_dirs_conflict(root)
    if conflict:
        return conflict
    if (root / EARLIER_STATE_DIR_NAME).is_dir():
        return (f"{NAME}: this project still holds {EARLIER_STATE_DIR_NAME}/, the "
                f"plugin's earlier state directory, which nothing reads from "
                f"{EARLIER_EXPIRY}. Run gates migrate-name, then commit what it moved.")
    return None


def _state_dir(root: Path) -> Path:
    """The project's state directory, `.gatedloop/`."""
    return root / STATE_DIR_NAME


def _state_rel(root: Path, *parts: str) -> str:
    """A path under the state directory, relative to `root`, posix-style."""
    return "/".join((_state_dir(root).name, *parts))


def _earlier_meta_key(key: str) -> str:
    """`x-gatedloop-…` spelled the earlier way, `x-specloop-…`."""
    return key.replace(f"x-{NAME}-", f"x-{EARLIER_NAME}-", 1)


def _meta_value(data, key: str):
    """A change-metadata value under its key; a missing or blank value is
    None. The earlier `x-specloop-*` spelling is not read from 0.9.0."""
    if not isinstance(data, dict):
        return None
    v = data.get(key)
    return v if v is not None and str(v).strip() else None

# `gates migrate-name` (design D3): one command moves a project onto the new
# names, locally. It never commits and never pushes, leaves archived changes
# alone, and prints each edit it cannot make with its exact replacement.

_SETTINGS_FILES = (".claude/settings.json", ".claude/settings.local.json")
PUBLISHED_STATUS_GATES = ("ci", "live-check")


def _migrate_name_text(text: str) -> str | None:
    """`text` with every top-level `x-specloop-*` key renamed to its
    `x-gatedloop-*` spelling, values and order kept, or None when it has none.
    Where both spellings are present the new one already wins, so the earlier
    line is dropped rather than renamed into a duplicate."""
    earlier = f"x-{EARLIER_NAME}-"
    lines = text.splitlines(keepends=True)
    present = {_top_level_key(line) for line in lines}
    out, changed = [], False
    for line in lines:
        key = _top_level_key(line)
        if key and key.startswith(earlier):
            changed = True
            new = f"x-{NAME}-" + key[len(earlier):]
            if new in present:
                continue
            line = new + line[len(key):]
        out.append(line)
    return "".join(out) if changed else None


def _settings_edits(root: Path) -> list[str]:
    """Every earlier-named entry in the project's Claude Code settings, as
    `<file> <where>: "<old>" -> "<new>"` lines. Read only, never written."""
    edits = []
    for rel in _SETTINGS_FILES:
        try:
            data = json.loads((root / rel).read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(data, dict):
            continue

        def new_of(old: str) -> str:
            return old.replace(f"{EARLIER_NAME}@{EARLIER_NAME}", f"{NAME}@{NAME}").replace(EARLIER_NAME, NAME)

        for field in ("enabledPlugins", "extraKnownMarketplaces"):
            block = data.get(field)
            for key in block if isinstance(block, dict) else ():
                if EARLIER_NAME in key:
                    edits.append(f'{rel} {field}: "{key}" -> "{new_of(key)}"')
        perms = data.get("permissions")
        for kind in ("allow", "ask", "deny"):
            rules = perms.get(kind) if isinstance(perms, dict) else None
            for rule in rules if isinstance(rules, list) else ():
                if isinstance(rule, str) and EARLIER_NAME in rule:
                    edits.append(f'{rel} permissions.{kind}: "{rule}" -> "{new_of(rule)}"')
    return edits


def _move_state_dir(root: Path) -> str | None:
    """Move `.specloop/` to `.gatedloop/`: a `git mv` git records as renames,
    or a plain rename when git does not track the directory. Returns what it
    did, or None when there was nothing to move."""
    old, new = root / EARLIER_STATE_DIR_NAME, root / STATE_DIR_NAME
    if not old.is_dir() or new.exists():
        return None
    moved = subprocess.run(["git", "mv", EARLIER_STATE_DIR_NAME, STATE_DIR_NAME],
                           cwd=root, capture_output=True, text=True)
    if moved.returncode == 0 and new.is_dir():
        return f"moved {EARLIER_STATE_DIR_NAME}/ to {STATE_DIR_NAME}/ (git mv)"
    old.rename(new)
    return f"moved {EARLIER_STATE_DIR_NAME}/ to {STATE_DIR_NAME}/ (untracked, so a plain rename)"


def cmd_migrate_name(_args) -> int:
    root = _repo_root()
    conflict = _state_dirs_conflict(root)
    if conflict:
        print(conflict, file=sys.stderr)
        return 1
    done: list[str] = []
    moved = _move_state_dir(root)
    if moved:
        done.append(moved)
    for d in _active_change_dirs(root):
        p = d / ".openspec.yaml"
        if not p.is_file():
            continue
        new_text = _migrate_name_text(p.read_text())
        if new_text is not None:
            p.write_text(new_text)
            done.append(f"renamed the x-{EARLIER_NAME}-* keys in {p.relative_to(root)}")
    refresh = None
    _kind, hook = _detect_hook_owner(root)
    if hook is not None and hook.is_file():
        text = _read_text_safe(hook)
        if EARLIER_HOOK_BEGIN in text:
            hook.write_text(text.replace(EARLIER_HOOK_BEGIN, HOOK_BEGIN).replace(EARLIER_HOOK_END, HOOK_END))
            done.append(f"renamed the composed block's markers in {hook}")
        elif EARLIER_HOOK_TEMPLATE_MARK in text:
            refresh = hook
    for line in done:
        print(f"{NAME}: {line}")
    if refresh is not None:
        print(f"{NAME}: {refresh} is a direct copy of an earlier template; run "
              "`gates hook install` to refresh it (the old body is kept beside it).")
    if not done and refresh is None:
        print(f"{NAME}: nothing to migrate — this project's state, change metadata and "
              "git hook already use the new names.")
    else:
        print(f"{NAME}: nothing was committed. Commit the result (a planning- and "
              "ledger-grade commit).")
    contexts = ", ".join(f"{EARLIER_STATUS_CONTEXT_PREFIX}{g} -> {NAME}/{g}" for g in PUBLISHED_STATUS_GATES)
    print(f"\n{NAME}: edits this command does not make; make each by hand:")
    print(f"  - branch protection, where it requires a status: {contexts}. Only the "
          f"new contexts are posted from {EARLIER_EXPIRY}, so an earlier one required "
          "there never passes again.")
    print(f"  - Claude Code: /plugin marketplace add tessellate-space/{NAME}, then /plugin "
          f"install {NAME}@{NAME}, then /plugin uninstall {EARLIER_NAME}@{EARLIER_NAME}.")
    for edit in _settings_edits(root):
        print(f"  - {edit}")
    return 0

def _earlier_name_remnants(root: Path) -> list[str]:
    """What earlier names this project still holds, one line each: the one
    scan doctor's `name` row and the recurring `rename` adoption item read
    (design D3). Archived changes are never migrated, so they never count.
    Reads only; it never warns, because asking is not using."""
    out = []
    if (root / EARLIER_STATE_DIR_NAME).is_dir():
        out.append(f"{EARLIER_STATE_DIR_NAME}/")
    for d in _active_change_dirs(root):
        p = d / ".openspec.yaml"
        with contextlib.suppress(OSError):
            if p.is_file() and _migrate_name_text(p.read_text()) is not None:
                out.append(f"x-{EARLIER_NAME}-* keys in {d.name}")
    _kind, hook = _detect_hook_owner(root)
    if hook is not None and hook.is_file():
        text = _read_text_safe(hook)
        if EARLIER_HOOK_BEGIN in text or EARLIER_HOOK_TEMPLATE_MARK in text:
            out.append(f"{EARLIER_NAME} markers in {hook}")
    return out


def _doctor_name_row(names: list[str]) -> tuple:
    if names:
        return ("warn", "name",
                f"This project still holds the plugin's earlier name: {'; '.join(names)}. "
                f"Nothing reads it from {EARLIER_EXPIRY}, and while {EARLIER_STATE_DIR_NAME}/ "
                "exists every command but this one and `gates migrate-name` refuses. Run "
                "`gates migrate-name`, then commit what it changed and make the edits it prints.")
    return ("ok", "name", "Nothing in this project uses the plugin's earlier name.")

# ---------- end of the earlier name ------------------------------------------


def _parse_yaml_text(text: str) -> dict:
    """Parse YAML text (not a JSON manifest) — PyYAML if importable, else the
    zero-dependency `_mini_yaml` fallback. Shared by `_load` (manifest files
    on disk) and any caller parsing YAML read another way (e.g. `git show
    <ref>:path` output, which has no file on disk to hand `_load`)."""
    try:
        import yaml  # type: ignore
        return yaml.safe_load(text) or {}
    except ImportError:
        # Zero-dependency fallback: a minimal parser for the manifest subset
        # (mappings, block lists of scalars/maps, inline flow lists). Keeps
        # gatedloop installable without pip. Falls through to PyYAML when present.
        return _mini_yaml(text)


def _load(path: Path) -> dict:
    text = path.read_text()
    if path.suffix == ".json":
        return json.loads(text)
    return _parse_yaml_text(text)


def _strip_comment(line: str) -> str:
    out, q = [], None
    for ch in line:
        if q:
            out.append(ch)
            if ch == q:
                q = None
        elif ch in ("'", '"'):
            q = ch
            out.append(ch)
        elif ch == "#":
            break
        else:
            out.append(ch)
    return "".join(out).rstrip()


def _has_bare_char(s: str, ch: str) -> bool:
    """True if `s` holds `ch` outside any quoted span."""
    q = None
    for c in s:
        if q:
            if c == q:
                q = None
        elif c in ("'", '"'):
            q = c
        elif c == ch:
            return True
    return False


def _has_bare_colon(s: str) -> bool:
    """True if `s` holds a colon outside any quoted span.

    Distinguishes a block-list mapping item (`- name: all`) from a quoted prose
    scalar that merely contains a colon (`- "Prefer composition: avoid ..."`).
    Prose rules are a documented alternative to rule-ids, and prose routinely
    contains colons.
    """
    return _has_bare_char(s, ":")


def _split_quote_aware(s: str, sep: str) -> list[str]:
    """Split `s` on `sep` outside any quoted span (single or double quotes)."""
    parts: list[str] = []
    current: list[str] = []
    q = None
    for ch in s:
        if q:
            current.append(ch)
            if ch == q:
                q = None
        elif ch in ("'", '"'):
            q = ch
            current.append(ch)
        elif ch == sep:
            parts.append("".join(current))
            current = []
        else:
            current.append(ch)
    parts.append("".join(current))
    return parts


def _partition_quote_aware(s: str, sep: str) -> tuple[str, str] | None:
    """Split `s` on the first `sep` outside any quoted span; `None` if `sep`
    never appears bare (same quote discipline as `_has_bare_char`)."""
    q = None
    for i, ch in enumerate(s):
        if q:
            if ch == q:
                q = None
        elif ch in ("'", '"'):
            q = ch
        elif ch == sep:
            return s[:i], s[i + 1:]
    return None


def _flow_mapping(inner: str, original: str) -> dict:
    """Parse the inside of a single-level `{...}` flow mapping with scalar
    values (design D1, the gate/live-check mapping form `{run: ..., requires:
    ...}`). Splits on top-level commas (quote-aware), then each entry on its
    first bare colon. A value holding a bare `[` or `{` is a nested flow
    structure — out of the supported subset — and fails loudly here rather
    than ever being returned as a literal string that could be executed as a
    shell command."""
    if inner.strip() == "":
        return {}
    result: dict = {}
    for raw_entry in _split_quote_aware(inner, ","):
        entry = raw_entry.strip()
        if not entry:
            raise ValueError(f"empty entry in flow mapping '{original}'")
        split = _partition_quote_aware(entry, ":")
        if split is None:
            raise ValueError(f"flow mapping entry '{entry}' has no ':' in '{original}'")
        key, val = split[0].strip(), split[1].strip()
        if not key:
            raise ValueError(f"flow mapping entry '{entry}' has an empty key in '{original}'")
        if _has_bare_char(val, "[") or _has_bare_char(val, "{"):
            raise ValueError(
                f"nested flow structures are not supported in flow mapping "
                f"'{original}' (unsupported value for '{key}': '{val}')"
            )
        result[key] = _scalar(val)
    return result


def _scalar(v: str):
    v = v.strip()
    if v == "" or v == "~" or v == "null":
        return None
    if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
        return v[1:-1]
    if v[0] == "[" and v[-1] == "]":
        inner = v[1:-1].strip()
        return [_scalar(x) for x in inner.split(",")] if inner else []
    if v[0] == "{" and v[-1] == "}":
        return _flow_mapping(v[1:-1], v)
    if v in ("true", "false"):
        return v == "true"
    try:
        return int(v)
    except ValueError:
        pass
    # token-ledger D4: a plain decimal (`0.3`, `-1.25`) is a float, as PyYAML
    # reads it -- `economics.prices` are per-million-token prices. Nothing
    # looser: a version string (`0.7.0`) or an exponent stays a string.
    if _DECIMAL_RE.fullmatch(v):
        return float(v)
    return v


_DECIMAL_RE = re.compile(r"-?\d+\.\d+")


def _yaml_key(k: str) -> str:
    """A mapping key with surrounding quotes removed (`"model-a": ...`), as
    PyYAML reads a quoted key."""
    if len(k) >= 2 and k[0] == k[-1] and k[0] in ("'", '"'):
        return k[1:-1]
    return k


def _mini_yaml(text: str) -> dict:
    rows = []
    for raw in text.split("\n"):
        s = _strip_comment(raw)
        if s.strip() == "":
            continue
        rows.append((len(s) - len(s.lstrip(" ")), s.strip()))
    n = len(rows)
    i = 0

    def parse(indent):
        return parse_list(indent) if (i < n and rows[i][1].startswith("- ")) else parse_map(indent)

    def _kv(entry, own_indent):
        nonlocal i
        # token-ledger D4: a quoted key (`"model-a.v2": ...`) is split at the
        # first colon outside its quotes and unquoted, as PyYAML reads it.
        split = _partition_quote_aware(entry, ":") if entry[:1] in ("'", '"') else None
        key, _, val = (split[0], ":", split[1]) if split is not None else entry.partition(":")
        key, val = _yaml_key(key.strip()), val.strip()
        if val != "":
            return key, _scalar(val)
        if i < n and rows[i][0] > own_indent:
            return key, parse(rows[i][0])
        return key, None

    def parse_map(indent):
        nonlocal i
        d = {}
        while i < n and rows[i][0] == indent and not rows[i][1].startswith("- "):
            entry = rows[i][1]
            i += 1
            k, v = _kv(entry, indent)
            d[k] = v
        return d

    def parse_list(indent):
        nonlocal i
        lst = []
        while i < n and rows[i][0] == indent and rows[i][1].startswith("- "):
            rest = rows[i][1][2:].strip()
            i += 1
            if _has_bare_colon(rest) and not rest.startswith("["):
                k, v = _kv(rest, indent)
                item = {k: v}
                while i < n and rows[i][0] > indent and not rows[i][1].startswith("- "):
                    entry = rows[i][1]
                    ki = rows[i][0]
                    i += 1
                    k2, v2 = _kv(entry, ki)
                    item[k2] = v2
                lst.append(item)
            else:
                lst.append(_scalar(rest))
        return lst

    return parse(rows[0][0]) if n else {}


def load_manifest() -> tuple[dict, Path]:
    root = _repo_root()
    path, _ignored = _find_manifest(root)
    if path is None:
        sys.exit(f"gatedloop: no manifest found ({' / '.join(MANIFEST_NAMES)}) at repo root {root}")
    data = _load(path)
    if not isinstance(data, dict):
        sys.exit(f"gatedloop: {path.name} did not parse to a mapping")
    data["__root__"] = str(root)
    return data, path


def _gate_spec(value) -> tuple[str | None, str | None]:
    """Normalize one gate/live-check manifest value to `(run, requires)`
    (design D2) — the one place scalar-vs-mapping is decided. A scalar
    command string means `(value, None)`; a mapping means `(value["run"],
    value.get("requires"))`. Every consumer of a gate/live-check value (run,
    validate, and the surfaces display) goes through this."""
    if isinstance(value, dict):
        return value.get("run"), value.get("requires")
    return value, None


# ---------- validation ----------------------------------------------------

def _validate_gate_spec(errs: list[str], label: str, value) -> None:
    """Validate one gate/live-check manifest value against the scalar-or-
    mapping shape (design D1/D2): a mapping requires a non-empty `run`; an
    optional `requires` must be a non-empty string; any other key is
    rejected. `label` names the gate or surface (e.g. "gate 'ci'" or
    "surface 'prod' live-check") for the error message. Fail-loud backstop:
    a string value that looks like an unparsed mapping (starts with `{`) is
    rejected too — a mapping the fallback (or a typo) failed to parse must
    never validate as a command (design D1)."""
    if isinstance(value, dict):
        run = value.get("run")
        if not isinstance(run, str) or not run.strip():
            errs.append(f"{label}: mapping form requires a non-empty 'run' string")
        if "requires" in value:
            requires = value.get("requires")
            if not isinstance(requires, str) or not requires.strip():
                errs.append(f"{label}: 'requires' must be a non-empty string")
        for k in sorted(set(value.keys()) - {"run", "requires"}):
            errs.append(f"{label}: unknown key '{k}' in mapping form")
    elif not isinstance(value, str) or not value.strip():
        errs.append(f"{label} must be a non-empty command string")
    elif value.strip().startswith("{"):
        errs.append(
            f"{label}: value '{value}' looks like an unparsed mapping "
            "(starts with '{') and is rejected rather than executed as a command"
        )


def _errors(m: dict, root: Path) -> list[str]:
    errs: list[str] = []
    version = m.get("gatesVersion")
    if version != 1:
        errs.append("gatesVersion must be 1")
    gates = m.get("gates") or {}
    if not isinstance(gates, dict):
        errs.append("gates must be a mapping")
        gates = {}
    for req in REQUIRED_GATES:
        if not gates.get(req):
            errs.append(f"required gate '{req}' is missing or empty")
    for name, cmd in gates.items():
        _validate_gate_spec(errs, f"gate '{name}'", cmd)

    # rules-doc + rule-id resolution (D8: dangling id fails loud)
    conv = m.get("conventions") or {}
    rules_doc = conv.get("rules-doc")
    doc_text = None
    if rules_doc:
        dp = root / rules_doc
        if not dp.exists():
            errs.append(f"conventions.rules-doc '{rules_doc}' does not exist")
        else:
            doc_text = dp.read_text()

    heading_ids = _heading_ids(doc_text) if doc_text is not None else set()
    for surf in m.get("surfaces") or []:
        nm = surf.get("name", "<unnamed>")
        if not surf.get("match"):
            errs.append(f"surface '{nm}' has no match glob")
        else:
            # design D3: the same expander matching uses, so an invalid
            # brace pattern can only ever be a validate-time error, never a
            # runtime under-selection. Collect every surface's failure
            # (existing all-errors-at-once style) rather than stopping at
            # the first.
            for raw in _globs(surf.get("match")):
                try:
                    _expand_braces(raw)
                except BraceExpansionError as e:
                    errs.append(f"surface '{nm}': {e}")
        if "live-check" in surf:
            _validate_gate_spec(errs, f"surface '{nm}' live-check", surf["live-check"])
        # scale-gate-cost D1: a surface MAY override `ci`/`unit` with a
        # scoped command. Restricted to those two scopable gates, and the
        # overridden gate must itself be globally declared -- otherwise the
        # override has no full-gate fallback to narrow from, which is the
        # one direction scoping is allowed to move. The override value takes
        # the same scalar-or-{run, requires} shape as any gate value
        # (gate-preconditions D2), through the same validator.
        overrides = surf.get("gates") or {}
        if not isinstance(overrides, dict):
            errs.append(f"surface '{nm}': gates must be a mapping")
        else:
            for gname, gcmd in overrides.items():
                if gname not in ("ci", "unit"):
                    errs.append(
                        f"surface '{nm}': gate override '{gname}' is not scopable "
                        "(only 'ci'/'unit' may be overridden per-surface)"
                    )
                elif not gates.get(gname):
                    errs.append(
                        f"surface '{nm}': declares a scoped '{gname}' override but "
                        f"no global gate '{gname}' is declared"
                    )
                _validate_gate_spec(errs, f"surface '{nm}': gate override '{gname}'", gcmd)
        for rule in surf.get("rules") or []:
            # An entry is either inline prose (has spaces / long) or a rule-id.
            is_id = (" " not in rule) and len(rule) <= 60
            if is_id and rule in BUILTIN_RULE_IDS:
                continue  # resolved against the plugin's own rules file
            if is_id and doc_text is not None and rule not in heading_ids:
                errs.append(
                    f"surface '{nm}': rule-id '{rule}' not found as a "
                    f"'### {rule}' heading in rules-doc '{rules_doc}'"
                )
            if is_id and doc_text is None:
                errs.append(
                    f"surface '{nm}': rule-id '{rule}' used but no conventions.rules-doc is set to resolve it"
                )

    # D4/1.5: a generator nobody runs is worse than no generator — fail loud
    # when config.yaml's rules: has drifted from conventions.rules-doc.
    drift = _conventions_drift(m, root)
    if drift:
        errs.append(drift)

    # onboarding-asks-first §5: the declared integration process (how a
    # change reaches main) is optional — absence means today's behavior — but
    # a present one must have a shape the loop can eventually switch on.
    if "integration" in m:
        integ = m.get("integration")
        if not isinstance(integ, dict):
            errs.append("integration must be a mapping")
        else:
            mode = integ.get("mode")
            if mode not in ("local-squash-merge", "pull-request"):
                errs.append(
                    "integration.mode must be 'local-squash-merge' or "
                    f"'pull-request' (got {mode!r})"
                )
            if "requireApproval" in integ and not isinstance(integ["requireApproval"], bool):
                errs.append("integration.requireApproval must be a boolean")

    # solo-approval-mode D1: the declared plan-approval policy is optional --
    # absence means today's behavior (`review`, a second party approves via
    # the forge) -- but a present block must name one of the two accepted
    # values, so `gates validate` fails loud on a typo rather than a writer
    # silently treating an unrecognized value as one policy or the other.
    if "approval" in m:
        appr = m.get("approval")
        if not isinstance(appr, dict):
            errs.append("approval must be a mapping")
        else:
            plan = appr.get("plan")
            if plan not in ("review", "self"):
                errs.append(
                    f"approval.plan must be 'review' or 'self' (got {plan!r})"
                )
            # acceptance-gate D1: `acceptance` is optional -- absent means no
            # acceptance is required anywhere. A present value must be one of
            # the two policies, and `review` needs a pull request whose review
            # can be read: a `local-squash-merge` project (or one declaring no
            # `integration` at all, which means the same) could never satisfy
            # it, so that is a validate-time error, not a first-merge surprise.
            # JSON Schema cannot express the cross-block conflict; this can.
            if "acceptance" in appr:
                acc = appr.get("acceptance")
                if acc not in ACCEPTANCE_POLICIES:
                    errs.append(
                        f"approval.acceptance must be 'review' or 'self' (got {acc!r})"
                    )
                elif acc == "review":
                    integ = m.get("integration")
                    mode = integ.get("mode") if isinstance(integ, dict) else None
                    if mode != "pull-request":
                        errs.append(
                            "approval.acceptance is 'review', but the declared integration "
                            f"mode ({mode or 'local-squash-merge (no integration block)'}) "
                            "opens no pull request to review — a review-based acceptance "
                            "needs a pull request. Resolve it with `approval.acceptance: "
                            "self` (standing self-acceptance) or `integration.mode: "
                            "pull-request`."
                        )

    # acceptance-gate D5: the optional top-level `acceptance` block names
    # where the project's acceptance scenarios live, and nothing else -- one
    # key, `match`, a glob. It is the only thing the shim knows about
    # acceptance artifacts (no format, no runner), so any other key is
    # refused rather than silently ignored.
    if "acceptance" in m:
        acc_block = m.get("acceptance")
        shape = "the accepted shape is `acceptance: { match: \"<glob>\" }`"
        if not isinstance(acc_block, dict):
            errs.append(f"acceptance must be a mapping — {shape}")
        else:
            for key in acc_block:
                if key != "match":
                    errs.append(
                        f"acceptance has an unknown key '{key}' — {shape}"
                    )
            match = acc_block.get("match")
            if "match" not in acc_block:
                errs.append(f"acceptance.match is required — {shape}")
            elif not isinstance(match, str) or not match.strip():
                errs.append(f"acceptance.match must be a non-empty glob string — {shape}")
            else:
                try:
                    _expand_braces(match)
                except BraceExpansionError as e:
                    errs.append(f"acceptance.match: {e}")

    # worktree-native-loop design D3: `discipline.propose-branches` is an
    # optional list of additional fnmatch patterns accepted for proposal
    # authoring. Absent -> today's exact behavior (merge target + `plan/*`).
    if "discipline" in m:
        disc = m.get("discipline")
        if not isinstance(disc, dict):
            errs.append("discipline must be a mapping")
        elif "propose-branches" in disc:
            patterns = disc.get("propose-branches")
            if not isinstance(patterns, list):
                errs.append("discipline.propose-branches must be a list of strings")
            else:
                for p in patterns:
                    if not isinstance(p, str) or not p.strip():
                        errs.append(
                            "discipline.propose-branches entries must be "
                            f"non-empty strings (got {p!r})"
                        )
                    elif p.startswith("/"):
                        errs.append(
                            "discipline.propose-branches entries must be branch-"
                            f"name globs, not absolute paths (got {p!r})"
                        )
        if isinstance(disc, dict) and "agent-env" in disc:
            problem = _agent_env_problem(disc.get("agent-env"))
            if problem:
                errs.append(problem)

    # worktree-native-loop design D6: `concurrency.serialize` names gates
    # (or `live-check`, a declarable gate in the contract table though not a
    # `gates:` entry) to serialize machine-wide. Absent -> no locking, today's
    # exact behavior.
    if "concurrency" in m:
        conc = m.get("concurrency")
        if not isinstance(conc, dict):
            errs.append("concurrency must be a mapping")
        elif "serialize" in conc:
            names = conc.get("serialize")
            if not isinstance(names, list):
                errs.append("concurrency.serialize must be a list of gate names")
            else:
                declared = set((m.get("gates") or {}).keys()) | {"live-check"}
                for name in names:
                    if not isinstance(name, str) or not name.strip():
                        errs.append(
                            f"concurrency.serialize entries must be non-empty strings (got {name!r})"
                        )
                    elif name not in declared:
                        errs.append(
                            f"concurrency.serialize names '{name}', which is not a "
                            "declared gate (or 'live-check')"
                        )
        # lock-and-ledger-hygiene D2: the bound on a serialized gate's wait.
        # `bool` is an `int` subclass in Python, so `true` is refused by name.
        # merge-lane-friction D3: `merge-wait-seconds` bounds `gates merge`'s
        # own waits the same way.
        for key in ("max-wait-seconds", "merge-wait-seconds"):
            if isinstance(conc, dict) and key in conc:
                bound = conc.get(key)
                if isinstance(bound, bool) or not isinstance(bound, int) or bound <= 0:
                    errs.append(
                        f"concurrency.{key} must be a positive integer "
                        f"(got {bound!r})"
                    )

    # split-test-author D6: `loop.test-author` picks who authors a change's
    # tests. Absent -> `separate`. A present value must be one of the two;
    # an unknown key under `loop` is refused too, since a typo would silently
    # leave the project on the default it meant to change.
    if "loop" in m:
        loop = m.get("loop")
        if not isinstance(loop, dict):
            errs.append("loop must be a mapping")
        else:
            for key in loop:
                if key not in LOOP_KEYS:
                    errs.append(f"loop has an unknown key '{key}' (known: {', '.join(LOOP_KEYS)})")
            if "test-author" in loop and loop.get("test-author") not in TEST_AUTHOR_MODES:
                errs.append(
                    "loop.test-author must be "
                    f"{' or '.join(repr(v) for v in TEST_AUTHOR_MODES)} "
                    f"(got {loop.get('test-author')!r})"
                )
            # task-oracle: whether every task must declare its oracle.
            if "task-oracle" in loop and loop.get("task-oracle") not in TASK_ORACLE_MODES:
                errs.append(
                    "loop.task-oracle must be "
                    f"{' or '.join(repr(v) for v in TASK_ORACLE_MODES)} "
                    f"(got {loop.get('task-oracle')!r})"
                )
            # retry-budget D5: the attempt budget, integers >= 0. `bool` is an
            # `int` subclass, so `true` is refused by name.
            for key in ("attempts", "fresh-restarts"):
                if key in loop:
                    v = loop.get(key)
                    if isinstance(v, bool) or not isinstance(v, int) or v < 0:
                        errs.append(f"loop.{key} must be a non-negative integer (got {v!r})")
            # token-ledger D5: a change's token budget -- a positive integer,
            # no default (absent: no budget).
            if "token-budget" in loop:
                v = loop.get("token-budget")
                if isinstance(v, bool) or not isinstance(v, int) or v <= 0:
                    errs.append(f"loop.token-budget must be a positive integer of tokens "
                                f"per change (got {v!r})")

    # token-ledger D4: prices are the adopter's binding. The shape is checked,
    # never the model names; the shim ships no price list.
    if "economics" in m:
        errs.extend(_economics_errors(m.get("economics")))
    return errs


ECONOMICS_KEYS = ("currency", "prices")
PRICE_KEYS = ("input", "output", "cache-read", "cache-write")
# A price key -> the usage row's count it multiplies (TOKEN_FIELDS).
PRICE_FIELDS = dict(zip(PRICE_KEYS, ("input", "output", "cache_read", "cache_write")))


def _economics_errors(econ) -> list[str]:
    shape = ("the accepted shape is `economics: { currency: <code>, prices: { "
             "\"<model>\": { input: <n>, output: <n>, cache-read: <n>, cache-write: <n> } } }`, "
             "prices per million tokens")
    if not isinstance(econ, dict):
        return [f"economics must be a mapping — {shape}"]
    errs = [f"economics has an unknown key '{k}' (known: {', '.join(ECONOMICS_KEYS)})"
            for k in econ if k not in ECONOMICS_KEYS]
    if "currency" in econ or "prices" in econ:
        cur = econ.get("currency")
        if not isinstance(cur, str) or not cur.strip():
            errs.append(f"economics.currency must be a non-empty string naming the "
                        f"currency the prices are in (got {cur!r})")
    if "prices" in econ:
        prices = econ.get("prices")
        if not isinstance(prices, dict):
            errs.append(f"economics.prices must be a mapping of model name to prices — {shape}")
            return errs
        for model, entry in prices.items():
            where = f"economics.prices['{model}']"
            if not isinstance(entry, dict):
                errs.append(f"{where} must be a mapping of {', '.join(PRICE_KEYS)} — {shape}")
                continue
            for k in entry:
                if k not in PRICE_KEYS:
                    errs.append(f"{where} has an unknown key '{k}' (known: {', '.join(PRICE_KEYS)})")
            for k in PRICE_KEYS:
                if k not in entry:
                    errs.append(f"{where} is missing '{k}'")
                    continue
                v = entry[k]
                if isinstance(v, bool) or not isinstance(v, (int, float)) or v < 0:
                    errs.append(f"{where}.{k} must be a non-negative number (got {v!r})")
    return errs


TEST_AUTHOR_MODES = ("separate", "inline")
TASK_ORACLE_MODES = ("optional", "required")
LOOP_KEYS = ("test-author", "attempts", "fresh-restarts", "token-budget", "task-oracle")
DEFAULT_LOOP_ATTEMPTS = 2
DEFAULT_LOOP_FRESH_RESTARTS = 1


def loop_budget(m: dict) -> tuple[int, int]:
    """The effective `(loop.attempts, loop.fresh-restarts)` (retry-budget D5):
    each key's declared value when it is a valid non-negative integer, its
    default otherwise (a malformed value is `gates validate`'s business)."""
    loop = m.get("loop") if isinstance(m, dict) else None
    loop = loop if isinstance(loop, dict) else {}

    def pick(key: str, default: int) -> int:
        v = loop.get(key)
        if isinstance(v, bool) or not isinstance(v, int) or v < 0:
            return default
        return v

    return (pick("attempts", DEFAULT_LOOP_ATTEMPTS),
            pick("fresh-restarts", DEFAULT_LOOP_FRESH_RESTARTS))


def _loop_budget_warnings(m: dict) -> list[str]:
    """Legal but odd budgets (retry-budget D5): advisory, never an error."""
    loop = m.get("loop") if isinstance(m, dict) else None
    if isinstance(loop, dict) and loop.get("attempts") == 0 and not isinstance(loop.get("attempts"), bool):
        return ["loop.attempts is 0: the first failed attempt after a task's RED run "
                "refuses every further `unit` or `ci` run for it"]
    return []


def _task_oracle_mode(m: dict) -> str:
    """The effective `loop.task-oracle` (task-oracle D7): `required` only
    when declared; `optional` otherwise (a malformed value is `gates
    validate`'s business)."""
    loop = m.get("loop") if isinstance(m, dict) else None
    if isinstance(loop, dict) and loop.get("task-oracle") == "required":
        return "required"
    return "optional"


def _test_author_mode(m: dict) -> str:
    """The effective `loop.test-author` (design D6): `inline` only when
    explicitly declared; `separate` otherwise, including when the block is
    absent or malformed (a malformed block is `gates validate`'s business)."""
    loop = m.get("loop")
    if isinstance(loop, dict) and loop.get("test-author") == "inline":
        return "inline"
    return "separate"


def _approval_policy(m: dict) -> str:
    """The effective plan-approval policy (design D1): `self` only when
    explicitly declared; `review` otherwise, including when the block is
    absent or malformed (a malformed block is `gates validate`'s business,
    not a silent policy escalation here)."""
    appr = m.get("approval")
    if isinstance(appr, dict) and appr.get("plan") == "self":
        return "self"
    return "review"


ACCEPTANCE_POLICIES = ("review", "self")
# acceptance-gate D2: the ledger event an acceptance is recorded as.
ACCEPTANCE_EVENT = "acceptance"
# merge-pull-request D4: `gates ledger record-ready` -- the implementer's
# READY TO MERGE, recorded and committed so any process can read it.
READY_EVENT = "ready"


def _acceptance_policy(m: dict) -> str | None:
    """The declared acceptance policy (acceptance-gate D1): `"review"`,
    `"self"`, or `None` when undeclared. Deliberately asymmetric with
    `_approval_policy`: plan approval is always required, so its policy
    defaults to `review`; acceptance is opt-in, so an undeclared (or
    malformed -- `gates validate`'s business) value means *nothing is
    required*, never a silently chosen policy."""
    appr = m.get("approval")
    if isinstance(appr, dict):
        acc = appr.get("acceptance")
        if acc in ACCEPTANCE_POLICIES:
            return acc
    return None


def cmd_init(_args) -> int:
    root = _repo_root()
    existing, _ignored = _find_manifest(root)
    if existing is not None:
        print(f"gatedloop: a manifest already exists at {root} — nothing to do "
              "(edit it, or run `gates validate`).")
        return 0
    tmpl = Path(__file__).resolve().parent.parent / "templates" / "gates.yaml.template"
    dest = root / ".gates.yaml"
    if not tmpl.exists():
        sys.exit(f"gatedloop: template not found at {tmpl}")
    dest.write_text(tmpl.read_text())
    print(
        f"gatedloop: wrote {dest}\n"
        "Next: fill in your gate commands + surfaces, then `gates validate`.\n"
        "For guided setup (auto-detects your task runner, asks for the rest), "
        "run /gatedloop:gates-init inside Claude Code."
    )
    return 0


# ---------- adoption (openspec change `adoption-prompts`) -------------------
#
# What a new plugin version asks an adopter to *decide*. The catalogue ships in
# the plugin (resolved from this shim's location, like templates/); whether an
# item is still undecided is computed here, in code, from closed sets of
# detector/predicate/action kinds (design D1/D3). The questions themselves are
# asked by /gatedloop:upgrade, never by the shim or a hook.

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
ADOPTION_CATALOG_FILE = PLUGIN_ROOT / "adoption" / "catalog.json"
PLUGIN_MANIFEST_FILE = PLUGIN_ROOT / ".claude-plugin" / "plugin.json"
ADOPTION_RECORD_NAME = "adoption.json"
ADOPTION_DECISIONS = ("adopted", "declined", "later")
ADOPTION_OPTION_ANSWERS = ("adopted", "declined")  # "later" is always offered by the walk
ADOPTION_DETECTOR_KINDS = {"manifest-key": ("key",), "rules-target": ("target",),
                           "schema-key": ("key",), "decision-only": (),
                           "git-hook-current": (), "old-approval-keys": (),
                           "earlier-name": (),
                           "file-contains": ("path", "text"),
                           "git-push-hook-installed": ()}
ADOPTION_PREDICATE_KINDS = ("manifest-key", "path-exists", "surface-key", "any",
                            "git-hook-copy", "git-commit-hook-wired")
ADOPTION_ACTION_KINDS = {"manifest-key": ("key",), "onboarding-step": ("step",),
                         "confirm": ("detail",)}
ADOPTION_REQUIRED_FIELDS = ("id", "since", "what", "question", "options", "detector",
                            "applies_when", "action")
ADOPTION_RECOMMENDED = "(Recommended)"
_SEMVER_RE = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")


class AdoptionError(Exception):
    """The adoption state cannot be decided: a bad catalogue, an unreadable
    record, or an unknown kind. Always fatal (fail-loud-gates)."""


def _semver_key(value) -> tuple | None:
    m = _SEMVER_RE.match(value) if isinstance(value, str) else None
    return tuple(int(g) for g in m.groups()) if m else None


def _nonempty_str(value) -> bool:
    return isinstance(value, str) and bool(value.strip())


def _check_kinded(where: str, block, kinds: dict) -> None:
    if not isinstance(block, dict):
        raise AdoptionError(f"{where} must be a mapping with a `kind`")
    kind = block.get("kind")
    if kind not in kinds:
        raise AdoptionError(f"{where} has unknown kind '{kind}' "
                            f"(known: {', '.join(kinds)})")
    for field in kinds[kind]:
        if not _nonempty_str(block.get(field)):
            raise AdoptionError(f"{where} of kind '{kind}' needs a non-empty `{field}`")


def _check_predicate(where: str, pred) -> None:
    if pred is None:
        return
    if not isinstance(pred, dict) or pred.get("kind") not in ADOPTION_PREDICATE_KINDS:
        kind = pred.get("kind") if isinstance(pred, dict) else pred
        raise AdoptionError(f"{where} has unknown kind '{kind}' "
                            f"(known: {', '.join(ADOPTION_PREDICATE_KINDS)}, or null)")
    if pred["kind"] == "manifest-key":
        keys = pred.get("any_of", [pred.get("key")])
        if not isinstance(keys, list) or not keys or not all(_nonempty_str(k) for k in keys):
            raise AdoptionError(f"{where} of kind 'manifest-key' needs a `key` or a "
                                "non-empty `any_of` list of keys")
    elif pred["kind"] == "surface-key":
        if not _nonempty_str(pred.get("key")):
            raise AdoptionError(f"{where} of kind 'surface-key' needs a non-empty `key`")
    elif pred["kind"] == "any":
        nested = pred.get("of")
        if not isinstance(nested, list) or not nested:
            raise AdoptionError(f"{where} of kind 'any' needs a non-empty `of` list of predicates")
        for n, sub in enumerate(nested):
            if sub is None:
                raise AdoptionError(f"{where} `of` entry {n + 1} is null")
            _check_predicate(f"{where} `of` entry {n + 1}", sub)
    elif pred["kind"] in ("git-hook-copy", "git-commit-hook-wired"):
        return  # no fields: it reads the gathered hook facts (adoption-followups D2)
    elif not _nonempty_str(pred.get("glob")):
        raise AdoptionError(f"{where} of kind 'path-exists' needs a non-empty `glob`")


def _check_options(where: str, options, action: dict) -> None:
    if not isinstance(options, list) or not options:
        raise AdoptionError(f"{where} `options` must be a non-empty list")
    for n, opt in enumerate(options):
        if not isinstance(opt, dict) or not _nonempty_str(opt.get("label")):
            raise AdoptionError(f"{where} option {n + 1} needs a non-empty `label`")
        if opt.get("answer") not in ADOPTION_OPTION_ANSWERS:
            raise AdoptionError(
                f"{where} option {n + 1} has answer '{opt.get('answer')}'; an option is "
                f"{' or '.join(ADOPTION_OPTION_ANSWERS)} — 'later' is offered by the walk itself")
        recommended = ADOPTION_RECOMMENDED in opt["label"]
        if recommended != (n == 0):
            raise AdoptionError(f"{where} must list exactly one option marked "
                                f"'{ADOPTION_RECOMMENDED}', and list it first")
        if (action.get("kind") == "manifest-key" and opt["answer"] == "adopted"
                and "value" not in opt):
            raise AdoptionError(f"{where} option {n + 1} adopts a manifest key, so it needs "
                                "the `value` to set")


def load_adoption_catalog(data) -> list[dict]:
    """Validate a parsed `adoption/catalog.json` and return its items, in
    catalogue order. Raises AdoptionError naming the item on any violation
    (design D1) — nothing is ever evaluated from a catalogue that failed."""
    items = data.get("items") if isinstance(data, dict) else None
    if not isinstance(items, list):
        raise AdoptionError("the catalogue must be an object with an `items` list")
    seen: set[str] = set()
    for n, item in enumerate(items):
        if not isinstance(item, dict):
            raise AdoptionError(f"catalogue item {n + 1} is not an object")
        label = item.get("id") if _nonempty_str(item.get("id")) else f"#{n + 1}"
        where = f"catalogue item '{label}'"
        missing = [f for f in ADOPTION_REQUIRED_FIELDS if f not in item]
        if missing:
            raise AdoptionError(f"{where} is missing {', '.join(missing)}")
        if label in seen:
            raise AdoptionError(f"{where} is a duplicate id")
        seen.add(label)
        if _semver_key(item["since"]) is None:
            raise AdoptionError(f"{where} has since '{item['since']}', not MAJOR.MINOR.PATCH")
        for field in ("id", "what", "question"):
            if not _nonempty_str(item[field]):
                raise AdoptionError(f"{where} needs a non-empty `{field}`")
        # adoption-followups D4: optional, and a real boolean when present; a
        # truthy typo must not turn a one-time item into a recurring one.
        if "recurs" in item and not isinstance(item["recurs"], bool):
            raise AdoptionError(f"{where} has recurs {item['recurs']!r}; `recurs` is "
                                "true or false, or absent")
        _check_kinded(f"{where} detector", item["detector"], ADOPTION_DETECTOR_KINDS)
        _check_predicate(f"{where} applies_when", item["applies_when"])
        _check_kinded(f"{where} action", item["action"], ADOPTION_ACTION_KINDS)
        _check_options(where, item["options"], item["action"])
    return items


# Project facts the evaluators read, gathered once by `_adoption_project_facts`:
#   manifest        the parsed .gates.yaml (or {})
#   rules_doc       the text of conventions.rules-doc, or None
#   schemas         raw text of each openspec/schemas/*/schema.yaml
#   existing_globs  the `path-exists` globs that match at least one path
#   hook            {"copy", "current"} for the pre-commit hook path, from the
#                   same `_hook_copy_facts` `gates doctor` reads
#                   (adoption-followups D2)
#   push_hook       the same for the pre-push hook path (git-layer-enforcement D4)
#   hook_states     {"pre-commit": state, "pre-push": state}, `_hook_state`'s
#                   doctor vocabulary for each hook
#   old_approval_changes
#                   active changes still carrying 0.5.0-spelled approval keys,
#                   from the same scan doctor's `approval-keys` row reads
#                   (openspec-1-14-compat D4a)
#   files           {path: text or None} for every `file-contains` detector's
#                   path, relative to the repo root (merge-lane-friction D5)

def _dotted_present(data, dotted: str) -> bool:
    node = data
    for part in dotted.split("."):
        if not isinstance(node, dict) or part not in node:
            return False
        node = node[part]
    return node is not None


def adoption_detector_acted(detector: dict, facts: dict) -> bool:
    """Has the project already acted on this item? (design D1). Pure."""
    kind = detector.get("kind")
    if kind == "manifest-key":
        return _dotted_present(facts["manifest"], detector["key"])
    if kind == "rules-target":
        text = facts.get("rules_doc")
        if not text:
            return False
        return any(detector["target"] in meta["applies_to"]
                   for meta in parse_conventions_doc(text).values())
    if kind == "schema-key":
        # Column-0 key match on raw text: presence only, so no YAML parser is
        # needed (the schema-declared-flow D4 reasoning).
        pattern = re.compile(rf"^{re.escape(detector['key'])}\s*:", re.MULTILINE)
        return any(pattern.search(text) for text in facts["schemas"])
    if kind == "decision-only":
        return False
    if kind == "git-hook-current":
        # Acted unless either hook path holds a direct copy that is not
        # current (D2; both hooks since git-layer-enforcement D4); no hook, or
        # a composed one, leaves nothing to refresh.
        for hook in (facts["hook"], facts.get("push_hook") or {}):
            if hook.get("copy") and not hook.get("current"):
                return False
        return True
    if kind == "git-push-hook-installed":
        # Acted once the push hook is anything but absent (git-layer-
        # enforcement D4): a stale or uncomposed one is the refresh's and
        # the doctor's business, not this offer's.
        return (facts.get("hook_states") or {}).get("pre-push", "absent") != "absent"
    if kind == "old-approval-keys":
        # Acted unless an active change still carries an earlier-spelled
        # approval key (openspec-1-14-compat D4a).
        return not facts.get("old_approval_changes")
    if kind == "earlier-name":
        # Acted unless the project still holds an earlier name
        # (rename-to-gatedloop D3), from the scan doctor's `name` row reads.
        return not facts.get("earlier_names")
    if kind == "file-contains":
        # Acted unless the file holds the text; an absent file holds nothing
        # (merge-lane-friction D5).
        text = (facts.get("files") or {}).get(detector["path"])
        return not (text and detector["text"] in text)
    raise AdoptionError(f"unknown detector kind '{kind}'")


def adoption_applies(predicate, facts: dict) -> bool:
    """Does the item concern this project at all? `None` always applies. Pure."""
    if predicate is None:
        return True
    kind = predicate.get("kind")
    if kind == "manifest-key":
        keys = predicate.get("any_of", [predicate.get("key")])
        return any(_dotted_present(facts["manifest"], k) for k in keys)
    if kind == "path-exists":
        return predicate["glob"] in facts["existing_globs"]
    if kind == "surface-key":
        # Some `surfaces[]` entry declares the key, e.g. a per-surface live-check.
        surfaces = facts["manifest"].get("surfaces")
        return isinstance(surfaces, list) and any(
            isinstance(s, dict) and s.get(predicate["key"]) is not None for s in surfaces)
    if kind == "any":
        return any(adoption_applies(sub, facts) for sub in predicate["of"])
    if kind == "git-hook-copy":
        return bool(facts["hook"]["copy"] or (facts.get("push_hook") or {}).get("copy"))
    if kind == "git-commit-hook-wired":
        return (facts.get("hook_states") or {}).get("pre-commit") == "wired"
    raise AdoptionError(f"unknown applies_when kind '{kind}'")


def _decision_applies(record, installed_version: str, recurs: bool = False) -> bool:
    """`adopted`/`declined` always apply; `later` only at the version it was
    recorded at, so it comes back once the plugin version changes (D3).

    For a recurring item (adoption-followups D4) the detector is the truth:
    `adopted` never applies, and `declined` is version-scoped like `later`,
    so the act a later release requires again is asked about again."""
    if not isinstance(record, dict):
        return False
    decision = record.get("decision")
    at_installed = record.get("version") == installed_version
    if recurs:
        return decision in ("declined", "later") and at_installed
    if decision in ("adopted", "declined"):
        return True
    return decision == "later" and at_installed


def adoption_undecided(items: list[dict], facts: dict, decisions: dict,
                       installed_version: str) -> list[dict]:
    """The items to ask about (design D3), in walk order: `since`, then
    catalogue order. Listed when it applies, the detector says not acted
    (detector beats record), and no recorded decision still applies; an
    item whose `since` is later than the installed version is never listed.
    Pure."""
    out = []
    installed = _semver_key(installed_version)
    for index, item in enumerate(items):
        # D1 "Unreleased items": only this repo between releases carries an
        # item later than the installed version; nothing asks about it yet.
        if installed is not None and _semver_key(item["since"]) > installed:
            continue
        if not adoption_applies(item["applies_when"], facts):
            continue
        if adoption_detector_acted(item["detector"], facts):
            continue
        if _decision_applies(decisions.get(item["id"]), installed_version,
                             recurs=item.get("recurs", False)):
            continue
        out.append((_semver_key(item["since"]), index, item))
    return [item for _key, _index, item in sorted(out, key=lambda t: t[:2])]


def _adoption_read_json(path: Path, what: str):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        raise AdoptionError(f"{what} not found at {path}")
    except (OSError, ValueError) as e:
        raise AdoptionError(f"{what} at {path} is unreadable ({e})")


def _shipped_adoption_catalog() -> list[dict]:
    return load_adoption_catalog(_adoption_read_json(ADOPTION_CATALOG_FILE, "the adoption catalogue"))


def _installed_plugin_version() -> str:
    """The installed plugin's version, from `.claude-plugin/plugin.json` beside
    this shim (design D3)."""
    data = _adoption_read_json(PLUGIN_MANIFEST_FILE, "the plugin manifest")
    version = data.get("version") if isinstance(data, dict) else None
    if _semver_key(version) is None:
        raise AdoptionError(f"{PLUGIN_MANIFEST_FILE} has version '{version}', not MAJOR.MINOR.PATCH")
    return version


def _read_adoption_decisions(root: Path) -> dict:
    """`.gatedloop/adoption.json`'s decisions; {} when the file is absent."""
    path = _state_dir(root) / ADOPTION_RECORD_NAME
    if not path.exists():
        return {}
    data = _adoption_read_json(path, "the adoption record")
    decisions = data.get("decisions") if isinstance(data, dict) else None
    if not isinstance(decisions, dict):
        raise AdoptionError(f"{path} must be an object with a `decisions` object")
    return decisions


def cmd_adoption_record(root: Path, args) -> int:
    """`gates adoption record <id> <decision>` (design D2): the only writer of
    `.gatedloop/adoption.json`. Refuses before writing on an unknown id or
    decision, a bad catalogue or record, or no git identity; the write is a
    temp file then a rename, so a reader never sees half a record."""
    items = _shipped_adoption_catalog()
    ids = [i["id"] for i in items]
    if args.id not in ids:
        raise AdoptionError(f"unknown adoption item '{args.id}' (known: {', '.join(ids)})")
    if args.decision not in ADOPTION_DECISIONS:
        raise AdoptionError(f"unknown decision '{args.decision}' "
                            f"(one of: {', '.join(ADOPTION_DECISIONS)})")
    path = _write_adoption_decision(root, args.id, args.decision)
    print(f"gatedloop: recorded {args.id}: {args.decision} (gatedloop {_installed_plugin_version()}) in {path}. "
          "Commit it, so the whole team shares the decision.")
    return 0


def _write_adoption_decision(root: Path, item_id: str, decision: str) -> Path:
    """Write one decision to `.gatedloop/adoption.json` (design D2's record):
    shared by `gates adoption record` and `gates hook install --commit-only /
    --push` (git-layer-enforcement 6.2), so the record has one writer. The
    write is a temp file then a rename, so a reader never sees half a
    record."""
    version = _installed_plugin_version()
    decisions = _read_adoption_decisions(root)
    by = _local_git_identity(root)
    if not by:
        raise AdoptionError("no git identity configured (user.name/user.email); "
                            "set one so the record says who decided")
    decisions[item_id] = {"decision": decision, "by": by, "at": _now_iso(),
                          "version": version}
    path = _state_dir(root) / ADOPTION_RECORD_NAME
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".adoption-", suffix=".json", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump({"decisions": decisions}, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    return path


def _adoption_manifest(root: Path) -> dict:
    """The project's manifest, or {} when it has none; an unparsable one
    means the detectors cannot answer, so it fails rather than reading {}."""
    path, _ignored = _find_manifest(root)
    if path is None:
        return {}
    try:
        data = _load(path)
    except Exception as e:  # noqa: BLE001 -- any parse failure is "cannot decide"
        raise AdoptionError(f"{path.name} is unreadable ({e})")
    if not isinstance(data, dict):
        raise AdoptionError(f"{path.name} did not parse to a mapping")
    return data


def _adoption_project_facts(root: Path, manifest: dict, items: list[dict]) -> dict:
    """Gather, once, everything the pure evaluators read (see above)."""
    conventions = manifest.get("conventions")
    rel = conventions.get("rules-doc") if isinstance(conventions, dict) else None
    rules_doc = None
    if isinstance(rel, str) and rel:
        with contextlib.suppress(OSError):
            rules_doc = (root / rel).read_text()
    schemas = []
    for path in sorted((root / "openspec" / "schemas").glob("*/schema.yaml")):
        with contextlib.suppress(OSError):
            schemas.append(path.read_text())
    globs: set[str] = set()

    def collect(pred):
        if not pred:
            return
        if pred.get("kind") == "path-exists":
            globs.add(pred["glob"])
        for sub in pred.get("of", []) if pred.get("kind") == "any" else []:
            collect(sub)

    for item in items:
        collect(item["applies_when"])
    existing = {g for g in globs if next(iter(root.glob(g)), None) is not None}
    files: dict = {}
    for item in items:
        detector = item["detector"]
        if detector.get("kind") == "file-contains":
            files[detector["path"]] = _read_text_or_none(root / detector["path"])
    return {"manifest": manifest, "rules_doc": rules_doc, "schemas": schemas,
            "existing_globs": existing, "hook": _hook_copy_facts(root),
            "push_hook": _hook_copy_facts(root, "pre-push"),
            "hook_states": {hook: _hook_state(root, hook) for hook in GIT_HOOKS},
            "old_approval_changes": _changes_with_old_approval_keys(root),
            "earlier_names": _earlier_name_remnants(root),
            "files": files}


def _read_text_or_none(path: Path) -> str | None:
    try:
        return path.read_text()
    except (OSError, UnicodeDecodeError):
        return None


def cmd_adoption_status(root: Path, args) -> int:
    """`gates adoption status [--json]` (design D3). Exit 0 whether or not
    anything is listed; non-zero (via AdoptionError) only when it cannot
    decide."""
    items = _shipped_adoption_catalog()
    version = _installed_plugin_version()
    decisions = _read_adoption_decisions(root)
    facts = _adoption_project_facts(root, _adoption_manifest(root), items)
    undecided = adoption_undecided(items, facts, decisions, version)
    if args.json:
        print(json.dumps({"version": version, "undecided": [
            {"id": i["id"], "since": i["since"], "what": i["what"]} for i in undecided]}))
        return 0
    if not undecided:
        print(f"gatedloop {version}: nothing to decide — every adoption item is decided, "
              "already set, or does not apply to this project.")
        return 0
    print(f"gatedloop {version}: {len(undecided)} setting(s) this project hasn't decided on:")
    for i in undecided:
        print(f"  - {i['id']} (since {i['since']}): {i['what']}")
    print("Run /gatedloop:upgrade to decide them, one question each.")
    return 0


def cmd_adoption(args) -> int:
    """`gates adoption …`. Runs ahead of load_manifest: a project with no (or
    an unparsable) manifest still has decisions to record and read."""
    root = _repo_root()
    try:
        if args.adoption_cmd == "status":
            return cmd_adoption_status(root, args)
        return cmd_adoption_record(root, args)
    except AdoptionError as e:
        print(f"gatedloop: adoption {args.adoption_cmd}: {e}", file=sys.stderr)
        return 1


# ---------- doctor (D3/D4: an onboarding preflight, advisory, never blocking) --
#
# Runs as gates-init's step 0 (before any .gates.yaml exists) and standalone.
# It diagnoses the *reachable* partial-visibility states — OpenSpec CLI missing
# or drifted from the tested contract version (F5), a stale gatesVersion,
# `gates` not resolving by name on PATH. The *fully*-invisible state (no
# gatedloop surface reachable at all) cannot be diagnosed by a command bundled
# in the very plugin that is invisible; SETUP.md's CLAUDE_CONFIG_DIR note
# covers that, and the shim-location row points at it. Every finding is 'ok' or 'warn' — NEVER a
# blocking error: a pre-1.0 CLI's version drift is informative, not conclusive,
# so it must not fail `gates validate` or stop onboarding (design D4).

def _parse_openspec_version(raw: str | None) -> str | None:
    """A semver from `openspec --version` output (bare or embedded), else None."""
    if not raw:
        return None
    m = re.search(r"\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?", raw)
    return m.group(0) if m else None


def _openspec(args: list, cwd, **kw) -> subprocess.CompletedProcess:
    """Run `openspec <args>` with `OPEN_SPEC_INTERACTIVE=0` added to a copy of
    the environment (openspec-1-14-compat D5). The shim starts OpenSpec from
    hooks and the git pre-commit layer, where a spinner on a terminal that
    reports zero columns could spin forever (fixed upstream in 1.14.3); the
    variable is harmless on versions that do not read it. Every `openspec`
    subprocess goes through here."""
    env = dict(kw.pop("env", None) or os.environ)
    env["OPEN_SPEC_INTERACTIVE"] = "0"
    return subprocess.run(["openspec", *args], cwd=cwd, env=env, **kw)


def _installed_openspec_version(root: Path) -> str | None:
    """The installed OpenSpec CLI version, or None if it is absent/unreadable."""
    try:
        out = _openspec(["--version"], root, capture_output=True, text=True, timeout=15)
    except Exception:
        return None
    if out.returncode != 0:
        return None
    return _parse_openspec_version(out.stdout) or _parse_openspec_version(out.stderr)


_NOT_CHECKED = object()


def _shim_location(shim_path) -> tuple:
    """Where the running shim lives, from its own resolved path (gates-on-path
    D3): ``("plugin", marketplace, plugin, version, path)`` for an installed
    copy under `plugins/cache/<marketplace>/<plugin>/<version>/bin/gates`,
    ``("checkout", root)`` for a git work tree carrying
    `.claude-plugin/plugin.json` (a linked worktree's `.git` is a file), else
    ``("other", path)``."""
    p = Path(shim_path).resolve()
    parts = p.parts
    for i in range(len(parts) - 1):
        if (parts[i] == "plugins" and parts[i + 1] == "cache"
                and len(parts) == i + 7 and parts[-2:] == ("bin", "gates")):
            return ("plugin", parts[i + 2], parts[i + 3], parts[i + 4], str(p))
    root = p.parent.parent
    if (root / ".git").exists() and (root / ".claude-plugin" / "plugin.json").is_file():
        return ("checkout", str(root))
    return ("other", str(p))


def doctor_checks(installed_openspec, gates_version, shim_path=None, hook_state=None,
                  yaml_importable=None, forge_cli=None, old_approval_changes=None,
                  gates_on_path=_NOT_CHECKED, local_settings=_NOT_CHECKED,
                  earlier_names=_NOT_CHECKED, push_hook_state=None) -> list:
    """The pure diagnostic logic (design D3/D4). Returns a list of
    ``(level, title, detail)`` where `level` is 'ok' or 'warn' — never a
    blocking 'error', because doctor is advisory: nothing here fails validation
    or blocks onboarding.

    `hook_state` (enforce-at-the-effect, task 2.4) is the git pre-commit hook's
    wiring state — `_hook_state()`'s primitive. `None` means "not checked" and
    the hook sub-check is omitted (so a caller with no git context adds no
    misleading row); a real state adds one advisory ok/warn row.

    `yaml_importable` (schema-declared-flow D5) is whether PyYAML imports.
    `None` omits the row; a bool adds one advisory ok/warn row. Its absence is
    never a failure: every gate, hook and dispatch decision works without it.

    `push_hook_state` (git-layer-enforcement D4) is the git pre-push hook's
    state, from the same primitive; `None` omits its row.

    `old_approval_changes` (openspec-1-14-compat D4) lists the active changes
    still carrying 0.5.0-spelled approval keys. `None` omits the row.

    `forge_cli` (merge-pull-request D1) is the forge CLI's state --
    `_forge_cli_state()`'s "ready" | "missing" | "unauthenticated" -- passed
    only where `integration.mode: pull-request` is declared. `None` omits the
    row: a local-squash-merge project never needs `gh`.

    `gates_on_path` (gates-on-path D2) is what `shutil.which("gates")`
    returned: a path, or None when `gates` does not resolve by name. Left out,
    the row is omitted.

    `local_settings` (merge-lane-friction D5) is the text of the project's
    `.claude/settings.local.json`, or None when it is absent. Left out, the
    `merge-checkpoint` row is omitted.

    `shim_path` (gates-on-path D3) is the running shim's own path: the
    `shim-location` row reports where it lives, and `gates-on-path` compares
    against it and builds its remedy from it. `None` omits `shim-location`.
    """
    checks: list = []

    # 1. OpenSpec CLI presence + version (F5).
    if installed_openspec is None:
        checks.append((
            "warn", "openspec-cli",
            "OpenSpec CLI not found on PATH. gatedloop requires it; onboarding "
            "step 1 offers to install it (`npm install -g @fission-ai/openspec`).",
        ))
    elif installed_openspec != TESTED_OPENSPEC_VERSION:
        checks.append((
            "warn", "openspec-version",
            f"OpenSpec CLI is {installed_openspec}; gatedloop was last verified "
            f"against {TESTED_OPENSPEC_VERSION}. A pre-1.0 CLI can drift — this is "
            "a heads-up, not a failure. If `gates validate` behaves oddly, check "
            "`openspec schemas --json`'s shape, and re-run `gates doctor` after "
            "`openspec update`.",
        ))
    else:
        checks.append((
            "ok", "openspec-version",
            f"OpenSpec CLI {installed_openspec} matches the tested contract version.",
        ))

    # 2. gatesVersion currency (None = no manifest yet, which is fine at step 0).
    if gates_version is None:
        checks.append((
            "ok", "gates-version",
            "No .gates.yaml yet — onboarding will write one "
            f"(gatesVersion {EXPECTED_GATES_VERSION}).",
        ))
    elif gates_version != EXPECTED_GATES_VERSION:
        checks.append((
            "warn", "gates-version",
            f".gates.yaml declares gatesVersion {gates_version}; this shim expects "
            f"{EXPECTED_GATES_VERSION}. Migrate the manifest.",
        ))
    else:
        checks.append((
            "ok", "gates-version",
            f".gates.yaml gatesVersion {gates_version} is current.",
        ))

    # 3. Where the running shim lives (gates-on-path D3). Never a warning: the
    #    old `plugin-registered` row decided on CLAUDE_PLUGIN_ROOT, which the
    #    Bash tool's environment never carries, so it warned in every working
    #    session (issue #40). Omitted when no shim path is given.
    if shim_path:
        loc = _shim_location(shim_path)
        if loc[0] == "plugin":
            where = (f"This shim is the installed plugin copy: {loc[2]} {loc[3]} "
                     f"from marketplace {loc[1]} ({loc[4]}).")
        elif loc[0] == "checkout":
            where = (f"This shim runs from a checkout at {loc[1]}, not from a "
                     "plugin install.")
        else:
            where = f"This shim runs from {loc[1]}."
        checks.append((
            "ok", "shim-location",
            where + " Whether gatedloop's commands and hooks are registered for this "
            "session can't be seen from the Bash tool; hooks take effect only in a "
            "session started after the plugin was enabled or updated. If no "
            "gatedloop command, skill or session brief appears at all, see "
            "SETUP.md's CLAUDE_CONFIG_DIR troubleshooting note.",
        ))

    # 3b. `gates` by name on this shell's PATH (gates-on-path D2, issue #40):
    #     the symptom itself, not a proxy for it. Omitted when not checked.
    if gates_on_path is not _NOT_CHECKED:
        shim = Path(shim_path).resolve() if shim_path else None
        if gates_on_path:
            found = Path(gates_on_path)
            detail = f"`gates` resolves on PATH to {found}."
            if shim is not None and found.resolve() != shim:
                detail += (
                    f" That is a different copy from the running shim ({shim}), "
                    "and it is the one gatedloop's commands run."
                )
            checks.append(("ok", "gates-on-path", detail))
        else:
            bin_dir = shim.parent if shim is not None else "<plugin root>/bin"
            checks.append((
                "warn", "gates-on-path",
                "`gates` is not on this shell's PATH, so every `gates …` step in "
                "gatedloop's commands and skills fails. Remedies: (1) start a new "
                "session, which re-runs the SessionStart fallback; (2) "
                f'`export PATH="$PATH:{bin_dir}"`; (3) see SETUP.md\'s note '
                "\"The plugin is active but `gates` is not found\".",
            ))

    # 4. Git-layer commit hook wiring (enforce-at-the-effect, task 2.4). Omitted
    #    when not checked (hook_state None), so a non-git caller adds no row.
    if hook_state is not None:
        if hook_state == "wired":
            checks.append((
                "ok", "git-commit-hook",
                "The git pre-commit hook (effect-layer commit gate) is installed. "
                "It enforces only inside a Claude Code session and no-ops for humans.",
            ))
        elif hook_state == "stale-copy":
            checks.append((
                "warn", "git-commit-hook",
                "The git pre-commit hook is a direct copy of an earlier (or locally edited) "
                "gatedloop template, so it does not run the shipped check. Run `gates hook "
                "install`: it replaces the copy and keeps the old body in "
                "`pre-commit.gatedloop-prev` beside it.",
            ))
        elif hook_state == "manager-uncomposed":
            checks.append((
                "warn", "git-commit-hook",
                "A hook manager (husky/lefthook/pre-commit) owns the hook path but the "
                "git-layer commit gate is not composed into it. Run `gates hook install` "
                "(it composes where safe, refuses-and-instructs otherwise) — without it, "
                "only the tool-invocation hook guards commits (issue #2).",
            ))
        elif hook_state == "unmanaged-hook":
            checks.append((
                "warn", "git-commit-hook",
                "An existing, unmanaged pre-commit hook is present and the git-layer "
                "commit gate is not in it. `gates hook install` will refuse-and-instruct "
                "rather than risk your hook; wire the printed block by hand to close the "
                "#2 indirection gap.",
            ))
        else:  # absent
            checks.append((
                "warn", "git-commit-hook",
                "The git pre-commit hook (effect-layer commit gate) is not installed, so a "
                "commit created through indirection (a subprocess, a script) is caught only "
                "after the fact by the reflog audit (issue #2). Run `gates hook install` "
                "or re-run `/gatedloop:gates-init`.",
            ))

    # 4b. Git-layer push hook wiring (git-layer-enforcement D4): the commit
    #     hook's five states, for the hook that gates a push of the merge
    #     target. Omitted when not checked.
    if push_hook_state is not None:
        if push_hook_state == "declined":
            checks.append((
                "ok", "git-push-hook",
                "The git pre-push hook is not installed: this project declined it (the "
                "`git-push-hook` adoption item is recorded `declined`), so `gates hook "
                "install` installs the commit hook only. Add it with `gates hook install "
                "--push`.",
            ))
        elif push_hook_state == "wired":
            checks.append((
                "ok", "git-push-hook",
                "The git pre-push hook (the merge target's push gate) is installed. It "
                "enforces only inside a declared agent session and no-ops for humans.",
            ))
        elif push_hook_state == "stale-copy":
            checks.append((
                "warn", "git-push-hook",
                "The git pre-push hook is a direct copy of an earlier (or locally edited) "
                "gatedloop template, or the shim path it records is gone and nothing else "
                "resolves the shim. Run `gates hook install`: it replaces the copy and keeps "
                "the old body in `pre-push.gatedloop-prev` beside it.",
            ))
        elif push_hook_state == "manager-uncomposed":
            checks.append((
                "warn", "git-push-hook",
                "A hook manager (husky/lefthook/pre-commit) owns the hook path but the "
                "git-layer push gate is not composed into it. Run `gates hook install` "
                "(it composes where safe, refuses-and-instructs otherwise) — without it, "
                "a raw merge of the target pushed by hand is checked by nothing local.",
            ))
        elif push_hook_state == "unmanaged-hook":
            checks.append((
                "warn", "git-push-hook",
                "An existing, unmanaged pre-push hook is present and the git-layer push "
                "gate is not in it. `gates hook install` will refuse-and-instruct rather "
                "than risk your hook; wire the printed block by hand.",
            ))
        else:  # absent
            checks.append((
                "warn", "git-push-hook",
                "The git pre-push hook (the merge target's push gate) is not installed, so "
                "a raw merge of the target pushed by hand reaches the shared history "
                "unchecked. Run `gates hook install` or re-run `/gatedloop:gates-init`.",
            ))

    # 5. The optional YAML dependency (schema-declared-flow D5).
    if yaml_importable is not None:
        if yaml_importable:
            checks.append((
                "ok", "pyyaml",
                "PyYAML is importable, so `gates schema inspect` can parse a full "
                "schema.yaml.",
            ))
        else:
            checks.append(("warn", "pyyaml", PYYAML_ABSENT_HINT))

    # 6. The forge CLI, under pull-request mode only (merge-pull-request D1).
    if forge_cli == "ready":
        checks.append((
            "ok", "gh",
            "The forge CLI `gh` is installed and authenticated, so pull-request mode "
            "(`gates merge`, `gates marker publish|check-remote`, `gates record-merged`) "
            "can reach the forge.",
        ))
    elif forge_cli == "missing":
        checks.append((
            "warn", "gh",
            "integration.mode is pull-request, and the forge CLI `gh` is not installed. "
            "`gates merge`, `gates marker publish|check-remote` and `gates record-merged` "
            "will refuse until it is: install it (https://cli.github.com) and run "
            "`gh auth login`.",
        ))
    elif forge_cli is not None:
        checks.append((
            "warn", "gh",
            "integration.mode is pull-request, and the forge CLI `gh` is installed but not "
            "authenticated. Run `gh auth login` (or set GH_TOKEN in CI).",
        ))

    # 7. Approval keys in the earlier spelling (openspec-1-14-compat D4).
    if old_approval_changes is not None:
        if old_approval_changes:
            checks.append((
                "warn", "approval-keys",
                f"Active change(s) {', '.join(old_approval_changes)} still carry approval "
                "keys in the earlier spelling (approved_by/approved_at/approved_sha), and "
                "`openspec validate --strict` fails on them from OpenSpec 1.14. Run `gates "
                "approval migrate` to rename them to x-gatedloop-approved-* (values and the "
                "approval sha are unchanged), then commit the result.",
            ))
        else:
            checks.append((
                "ok", "approval-keys",
                "No active change carries an approval key in the earlier spelling.",
            ))

    # 8. The permission scaffolding's checkpoint (merge-lane-friction D5).
    if local_settings is not _NOT_CHECKED:
        if _asks_on_every_git_merge(local_settings):
            checks.append((
                "warn", "merge-checkpoint",
                f".claude/settings.local.json asks on `{_OLD_MERGE_ASK}`, so every `git "
                "merge` an agent issues prompts, including a lane's routine sync of the "
                "target into its own branch, and an unattended lane stalls on a prompt "
                "nobody answers. The checkpoint belongs on the command that integrates: "
                f"replace it with `{_NEW_MERGE_ASK}` in `permissions.ask`. The merge hook "
                "still gates a raw integration `git merge`.",
            ))
        else:
            checks.append((
                "ok", "merge-checkpoint",
                "No local permission rule asks on every `git merge`; the human checkpoint "
                f"belongs on `{_NEW_MERGE_ASK}`.",
            ))

    # 9. The plugin's earlier name (rename-to-gatedloop D3): what is left
    # for `gates migrate-name`, from the scan the `rename` adoption item reads.
    if earlier_names is not _NOT_CHECKED:
        checks.append(_doctor_name_row(earlier_names))

    return checks


_OLD_MERGE_ASK = "Bash(git merge *)"
_NEW_MERGE_ASK = "Bash(gates merge *)"


def _asks_on_every_git_merge(text: str | None) -> bool:
    """Whether a settings file's `permissions.ask` holds the pre-0.6.0
    scaffolding rule. Unreadable or absent settings ask on nothing."""
    if not text:
        return False
    try:
        data = json.loads(text)
    except ValueError:
        return False
    perms = data.get("permissions") if isinstance(data, dict) else None
    ask = perms.get("ask") if isinstance(perms, dict) else None
    return isinstance(ask, list) and _OLD_MERGE_ASK in ask


# The one wording for "PyYAML is missing", shared by doctor and inspect.
PYYAML_ABSENT_HINT = (
    "PyYAML not importable — `gates schema inspect` needs it; the loop, hooks and "
    "`gates schema dispatch` do not. Install with `python3 -m pip install --user "
    "pyyaml`, or `pipx`/`uv` if your Python is externally managed (PEP 668)."
)


def _pyyaml_importable() -> bool:
    try:
        import yaml  # type: ignore  # noqa: F401
    except ImportError:
        return False
    return True


def _doctor_push_hook_state(root: Path) -> str:
    """The push hook's doctor state, `declined` when it is absent because the
    project declined it (git-layer-enforcement 6.2). An unreadable adoption
    record leaves the plain state: the doctor is advisory and never fails."""
    state = _hook_state(root, "pre-push")
    if state == "absent":
        with contextlib.suppress(AdoptionError):
            if _push_hook_declined(root):
                return "declined"
    return state


def cmd_doctor(_args) -> int:
    """gates doctor — the onboarding preflight (design D3). Special-cased in
    main() to run WITHOUT requiring a manifest, since it is gates-init's step 0
    and fires before any .gates.yaml exists. Always exits 0 (advisory)."""
    root = _repo_root()
    installed = _installed_openspec_version(root)

    gates_version = None
    mode = None
    path, _ignored = _find_manifest(root)
    if path is not None:
        try:
            data = _load(path) or {}
            gates_version = data.get("gatesVersion", data.get("harnessVersion"))
            mode = (data.get("integration") or {}).get("mode")
        except Exception:
            gates_version = None

    hook_state = _hook_state(root)
    forge_cli = _forge_cli_state(root)[0] if mode == "pull-request" else None
    checks = doctor_checks(installed, gates_version, str(Path(__file__).resolve()),
                           hook_state, _pyyaml_importable(), forge_cli,
                           _changes_with_old_approval_keys(root),
                           gates_on_path=shutil.which("gates"),
                           local_settings=_read_text_or_none(
                               root / ".claude" / "settings.local.json"),
                           earlier_names=_earlier_name_remnants(root),
                           push_hook_state=_doctor_push_hook_state(root))

    print("gatedloop: gates doctor — onboarding preflight\n")
    for level, title, detail in checks:
        tag = "ok  " if level == "ok" else "WARN"
        print(f"  [{tag}] {title}: {detail}")
    print()
    warns = [c for c in checks if c[0] == "warn"]
    if warns:
        print(
            f"gatedloop: {len(warns)} warning(s) — advisory only; none blocks "
            "onboarding or fails `gates validate`."
        )
    else:
        print("gatedloop: all preflight checks passed.")
    return 0


_NON_ORACLE_REASONS = {
    "ci": "it is green at every commit",
    "live-check": "it probes a surface, not a task",
    "eval": "it is an advisory score",
    "confirm": "it runs only on the merged tree",
}
_UNPARSED_TASK_RE = re.compile(r"^\s*-\s*\[[ xX]\]\s+(\S+)")


def _task_oracle_problems(m: dict, root: Path) -> tuple[list[str], list[str]]:
    """task-oracle D1: `(errors, warnings)` for every oracle tag in the
    active changes' `tasks.md`. An unknown gate, an excluded gate and a
    malformed tag are errors; a tag on a line the task parser does not match
    (a lettered id, #46) is a warning, so it is never silently ignored."""
    gates = m.get("gates") if isinstance(m.get("gates"), dict) else {}
    can = [g for g in gates if g not in NON_ORACLE_GATES]
    can_text = ", ".join(f"`{g}`" for g in can) + (", or " if can else "") + "`none`"
    errs: list[str] = []
    warns: list[str] = []
    for d in _active_change_dirs(root):
        tasks_md = d / "tasks.md"
        if not tasks_md.is_file():
            continue
        for line in tasks_md.read_text().splitlines():
            mt = _TASK_LINE_RE.match(line)
            if not mt:
                lone = _UNPARSED_TASK_RE.match(line)
                if lone and _ORACLE_TAG_RE.search(line.strip()):
                    warns.append(
                        f"change '{d.name}': the task line '{lone.group(1)}' carries an "
                        "oracle tag, but the task parser does not read lettered or "
                        "unnumbered ids (#46), so the tag is ignored. Number the task "
                        "N.M for its tag to count."
                    )
                continue
            tid = mt.group(1)
            _text, oracle, tag = _split_oracle_tag(mt.group(2))
            if tag is None:
                continue
            where = f"change '{d.name}' task {tid}: {tag}"
            if oracle is None:
                errs.append(f"{where} is malformed — the tag is {ORACLE_TAG_SYNTAX}")
                continue
            gate = oracle["gate"]
            if gate is None:
                continue
            if gate in NON_ORACLE_GATES:
                errs.append(
                    f"{where} — `{gate}` cannot judge one task ({_NON_ORACLE_REASONS[gate]}); "
                    f"a task's oracle is {can_text}"
                )
            elif gate not in gates:
                errs.append(
                    f"{where} names the gate `{gate}`, which .gates.yaml does not "
                    f"declare; a task's oracle is {can_text}"
                )
    return errs, warns


def cmd_validate(m: dict, root: Path, _args) -> int:
    oracle_errs, oracle_warns = _task_oracle_problems(m, root)  # task-oracle D1
    errs = _errors(m, root) + _epic_errors(root) + oracle_errs  # epic-linkage D2
    if errs:
        print("gatedloop: manifest invalid:", file=sys.stderr)
        for e in errs:
            print(f"  - {e}", file=sys.stderr)
        return 1
    for w in _loop_budget_warnings(m) + oracle_warns:
        print(f"gatedloop: warning: {w}", file=sys.stderr)
    print("gatedloop: manifest is valid")
    return 0


def cmd_integration(m: dict, root: Path, _args) -> int:
    """Prints the declared integration process (onboarding-asks-first §5) in
    a shape a prompt can branch on without hand-parsing YAML. Absence of
    `integration:` means today's behavior — local-squash-merge, no
    approval — exactly as `gates validate`'s shape check already treats it.
    """
    integ = m.get("integration") or {}
    mode = integ.get("mode", "local-squash-merge")
    require_approval = bool(integ.get("requireApproval", False))
    print(f"mode={mode}")
    print(f"requireApproval={'true' if require_approval else 'false'}")
    return 0


# ---------- conventions generation (D4: one source, generated into config.yaml) ----
#
# One conventions doc serves two consumers that want different *shapes* of the
# same content: convention-review resolves rule-ids from `conventions.rules-doc`
# directly (addressable prose); OpenSpec's artifact steps want a short
# imperative string per artifact id in `openspec/config.yaml`'s `rules:` map.
# This section renders the second shape from the first — never hand-edited,
# so the two cannot drift apart silently (`gates validate`'s drift check).

CONFIG_YAML_REL = Path("openspec") / "config.yaml"

_CONV_HEADING_RE = re.compile(r"^### (\S+)\s*$")
_CONV_APPLIES_RE = re.compile(r"^Applies to:\s*(.+)$")
_CONV_RULE_RE = re.compile(r"^Rule:\s*(.+)$")
# `Applies to:` targets that constrain review only, never an OpenSpec
# artifact: `code`, and `tests` (split-test-author D9) -- the project's test
# conventions, which `gates rules` lists for every diff and `gates tests
# brief` hands the test author, so both read the same rules.
REVIEW_ONLY_TARGETS = ("code", "tests")


def _heading_ids(text: str) -> set[str]:
    """`### <id>` heading ids in a conventions doc (design D4), regardless of
    whether the section also carries `Applies to:`/`Rule:` metadata.

    `parse_conventions_doc` requires both metadata lines because it feeds
    OpenSpec's artifact-keyed rule generation; rule-id *resolution* (`gates
    validate`, convention review) needs only the heading — a section left as
    prose-only, with no sync metadata, still resolves. A rule-id that is
    merely mentioned in another section's prose is NOT a heading and does
    not resolve; only an exact `### <id>` line does (F2: the previous
    substring check let a dangling id validate green if it appeared
    anywhere in the doc's text).
    """
    return {m.group(1) for line in text.splitlines() if (m := _CONV_HEADING_RE.match(line))}


def parse_conventions_doc(text: str) -> dict:
    """Parse `### <rule-id>` sections for their `Applies to:` / `Rule:` metadata.

    Returns ``{rule_id: {"applies_to": [id, ...], "rule": "<imperative line>"}}``.
    A section missing either metadata line is omitted from the result — the
    format is additive (task 1.3), so a rules-doc written before it, or a
    section deliberately left as prose-only, must not break generation.
    """
    sections: dict[str, dict] = {}
    current_id: str | None = None
    applies_to: list[str] = []
    rule_text: str | None = None

    def flush():
        if current_id and rule_text and applies_to:
            sections[current_id] = {"applies_to": applies_to, "rule": rule_text}

    for line in text.splitlines():
        m = _CONV_HEADING_RE.match(line)
        if m:
            flush()
            current_id, applies_to, rule_text = m.group(1), [], None
            continue
        if current_id is None:
            continue
        m = _CONV_APPLIES_RE.match(line)
        if m:
            applies_to = [x.strip() for x in m.group(1).split(",") if x.strip()]
            continue
        m = _CONV_RULE_RE.match(line)
        if m:
            rule_text = m.group(1).strip()
            continue
    flush()
    return sections


def build_rules_by_artifact(sections: dict, artifact_ids: list) -> dict:
    """Group each section's `Rule:` line under every artifact id it names.

    `code`-only rules (and any id naming an artifact the active schema
    doesn't declare) are dropped — OpenSpec has no artifact step to deliver
    them to. Grouping, not a hard-coded key set, is what makes this schema-
    agnostic (task 1.4a): pass a different schema's artifact ids and the same
    source doc yields a different map.
    """
    by_artifact: dict[str, list[str]] = {aid: [] for aid in artifact_ids}
    for meta in sections.values():
        for aid in meta["applies_to"]:
            # split-test-author D9: review-only targets are never emitted,
            # even when a schema happens to declare an artifact of that name.
            if aid in REVIEW_ONLY_TARGETS:
                continue
            if aid in by_artifact:
                by_artifact[aid].append(meta["rule"])
    return {aid: rules for aid, rules in by_artifact.items() if rules}


def _yaml_quote(s: str) -> str:
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def render_rules_block(by_artifact: dict, artifact_order: list) -> str:
    """Render the `rules:` block `config.yaml` carries, keyed by artifact id.

    Deterministic and canonical — `gates validate`'s drift check compares
    this exact text against what is on disk, so this is the ONLY function
    allowed to decide the formatting. Returns "" when no artifact has any
    rule (nothing to write). Artifact ids follow the schema's own
    declaration order; omitted entirely when their rule list is empty.
    """
    lines = ["rules:"]
    for aid in artifact_order:
        rules = by_artifact.get(aid) or []
        if not rules:
            continue
        lines.append(f"  {aid}:")
        for r in rules:
            lines.append(f"    - {_yaml_quote(r)}")
    return "\n".join(lines) + "\n" if len(lines) > 1 else ""


def _find_top_level_block(lines: list, key: str) -> tuple | None:
    """Line-index bounds `(start, end)` of a top-level `key:` block in
    `lines`, or `None`. `start` is the key's own line; `end` is exclusive,
    one past the last line that is blank or indented. A top-level key starts
    in column 0, so this never matches into `context:`'s block-scalar body
    (also indented, but owned by a different column-0 key).
    """
    for i, ln in enumerate(lines):
        if ln.startswith(key + ":"):
            j = i + 1
            while j < len(lines) and (lines[j].strip() == "" or lines[j][0] in " \t"):
                j += 1
            return i, j
    return None


def sync_rules_block(text: str, new_block_text: str) -> str:
    """Replace `text`'s top-level `rules:` block with `new_block_text`.

    Appends when no `rules:` key exists yet (preceded by one blank line);
    removes the key entirely when `new_block_text` is `""`.
    """
    lines = text.splitlines(keepends=True)
    bounds = _find_top_level_block(lines, "rules")
    new_lines = new_block_text.splitlines(keepends=True) if new_block_text else []

    if bounds is not None:
        start, end = bounds
        head, tail = lines[:start], lines[end:]
        while head and head[-1].strip() == "":
            head.pop()
        pieces = (head + ["\n"] if head and new_lines else head) + new_lines + tail
        return "".join(pieces)

    if not new_lines:
        return text
    prefix = text
    if not prefix.endswith("\n"):
        prefix += "\n"
    if not prefix.endswith("\n\n"):
        prefix += "\n"
    return prefix + "".join(new_lines)


def extract_rules_block(text: str) -> str:
    """The literal text of `text`'s top-level `rules:` block, or `""` if
    absent. Comparable byte-for-byte against `render_rules_block`'s output —
    that symmetry is what task 1.5's drift check relies on.
    """
    lines = text.splitlines(keepends=True)
    bounds = _find_top_level_block(lines, "rules")
    if bounds is None:
        return ""
    start, end = bounds
    block_lines = lines[start:end]
    # A blank line separating `rules:` from the NEXT key belongs to the
    # file's layout, not to this block's content — trim it before comparing.
    while block_lines and block_lines[-1].strip() == "":
        block_lines.pop()
    return "".join(block_lines)


def _schema_artifact_ids_safe(schema_name: str, root: Path) -> tuple:
    """Like `_schema_artifact_ids` but returns `(ids, None)` or `(None,
    error)` instead of exiting, for a caller (validate) that must collect
    errors rather than abort on the first one.
    """
    try:
        out = _openspec(["schemas", "--json"], root, capture_output=True, text=True,
                        check=True).stdout
    except Exception as e:
        return None, f"could not run `openspec schemas --json` to resolve artifact ids: {e}"
    try:
        schemas = json.loads(out)
    except json.JSONDecodeError as e:
        return None, f"`openspec schemas --json` did not return valid JSON: {e}"
    for s in schemas:
        if s.get("name") == schema_name:
            return list(s.get("artifacts") or []), None
    known = ", ".join(s.get("name", "?") for s in schemas)
    return None, f"schema '{schema_name}' not found among available schemas: {known}"


def _schema_artifact_ids(schema_name: str, root: Path) -> list:
    """Artifact ids for `schema_name`, read from `openspec schemas --json`.

    Not hard-coded (task 1.4a): the catalog's schemas declare very different
    artifact sets — `minimalist` has no `proposal`; `event-driven` adds
    `asyncapi`/`event-storming`/`event-modeling`; `intent-driven` and
    `spec-driven-with-adr` add `adr` — and installing or switching schemas
    must change what this generator emits without a code change here.
    """
    ids, err = _schema_artifact_ids_safe(schema_name, root)
    if err:
        sys.exit(f"gatedloop: {err}")
    return ids


# ---------- schema inspection (design D8) ---------------------------------
#
# A schema installed from the community catalog (or authored as one of
# gatedloop's own packs) is third-party code that will shape every artifact a
# team writes from here on, and nothing tells an adopter what they just
# installed. This splits the check the same way the rest of the shim does
# (D8): the DETERMINISTIC half lives here — enumerate the artifact DAG,
# detect cycles/unsatisfiable `requires`, report whether an `apply` block
# exists (the fact `tdd-apply` dispatch refuses on, D4), and scan for
# tool-name-shaped strings. The JUDGEMENT half (is a flagged name real
# coupling, is the workflow a fit for this project) is `agents/schema-review.md`
# — this shim never renders an opinion, only facts an agent or a human can act
# on. Advisory only, both halves (D8's two limits): nothing here edits a
# schema or blocks an install.

# Curated half of the tool-name scan (spike 1.3): product/library nouns that
# would not look command-shaped in prose (nothing about "shadcn" resembles an
# invocation), seeded from this repo's own stack-agnostic-prompts examples in
# docs/conventions.md plus the common ecosystem names that rule already names.
# Matched case-insensitively as a whole "word" (`\b...\b`), and only inside
# code spans and fenced blocks (schema-declared-flow D6) — advisory, not
# exhaustive.
TOOL_NAME_CURATED = frozenset({
    "pytest", "npm", "yarn", "pnpm", "jest", "mocha", "cucumber",
    "gherkin-lint", "maven", "gradle", "cargo", "docker", "kubectl",
    "terraform", "webpack", "vite", "rspec", "junit", "pip", "poetry",
    "eslint", "prettier", "keycloak", "shadcn", "postgres", "redis",
    "rubocop", "cypress", "playwright", "mongodb", "langfuse",
})
# Meta-tools that are the ecosystem this shim itself runs on, or the shim's
# own vocabulary — never a "project-specific" finding even command-shaped.
_TOOL_NAME_DENYLIST = frozenset({"openspec", "git", "gates"})
# Heuristic half: a command-shaped token inside a fenced or inline code span
# — `<word> (install|run|test|build|lint|exec|add|init|validate)`. Restricted
# to code spans (extracted below) rather than run over the whole prose, so
# "run the reproduction" in ordinary sentences doesn't also match.
_COMMAND_SHAPED_RE = re.compile(
    r"\b([a-zA-Z][a-zA-Z0-9_-]{1,24})\s+"
    r"(?:install|run|test|build|lint|exec|add|init|validate)\b"
)
_CODE_SPAN_RE = re.compile(r"```.*?```|`[^`\n]+`", re.DOTALL)


def scan_tool_names(text: str) -> set[str]:
    """Tool-name-shaped strings in `text` (spike 1.3: curated list UNION a
    command-shaped heuristic, both over code spans and fenced blocks only). Returns lowercase names,
    denylist and false-positive-prone meta-tools excluded. Pure — no IO.
    """
    if not text:
        return set()
    found: set[str] = set()
    spans = _CODE_SPAN_RE.findall(text)
    # Both halves read only code spans and fenced blocks (schema-declared-flow
    # D6): a curated name written as a product noun in a sentence is not an
    # invocation, and on a real project schema those prose hits were all noise.
    code = "\n".join(spans).lower()
    for name in TOOL_NAME_CURATED:
        if re.search(r"\b" + re.escape(name) + r"\b", code):
            found.add(name)
    for span in spans:
        for m in _COMMAND_SHAPED_RE.finditer(span):
            candidate = m.group(1).lower()
            if candidate not in _TOOL_NAME_DENYLIST:
                found.add(candidate)
    return found


def schema_artifacts_from_data(data: dict) -> list[dict]:
    """Normalize `schema.yaml`'s `artifacts:` list to `{id, requires,
    template, instruction}` dicts, defaulting absent optional fields (a
    schema like `minimalist` omits `instruction` entirely; the apply-less
    two-artifact case omits the whole `apply:` block, handled separately).
    Pure — operates on already-parsed YAML data, no IO.
    """
    out = []
    for a in data.get("artifacts") or []:
        out.append({
            "id": a.get("id"),
            "requires": list(a.get("requires") or []),
            "template": a.get("template"),
            "instruction": a.get("instruction") or "",
        })
    return out


def detect_requires_issues(artifacts: list[dict]) -> dict:
    """Cycles and unsatisfiable `requires` edges in the artifact DAG. Pure.

    `unsatisfiable`: an artifact's `requires` names an id no artifact defines.
    `cycles`: any artifact reachable from itself via `requires` edges,
    reported as the cycle path once per distinct cycle.
    """
    ids = {a["id"] for a in artifacts}
    by_id = {a["id"]: a for a in artifacts}
    unsatisfiable = []
    for a in artifacts:
        for dep in a["requires"]:
            if dep not in ids:
                unsatisfiable.append(f"{a['id']} requires undefined '{dep}'")

    cycles = []
    seen_cycle_keys = set()
    WHITE, GRAY, BLACK = 0, 1, 2
    color = {i: WHITE for i in ids}

    def dfs(node: str, path: list[str]) -> None:
        color[node] = GRAY
        path.append(node)
        for dep in by_id.get(node, {}).get("requires", []):
            if dep not in by_id:
                continue  # already reported as unsatisfiable
            if color[dep] == GRAY:
                cycle_start = path.index(dep)
                cycle = path[cycle_start:] + [dep]
                key = tuple(sorted(cycle))
                if key not in seen_cycle_keys:
                    seen_cycle_keys.add(key)
                    cycles.append(" -> ".join(cycle))
            elif color[dep] == WHITE:
                dfs(dep, path)
        path.pop()
        color[node] = BLACK

    for i in ids:
        if color[i] == WHITE:
            dfs(i, [])

    return {"unsatisfiable": unsatisfiable, "cycles": cycles}


def schema_apply_info(data: dict) -> dict:
    """Whether `schema.yaml` declares an `apply:` block, and what it tracks
    (design D4 — the fact `tdd-apply` dispatch refuses on, resolved here in
    code rather than by interpreting `openspec instructions apply`'s
    response, which is indistinguishable-from-real for an apply-less schema
    once every artifact exists — spike 1.5 confirmed this directly). Pure.

    `has_apply` answers only "is there an `apply:` key" and keeps that meaning
    for existing readers. `implementable` is the fact dispatch routes on
    (schema-declared-flow D2): an `apply` block that tracks a non-empty file.
    An `apply:` with no `tracks` has nothing to tick off, so the per-task
    loop's resumability (done <=> committed, read from the tracked file) has
    nothing to stand on -- issue #32's `epic` shape.
    """
    apply = data.get("apply")
    if not apply:
        return {"has_apply": False, "implementable": False,
                "tracks": None, "requires": None, "instruction": ""}
    tracks = apply.get("tracks")
    return {
        "has_apply": True,
        "implementable": isinstance(tracks, str) and bool(tracks.strip()),
        "tracks": tracks,
        "requires": list(apply.get("requires") or []),
        "instruction": apply.get("instruction") or "",
    }


# The flows a schema may declare under its namespaced `gatedloop:` block
# (schema-declared-flow D1). Closed: an unknown value fails loud rather than
# falling back to `per-task`, which would repeat the silent fall-through
# issue #32 reported. `per-task` is the default when nothing is declared.
KNOWN_FLOWS = ("per-task", "regression-first")
DEFAULT_FLOW = "per-task"


class SchemaDispatchError(Exception):
    """Dispatch cannot decide a route: an unknown declared flow, a malformed
    `gatedloop:` block, or a shape the scoped reader refuses to guess at.
    Callers exit non-zero with the message (fail-loud-gates)."""


def _declared_flow(data: dict):
    """The raw `gatedloop.flow` value, or None when nothing is declared."""
    block = data.get(NAME)
    if block is None:
        return None
    if not isinstance(block, dict):
        raise SchemaDispatchError(
            f"schema's top-level `gatedloop:` must be a mapping (e.g. "
            f"`gatedloop: {{ flow: regression-first }}`), got {block!r}"
        )
    return block.get("flow")


def schema_flow(data: dict) -> str:
    """The schema's declared flow, `per-task` when none is declared. Raises
    SchemaDispatchError naming the known flows on any other value. Pure."""
    flow = _declared_flow(data)
    if flow is None:
        return DEFAULT_FLOW
    if flow not in KNOWN_FLOWS:
        raise SchemaDispatchError(
            f"schema declares unknown `gatedloop.flow: {flow}` -- known flows: "
            f"{', '.join(KNOWN_FLOWS)}. Dispatch will not fall back to the "
            "default loop; fix the declaration."
        )
    return flow


# ---------- the scoped reader dispatch uses without PyYAML (schema-declared-flow D4)
#
# `gates schema inspect` needs the whole schema.yaml, so it requires PyYAML
# (`_mini_yaml` silently under-reads a rich schema). Dispatch needs exactly two
# scalars -- `apply.tracks` and `gatedloop.flow` -- so it gets a reader scoped to
# the two top-level blocks that hold them. It reads nothing else, and it refuses
# any shape it does not recognise rather than read it as absent: a missed
# `tracks` would route an implementable schema to `refuse`, and a missed `flow`
# would route a bugfix to the default loop.

_DISPATCH_READ_KEY = {"apply": "tracks", NAME: "flow"}
_DISPATCH_BLOCK_OPEN_RE = re.compile(rf"^(apply|{NAME}):[ ]*(#.*)?$")
_TOP_KEY_RE = re.compile(r"""^("[^"]*"|'[^']*'|[^\s#'"\-?:][^:#]*?|-[^\s:#][^:#]*?)[ ]*:(?:[ ]|$)""")
_CHILD_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_.\-]*)[ ]*:(?:[ ]+(.*))?$")
_YAML_NULLS = frozenset({"~", "null", "Null", "NULL"})
# A plain scalar YAML would resolve to something other than a string (a bool,
# a number, a date). Read as text, it would disagree with PyYAML -- refuse it.
_YAML_NON_STRING_RE = re.compile(
    r"(?i)^(y|n|yes|no|true|false|on|off|[-+.]?[0-9].*|[-+]?\.(inf|nan))$"
)


def _dispatch_fail(lineno: int, why: str):
    raise SchemaDispatchError(
        f"schema.yaml line {lineno}: {why}. Without PyYAML, `gates schema dispatch` "
        "reads only plain `apply.tracks` and `gatedloop.flow` scalars and refuses any "
        "other shape rather than under-read it. Install PyYAML (see `gates doctor`) "
        "or write these two blocks in plain block style."
    )


def _dispatch_scalar(value: str, lineno: int):
    """A plain, single- or double-quoted one-line scalar, trailing comment
    allowed. Returns the string, or None for YAML's null spellings."""
    v = value.strip()
    if not v or v.startswith("#"):
        return None
    q = v[0]
    if q in "|>":
        _dispatch_fail(lineno, "a block scalar indicator (`|` or `>`) on a value dispatch reads")
    if q in "&*":
        _dispatch_fail(lineno, "an anchor or alias")
    if q in "{[":
        _dispatch_fail(lineno, "a flow collection where a plain value belongs")
    if q == "!":
        _dispatch_fail(lineno, "a YAML tag")
    if q in ("'", '"'):
        end = v.find(q, 1)
        if end == -1:
            _dispatch_fail(lineno, "a quoted value that does not close on its own line")
        inner, rest = v[1:end], v[end + 1:].strip()
        if (q == '"' and "\\" in inner) or (q == "'" and rest.startswith("'")):
            _dispatch_fail(lineno, "an escape sequence inside a quoted value")
        if rest and not rest.startswith("#"):
            _dispatch_fail(lineno, "text after a quoted value")
        return inner
    # Plain scalar: a comment starts only at ` #`.
    cut = v.find(" #")
    if cut != -1:
        v = v[:cut].rstrip()
    if v in _YAML_NULLS:
        return None
    if v[0] in "@`%" or ": " in v or v.endswith(":"):
        _dispatch_fail(lineno, f"a value that is not a plain scalar ({v!r})")
    if _YAML_NON_STRING_RE.match(v):
        _dispatch_fail(lineno, f"a value YAML would not read as text ({v!r})")
    return v


def read_dispatch_blocks(text: str) -> dict:
    """Extract the top-level `apply` and `gatedloop` blocks from raw schema text,
    reading only `apply.tracks` and `gatedloop.flow` (design D4). Returns a dict
    shaped like the PyYAML parse of those two keys: a present block maps to a
    dict of its child keys (unread children map to None), an empty block to
    None, and an absent block is absent. Raises SchemaDispatchError, naming the
    line, on any shape it does not recognise. Pure.
    """
    out: dict = {}
    block = None          # "apply" | "gatedloop" while inside one
    children: dict = {}
    child_indent = None
    read_key_open = False  # the last child was the read key with no inline value
    seen_top: set = set()

    def close():
        nonlocal block, children, child_indent, read_key_open
        if block is not None:
            out[block] = children or None
        block, children, child_indent, read_key_open = None, {}, None, False

    for lineno, raw in enumerate(text.splitlines(), 1):
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent_str = raw[: len(raw) - len(raw.lstrip(" \t"))]

        if not indent_str:
            # Column 0: a top-level key (or a block sequence item that belongs
            # to the previous key's value). Either way the current block ends.
            if stripped.startswith("- ") or stripped == "-":
                if block is not None:
                    _dispatch_fail(lineno, f"`{block}:` holding a list rather than a mapping")
                continue
            close()
            m = _TOP_KEY_RE.match(stripped)
            if not m:
                _dispatch_fail(lineno, f"a top-level line that is not a plain `key:` ({stripped!r})")
            key = m.group(1)
            if key[:1] in ("'", '"') and key[1:-1] in _DISPATCH_READ_KEY:
                _dispatch_fail(lineno, f"a quoted `{key[1:-1]}` key")
            if key == "<<":
                _dispatch_fail(lineno, "a merge key (`<<`), which can inject blocks by alias")
            if key in seen_top:
                _dispatch_fail(lineno, f"the top-level key `{key}` repeated")
            seen_top.add(key)
            if key in _DISPATCH_READ_KEY:
                if not _DISPATCH_BLOCK_OPEN_RE.match(stripped):
                    _dispatch_fail(lineno, f"`{key}:` not followed by an indented block")
                block = key
            continue

        if block is None:
            continue  # inside some other top-level key's value: never read
        if "\t" in indent_str:
            _dispatch_fail(lineno, f"a tab in the indentation inside `{block}:`")
        indent = len(indent_str)
        if child_indent is None:
            child_indent = indent
        if indent > child_indent:
            if read_key_open:
                _dispatch_fail(lineno, f"a multi-line or nested `{block}.{_DISPATCH_READ_KEY[block]}`")
            continue  # part of an unread child's value
        if indent < child_indent:
            _dispatch_fail(lineno, f"inconsistent indentation inside `{block}:`")
        m = _CHILD_KEY_RE.match(stripped)
        if not m:
            _dispatch_fail(lineno, f"a line inside `{block}:` that is not a plain `key:` ({stripped!r})")
        key, value = m.group(1), m.group(2) or ""
        if key in children:
            _dispatch_fail(lineno, f"the key `{block}.{key}` repeated")
        if key == _DISPATCH_READ_KEY[block]:
            children[key] = _dispatch_scalar(value, lineno)
            v = value.strip()
            read_key_open = not v or v.startswith("#")
        else:
            if value.strip()[:1] in ("&", "*", "!"):
                _dispatch_fail(lineno, "an anchor, alias or tag inside a block dispatch reads")
            children[key] = None
            read_key_open = False
    close()
    return out


def dispatch_data_from_text(text: str) -> dict:
    """The parsed schema dispatch decides on: PyYAML's full parse where it is
    importable, the scoped reader otherwise (design D4). Never `_mini_yaml`,
    which can silently under-read a schema."""
    try:
        import yaml  # type: ignore
    except ImportError:
        return read_dispatch_blocks(text)
    return yaml.safe_load(text) or {}


def dispatch_route(data: dict) -> dict:
    """The one route `tdd-apply` step 2b takes (schema-declared-flow D2/D3),
    decided from structure and the declared flow — never the schema's name.
    Returns `{route, reason, has_apply, implementable, flow}` where `route` is
    `refuse`, `per-task` or `regression-first`. Raises SchemaDispatchError
    when it cannot decide (an unknown declared flow). Pure.
    """
    flow = schema_flow(data)  # raises on an unknown value, implementable or not
    declared = _declared_flow(data)
    info = schema_apply_info(data)
    out = {"has_apply": info["has_apply"], "implementable": info["implementable"], "flow": flow}
    if not info["has_apply"]:
        reason = ("schema has no `apply` block: this workflow ends at its final "
                  "artifact and has nothing to implement")
    elif not info["implementable"]:
        reason = ("schema's `apply` block declares no `tracks`: there is nothing to "
                  "tick off, so it is decision-terminal (omit `apply:` to say so)")
    else:
        reason = (f"schema declares `gatedloop.flow: {flow}`" if declared is not None
                  else "schema tracks a task file and declares no flow: the default per-task loop")
        return {"route": flow, "reason": reason, **out}
    if declared is not None:
        reason += (f"; its declared `gatedloop.flow: {declared}` is ignored because a "
                   "flow needs an implementation phase to run in")
    return {"route": "refuse", "reason": reason, **out}


def cross_check_gate_binding(names: set[str], gates_dict: dict) -> dict:
    """Which flagged tool names appear (case-insensitively, substring) in
    one of this project's OWN declared gate command bodies, vs which do not
    — 2c.4's coupling report: *"this schema names X; your .gates.yaml binds
    neither"* is the actionable half of D8's judgement. Pure.
    """
    bodies = " \n".join(str(v) for v in (gates_dict or {}).values()).lower()
    bound, unbound = [], []
    for name in sorted(names):
        (bound if name in bodies else unbound).append(name)
    return {"bound": bound, "unbound": unbound}


def inspect_schema_data(data: dict, template_texts: dict, gates_dict: dict) -> dict:
    """Combine the deterministic checks into one report dict. `data` is
    `schema.yaml` already parsed; `template_texts` maps artifact id -> that
    artifact's template file content (or apply-less schemas' `{}`).  Pure —
    the orchestrator (`cmd_schema_inspect`) does all the IO and hands in
    already-loaded content, so this function (and everything it calls) is
    covered by `tests/test_schema_inspect.py` with no `openspec`/filesystem
    dependency, matching how `_schema_artifact_ids` vs its `_safe` IO wrapper
    is split.
    """
    artifacts = schema_artifacts_from_data(data)
    requires_issues = detect_requires_issues(artifacts)
    apply_info = schema_apply_info(data)

    all_names: set[str] = set()
    per_artifact_names = {}
    for a in artifacts:
        text = a["instruction"] + "\n" + (template_texts.get(a["id"]) or "")
        names = scan_tool_names(text)
        if names:
            per_artifact_names[a["id"]] = sorted(names)
        all_names |= names
    if apply_info["instruction"]:
        apply_names = scan_tool_names(apply_info["instruction"])
        if apply_names:
            per_artifact_names["apply"] = sorted(apply_names)
        all_names |= apply_names

    coupling = cross_check_gate_binding(all_names, gates_dict)

    # The declared flow and its contradictions (schema-declared-flow D1/D2).
    # Inspection reports rather than blocks, so an unknown or malformed flow is
    # a warning here; `gates schema dispatch` is where it fails loud.
    warnings: list[str] = []
    try:
        declared = _declared_flow(data)
    except SchemaDispatchError as e:
        declared = None
        warnings.append(f"{e}; `gates schema dispatch` will refuse to decide a route")
    flow = DEFAULT_FLOW if declared is None else declared
    if declared is not None and declared not in KNOWN_FLOWS:
        warnings.append(
            f"unknown `gatedloop.flow: {declared}` (known: {', '.join(KNOWN_FLOWS)}); "
            "`gates schema dispatch` will fail loud rather than fall back to per-task"
        )
    if apply_info["has_apply"] and not apply_info["implementable"]:
        warnings.append(
            "`apply` block declares no `tracks`: dispatch will treat this schema as "
            "decision-terminal and refuse it. If that is the intent, omit `apply:` "
            "entirely -- that is the correct spelling for a decision-terminal schema."
        )
    if declared is not None and not apply_info["implementable"]:
        warnings.append(
            f"`gatedloop.flow: {declared}` is declared on a schema with no implementation "
            "phase that tracks anything; dispatch ignores it and refuses."
        )

    return {
        "name": data.get("name"),
        "artifacts": [a["id"] for a in artifacts],
        "requires_issues": requires_issues,
        "apply": apply_info,
        "flow": flow,
        "warnings": warnings,
        "flagged_tool_names": per_artifact_names,
        "coupling": coupling,
    }


def format_inspect_report(report: dict, label: str) -> list[str]:
    """The human-readable lines for `gates schema inspect`. Pure."""
    lines = [f"gatedloop: schema inspection — {label}"]
    lines.append(f"  artifacts: {' -> '.join(report['artifacts']) or '(none)'}")
    ri = report["requires_issues"]
    for line in ri["unsatisfiable"]:
        lines.append(f"  UNSATISFIABLE: {line}")
    for line in ri["cycles"]:
        lines.append(f"  CYCLE: {line}")
    if not ri["unsatisfiable"] and not ri["cycles"]:
        lines.append("  requires graph: OK, no cycles or unsatisfiable edges")
    ap = report["apply"]
    if ap["has_apply"]:
        lines.append(f"  apply: yes — tracks {ap['tracks']!r}, requires {ap['requires']}")
    else:
        lines.append(
            "  apply: NO — this schema is decision-terminal; tdd-apply must refuse it "
            "(omitting `apply:` is the correct spelling for that)"
        )
    lines.append(f"  implementable: {'yes' if ap['implementable'] else 'no'}")
    lines.append(f"  flow: {report['flow']}")
    for w in report["warnings"]:
        lines.append(f"  WARNING: {w}")
    if report["flagged_tool_names"]:
        lines.append("  flagged tool-name-shaped strings (advisory — a finding, not a verdict):")
        for aid, names in report["flagged_tool_names"].items():
            lines.append(f"    {aid}: {', '.join(names)}")
        coupling = report["coupling"]
        if coupling["unbound"]:
            lines.append(f"  not bound by this project's .gates.yaml: {', '.join(coupling['unbound'])}")
        if coupling["bound"]:
            lines.append(f"  bound by this project's .gates.yaml: {', '.join(coupling['bound'])}")
    else:
        lines.append("  no tool-name-shaped strings found")
    lines.append("  this report is advisory — the schema installs unmodified regardless")
    return lines


def resolve_schema_dir(root: Path, name, path, subcommand: str = "inspect") -> Path:
    """The schema directory `gates schema <subcommand>` reads: `--path`
    (relative to the repo root) when given, else OpenSpec's own resolution of
    NAME via `openspec schema which`. Shared by `inspect` and `dispatch` so the
    two can never read different files for the same name. Exits non-zero with
    an explicit message when it cannot resolve (fail-loud-gates)."""
    if path:
        schema_dir = Path(path)
        return schema_dir if schema_dir.is_absolute() else root / schema_dir
    if not name:
        sys.exit(f"gatedloop: `gates schema {subcommand}` needs a schema NAME or --path <dir>")
    try:
        out = _openspec(["schema", "which", name, "--json"], root, capture_output=True,
                        text=True, check=True).stdout
    except Exception as e:
        sys.exit(f"gatedloop: could not resolve schema '{name}' via `openspec schema which`: {e}")
    try:
        resolved = json.loads(out)
    except json.JSONDecodeError as e:
        sys.exit(f"gatedloop: `openspec schema which {name} --json` did not return valid JSON: {e}")
    if not isinstance(resolved, dict) or not resolved.get("path"):
        sys.exit(f"gatedloop: `openspec schema which {name} --json` returned no path for '{name}'")
    return Path(resolved["path"])


def cmd_schema_dispatch(_m: dict, root: Path, args) -> int:
    """gates schema dispatch — the one call `tdd-apply` step 2b makes
    (schema-declared-flow D3). Prints the route as data and exits 0 for every
    decided route, `refuse` included; exits non-zero only when it cannot
    decide (the schema does not resolve, an unknown flow, or the scoped reader
    refused a shape). Needs no manifest and no PyYAML (D4)."""
    schema_dir = resolve_schema_dir(root, args.name, args.path, "dispatch")
    schema_yaml = schema_dir / "schema.yaml"
    if not schema_yaml.exists():
        sys.exit(f"gatedloop: no schema.yaml at {schema_dir} -- cannot decide a route")
    try:
        data = dispatch_data_from_text(schema_yaml.read_text())
        if not isinstance(data, dict):
            raise SchemaDispatchError(f"{schema_yaml} is not a YAML mapping")
        decision = dispatch_route(data)
    except SchemaDispatchError as e:
        sys.exit(f"gatedloop: cannot decide a route for schema at {schema_dir}: {e}")
    except Exception as e:  # a PyYAML parse error, an unreadable file
        sys.exit(f"gatedloop: cannot decide a route for schema at {schema_dir}: {e}")
    report = {"schema": args.name or data.get("name") or schema_dir.name, **decision}
    if getattr(args, "json", False):
        print(json.dumps(report))
    else:
        print(f"gatedloop: schema {report['schema']} -> route {report['route']}: {report['reason']}")
    return 0


def cmd_schema_inspect(m: dict, root: Path, args) -> int:
    # `_mini_yaml` is documented (CLAUDE.md) as "a minimal parser for the
    # manifest subset" -- it is exercised and kept correct against
    # `.gates.yaml`'s own shape, not against arbitrary third-party YAML. A
    # community/pack schema.yaml uses richer shapes (multi-line folded block
    # scalars, nested `apply:` maps) that it can silently under-parse rather
    # than reject -- confirmed directly: without PyYAML, a real
    # behaviour-driven schema.yaml came back with 1 artifact instead of 4 and
    # no `apply` block at all, with no error. Reporting that with confidence
    # would defeat D8's whole premise ("code notices, or nothing does"), so
    # this one command requires PyYAML rather than risk it (fail-loud-gates)
    # -- zero-dep-shim stays intact because PyYAML remains optional for
    # every other `gates` command; only this command, which parses content it
    # does not control, declines to guess.
    if not _pyyaml_importable():
        sys.exit(
            "gatedloop: `gates schema inspect` needs PyYAML to parse a third-party "
            "schema.yaml correctly -- the built-in fallback only covers .gates.yaml's "
            "own subset and can silently under-read a richer file. " + PYYAML_ABSENT_HINT
        )
    schema_dir = resolve_schema_dir(root, args.name, args.path, "inspect")
    schema_yaml = schema_dir / "schema.yaml"
    if not schema_yaml.exists():
        sys.exit(f"gatedloop: no schema.yaml at {schema_dir}")
    data = _load(schema_yaml) or {}

    template_texts = {}
    for a in data.get("artifacts") or []:
        tmpl = a.get("template")
        if not tmpl:
            continue
        tpath = schema_dir / "templates" / tmpl
        if tpath.exists():
            template_texts[a.get("id")] = tpath.read_text()

    report = inspect_schema_data(data, template_texts, m.get("gates") or {})

    if getattr(args, "json", False):
        print(json.dumps(report, indent=2))
        return 0

    label = f"{report['name'] or schema_dir.name} ({schema_dir})"
    print("\n".join(format_inspect_report(report, label)))
    return 0


def _conventions_generation_inputs(m: dict, root: Path):
    """Resolve (rules_doc, doc_path, config_path, schema_name) for
    generation/drift-checking, or `None` if any precondition is unmet
    (no rules-doc declared, doc missing, no OpenSpec config, no schema — the
    same preconditions `cmd_conventions_sync` requires). Not an error by
    itself: a project may not use OpenSpec-artifact rule generation at all.
    """
    conv = m.get("conventions") or {}
    rules_doc = conv.get("rules-doc")
    if not rules_doc:
        return None
    doc_path = root / rules_doc
    if not doc_path.exists():
        return None
    config_path = root / CONFIG_YAML_REL
    if not config_path.exists():
        return None
    config_data = _load(config_path) or {}
    schema_name = config_data.get("schema")
    if not schema_name:
        return None
    return rules_doc, doc_path, config_path, schema_name


def _conventions_drift(m: dict, root: Path) -> str | None:
    """`None` if `openspec/config.yaml`'s `rules:` block matches what `gates
    conventions sync` would generate from `conventions.rules-doc`; otherwise
    an error string naming the fix (task 1.5, `fail-loud-gates`).
    """
    inputs = _conventions_generation_inputs(m, root)
    if inputs is None:
        return None
    rules_doc, doc_path, config_path, schema_name = inputs

    artifact_ids, err = _schema_artifact_ids_safe(schema_name, root)
    if err:
        return f"could not verify conventions sync is up to date ({err})"

    sections = parse_conventions_doc(doc_path.read_text())
    by_artifact = build_rules_by_artifact(sections, artifact_ids)
    expected = render_rules_block(by_artifact, artifact_ids)
    actual = extract_rules_block(config_path.read_text())
    if actual != expected:
        return (
            f"{CONFIG_YAML_REL}'s rules: block has drifted from '{rules_doc}' "
            "— run `gates conventions sync` to regenerate it"
        )
    return None


def cmd_conventions_sync(m: dict, root: Path, _args) -> int:
    conv = m.get("conventions") or {}
    rules_doc = conv.get("rules-doc")
    if not rules_doc:
        sys.exit("gatedloop: no conventions.rules-doc set in the manifest — nothing to sync from")
    doc_path = root / rules_doc
    if not doc_path.exists():
        sys.exit(f"gatedloop: conventions.rules-doc '{rules_doc}' does not exist")

    config_path = root / CONFIG_YAML_REL
    if not config_path.exists():
        sys.exit(f"gatedloop: {CONFIG_YAML_REL} does not exist — is this an OpenSpec project?")

    config_data = _load(config_path) or {}
    schema_name = config_data.get("schema")
    if not schema_name:
        sys.exit(f"gatedloop: {CONFIG_YAML_REL} has no top-level 'schema:' — cannot resolve artifact ids")

    artifact_ids = _schema_artifact_ids(schema_name, root)
    sections = parse_conventions_doc(doc_path.read_text())
    by_artifact = build_rules_by_artifact(sections, artifact_ids)
    new_block = render_rules_block(by_artifact, artifact_ids)

    original = config_path.read_text()
    updated = sync_rules_block(original, new_block)
    if updated == original:
        print(f"gatedloop: {CONFIG_YAML_REL} already matches {rules_doc} — nothing to do")
        return 0
    config_path.write_text(updated)
    emitted = sum(len(v) for v in by_artifact.values())
    print(
        f"gatedloop: wrote {CONFIG_YAML_REL} — {emitted} rule(s) across "
        f"{len(by_artifact)} artifact id(s), from {rules_doc}"
    )
    return 0


# ---------- surface selection --------------------------------------------
#
# Two baselines, decided by gate level, in code (design D1). Task-level
# selection (`gates rules`, `gates surfaces`, the per-task convention-review
# scope) is `_changed_files` — the working set alone, because its subject is
# the in-flight task and must not grow with the change's earlier commits.
# Change-level gate execution (`gates run live-check`) is
# `_change_level_changed_files` — the union of the working set and the
# branch's diff against the merge target, because a clean tree at change
# completion must still select the whole change (F1). `--changed`/`--all`
# override both paths identically.

def _working_set_files() -> list[str]:
    """Unstaged + staged + untracked files — the working tree's own diff."""
    files: set[str] = set()
    for cmd in (
        ["git", "diff", "--name-only", "HEAD"],
        ["git", "diff", "--name-only", "--staged"],
        ["git", "ls-files", "--others", "--exclude-standard"],
    ):
        try:
            out = subprocess.run(cmd, capture_output=True, text=True).stdout
            files.update(x for x in out.splitlines() if x.strip())
        except Exception:
            pass
    return sorted(files)


def _changed_files(args) -> list[str]:
    """Task-level changed-file set: the working set, or an explicit override.
    Used by `gates rules`/`gates surfaces` — unchanged by this fix."""
    if getattr(args, "all", False):
        return ["\x00ALL\x00"]
    if getattr(args, "changed", None):
        return list(args.changed)
    return _working_set_files()


def _resolve_merge_target(root: Path) -> tuple[str | None, str | None]:
    """Resolve the merge target generically (design D2), without hard-coding
    a branch name: the remote's default branch via `origin/HEAD`, else a
    local `main`, else a local `master`. Returns `(target, None)` on success
    — `target` is a ref git accepts directly (e.g. `origin/main` or `main`)
    — or `(None, reason)` when nothing resolves.
    """
    def _exists(ref: str) -> bool:
        try:
            return subprocess.run(
                ["git", "rev-parse", "--verify", "--quiet", ref],
                cwd=root, capture_output=True, text=True,
            ).returncode == 0
        except Exception:
            return False

    try:
        sym = subprocess.run(
            ["git", "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD"],
            cwd=root, capture_output=True, text=True,
        )
        if sym.returncode == 0 and sym.stdout.strip():
            # e.g. "refs/remotes/origin/main" -> "origin/main"
            full_ref = sym.stdout.strip()
            if _exists(full_ref):
                return full_ref.removeprefix("refs/remotes/"), None
    except Exception:
        pass

    for candidate in ("main", "master"):
        if _exists(f"refs/heads/{candidate}"):
            return candidate, None

    return None, "no origin/HEAD, local 'main', or local 'master' found"


def _merge_base_diff(root: Path, target: str) -> list[str] | None:
    """Files changed between the merge-base of `target`/`HEAD` and `HEAD`, or
    `None` if no merge base exists (detached HEAD, shallow clone, unrelated
    histories, ...) — the caller falls back to the working set in that case.
    Empty (not `None`) when `HEAD` == `target`: the merge-base *is* `HEAD`, so
    the diff is legitimately empty (design D2's on-target-branch case).
    """
    try:
        base = subprocess.run(
            ["git", "merge-base", target, "HEAD"],
            cwd=root, capture_output=True, text=True,
        )
        if base.returncode != 0 or not base.stdout.strip():
            return None
        merge_base = base.stdout.strip()
        out = subprocess.run(
            ["git", "diff", "--name-only", f"{merge_base}..HEAD"],
            cwd=root, capture_output=True, text=True,
        )
        if out.returncode != 0:
            return None
        return [x for x in out.stdout.splitlines() if x.strip()]
    except Exception:
        return None


def _change_level_changed_files(args, root: Path) -> tuple[list[str], dict]:
    """Change-level changed-file set (design D1): the union of the working
    set and the branch's merge-base diff against the resolved merge target.
    Falls back to the working set alone — loudly, on stderr (design D2) —
    when no target resolves or no merge base exists. Returns `(files,
    evidence)`; `evidence` records the baseline kind/target/count so an empty
    result can be reported with evidence rather than a bare skip (design D3).
    """
    if getattr(args, "all", False):
        return ["\x00ALL\x00"], {"baseline": "all"}
    if getattr(args, "changed", None):
        files = list(args.changed)
        return files, {"baseline": "override", "files_considered": len(files)}

    working = _working_set_files()
    target, reason = _resolve_merge_target(root)
    if target is None:
        print(
            f"gatedloop: no merge target resolved ({reason}) — "
            "falling back to the working-set baseline",
            file=sys.stderr,
        )
        return working, {
            "baseline": "working-set-fallback", "target": None,
            "reason": reason, "files_considered": len(working),
        }

    branch_diff = _merge_base_diff(root, target)
    if branch_diff is None:
        print(
            f"gatedloop: could not compute a merge-base diff against '{target}' — "
            "falling back to the working-set baseline",
            file=sys.stderr,
        )
        return working, {
            "baseline": "working-set-fallback", "target": target,
            "reason": "no merge base found", "files_considered": len(working),
        }

    merged = sorted(set(branch_diff) | set(working))
    return merged, {
        "baseline": "merge-target", "target": target,
        "files_considered": len(merged),
    }


def _describe_change_level_evidence(evidence: dict) -> str:
    """Render `_change_level_changed_files`'s evidence for a loud report
    (design D3): baseline kind, resolved target, files considered."""
    baseline = evidence.get("baseline")
    n = evidence.get("files_considered", 0)
    if baseline == "all":
        return "baseline=--all (every surface treated as hot)"
    if baseline == "override":
        return f"baseline=explicit --changed override, {n} file(s) considered"
    if baseline == "working-set-fallback":
        target = evidence.get("target")
        reason = evidence.get("reason")
        where = f"could not diff against merge target '{target}': {reason}" if target else reason
        return f"baseline=working set (fallback — {where}), {n} file(s) considered"
    if baseline == "merge-target":
        return (
            f"baseline=merge-target diff against '{evidence.get('target')}' "
            f"union working set, {n} file(s) considered"
        )
    return f"baseline={baseline}, {n} file(s) considered"


def _globs(match) -> list[str]:
    return match if isinstance(match, list) else [match]


# ---------- brace-glob expansion (expand-brace-globs, design D2) ---------
#
# fnmatch treats '{' as a literal, so a `match: "{bin,tests}/**"` surface
# matched nothing before this — a silent, under-selecting failure (issue
# #1). A strict, stdlib-only recursive expander turns each raw `match`
# pattern into its brace-free alternatives once, at the point surfaces are
# read for matching (design D1), so `_matches`'s per-path hot loop never
# sees a brace and `gates validate` can run the exact same function to
# reject what it cannot honor (design D3) — matching and validation share
# one function and cannot disagree.

_BRACE_EXPANSION_CAP = 512


class BraceExpansionError(ValueError):
    """A `match` pattern's brace syntax could not be expanded — unbalanced
    braces, an empty group/alternative, or too many alternatives. Callers
    name the offending surface when they catch this."""


def _split_top_level(body: str) -> list[str]:
    """Split `body` on commas at brace-depth 0 — commas inside a nested
    `{...}` do not split. `body` is assumed brace-balanced (it was sliced
    from a balanced outer group)."""
    parts: list[str] = []
    depth = 0
    current: list[str] = []
    for ch in body:
        if ch == "{":
            depth += 1
            current.append(ch)
        elif ch == "}":
            depth -= 1
            current.append(ch)
        elif ch == "," and depth == 0:
            parts.append("".join(current))
            current = []
        else:
            current.append(ch)
    parts.append("".join(current))
    return parts


def _expand_braces(pattern: str) -> list[str]:
    """Recursively expand `{a,b}` alternation in a glob pattern (design D2).

    A pattern with no `{` passes through unchanged. One or more groups,
    including a group nested inside another, expand to the full cross
    product of their alternatives. Raises BraceExpansionError, naming
    `pattern`, for an unbalanced `{`, an empty group (`{}`) or empty
    alternative (`{a,,b}`, `{,a}`) — an accident, not a feature — and for a
    pattern that would expand past `_BRACE_EXPANSION_CAP` alternatives.
    """
    start = pattern.find("{")
    if start == -1:
        return [pattern]

    depth = 0
    end = None
    for i in range(start, len(pattern)):
        ch = pattern[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                end = i
                break
    if end is None:
        raise BraceExpansionError(f"unbalanced '{{' in pattern '{pattern}'")

    prefix, body, suffix = pattern[:start], pattern[start + 1:end], pattern[end + 1:]
    alternatives = _split_top_level(body)
    if any(alt == "" for alt in alternatives):
        raise BraceExpansionError(f"empty group or alternative in pattern '{pattern}'")

    results: list[str] = []
    for alt in alternatives:
        for expanded in _expand_braces(prefix + alt + suffix):
            results.append(expanded)
            if len(results) > _BRACE_EXPANSION_CAP:
                raise BraceExpansionError(
                    f"pattern '{pattern}' expands to more than "
                    f"{_BRACE_EXPANSION_CAP} alternatives"
                )
    return results


def _expand_surface_globs(surf: dict) -> list[str]:
    """Expand every raw glob in a surface's `match` into its brace-free
    alternatives. Runtime callers (matching) get a loud, named fatal error
    on an unexpandable pattern rather than a silently empty selection
    (design D3) — `gates validate` instead collects these via
    `_expand_braces` directly so it can report every surface's failures at
    once."""
    nm = surf.get("name", "<unnamed>")
    expanded: list[str] = []
    for raw in _globs(surf.get("match")):
        try:
            expanded.extend(_expand_braces(raw))
        except BraceExpansionError as e:
            sys.exit(f"gatedloop: surface '{nm}': {e}")
    return expanded


def _matches(path: str, glob: str) -> bool:
    # fnmatch treats '*' as matching '/', so 'backend/app/**' behaves like a
    # recursive prefix. Collapse '**' -> '*' to keep that intent explicit.
    # `glob` must already be brace-free (see _expand_surface_globs) — this
    # hot loop runs once per path x glob and must stay a plain fnmatch call.
    return fnmatch.fnmatch(path, glob.replace("**", "*"))


def hot_surfaces(m: dict, changed: list[str]) -> list[dict]:
    surfaces = m.get("surfaces") or []
    if changed == ["\x00ALL\x00"]:
        return list(surfaces)
    hot = []
    for surf in surfaces:
        globs = _expand_surface_globs(surf)
        if any(_matches(f, g) for f in changed for g in globs):
            hot.append(surf)
    return hot


def _is_catchall_surface(surf: dict) -> bool:
    """A surface whose pattern matches every path (e.g. `match: "**"`) --
    excluded from the scoped-gate one-surface count (design D1): most field
    manifests declare one, and counting it would make every diff
    "multi-surface" and silently disable scoping forever."""
    return "**" in _expand_surface_globs(surf)


def _select_scoped_gate(m: dict, gate: str, changed: list[str] | None) -> tuple[str | dict | None, str]:
    """Select the manifest spec to run for a scopable gate (`ci`/`unit`) and
    the scope it ran under -- a surface name, or `"full"` for the globally
    declared gate (design D1, scale-gate-cost). The returned spec is the raw
    manifest value (a command string or a `{run, requires}` mapping) and the
    caller normalizes it through `_gate_spec`. Err-full, pinned: the scoped
    command runs ONLY when `changed`'s hot set is exactly one NON-catch-all
    surface that declares an override for `gate`; every other case --
    `changed` empty or unreadable (`None`), no hot surface, more than one hot
    surface, or a hot surface without the override -- runs the globally
    declared gate. This can only ever narrow to a declared scoped command,
    never skip the gate outright.
    """
    global_cmd = (m.get("gates") or {}).get(gate)
    if changed:
        non_catchall_hot = [s for s in hot_surfaces(m, changed) if not _is_catchall_surface(s)]
        if len(non_catchall_hot) == 1:
            override = (non_catchall_hot[0].get("gates") or {}).get(gate)
            if override:
                return override, non_catchall_hot[0].get("name", "<unnamed>")
    return global_cmd, "full"


def cmd_surfaces(m: dict, root: Path, args) -> int:
    changed = _changed_files(args)
    hot = hot_surfaces(m, changed)
    if not hot:
        print("(no hot surfaces for the changed set)")
        return 0
    for s in hot:
        raw_lc = s.get("live-check")
        lc = (_gate_spec(raw_lc)[0] or "—") if raw_lc else "—"
        print(f"{s['name']}: rules={s.get('rules', [])} live-check={lc}")
    return 0


# Rules the loop itself owns (`test-quality-rule` design D1): shipped in the
# plugin, resolved from the shim's own location (never the project), and
# listed by `gates rules` for every diff whatever surfaces are hot (D2).
BUILTIN_RULES_FILE = Path(__file__).resolve().parent.parent / "rules" / "loop-rules.md"
BUILTIN_RULE_IDS = (f"{NAME}.test-quality",)


def _builtin_rules_error() -> str | None:
    """Why the built-in rules can't be resolved, or None. A listed id whose
    section is absent would have review cite a rule it cannot read, so both
    a missing file and a missing `### <id>` heading fail loud."""
    try:
        text = BUILTIN_RULES_FILE.read_text()
    except OSError as e:
        return f"built-in rules file not readable at {BUILTIN_RULES_FILE} ({e.strerror})"
    missing = [r for r in BUILTIN_RULE_IDS if r not in _heading_ids(text)]
    if missing:
        return (f"built-in rule-id(s) {', '.join(missing)} have no '### <id>' "
                f"section in {BUILTIN_RULES_FILE}")
    return None


def _project_test_rule_ids(m: dict, root: Path) -> list[str]:
    """Rule-ids in `conventions.rules-doc` whose `Applies to:` names `tests`,
    in document order. Empty when no rules-doc is declared or readable (a
    missing doc is `gates validate`'s error to raise, not this reader's)."""
    rules_doc = (m.get("conventions") or {}).get("rules-doc")
    if not rules_doc:
        return []
    try:
        text = (root / rules_doc).read_text()
    except OSError:
        return []
    return [rid for rid, meta in parse_conventions_doc(text).items()
            if "tests" in meta["applies_to"]]


def cmd_rules(m: dict, root: Path, args) -> int:
    builtin_err = _builtin_rules_error()
    if builtin_err:
        print(f"gatedloop: {builtin_err} — the plugin install is incomplete; "
              f"reinstall it", file=sys.stderr)
        return 1
    changed = _changed_files(args)
    hot = hot_surfaces(m, changed)
    ids: list[str] = []
    for s in hot:
        for r in s.get("rules") or []:
            if r not in ids and r not in BUILTIN_RULE_IDS:
                ids.append(r)
    # split-test-author D9: the project's `tests` rules apply to every diff,
    # whatever surfaces are hot -- the reviewer reads what the author read.
    for r in _project_test_rule_ids(m, root):
        if r not in ids:
            ids.append(r)
    conv = m.get("conventions") or {}
    if ids:
        print("Applicable convention rules for this change:")
        for r in ids:
            print(f"  - {r}")
    else:
        print("(no convention rules apply to the changed set)")
    if conv.get("rules-doc"):
        print(f"\nResolve rule-ids against: {conv['rules-doc']}")
    print("\nBuilt-in loop rules (always apply):")
    for r in BUILTIN_RULE_IDS:
        print(f"  - {r}")
    print(f"\nResolve built-in rule-ids against: {BUILTIN_RULES_FILE}")
    return 0


# ---------- markers (D1/D2: a lock under .git/, ephemeral, per-worktree) --
#
# `gates run <gate>` writes a marker on success recording the gate name and
# the exact tree it passed on. A `PreToolUse` hook compares the marker to the
# tree it is about to commit/merge — an O(1) hash equality check, never a
# gate re-run (design D1). Two tree definitions matter (design D2): `ci`'s
# marker records `git write-tree` of the *staged index* (what will actually
# be committed — tdd-apply stages a subset, never `git add .`), so a marker
# cannot survive an edit and a failed partial `git add` cannot slip through
# (task 0.6/1.7). `live-check`'s marker records the branch-HEAD commit's tree
# (all tasks are already committed by the time live-check runs); the merge
# gate resolves the incoming ref and tries ITS tree first, falling back to
# the current HEAD tree (`fix-marker-mechanics` design D4).
#
# The recorded tree is always ledger-blind NORMALIZED (`fix-marker-mechanics`
# design D1): every `.gatedloop/runs/**` entry is stripped before hashing, so
# staging the very ledger row a gate run just appended can never stale the
# marker it wrote. A marker also carries an optional `verdict` — "skip" (with
# an `evidence` object: baseline kind, resolved merge target, files
# considered) for a resolved-empty `live-check`, absent (reads as "pass")
# otherwise (design D2) — and `gate-marker check` reports a tree-matching
# skip as satisfied, naming the verdict rather than looking indistinguishable
# from a real pass.
#
# Markers live under the *per-worktree* git dir (`git rev-parse --git-dir`,
# not `--git-common-dir`) so two worktrees never share a lock, and under
# `.git/` so a marker can never be committed by accident.

def _git_dir(root: Path) -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--git-dir"],
            cwd=root, capture_output=True, text=True, check=True,
        ).stdout.strip()
        p = Path(out)
        return p if p.is_absolute() else (root / p)
    except Exception:
        return root / ".git"


def _markers_dir(root: Path) -> Path:
    return _git_dir(root) / NAME / "markers"


def _write_tree(root: Path) -> str | None:
    """`git write-tree` of the current staged index — what `git commit` would
    actually record. `None` on failure (e.g. an in-progress conflicted merge)
    so callers can decline to write a marker rather than record a bogus one.
    """
    try:
        out = subprocess.run(
            ["git", "write-tree"], cwd=root, capture_output=True, text=True,
        )
        return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None
    except Exception:
        return None


def _head_tree(root: Path) -> str | None:
    """The tree of the current branch-HEAD commit."""
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", "HEAD^{tree}"],
            cwd=root, capture_output=True, text=True,
        )
        return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None
    except Exception:
        return None


_MARKER_LRU_DEPTH = 8


def _legacy_marker_path(root: Path, gate: str) -> Path:
    """The pre-D2 single-slot marker path — a sibling FILE of the gate's new
    per-tree DIRECTORY at the same base name, never consulted for a check
    (design D2's own layout note: "old single-slot `<gate>.json` files are
    ignored"), only cleaned up opportunistically on the next write."""
    return _markers_dir(root) / f"{gate}.json"


def _marker_gate_dir(root: Path, gate: str) -> Path:
    return _markers_dir(root) / gate


def _marker_path(root: Path, gate: str, normalized_tree: str) -> Path:
    return _marker_gate_dir(root, gate) / f"{normalized_tree}.json"


def _prune_markers(gate_dir: Path, keep: int = _MARKER_LRU_DEPTH) -> None:
    """Oldest-first eviction (design D2): keep the `keep` most recently
    recorded trees for this gate, by the payload's own `ts` (not file mtime,
    so pruning is deterministic under a `git worktree`/copy that doesn't
    preserve mtimes). A corrupt/unreadable file sorts as oldest — self-
    healing rather than jamming the LRU on one bad entry."""
    files = list(gate_dir.glob("*.json"))
    if len(files) <= keep:
        return

    def _ts(p: Path) -> str:
        try:
            return json.loads(p.read_text()).get("ts") or ""
        except Exception:
            return ""

    files.sort(key=_ts)
    for stale in files[: len(files) - keep]:
        stale.unlink(missing_ok=True)


def _report_normalize_failure(step: str, proc: "subprocess.CompletedProcess") -> None:
    """design D2: a failed strip step keeps the STRICT fail-closed contract
    (the caller still returns `tree` unchanged) but stops being silent --
    `fail-loud-gates` forbids a check silently skipping. stderr, not stdout:
    callers such as `gate-marker check` are parsed by hooks on exit status
    and message text, and a stderr note passes through `2>&1` into
    `hooks/gate-merge.sh`'s denial reason, which is where an adopter reads
    it. No exit-code change: the resulting hash mismatch already denies."""
    first_line = (proc.stderr or "").strip().splitlines()[:1]
    detail = first_line[0] if first_line else f"exit {proc.returncode}"
    print(
        f"gatedloop: ledger normalization failed ({step}): {detail}; "
        "comparing the unnormalized tree",
        file=sys.stderr,
    )


def _normalize_tree(root: Path, tree: str) -> str:
    """The tree hash a marker records/compares (design D1): `tree` with every
    entry under `.gatedloop/runs/` (the durable ledger) stripped out, so a
    gate's own ledger row can never stale the marker it just wrote. Pure
    plumbing — a temporary `GIT_INDEX_FILE` populated with `git read-tree
    <tree>`, `git rm --cached -r -f --ignore-unmatch .gatedloop/runs`, `git
    write-tree` — no working-tree effect, no mutation of the real index.

    A pure function of `(tree, the .gatedloop/runs prefix)`: the same `tree`
    normalizes to the same hash regardless of which branch is checked out,
    what the working tree contains, or what the real index holds. `-f` on
    the `rm` is what makes this true (fix-normalize-tree-checkout-dependence
    D1) -- git's working-tree safety check exists to protect the *real*
    index from losing staged content, and a scratch `--cached` removal in a
    throwaway `GIT_INDEX_FILE` touches no working-tree path and never opens
    the real index, so there is nothing for the check to protect. Left
    unforced, that check fires anyway, keyed on the *current checkout's*
    HEAD/working file -- state this function's contract says it must not
    depend on.

    Fail-safe STRICT, never fail-open: any plumbing failure returns `tree`
    unchanged, so a normalization defect can only make a marker compare as
    stale (denying) rather than silently pass an unnormalized ledger delta.
    Reported, not swallowed (design D2): a failure from `read-tree`, `rm`,
    or `write-tree` prints one stderr line naming the step and quoting git,
    so a denial it causes is attributable rather than a week of "marker is
    stale" friction pointing at the wrong cause.
    """
    try:
        with tempfile.TemporaryDirectory() as tmp:
            env = dict(os.environ)
            env["GIT_INDEX_FILE"] = str(Path(tmp) / "index")
            read = subprocess.run(
                ["git", "read-tree", tree],
                cwd=root, env=env, capture_output=True, text=True,
            )
            if read.returncode != 0:
                _report_normalize_failure("git read-tree", read)
                return tree
            # `--ignore-unmatch`: a tree with no `.gatedloop/runs/` entries is
            # the common case, not an error. `-f`: see the docstring above --
            # the scratch index has no working-tree effect to protect, so
            # the safety check that would otherwise fire on it is pure
            # false-positive noise keyed on checkout state. Its exit status
            # is read: a refusal must not produce a successful-looking,
            # un-stripped `write-tree`.
            rm = subprocess.run(
                ["git", "rm", "--cached", "-r", "-f", "--ignore-unmatch", *LEDGER_PREFIXES],
                cwd=root, env=env, capture_output=True, text=True,
            )
            if rm.returncode != 0:
                _report_normalize_failure("git rm --cached", rm)
                return tree
            out = subprocess.run(
                ["git", "write-tree"], cwd=root, env=env, capture_output=True, text=True,
            )
            normalized = out.stdout.strip()
            if out.returncode != 0 or not normalized:
                _report_normalize_failure("git write-tree", out)
                return tree
            return normalized
    except Exception:
        return tree


def _write_marker(
    root: Path, gate: str, tree: str,
    verdict: str | None = None, evidence: dict | None = None,
    scope: str = "full",
) -> None:
    # design D1: the recorded tree is ledger-normalized, so a gate's own
    # ledger row (appended after this write) can never stale what was just
    # recorded. design D2: `verdict` is "pass" (the default -- omitted so a
    # pre-existing marker with no `verdict` key still reads as a pass) or
    # "skip", the latter carrying `evidence` (baseline kind, resolved merge
    # target, files considered) -- the same facts the skip message prints.
    # scale-gate-cost D2: additive `scope` field ("full", or a surface name
    # for a scoped ci/unit run) -- every existing caller that doesn't pass
    # one still gets "full", so an unmodified marker consumer sees no change.
    # `scope` and `verdict` are orthogonal (fix-marker-mechanics D7): scope
    # says WHICH oracle ran, verdict says WHETHER anything needed to run.
    #
    # design D2 (worktree-native-loop): the marker is now TREE-KEYED, one
    # file per recorded tree under the gate's own directory, so a lane
    # alternating between trees (a serialized merge lane) never invalidates
    # its own still-valid evidence by recording a newer one. Eviction is a
    # bounded LRU (`_prune_markers`) -- oldest-first, silent, never an error.
    normalized = _normalize_tree(root, tree)
    d = _marker_gate_dir(root, gate)
    d.mkdir(parents=True, exist_ok=True)
    payload = {"gate": gate, "tree": normalized, "ts": _now_iso(), "scope": scope}
    if verdict and verdict != "pass":
        payload["verdict"] = verdict
        if evidence is not None:
            payload["evidence"] = evidence
    _marker_path(root, gate, normalized).write_text(json.dumps(payload))
    _prune_markers(d)
    # Opportunistic legacy cleanup (design D2: "cleaned up opportunistically
    # on the first new write") -- migration is "one re-run per worktree",
    # never a required step.
    _legacy_marker_path(root, gate).unlink(missing_ok=True)


def _read_marker(root: Path, gate: str, normalized_tree: str) -> dict | None:
    p = _marker_path(root, gate, normalized_tree)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def _now_iso() -> str:
    import datetime
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


_STALE_LIST_LIMIT = 10


def _stale_diagnosis(root: Path, gate_dir: Path, normalized: str) -> str:
    """What changed between the tree `ci` last passed on and `normalized`
    (hook-correctness D4) -- the most recently recorded marker, by its own
    `ts`, stands for "the gate run just before this commit". Both trees are
    ledger-normalized, so a ledger row never appears. Empty when the diff
    can't be read: the stale line above still denies."""
    newest: tuple[str, str] | None = None
    for p in gate_dir.glob("*.json"):
        try:
            payload = json.loads(p.read_text())
        except Exception:
            continue
        ts = payload.get("ts") or ""
        if newest is None or ts > newest[0]:
            newest = (ts, payload.get("tree") or p.stem)
    if newest is None:
        return ""
    out = subprocess.run(
        ["git", "diff-tree", "-r", "--name-status", newest[1], normalized],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return ""
    entries = [line.split("\t") for line in out.stdout.splitlines() if "\t" in line]
    if not entries:
        return ""
    shown = entries[:_STALE_LIST_LIMIT]
    more = len(entries) - len(shown)
    more_note = f", and {more} more" if more else ""
    if all(e[0] == "A" for e in entries):
        paths = ", ".join(e[-1] for e in shown)
        return (
            f"{len(entries)} file(s) were staged after `gates run ci` ran: "
            f"{paths}{more_note} — re-run the gate"
        )
    listed = ", ".join(f"{e[0]} {e[-1]}" for e in shown)
    return f"the staged tree differs from the one `ci` passed on: {listed}{more_note}"


def _check_marker_and_report(root: Path, gate: str, tree: str, require_scope: str | None = None) -> int:
    """The O(1) marker compare shared by `gates gate-marker check` and the
    fallback rung of `gates discipline check-commit` (design D2): one
    implementation so the two paths cannot disagree on what a fresh marker
    means. `tree` is normalized (design D1) before comparing — the same
    ledger-blind hash `_write_marker` recorded — so a ledger row staged after
    the marker was written can never stale it. `require_scope`, when given,
    additionally refuses a marker whose recorded scope doesn't match
    (scale-gate-cost D2: "full ci is always the last word" -- a per-task
    scoped marker satisfies a commit, never the completion/pre-merge
    requirement). A marker with no `scope` key at all predates scoping and is
    treated as `"full"` -- it was, by construction, the only kind of run that
    existed then."""
    normalized = _normalize_tree(root, tree)
    marker = _read_marker(root, gate, normalized)
    if marker is None:
        # design D2: distinguish "nothing was ever recorded for this gate"
        # (today's "no marker" wording) from "other trees are recorded, but
        # not this one" (an eviction or a genuinely different tree — today's
        # "stale" wording, generalized to name no single displaced tree since
        # several may be retained).
        gate_dir = _marker_gate_dir(root, gate)
        retained = sorted(p.stem for p in gate_dir.glob("*.json")) if gate_dir.exists() else []
        if not retained:
            print(
                f"gatedloop: no '{gate}' marker found — run `gates run {gate}` first",
                file=sys.stderr,
            )
            return 1
        print(
            f"gatedloop: '{gate}' marker is stale — no recorded tree matches "
            f"(ledger-normalized) tree {normalized!r}; {len(retained)} other "
            f"tree(s) are still retained. Run `gates run {gate}` again.",
            file=sys.stderr,
        )
        if gate == "ci":
            diagnosis = _stale_diagnosis(root, gate_dir, normalized)
            if diagnosis:
                print(f"gatedloop: {diagnosis}", file=sys.stderr)
        return 1
    # `marker.get("tree") == normalized` is now structural (the file is
    # keyed by that exact value), not a fact worth re-checking here.
    marker_scope = marker.get("scope") or "full"
    if require_scope is not None and marker_scope != require_scope:
        print(
            f"gatedloop: '{gate}' marker matches the tree but ran scoped to "
            f"'{marker_scope}' — this requires an unscoped ('{require_scope}') "
            f"run. Run `gates run {gate}` again with nothing staged.",
            file=sys.stderr,
        )
        return 1
    verdict = marker.get("verdict") or "pass"
    if verdict == "skip":
        # design D2: a skip verdict satisfies the check, but the success line
        # names it — a merge allowed by a skip must be visibly allowed by a
        # skip, not indistinguishable from a real pass.
        evidence = marker.get("evidence") or {}
        print(
            f"gatedloop: '{gate}' marker matches — {tree} — verdict=skip "
            f"({_describe_change_level_evidence(evidence)}) (scope: {marker_scope})"
        )
        return 0
    print(f"gatedloop: '{gate}' marker matches — {tree} (scope: {marker_scope})")
    return 0


def _main_worktree(root: Path) -> Path | None:
    """The primary checkout: the first entry `git worktree list` prints."""
    out = subprocess.run(
        ["git", "worktree", "list", "--porcelain"], cwd=root, capture_output=True, text=True,
    )
    for line in out.stdout.splitlines() if out.returncode == 0 else []:
        if line.startswith("worktree "):
            return Path(line[len("worktree "):])
    return None


def _check_marker_in_stores(
    root: Path, gate: str, tree: str, require_scope: str | None, ref: str | None,
) -> int:
    """`gate-marker check` across `_marker_stores(root, ref)`
    (cross-worktree-evidence D2): each store is tried in order and the first
    match wins. With one store the check is exactly `_check_marker_and_report`.
    With more, a failure prints each store's verdict on its own line, labelled
    with the store it read, so a denial says everywhere it looked."""
    stores = _marker_stores(root, ref)
    if len(stores) == 1:
        return _check_marker_and_report(root, gate, tree, require_scope)
    main = _main_worktree(root)
    branch = (ref or "").removeprefix("refs/heads/")
    failures: list[tuple[str, str]] = []
    for store in stores:
        rc, out, err = _captured(_check_marker_and_report, store, gate, tree, require_scope)
        if store.resolve() == root.resolve():
            kind = "primary" if main is not None and main.resolve() == root.resolve() else "this worktree"
        else:
            kind = f"worktree of '{branch}'"
        label = f"{kind}: {_markers_dir(store).resolve()}"
        if rc == 0:
            sys.stdout.write(out.rstrip("\n") + f" [{label}]\n")
            return 0
        failures.append((label, err))
    for label, err in failures:
        lines = err.strip().splitlines() or [f"gatedloop: no '{gate}' marker matched"]
        print(f"gatedloop: [{label}] {lines[0].removeprefix('gatedloop: ')}", file=sys.stderr)
        for line in lines[1:]:
            print(line, file=sys.stderr)
    return 1


def cmd_gate_marker(m: dict, root: Path, args) -> int:
    sub = args.gate_marker_cmd
    if sub == "check":
        return _check_marker_in_stores(
            root, args.gate, args.tree, getattr(args, "require_scope", None),
            getattr(args, "ref", None),
        )
    if sub == "clear":
        # design D2: clears BOTH layouts — the legacy single-slot file (a
        # pre-D2 install may still have one) and the tree-keyed directory —
        # for the named gate, or every gate's when none is named.
        d = _markers_dir(root)
        if not d.exists():
            return 0
        if args.gate:
            _legacy_marker_path(root, args.gate).unlink(missing_ok=True)
            gate_dir = _marker_gate_dir(root, args.gate)
            if gate_dir.exists():
                for f in gate_dir.glob("*.json"):
                    f.unlink(missing_ok=True)
                gate_dir.rmdir()
            return 0
        for legacy in d.glob("*.json"):
            legacy.unlink(missing_ok=True)
        for gate_dir in d.iterdir():
            if gate_dir.is_dir():
                for f in gate_dir.glob("*.json"):
                    f.unlink(missing_ok=True)
                gate_dir.rmdir()
        return 0
    sys.exit(f"gatedloop: unknown gate-marker subcommand '{sub}'")


# ---------- markers as commit statuses (merge-pull-request D1) -------------
#
# A marker lives under `.git/` on the machine that ran the gate, so nothing a
# forge or a CI job can read says which tree passed which gate. `gates marker
# publish` turns a green local marker into a `gatedloop/<gate>` commit status
# whose description carries the ledger-normalized tree it vouches for; `gates
# marker check-remote` reads one back and compares that tree with the sha's
# own. The forge is GitHub, reached only through `gh` -- an optional
# dependency, needed only here and in pull-request mode, and named loudly when
# it is missing (fail-loud-gates). A status posted from a laptop is
# self-reported; branch protection that requires the statuses from the CI
# provider is what makes them evidence (SETUP.md).

STATUS_CONTEXT_PREFIX = f"{NAME}/"
SKIP_STATUS_SUFFIX = " (skip: no hot surface)"
_STATUS_TREE_RE = re.compile(r"^tree ([0-9a-f]{40,64})\b")


class _ForgeRefusal(Exception):
    """A forge-facing command refused: the forge CLI is missing or
    unauthenticated, a forge call failed, or there is nothing true to say."""

    def __init__(self, message: str):
        self.message = message
        super().__init__(message)


def _gh(root: Path, *args: str) -> subprocess.CompletedProcess:
    """One `gh` call. A missing `gh` is a refusal naming it, never an empty
    answer that could read as "no status" or "nothing to publish"."""
    try:
        return subprocess.run(["gh", *args], cwd=root, capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        raise _ForgeRefusal(
            "gatedloop: the forge CLI `gh` is not installed. It is optional, and needed "
            "for commit statuses and pull-request mode: install it "
            "(https://cli.github.com), run `gh auth login` (or set GH_TOKEN in CI), "
            "then run this again."
        )
    except subprocess.TimeoutExpired:
        raise _ForgeRefusal(f"gatedloop: `gh {' '.join(args[:2])}` timed out — the forge did not answer.")


def _gh_json(root: Path, *args: str):
    out = _gh(root, *args)
    if out.returncode != 0:
        raise _ForgeRefusal(
            f"gatedloop: `gh {' '.join(args[:2])}` failed: "
            f"{(out.stderr or out.stdout).strip() or f'exit {out.returncode}'}"
        )
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError as e:
        raise _ForgeRefusal(f"gatedloop: `gh {' '.join(args[:2])}` did not return JSON: {e}")


def _forge_cli_state(root: Path) -> tuple[str, str]:
    """`("ready" | "missing" | "unauthenticated", detail)` -- the one reading
    of "is the forge CLI usable" shared by the forge commands and `gates
    doctor`'s `gh` row, so the two cannot disagree."""
    try:
        out = _gh(root, "auth", "status")
    except _ForgeRefusal as refusal:
        return "missing", refusal.message
    if out.returncode != 0:
        first = ((out.stderr or out.stdout).strip().splitlines() or [f"exit {out.returncode}"])[0]
        return "unauthenticated", (
            f"gatedloop: the forge CLI `gh` is not authenticated (`gh auth status`: "
            f"{first}). Run `gh auth login`, or set GH_TOKEN in CI, then run this again."
        )
    return "ready", ""


def _forge_repo(root: Path) -> str:
    """`owner/repo` of this checkout's forge repository (design D1), after
    confirming the forge CLI is installed and authenticated."""
    state, detail = _forge_cli_state(root)
    if state != "ready":
        raise _ForgeRefusal(detail)
    data = _gh_json(root, "repo", "view", "--json", "nameWithOwner")
    name = (data or {}).get("nameWithOwner") if isinstance(data, dict) else None
    if not name:
        raise _ForgeRefusal("gatedloop: `gh repo view` named no repository for this checkout.")
    return name


def _ci_run_url(repo: str) -> str | None:
    """The CI run a status links to, when published from GitHub Actions."""
    run_id = os.environ.get("GITHUB_RUN_ID")
    if not run_id:
        return None
    server = (os.environ.get("GITHUB_SERVER_URL") or "https://github.com").rstrip("/")
    return f"{server}/{os.environ.get('GITHUB_REPOSITORY') or repo}/actions/runs/{run_id}"


def _resolve_commit_or_refuse(root: Path, ref: str) -> tuple[str, str]:
    """`(sha, ledger-normalized tree)` of `ref`, or a refusal."""
    sha = _rev(root, ref)
    tree = _commit_tree(root, sha) if sha else None
    if not sha or not tree:
        raise _ForgeRefusal(f"gatedloop: '{ref}' is not a commit in this repository.")
    return sha, _normalize_tree(root, tree)


def _status_description(stores: list[Path], gate: str, sha: str, normalized: str) -> str:
    """What a `gatedloop/<gate>` status on `sha` may truthfully say, from the
    first store holding a green marker for its tree. A `ci` marker counts
    only from an unscoped run: a surface-scoped `ci` is not the whole oracle,
    and the status is read as if it were."""
    for store in stores:
        marker = _read_marker(store, gate, normalized)
        if marker is None:
            continue
        if gate == "ci" and (marker.get("scope") or "full") != "full":
            continue
        suffix = SKIP_STATUS_SUFFIX if marker.get("verdict") == "skip" else ""
        return f"tree {normalized}{suffix}"
    scoped = " from an unscoped run" if gate == "ci" else ""
    raise _ForgeRefusal(
        f"gatedloop: refusing to publish {STATUS_CONTEXT_PREFIX}{gate} on {sha[:12]} — no "
        f"green local '{gate}' marker{scoped} for its (ledger-normalized) tree "
        f"{normalized}. Run `gates run {gate}` on that tree first. Nothing was posted."
    )


def _publish_marker_status(root: Path, gate: str, ref: str, stores: list[Path] | None = None) -> str:
    """Post `gatedloop/<gate>` on `ref` (design D1). The local marker is
    checked before the forge is contacted, so a refusal never posts."""
    if gate == TESTS_STATUS_GATE:
        return _publish_tests_status(root, ref)
    sha, normalized = _resolve_commit_or_refuse(root, ref)
    description = _status_description(stores or [root], gate, sha, normalized)
    _post_status(root, _forge_repo(root), sha, gate, "success", description)
    return sha


# test-lock-remote-check D4: `tests` is computed, not a marker -- the commit's
# own tree is the evidence, so no gate run leaves anything to read.
TESTS_STATUS_GATE = "tests"
STATUS_DESCRIPTION_MAX = 140  # the forge's limit on a status description


def _active_changes_at(root: Path, sha: str) -> list[str]:
    """The change directories `sha`'s tree holds under `openspec/changes/`,
    archive excluded: the changes whose lock a commit can carry."""
    out = subprocess.run(
        ["git", "ls-tree", "-d", "--name-only", f"{sha}:openspec/changes"],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return []
    return sorted(n for n in out.stdout.split() if n and n != "archive")


def _publish_tests_status(root: Path, ref: str) -> str:
    """Post `gatedloop/tests` on `ref` from the lock evaluated at its tree,
    for every active change it carries: success naming the tree when the
    lock holds (saying so when there are no authored tests), failure naming
    the first offending path otherwise -- posted, then refused (exit 1)."""
    sha, normalized = _resolve_commit_or_refuse(root, ref)
    results = [_lock_at_commit(root, change, sha) for change in _active_changes_at(root, sha)]
    broken = [r for r in results if r.problems]
    repo = _forge_repo(root)
    if broken:
        first = broken[0]
        where = first.problems[0].split(": ", 1)[0]
        description = f"lock broken in {first.change}: {where}"[:STATUS_DESCRIPTION_MAX]
        _post_status(root, repo, sha, TESTS_STATUS_GATE, "failure", description)
        raise _ForgeRefusal("\n".join(r.refusal() for r in broken))
    authored = [r for r in results if r.handoff]
    for r in authored:
        print(r.summary())
    suffix = "" if authored else " (no authored tests)"
    _post_status(root, repo, sha, TESTS_STATUS_GATE, "success", f"tree {normalized}{suffix}")
    return sha


def _post_status(root: Path, repo: str, sha: str, gate: str, state: str, description: str) -> None:
    """Post one status under `gatedloop/<gate>`, the only context from 0.9.0."""
    context = f"{STATUS_CONTEXT_PREFIX}{gate}"
    fields = ["-f", f"state={state}", "-f", f"context={context}", "-f", f"description={description}"]
    url = _ci_run_url(repo)
    if url:
        fields += ["-f", f"target_url={url}"]
    out = _gh(root, "api", f"repos/{repo}/statuses/{sha}", "-X", "POST", *fields)
    if out.returncode != 0:
        raise _ForgeRefusal(
            f"gatedloop: posting {context} on {sha[:12]} failed (`gh api`): "
            f"{(out.stderr or out.stdout).strip() or f'exit {out.returncode}'}"
        )
    print(f"gatedloop: published {context} on {sha[:12]} — {description}")


def _check_remote_status(root: Path, gate: str, ref: str) -> str:
    """Verify `gatedloop/<gate>` on `ref` (design D1): its LATEST status must
    be a success naming `ref`'s own ledger-normalized tree. Returns the
    success line; every other outcome is a refusal naming what was found."""
    sha, normalized = _resolve_commit_or_refuse(root, ref)
    repo = _forge_repo(root)
    context = f"{STATUS_CONTEXT_PREFIX}{gate}"
    data = _gh_json(root, "api", f"repos/{repo}/commits/{sha}/status")
    statuses = (data.get("statuses") if isinstance(data, dict) else None) or []
    # The combined status lists the latest status per context.
    by_context = {s.get("context"): s for s in statuses if isinstance(s, dict)}
    latest = by_context.get(context)
    if latest is None:
        raise _ForgeRefusal(
            f"gatedloop: no {context} status on {sha[:12]} — nothing vouches for its tree "
            f"{normalized}. Publish one with `gates marker publish {gate} --sha {sha}` "
            "where the gate ran green."
        )
    state = latest.get("state")
    if state != "success":
        raise _ForgeRefusal(
            f"gatedloop: the latest {context} status on {sha[:12]} is '{state}', not "
            "'success'."
        )
    description = latest.get("description") or ""
    found = _STATUS_TREE_RE.match(description)
    if found is None or found.group(1) != normalized:
        named = found.group(1) if found else f"no tree ({description!r})"
        raise _ForgeRefusal(
            f"gatedloop: {context} on {sha[:12]} names tree {named}, but the commit's "
            f"(ledger-normalized) tree is {normalized} — the status vouches for a "
            "different tree."
        )
    skip = " (a skip verdict: no hot surface)" if description.endswith(SKIP_STATUS_SUFFIX) else ""
    return f"gatedloop: {context} on {sha[:12]} verifies — success for tree {normalized}{skip}"


def cmd_marker(m: dict, root: Path, args) -> int:
    """`gates marker publish|check-remote` (design D1)."""
    try:
        if args.marker_cmd == "publish":
            _publish_marker_status(root, args.gate, args.sha or "HEAD")
            return 0
        if args.marker_cmd == "check-remote":
            print(_check_remote_status(root, args.gate, args.sha))
            return 0
    except _ForgeRefusal as refusal:
        print(refusal.message, file=sys.stderr)
        return 1
    sys.exit(f"gatedloop: unknown marker subcommand '{args.marker_cmd}'")


# ---------- git pre-commit hook install (enforce-at-the-effect D4) ---------
#
# `gates hook install` owns wiring the effect-layer git `pre-commit` hook
# (layer 2). It is deterministic, testable shim code — not prompt prose —
# precisely because hook-manager topology is exactly the branchy detection a
# prompt does unreliably (design D4). It detects who owns the hook path and
# either COMPOSES the check in where a safe composition is determinable, or
# REFUSES-AND-INSTRUCTS where it is not. It never clobbers an existing hook.
#
# Task 2.4 decision — `gates hook status` does NOT earn a top-level verb. Its
# only consumer is `gates doctor` (streamline D3/D4), which already reports
# partial-wiring states; a standalone verb with no other caller is surface
# area for nothing (the repo's own rejection-test discipline). So hook status
# ships as a `gates doctor` sub-check (see `_hook_state` / `doctor_checks`),
# and `gates hook` exposes only `install`.

HOOK_BEGIN = f"# >>> {NAME} pre-commit (enforce-at-the-effect) >>>"
HOOK_END = f"# <<< {NAME} pre-commit (enforce-at-the-effect) <<<"
PUSH_HOOK_BEGIN = f"# >>> {NAME} pre-push (enforce-at-the-effect) >>>"
PUSH_HOOK_END = f"# <<< {NAME} pre-push (enforce-at-the-effect) <<<"
# The template's own header line — used to recognize an already-installed
# direct copy (which carries no BEGIN sentinel). It is the header rather than
# the check the body runs, because that check changed (lock-and-ledger-hygiene
# D4: `gate-marker check ci` became `discipline check-commit`) and a copy of
# either body is still one of ours, never a foreign one.
_HOOK_TEMPLATE_MARK = f"# {NAME} git pre-commit hook (enforce-at-the-effect"
_PUSH_HOOK_TEMPLATE_MARK = f"# {NAME} git pre-push hook (enforce-at-the-effect"

# git-layer-enforcement D4: both git-layer hooks install, compose, refuse and
# are diagnosed through one path, hook by hook.
GIT_HOOKS = ("pre-commit", "pre-push")
_HOOK_MARKERS = {
    "pre-commit": (HOOK_BEGIN, HOOK_END, _HOOK_TEMPLATE_MARK),
    "pre-push": (PUSH_HOOK_BEGIN, PUSH_HOOK_END, _PUSH_HOOK_TEMPLATE_MARK),
}

# git-layer-enforcement D2: the one line `gates hook install` writes into a
# template — the installing shim's path, the hook's last fallback for finding
# the shim outside a plugin environment. The shipped template holds it empty,
# and a copy is compared with the template with this line emptied.
_RECORDED_LINE_RE = re.compile(r"^GATES_INSTALLED=.*$", re.MULTILINE)
_EMPTY_RECORDED_LINE = "GATES_INSTALLED=''"


def _hook_template_path(hook: str = "pre-commit") -> Path:
    return (
        Path(__file__).resolve().parent.parent
        / "templates" / "git-hooks" / hook
    )


def _composed_hook_snippet(hook: str = "pre-commit") -> str:
    """The delegating block appended when composing into an existing hook.
    It calls the shipped template (one source of truth for the check logic,
    the agent-session decision included: git-layer-enforcement D1) with the
    hook's arguments and stdin, and is a transparent no-op when the plugin
    root is unavailable — so it never blocks a human."""
    begin, end, _mark = _HOOK_MARKERS[hook]
    return "\n".join([
        begin,
        f"# Git-layer {hook} gate. Delegates to the shipped template so there is a",
        "# single source of truth; the template decides whether this is an agent",
        "# session (`gates discipline agent-session`) and is a transparent no-op",
        "# otherwise, as this block is when the plugin root is unavailable.",
        f'if [ -x "${{CLAUDE_PLUGIN_ROOT:-}}/templates/git-hooks/{hook}" ]; then',
        f'  "${{CLAUDE_PLUGIN_ROOT}}/templates/git-hooks/{hook}" "$@" || exit $?',
        "fi",
        end,
        "",
    ])


def _hook_install_body(hook: str) -> str:
    """The template with the installing shim's path recorded (D2)."""
    line = "GATES_INSTALLED=" + shlex.quote(str(Path(__file__).resolve()))
    return _RECORDED_LINE_RE.sub(lambda _m: line, _hook_template_path(hook).read_text(), count=1)


def _hook_recorded_shim_gone(text: str) -> bool:
    """Whether a copy records a shim path that no longer exists while
    neither the plugin root nor PATH resolves the shim: then nothing the hook
    tries finds it, and the copy is stale (git-layer-enforcement D2)."""
    m = _RECORDED_LINE_RE.search(text)
    if not m:
        return False
    try:
        words = shlex.split(m.group(0)[len("GATES_INSTALLED="):])
    except ValueError:
        return True
    recorded = words[0] if words else ""
    if not recorded or os.access(recorded, os.X_OK):
        return False
    plugin = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if plugin and os.access(os.path.join(plugin, "bin", "gates"), os.X_OK):
        return False
    return shutil.which("gates") is None


def _read_text_safe(p: Path) -> str:
    try:
        return p.read_text()
    except Exception:
        return ""


# ---------- command-derived repo resolution (design D1, worktree-native-loop) --
#
# Every gate hook used to `cd` to the hook input's `cwd` -- the harness
# SESSION cwd, not the directory the guarded command actually runs in. A
# background agent whose shell resets cwd per call issues `cd <worktree> &&
# git commit …` or `git -C <worktree> …`, and the session cwd stays at the
# primary checkout -- the hook then evaluates the WRONG repository. `gates
# hook git-cwd` resolves the effective directory from the guarded command
# itself, reusing `hooks/_gate_match.py`'s tokenizer (one parser, two
# consumers -- this shim is sequenced after harden-hook-matching precisely
# so it can reuse it, rather than re-implementing shell tokenizing here).

_GIT_CWD_KINDS = (
    "git-commit", "git-merge", "openspec-archive", "implement-branch",
    "openspec-scaffold",
)


def _load_gate_match():
    """Load `hooks/_gate_match.py` as a module -- same technique
    `_hook_template_path()` uses to reach a sibling file by position
    relative to this script, not an absolute path (`plugin-relative-paths`).
    """
    import importlib.util
    path = Path(__file__).resolve().parent.parent / "hooks" / "_gate_match.py"
    spec = importlib.util.spec_from_file_location(f"_{NAME}_gate_match", str(path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _find_kind_command_index(gm, commands: list[list[str]], kind: str) -> int | None:
    """The index of the first simple command in `commands` that is the
    `kind` invocation being guarded -- the anchor D1's `-C`/`GIT_DIR`/`cd`
    rungs resolve against. `None` when no simple command matches (nothing
    to anchor on; the caller falls through to the hook cwd)."""
    for i, c in enumerate(commands):
        if kind == "git-commit":
            if gm._match_git_subcommand(c, "commit") is not None:
                return i
        elif kind == "git-merge":
            if gm._match_git_subcommand(c, "merge") is not None:
                return i
        elif kind == "implement-branch":
            rest = gm._match_git_subcommand(c, "checkout")
            if rest is not None and gm._flag_value(rest, "-b"):
                return i
            rest = gm._match_git_subcommand(c, "switch")
            if rest is not None and gm._flag_value(rest, "-c"):
                return i
        elif kind == "openspec-archive":
            if gm._match_openspec_tokens(c, ["archive"]) is not None:
                return i
        elif kind == "openspec-scaffold":
            if gm._match_openspec_tokens(c, ["new", "change"]) is not None:
                return i
    return None


def _env_assignment_dir(tok: str) -> tuple[str, str] | None:
    """`(name, dir)` if `tok` is a `GIT_DIR=…`/`GIT_WORK_TREE=…` assignment,
    else `None`. `GIT_DIR`'s value is resolved to its PARENT when it ends in
    `.git` (D1: "`GIT_WORK_TREE` (or `GIT_DIR`'s parent for a `.git`-suffixed
    path) names the tree under check")."""
    if "=" not in tok:
        return None
    name, val = tok.split("=", 1)
    if name == "GIT_WORK_TREE":
        return name, val
    if name == "GIT_DIR":
        p = Path(val)
        return name, (str(p.parent) if p.name == ".git" else val)
    return None


def _git_dash_c_and_env_dir(gm, tokens: list[str]) -> str | None:
    """Rungs 1-2 for one simple command's full token list (leading
    assignments/wrappers included): `git -C <dir>` (repeatable, composing
    left-to-right) takes precedence over a `GIT_DIR`/`GIT_WORK_TREE`
    assignment carried by the same command; both apply only when the
    command's program is `git` -- an `openspec` invocation carries neither
    signal. `None` when this simple command has no such signal."""
    prog, rest = gm._prog_and_rest(tokens)
    env_dir: str | None = None
    i, n = 0, len(tokens)
    while i < n:
        tok = tokens[i]
        assignment = _env_assignment_dir(tok)
        if assignment is not None:
            _, val = assignment
            if env_dir is None or assignment[0] == "GIT_WORK_TREE":
                env_dir = val
            i += 1
            continue
        if tok in gm._WRAPPERS:
            i += 1
            if tok == "env":
                while i < n and gm._is_assignment(tokens[i]):
                    a = _env_assignment_dir(tokens[i])
                    if a is not None and (env_dir is None or a[0] == "GIT_WORK_TREE"):
                        env_dir = a[1]
                    i += 1
            continue
        if gm._is_assignment(tok):
            i += 1
            continue
        break
    if prog != "git":
        return None
    # Global options before the subcommand. `-C` composes left-to-right and
    # applies first; `--git-dir`/`--work-tree` (cross-worktree-evidence D4)
    # then resolve against it, as git resolves them, and override the
    # environment forms, as git's own options do.
    dir_path: str | None = None
    git_dir: str | None = None
    work_tree: str | None = None
    j, m = 0, len(rest)
    while j < m:
        tok = rest[j]
        name, val = tok, None
        if tok.startswith("--") and "=" in tok:
            name, val = tok.split("=", 1)
        elif tok.startswith("-C") and len(tok) > 2:
            name, val = "-C", tok[2:]
        elif tok in gm._GIT_GLOBAL_FLAGS_WITH_VALUE:
            val = rest[j + 1] if j + 1 < m else None
            j += 1
        elif not tok.startswith("-"):
            break
        j += 1
        if val is None:
            continue
        if name == "-C":
            dir_path = val if Path(val).is_absolute() or dir_path is None else str(Path(dir_path) / val)
        elif name == "--git-dir":
            git_dir = val
        elif name == "--work-tree":
            work_tree = val

    def _against_c(p: str) -> str:
        return p if Path(p).is_absolute() or dir_path is None else str(Path(dir_path) / p)

    if work_tree:
        return _against_c(work_tree)
    if git_dir and Path(git_dir).name == ".git":
        return _against_c(str(Path(git_dir).parent))
    if dir_path:
        return dir_path
    return env_dir


_UNEVALUABLE_MARKERS = ("$", "`")


def _resolve_cd_chain(gm, commands: list[list[str]], end: int, base: str) -> str | None:
    """Rung 3: chain every `cd <dir>` before index `end`, starting from
    `base` (the hook cwd). A target this can't statically evaluate (a shell
    variable or command substitution) abandons the WHOLE chain -- D1's own
    non-goal is explicit that fall-through, not a partial answer, is the
    safe behavior here."""
    current = base
    saw_cd = False
    for c in commands[:end]:
        if not c or c[0] != "cd":
            continue
        if len(c) < 2:
            continue
        target = c[1]
        if any(marker in target for marker in _UNEVALUABLE_MARKERS):
            return None
        current = target if target.startswith("/") or not current else str(Path(current) / target)
        saw_cd = True
    return current if saw_cd else None


def _resolve_command_cwd(command: str, kind: str, hook_cwd: str) -> str | None:
    """The effective directory for the `kind` invocation inside `command`,
    or `None` if nothing resolves (the caller falls through to the hook cwd/
    `CLAUDE_PROJECT_DIR`/pwd rungs, D1 items 4-5)."""
    gm = _load_gate_match()
    commands = gm._split_simple_commands(command)
    if not commands:
        return None
    idx = _find_kind_command_index(gm, commands, kind)
    if idx is None:
        return None
    rung12 = _git_dash_c_and_env_dir(gm, commands[idx])
    if rung12:
        return rung12
    return _resolve_cd_chain(gm, commands, idx, hook_cwd)


def _hook_git_cwd(kind: str | None) -> int:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except Exception:
        data = {}
    command = ((data.get("tool_input") or {}).get("command")) or ""
    hook_cwd = data.get("cwd") or ""

    resolved = None
    if command and kind:
        resolved = _resolve_command_cwd(command, kind, hook_cwd)
    if resolved:
        print(resolved)
        return 0
    if hook_cwd and Path(hook_cwd).is_dir():
        print(hook_cwd)
        return 0
    proj = os.environ.get("CLAUDE_PROJECT_DIR")
    if proj and Path(proj).is_dir():
        print(proj)
        return 0
    print(os.getcwd())
    return 0


def _git_config_get(root: Path, key: str) -> str | None:
    try:
        out = subprocess.run(
            ["git", "config", "--get", key],
            cwd=root, capture_output=True, text=True,
        )
    except Exception:
        return None
    if out.returncode != 0:
        return None
    return out.stdout.strip() or None


def _core_hooks_path(root: Path) -> Path | None:
    v = _git_config_get(root, "core.hooksPath")
    if not v:
        return None
    p = Path(v)
    return p if p.is_absolute() else (root / p)


def _hooks_dir(root: Path) -> Path:
    """The directory git itself runs hooks from (cross-worktree-evidence D3).

    `--git-dir` is a linked worktree's private `.git/worktrees/<lane>`, which
    git never runs hooks from; `--git-path hooks` is git's own answer, the
    common directory's `hooks/` (or `core.hooksPath`), the same from every
    worktree of the repository."""
    out = subprocess.run(
        ["git", "rev-parse", "--git-path", "hooks"],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0 or not out.stdout.strip():
        return _git_dir(root) / "hooks"
    p = Path(out.stdout.strip())
    return p if p.is_absolute() else (root / p)


def _detect_hook_owner(root: Path, hook: str = "pre-commit") -> tuple[str, Path | None]:
    """Classify who owns the `hook` path (`pre-commit` or `pre-push`). Returns
    `(kind, path)`: kind ∈ {husky, lefthook, pre-commit, hooksPath, bare-hook,
    none}. `path` is the concrete hook file our check lives in / would install
    to, when meaningful. Managers are authority on the hook path, so they win
    over a stray `.git/hooks/<hook>`; a manager owns every hook path at once
    (git-layer-enforcement D4), a bare hook only its own."""
    if (root / ".husky").is_dir():
        # husky v9 points core.hooksPath at .husky/_ and runs .husky/<hook>;
        # older husky sources husky.sh from the same per-hook script. Either
        # way .husky/<hook> is the file to compose into.
        return "husky", root / ".husky" / hook
    for name in ("lefthook.yml", "lefthook.yaml", ".lefthook.yml", ".lefthook.yaml"):
        if (root / name).exists():
            return "lefthook", None
    for name in (".pre-commit-config.yaml", ".pre-commit-config.yml"):
        if (root / name).exists():
            return "pre-commit", None
    hooks_path = _core_hooks_path(root)
    if hooks_path is not None:
        return "hooksPath", hooks_path / hook
    default_hook = _hooks_dir(root) / hook
    if default_hook.exists():
        return "bare-hook", default_hook
    return "none", default_hook


def _hook_already_wired(path: Path | None, hook: str = "pre-commit") -> bool:
    if path is None or not path.exists():
        return False
    existing = _read_text_safe(path)
    begin, _end, mark = _HOOK_MARKERS[hook]
    return begin in existing or mark in existing


def _hook_copy_at(path: Path | None, hook: str = "pre-commit") -> dict:
    """Whether `path` holds a *direct copy* of a gatedloop hook template, and
    whether that copy is *current* (adoption-followups D1). A copy carries the
    template header and no composed-block marker, wherever it sits; it is
    current when its text, with the recorded shim-path line emptied, equals
    the shipped template's and that path still resolves the shim, or
    something else does (git-layer-enforcement D2). A local edit reads as
    stale (the refresh keeps it in a backup, D3). A composed block delegates
    to the shipped template at run time and is never a copy."""
    if path is None or not path.is_file():
        return {"copy": False, "current": False}
    try:
        text = path.read_bytes().decode("utf-8", errors="replace")
    except OSError:
        return {"copy": False, "current": False}
    begin, _end, mark = _HOOK_MARKERS[hook]
    if mark not in text or begin in text:
        return {"copy": False, "current": False}
    try:
        shipped = _hook_template_path(hook).read_text()
    except OSError:
        return {"copy": True, "current": False}
    normalized = _RECORDED_LINE_RE.sub(lambda _m: _EMPTY_RECORDED_LINE, text, count=1)
    current = normalized == shipped and not _hook_recorded_shim_gone(text)
    return {"copy": True, "current": current}


def _hook_copy_facts(root: Path, hook: str = "pre-commit") -> dict:
    """`{"copy", "current"}` for the repo's `hook` path: the one fact both
    `gates doctor` (via `_hook_state`) and the adoption evaluators read
    (adoption-followups D2), so the two never disagree about a hook."""
    _kind, path = _detect_hook_owner(root, hook)
    return _hook_copy_at(path, hook)


def _hook_state(root: Path, hook: str = "pre-commit") -> str:
    """A single primitive for `gates doctor`'s hook sub-checks (task 2.4;
    both hooks since git-layer-enforcement D4): 'wired' (installed or
    composed), 'stale-copy' (a direct copy of an earlier or locally edited
    template, or one whose recorded shim is gone; adoption-followups D7),
    'manager-uncomposed' (a manager owns the path but our check isn't in it),
    'unmanaged-hook' (a foreign bare hook), or 'absent' (nothing installed)."""
    kind, path = _detect_hook_owner(root, hook)
    copy = _hook_copy_at(path, hook)
    if copy["copy"] and not copy["current"]:
        return "stale-copy"
    if _hook_already_wired(path, hook):
        return "wired"
    if kind in ("husky", "lefthook", "pre-commit", "hooksPath"):
        return "manager-uncomposed"
    if kind == "bare-hook":
        return "unmanaged-hook"
    return "absent"


def _hook_refuse(kind: str, path: Path | None, hook: str = "pre-commit") -> int:
    """Refuse-and-instruct: never clobber; print exactly how to wire it by
    hand. Non-zero exit — the check is NOT in place, and the caller
    (`gates-init`) must report that rather than treat it as done."""
    where = {
        "bare-hook": (
            f"an existing, unmanaged {hook} hook is present and its exit "
            "semantics are unknown — appending could silently never run"
        ),
        "lefthook": "lefthook manages hooks via its own config file",
        "pre-commit": "the pre-commit framework manages hooks via .pre-commit-config.yaml",
        "hooksPath": "core.hooksPath redirects hooks to a path this installer does not recognize",
    }.get(kind, "the hook topology could not be classified safely")
    print(
        f"gatedloop: refusing to modify the {hook} hook — {where}.\n"
        "gatedloop: nothing was changed. Wire the git-layer check by hand by adding this "
        f"block to your {hook} hook (or your manager's {hook} entry):\n\n"
        f"{_composed_hook_snippet(hook)}",
        file=sys.stderr,
    )
    if path is not None:
        print(f"gatedloop: (the existing hook this refers to is at {path})", file=sys.stderr)
    return 1


_HOOK_PURPOSE = {
    "pre-commit": "commit enforcement",
    "pre-push": "push enforcement (the merge target)",
}


def _hook_install_one(root: Path, hook: str) -> int:
    tmpl = _hook_template_path(hook)
    if not tmpl.exists():
        print(f"gatedloop: hook template not found at {tmpl}", file=sys.stderr)
        return 1
    kind, path = _detect_hook_owner(root, hook)

    # adoption-followups D3: gatedloop's own direct copy that is not current
    # (a different body, or a recorded shim that is gone) is the one file
    # this installer may replace. Checked before the "already wired" return,
    # which a stale copy would otherwise satisfy, leaving it in place forever.
    copy = _hook_copy_at(path, hook)
    if copy["copy"] and not copy["current"]:
        backup = path.with_name(path.name + f".{NAME}-prev")
        backup.write_bytes(path.read_bytes())
        path.write_text(_hook_install_body(hook))
        path.chmod(0o755)
        print(
            f"gatedloop: refreshed the git {hook} hook at {path} to the shipped "
            f"template. The previous body is saved at {backup}; any local edit you "
            "made to the old copy is there."
        )
        return 0

    if _hook_already_wired(path, hook):
        print(
            f"gatedloop: git-layer {_HOOK_PURPOSE[hook]} is already installed "
            f"({kind}) at {path} — nothing to do."
        )
        return 0

    if kind == "none":
        # Nothing present: install the shipped template directly (task 2.3),
        # with the installing shim's path recorded (git-layer-enforcement D2).
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(_hook_install_body(hook))
        path.chmod(0o755)
        print(
            f"gatedloop: installed the git {hook} hook at {path}. It enforces only "
            "inside a declared agent session (`discipline.agent-env`, default "
            "CLAUDECODE); a human's commit or push is unaffected."
        )
        return 0

    if kind == "husky":
        # Compose: append the delegating snippet to .husky/<hook> — a plain
        # shell script husky runs. Appending is additive and preserves every
        # existing line (never clobbers).
        snippet = _composed_hook_snippet(hook)
        if path.exists():
            content = _read_text_safe(path)
            if content and not content.endswith("\n"):
                content += "\n"
            path.write_text(content + "\n" + snippet)
            print(
                f"gatedloop: composed the git-layer check into the existing husky {hook} "
                f"hook at {path} (existing content preserved)."
            )
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("#!/usr/bin/env sh\n" + snippet)
            print(f"gatedloop: added a husky {hook} hook at {path} with the git-layer check.")
        path.chmod(0o755)
        return 0

    # lefthook / pre-commit framework / an unrecognized core.hooksPath / a
    # foreign bare hook: no safe automatic composition — refuse and instruct.
    return _hook_refuse(kind, path, hook)


PUSH_HOOK_ITEM = "git-push-hook"


def _push_hook_declined(root: Path) -> bool:
    """Whether the project declined the push hook: the `git-push-hook`
    adoption item recorded `declined` in `.gatedloop/adoption.json` (by the
    upgrade walk, or by `gates hook install --commit-only`). Raises
    AdoptionError when the record cannot be read."""
    record = _read_adoption_decisions(root).get(PUSH_HOOK_ITEM)
    return isinstance(record, dict) and record.get("decision") == "declined"


def _hook_install(root: Path, commit_only: bool = False, push: bool = False) -> int:
    """Install the git-layer hooks (git-layer-enforcement D4), each under the
    same owner detection; exit 1 when any is not in place. The push hook is
    opt-in (task 6.2): `--commit-only` installs the commit hook alone and
    records the `git-push-hook` item `declined`; while it is declined a plain
    install skips the push hook and says so; `--push` installs it and records
    `adopted`."""
    try:
        declined = _push_hook_declined(root)
    except AdoptionError as e:
        print(f"gatedloop: cannot tell whether this project declined the push hook — {e}",
              file=sys.stderr)
        return 1
    if commit_only or (declined and not push):
        hooks = ("pre-commit",)
    else:
        hooks = GIT_HOOKS
    results = [_hook_install_one(root, hook) for hook in hooks]
    if declined and not (commit_only or push):
        print(
            f"gatedloop: skipped the git pre-push hook — this project declined it (the "
            f"`{PUSH_HOOK_ITEM}` adoption item is recorded `declined`). Add it with "
            "`gates hook install --push`."
        )
    decision = "declined" if commit_only else "adopted" if push else None
    if decision:
        try:
            path = _write_adoption_decision(root, PUSH_HOOK_ITEM, decision)
        except AdoptionError as e:
            print(f"gatedloop: the push-hook choice was not recorded — {e}", file=sys.stderr)
            return 1
        follow = (
            "`gates hook install` now installs the commit hook only; add the push hook "
            "with `gates hook install --push`." if commit_only
            else "`gates hook install` installs both hooks again."
        )
        print(f"gatedloop: recorded {PUSH_HOOK_ITEM}: {decision} in {path}. Commit it, so the "
              f"whole team shares the decision. {follow}")
    return 1 if any(results) else 0


def cmd_hook(args) -> int:
    if args.hook_cmd == "git-cwd":
        return _hook_git_cwd(args.kind)
    root = _repo_root()
    if args.hook_cmd == "install":
        return _hook_install(root, commit_only=args.commit_only, push=args.push)
    sys.exit(f"gatedloop: unknown hook subcommand '{args.hook_cmd}'")


# ---------- ledger (D7/D8: a durable record, opposite lifetime to the marker) --
#
# The marker (above) and the ledger row are written at the same MOMENT —
# `gates run <gate>` finishing — but want opposite LIFETIMES: the marker is
# an ephemeral per-worktree lock under `.git/` that must never be committed;
# the ledger is a durable, committed record under `.gatedloop/runs/<change>.jsonl`
# that must survive a squash-merge (a branch's commits stop being ancestors
# of `main`, but an append-only file's final state is carried by the squash
# commit intact). Rows are keyed on (change, task) — never a commit SHA,
# which a squash orphans.
#
# Row shape (fixed before implementation, per task 1b.1 — a field omitted
# here cannot be reconstructed later). The design's own candidate shape is
# `{ts, gate, exit, duration_ms, change, task, tree, attempt}`; two fields
# are added up front rather than bolted on later once rows already exist
# with a narrower shape: `approved_by` (task 1c.6 — "record the approver on
# the run's ledger rows") and `sha` (task 1b.4 — populated only on the one
# `change -> squash SHA` row appended at merge, `None` on every gate row).
# Every row carries all of `LEDGER_ROW_FIELDS`'s keys; unused ones are
# `None`, so the shape never has to be inferred from which keys happen to be
# present.
#
# `gate` names the EVENT, and several of its values are not gates: `merge`
# (task 1b.4's one change -> squash-SHA row), `taint` / `taint-clear` (the
# post-hoc reflog audit's verdict), `review` (a convention review's verdict,
# baseline finding 0.3) and `task-start` (the tree a task began from,
# baseline finding 0.4). All of them are recorded here rather than anywhere
# new because this is already the only place in the system where an outcome
# is written down at all — a second store would be a second thing to keep
# honest.
#
# `verdict` (fix-marker-mechanics design D2/D7, task 2.4): `"skip"` on the
# one row a resolved-empty `live-check` appends, `None` on every other row
# (including a `ci` row's own default "a probe genuinely ran" case). It is
# orthogonal to the merged-but-unimplemented `scale-gate-cost` change's
# `scope` field — `scope` says which oracle ran, `verdict` says whether
# anything needed to run — and both are read by key with absent-means-default
# semantics, so whichever change lands second only has to extend this tuple
# with the union; rows written in the gap read as `None`/default for the
# missing key, which both designs already treat as the safe value.
#
# gate-preconditions design D3 widens the fixed shape by three more fields —
# `outcome`, `precondition`, `precondition_exit` — for exactly one new row
# kind: a failed `requires` (`gate` names the gate/live-check that was NOT
# run, `exit` is the reserved `PRECONDITION_EXIT_CODE`, `outcome` is the
# literal string `"precondition-failed"`, `precondition` names the command
# that failed, `precondition_exit` is its own exit code, and `tree` is
# always `None` — nothing ran against a tree, so nothing can join one).
# Every other row kind leaves the three `None` (omitted from the dict
# `_append_ledger_row` is called with; the fixed-shape lookup below fills
# them in), so an old reader that only knows the original ten keys still
# sees a row whose `exit` is non-zero and whose `tree` is unset — never a
# false green, and `_maybe_resolve_taint`'s join on green `ci` rows can
# never match one. This tuple is the union of both changes' fields, per
# fix-marker-mechanics D7.

LEDGER_ROW_FIELDS = (
    "ts", "gate", "exit", "duration_ms", "change", "task", "tree", "attempt",
    "approved_by", "sha", "verdict", "outcome", "precondition", "precondition_exit",
    # scale-gate-cost D2: additive -- "full" or a surface name for a scoped
    # `ci`/`unit` row; absent/`None` on every other row kind (review,
    # task-start, taint, merge, …), which never scoped. Appended last so the
    # tuple is the union of every change's fields (fix-marker-mechanics D7);
    # rows written before it read as `None`, the safe default.
    "scope",
    # escalation-outcomes D2: `cause` names why the loop stopped (a `halt`
    # row, one of HALT_CAUSES) or what kind of human turn it was (an
    # `intervention` row: `ask` / `human-commit`); `detail` is its free text.
    # `None` on every other row kind. D5: `session` is `"agent"` when the
    # `CLAUDECODE` session marker is in the writer's environment, else
    # `"human"` -- set by `_append_ledger_row` itself, never by a caller, so
    # no row kind can omit or forge it. A row without the key (written before
    # this field existed) reads as *unknown*, never as either value.
    "cause", "detail", "session",
    # acceptance-gate D2: who accepted (or rejected) the increment -- set on
    # `acceptance` rows only, from the forge review's author (`--pr`) or the
    # configured git identity (`--local`, `reject`); `None` on every other
    # row kind. Appended after `session` per the union rule.
    "accepted_by",
    # split-test-author D4: set on `tests-handoff` rows (and, for the placed
    # task's own paths, `tests-placed`) only; `None` on every other row kind,
    # and rows written before them read as `None`. `author` is `separate` or
    # `inline`; `tests` is `{task: {path: blob}}`; `base` is `{path:
    # blob|null}`, each real path's content at authoring time; `no_behaviour`
    # is `{task: reason}`. The blobs are what survive once the holding files
    # move (D3). Appended after `accepted_by` per the union rule.
    "author", "tests", "base", "no_behaviour",
    # retry-budget D3: the four-field lesson on an `attempt-note` row; `None`
    # on every other row kind. Appended after `no_behaviour` per the union rule.
    "note",
    # retry-budget D4: whether a fresh restart remains, on a `stalled` halt
    # row only, computed by the shim; `None` on every other row.
    "restart_available",
    # authored-test-kinds D1: `{task: reason}` for the tasks the author
    # declared `characterization` (their tests pin behaviour the tree already
    # has), on `tests-handoff` rows only; `None` on every other row kind.
    # Appended after `restart_available` per the union rule.
    "characterization",
    # authored-test-kinds D3: a `test-defect` row's kind, `setup` or
    # `assertion`; `None` on every other row kind. A defect row written
    # before it reads as `assertion`. Appended per the union rule.
    "kind",
    # token-ledger D1: on a `usage` row only -- `tokens` maps a model name to
    # its `{input, output, cache_read, cache_write}` counts (`None` when the
    # source had none), `window` is `{from, to}`, `messages` the assistant
    # messages counted, `source` which reader produced the counts
    # (USAGE_SOURCES). `None` on every other row kind. Appended per the
    # union rule.
    "tokens", "window", "messages", "source",
)


def _ledger_path(root: Path, change: str) -> Path:
    return _state_dir(root) / "runs" / f"{change}.jsonl"


def _current_branch(root: Path) -> str | None:
    try:
        out = subprocess.run(
            ["git", "branch", "--show-current"],
            cwd=root, capture_output=True, text=True,
        ).stdout.strip()
        return out or None
    except Exception:
        return None


def _resolve_change_name(root: Path, given: str | None) -> str | None:
    """The ledger is keyed on the change name (hook-correctness D6).

    An explicit name is trusted -- unless it contains `/`, which no change
    name does (`--change plan/<name>` would mint a nested ledger path): that
    is refused, naming the bare name. With none given, the current branch is
    the change only when `openspec/changes/<branch>/` exists -- the active
    directory first, then `openspec/changes/archive/*-<branch>/` so a
    just-archived change still resolves for its merge row. `main`, `master`,
    the merge target, a `plan/*` branch, a docs branch and a detached HEAD
    all resolve to `None`: no ledger row.
    """
    if given:
        if "/" in given:
            sys.exit(
                f"gatedloop: change names never contain '/'; use "
                f"`{given.rstrip('/').rsplit('/', 1)[-1]}`"
            )
        return given
    branch = _current_branch(root)
    if branch is None or "/" in branch or branch in ("main", "master"):
        return None
    target, _reason = _resolve_merge_target(root)
    if target is not None and branch == target.split("/")[-1]:
        return None
    changes = root / "openspec" / "changes"
    if (changes / branch).is_dir():
        return branch
    archive = changes / "archive"
    # Archived as `<YYYY-MM-DD>-<name>`: match the date prefix exactly, so
    # `foo` never resolves from an archived `bar-foo`.
    dated = re.compile(r"\d{4}-\d{2}-\d{2}-" + re.escape(branch))
    if archive.is_dir() and any(
        p.is_dir() and dated.fullmatch(p.name) for p in archive.iterdir()
    ):
        return branch
    return None


def _openspec_yaml_path(root: Path, change: str) -> Path:
    return root / "openspec" / "changes" / change / ".openspec.yaml"


# openspec-1-14-compat D1: OpenSpec 1.14 reports unknown `.openspec.yaml`
# keys and `validate --strict` fails on them, except lowercase `x-…` keys,
# which it reserves for tools. gatedloop's approval keys are written in the
# `x-gatedloop-` spelling; the 0.5.0 spelling is still read (D2), so a plan
# merged before the rename keeps opening the implementation gate.
APPROVAL_KEYS = (
    (f"x-{NAME}-approved-by", "approved_by"),
    (f"x-{NAME}-approved-at", "approved_at"),
    (f"x-{NAME}-approved-sha", "approved_sha"),
)


def _approval_meta(data) -> tuple:
    """`(by, at, sha)` from a parsed `.openspec.yaml` (design D2): each field
    from the `x-gatedloop-` key, falling back to its 0.5.0 spelling field by
    field. A missing or blank value is `None`. Every approval reader goes
    through here."""
    data = data if isinstance(data, dict) else {}
    out = []
    for new, old in APPROVAL_KEYS:
        value = _meta_value(data, new)
        if value is None:
            v = data.get(old)
            value = v if v is not None and str(v).strip() else None
        out.append(value if value is None or isinstance(value, str) else str(value))
    return tuple(out)


def _read_approved_by(root: Path, change: str) -> str | None:
    p = _openspec_yaml_path(root, change)
    if not p.exists():
        return None
    try:
        data = _load(p) or {}
    except Exception:
        return None
    return _approval_meta(data)[0]


def _append_ledger_row(root: Path, row: dict) -> None:
    change = row.get("change")
    if not change:
        return
    full = {k: row.get(k) for k in LEDGER_ROW_FIELDS}
    # escalation-outcomes D5: the same discriminator the git-layer commit hook
    # scopes itself by, so the two mechanisms agree about what a session is.
    full["session"] = "agent" if os.environ.get("CLAUDECODE") else "human"
    path = _ledger_path(root, change)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps(full) + "\n")


def cmd_ledger(m: dict, root: Path, args) -> int:
    if args.ledger_cmd == "record-merge":
        change = args.change
        sha = args.sha or subprocess.run(
            ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True,
        ).stdout.strip()
        if not sha:
            sys.exit("gatedloop: could not resolve a SHA for the merge ledger row")
        # acceptance-gate D7: the tree is recorded ledger-normalized, the same
        # hash an `acceptance` row pins, so the outcomes view can join "what
        # was accepted" to "what shipped" without re-running git. Nothing
        # read the raw value before.
        # The tree of the commit the row names (merge-pull-request D3: a
        # forge merge is recorded later, from a HEAD that may have moved on);
        # identical to HEAD's whenever the row is written at the squash.
        head = (_commit_tree(root, args.sha) if args.sha else None) or _head_tree(root)
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": "merge", "exit": 0, "duration_ms": 0,
            "change": change, "task": None,
            "tree": _normalize_tree(root, head) if head else None,
            "attempt": None, "approved_by": _read_approved_by(root, change),
            "sha": sha,
        })
        print(f"gatedloop: recorded merge of '{change}' -> {sha} in {_ledger_path(root, change)}")
        return 0
    if args.ledger_cmd == "record-ready":
        # merge-pull-request D4: readiness as a committed ledger fact, in the
        # existing row shape. A reader tells ready / halted / in progress
        # apart from the committed ledger alone.
        change = args.change
        head = _head_tree(root)
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": READY_EVENT, "exit": 0, "duration_ms": 0,
            "change": change, "task": None,
            "tree": _normalize_tree(root, head) if head else None,
            "attempt": None, "approved_by": _read_approved_by(root, change),
            "sha": _rev(root, "HEAD"),
        })
        print(
            f"gatedloop: recorded '{change}' as ready in {_ledger_path(root, change)} — "
            "commit that row on its own (ledger grade) before reporting READY TO MERGE"
        )
        return 0
    sys.exit(f"gatedloop: unknown ledger subcommand '{args.ledger_cmd}'")


# ---------- post-hoc reflog audit + ledger taint (enforce-at-the-effect D6/D7) --
#
# Layer 3 of the four-layer model: detection, not prevention. Layers 1–2 (the
# PreToolUse matcher and the git pre-commit hook) can be defeated by
# `--no-verify` or `env -u CLAUDECODE` — an unmistakable act of evasion. This
# layer makes even that visible: the `Stop` hook walks the change branch's new
# commits and joins each commit's tree to the ledger's green-`ci` rows. A commit
# whose tree has no green-`ci` row was committed without a recorded green gate,
# so it is reported loudly and recorded as a TAINT on the durable ledger, which
# blocks the merge (D7) until the head is re-verified.
#
# The join is exact (design D6): a legitimate task commit's tree equals
# `git write-tree` of the staged index at commit time, which is exactly the tree
# `gates run ci` recorded in its green ledger row (harden D2). So a gated commit
# always matches and an ungated one never does — no heuristic.
#
# Taint row ENCODING (design Open Question, settled here): a new `gate: "taint"`
# row kind, reusing the existing LEDGER_ROW_FIELDS shape unchanged rather than
# adding a dedicated field — the incident is `gate="taint", exit=1, tree=<offending
# tree>, sha=<offending commit>`; its resolution (§5) is `gate="taint-clear",
# exit=0`. Both survive the squash and satisfy the merge gate (the two constraints
# the design named), and reusing the fixed shape honors harden's "fix the row shape
# before writing rows" rule — no field is added that a later reader would have to
# reconstruct.
#
# gate-preconditions design D3 is the one row kind that DID need a wider shape
# (see LEDGER_ROW_FIELDS's own comment above): a failed `requires` writes
# `gate="<the gate/live-check that was NOT run>", exit=PRECONDITION_EXIT_CODE
# (75), outcome="precondition-failed", tree=None`. `exit` is non-zero by
# construction, so this row can never join `_maybe_resolve_taint`'s green-`ci`
# lookup — a precondition failure can neither taint nor clear one; it simply
# never reaches the taint-relevant code path (`cmd_run` returns before it).


def _read_ledger_rows(root: Path, change: str) -> list[dict]:
    p = _ledger_path(root, change)
    if not p.exists():
        return []
    rows: list[dict] = []
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except Exception:
            continue
    return rows


def _existing_taint_shas(rows: list[dict]) -> set[str]:
    return {r.get("sha") for r in rows if r.get("gate") == "taint" and r.get("sha")}


def _taint_unresolved(rows: list[dict]) -> bool:
    """Ordered scan: a `taint` row sets the change tainted, a `taint-clear` row
    clears it. The last of the two wins, so one green-`ci`-on-head resolution
    clears an outstanding incident regardless of how many preceded it (design
    D7: re-verifying the head clears the taint)."""
    tainted = False
    for r in rows:
        g = r.get("gate")
        if g == "taint":
            tainted = True
        elif g == "taint-clear":
            tainted = False
    return tainted


def _audit_cursor_path(root: Path, change: str) -> Path:
    # Per-worktree, ephemeral, under .git/ (like the Stop hook's continue-
    # counter) — never committed. Records the last-audited HEAD so a re-audit
    # walks only genuinely-new commits (task 4.2).
    return _git_dir(root) / NAME / "audit" / f"{change}.head"


def _is_ancestor(root: Path, a: str, b: str) -> bool:
    try:
        return subprocess.run(
            ["git", "merge-base", "--is-ancestor", a, b],
            cwd=root, capture_output=True,
        ).returncode == 0
    except Exception:
        return False


def _commit_tree(root: Path, sha: str) -> str | None:
    out = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", f"{sha}^{{tree}}"],
        cwd=root, capture_output=True, text=True,
    )
    return out.stdout.strip() or None if out.returncode == 0 else None


def _new_commits_to_audit(root: Path, change: str) -> tuple[list[str], str | None]:
    """Commits on the change branch new since the last audited point, oldest
    first, plus the current HEAD (the new cursor). Uses the cursor when it is
    still an ancestor of HEAD; otherwise the merge target bounds the walk to the
    change branch's own commits (`target..HEAD`). Either way, when a merge
    target resolves, its ancestry is always excluded from the walk (`base..HEAD
    --not target`, design D1): a commit already reachable from the merge target
    was gated by its own change before landing there, so it is exempt even when
    the cursor (not the target) supplied the range base — e.g. a fast-forward
    onto a moved `main` (issue #11). Only merge-target ancestry exempts a commit;
    a commit created locally without a green-`ci` row still taints regardless of
    which base was used. When no merge target resolves, the walk is exactly
    today's cursor-based range, unnarrowed — resolution failure must widen
    auditing, never skip it (design D3). Returns `([], head)` when there is
    nothing new or no range can be determined — the caller still advances the
    cursor."""
    head = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", "HEAD"],
        cwd=root, capture_output=True, text=True,
    ).stdout.strip()
    if not head:
        return [], None
    base: str | None = None
    cursor_path = _audit_cursor_path(root, change)
    if cursor_path.exists():
        cur = cursor_path.read_text().strip()
        if cur == head:
            return [], head
        if cur and _is_ancestor(root, cur, head):
            base = cur
    target, _reason = _resolve_merge_target(root)
    if base is None:
        if target:
            base = target
    if base is None:
        return [], head
    cmd = ["git", "rev-list", f"{base}..{head}"]
    if target:
        cmd += ["--not", target]
    out = subprocess.run(cmd, cwd=root, capture_output=True, text=True)
    if out.returncode != 0:
        return [], head
    shas = [s for s in out.stdout.splitlines() if s.strip()]
    shas.reverse()  # oldest first — stable, chronological reporting
    return shas, head


def _write_audit_cursor(root: Path, change: str, head: str) -> None:
    cp = _audit_cursor_path(root, change)
    cp.parent.mkdir(parents=True, exist_ok=True)
    cp.write_text(head)


def _append_taint_row(root: Path, change: str, sha: str, tree: str) -> None:
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": "taint", "exit": 1, "duration_ms": 0,
        "change": change, "task": None, "tree": tree, "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": sha,
    })


def cmd_audit(m: dict, root: Path, args) -> int:
    """The Stop-hook audit pass (design D6). Detection only — it cannot un-create
    a commit; its teeth are the taint that blocks the merge (D7). Exits non-zero
    when it records a NEW taint (fail-loud), 0 otherwise; the Stop hook ignores
    the code (the merge gate is the enforcement point)."""
    ref = getattr(args, "ref", None)
    if ref:
        # The merge gate's audit (escalation-outcomes D5): audit the change the
        # incoming ref names, where its branch lives, so a new taint lands in
        # the ledger `taint check --ref` reads. Bare, it resolved the current
        # branch -- the target during an integrating merge -- and audited
        # nothing. A ref naming no change keeps the current-branch behaviour;
        # a branch no worktree holds has no working ledger to write, and its
        # committed rows already reach the taint check (as in `gates merge`).
        change = _change_for_ref(root, ref)
        if change is not None:
            holder = _worktree_holding(root, ref.removeprefix("refs/heads/"))
            if holder is None:
                return 0
            return cmd_audit(m, holder, argparse.Namespace(change=change))
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        return 0  # not on a change branch — nothing to audit
    shas, head = _new_commits_to_audit(root, change)
    rows = _read_ledger_rows(root, change)
    matcher = _GreenCiMatcher(root, rows)
    # escalation-outcomes D5: a commit is classified once, whichever row
    # recorded it — the SHA dedupe spans taints, interventions and
    # disclosures alike.
    already = _existing_taint_shas(rows) | _existing_classified_shas(rows)
    new_incidents = 0
    for sha in shas:
        if sha in already:
            continue  # belt-and-suspenders; the cursor already prevents re-walking
        tree = _commit_tree(root, sha)
        if tree is None:
            continue
        matches = matcher.rows_for(tree)
        if matches:
            _classify_gated_commit(root, change, sha, tree, matches)
            already.add(sha)
            continue
        _append_taint_row(root, change, sha, tree)
        already.add(sha)
        new_incidents += 1
        print(
            f"gatedloop: AUDIT — commit {sha} (tree {tree}) on change '{change}' has no "
            "green-ci record: it slipped the commit hooks (e.g. --no-verify or a stripped "
            "CLAUDECODE). Tainting the ledger — the merge is blocked until `gates run ci` "
            "passes green on the branch head (issue #2).",
            file=sys.stderr,
        )
    if head:
        _write_audit_cursor(root, change, head)
    return 1 if new_incidents else 0


class _GreenCiMatcher:
    """The audit's join of a commit tree to the green-`ci` rows that vouch
    for it. A raw tree match is tried first (cheap, and exact for a commit
    that carries no ledger delta); on a miss, both sides are compared
    ledger-blind (`_normalize_tree`, the same `.gatedloop/runs/**` strip the
    `ci` marker uses — fix-marker-mechanics D1). The documented discipline
    commits a task's ledger row WITH the task (tdd-apply 5h), so that
    commit's tree differs from the tree `gates run ci` recorded by exactly
    the ledger; a raw-only join would taint every rule-following commit and
    could never classify a human-gated one (escalation-outcomes D5). The
    normalized side is computed lazily, once per audit, and only when some
    commit misses the raw join. Normalization is fail-safe strict: a
    plumbing failure returns the raw tree, which can only miss (taint), never
    match falsely."""

    def __init__(self, root: Path, rows: list[dict]):
        self._root = root
        self._by_raw: dict[str, list[dict]] = {}
        for r in rows:
            if r.get("gate") == "ci" and r.get("exit") == 0 and r.get("tree"):
                self._by_raw.setdefault(r["tree"], []).append(r)
        self._by_norm: dict[str, list[dict]] | None = None

    def rows_for(self, tree: str) -> list[dict]:
        hit = self._by_raw.get(tree)
        if hit:
            return hit
        if not self._by_raw:
            return []
        if self._by_norm is None:
            self._by_norm = {}
            for raw, rs in self._by_raw.items():
                self._by_norm.setdefault(_normalize_tree(self._root, raw), []).extend(rs)
        return self._by_norm.get(_normalize_tree(self._root, tree), [])


# escalation-outcomes D5 (the implementer's choice it leaves open): a commit
# whose matching green-`ci` rows carry no `session` value (written before the
# field existed) and none says `agent` is neither tainted nor classified. The
# audit appends one disclosure row for it, so `gates stats --outcomes` counts
# unclassifiable commits from ledger rows alone -- it stays a pure reader with
# no git join of its own.
UNCLASSIFIED_COMMIT_EVENT = "unclassified-commit"


def _existing_classified_shas(rows: list[dict]) -> set[str]:
    return {
        r.get("sha") for r in rows
        if r.get("sha") and (
            (r.get("gate") == INTERVENTION_EVENT and r.get("cause") == "human-commit")
            or r.get("gate") == UNCLASSIFIED_COMMIT_EVENT
        )
    }


def _classify_gated_commit(root: Path, change: str, sha: str, tree: str,
                           matches: list[dict]) -> None:
    """Design D5 part 2: any `agent` row -> nothing; every row `human` -> a
    `human-commit` intervention; otherwise (some row has no `session`, none
    `agent`) -> the disclosure row. Additive to tainting, never a substitute:
    only a commit that DID match a green row reaches here."""
    sessions = [r.get("session") for r in matches]
    if "agent" in sessions:
        return
    if all(s == "human" for s in sessions):
        event, cause = INTERVENTION_EVENT, "human-commit"
        line = (
            f"gatedloop: AUDIT — commit {sha} on change '{change}' was gated by a "
            "`gates run ci` run outside an agent session: recorded as a "
            "human-commit intervention."
        )
    else:
        event, cause = UNCLASSIFIED_COMMIT_EVENT, None
        line = (
            f"gatedloop: AUDIT — commit {sha} on change '{change}' was gated by ledger "
            "rows that carry no session value (written before the field existed): "
            "recorded as unclassifiable, neither agent nor human."
        )
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": event, "exit": None, "duration_ms": 0,
        "change": change, "task": None, "tree": tree, "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": sha,
        "cause": cause,
    })
    print(line, file=sys.stderr)


def _append_taint_clear_row(root: Path, change: str, sha: str | None, tree: str) -> None:
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": "taint-clear", "exit": 0, "duration_ms": 0,
        "change": change, "task": None, "tree": tree, "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": sha,
    })


def _maybe_resolve_taint(root: Path, change: str, tree: str) -> None:
    """A green `ci` on the branch head resolves an outstanding taint (design D7):
    the head is now individually verified even if a mid-branch commit was not.
    Appends a taint-clear row (append-only — the incident stays in history). A
    no-op when there is no unresolved taint, or the green `ci` was not on the head
    tree (only re-verifying the actual head clears the block)."""
    rows = _read_ledger_rows(root, change)
    if not _taint_unresolved(rows):
        return
    head_tree = _head_tree(root)
    if not head_tree or tree != head_tree:
        return
    head_sha = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True,
    ).stdout.strip() or None
    _append_taint_clear_row(root, change, head_sha, tree)
    print(
        f"gatedloop: taint cleared — a green ci on the branch head (tree {tree}) "
        f"re-verifies change '{change}'; the merge is no longer blocked on that basis.",
        file=sys.stderr,
    )


def _taint_refusal(change: str) -> str:
    return (
        f"gatedloop: change '{change}' carries an unresolved taint — the reflog audit "
        "found a commit with no green-ci record (it slipped the commit hooks, issue "
        "#2). Run `gates run ci` green on the branch head to re-verify and clear it "
        "before merging."
    )


def _worktree_holding(root: Path, branch: str) -> Path | None:
    """The worktree that has `branch` checked out, or `None`."""
    out = subprocess.run(
        ["git", "worktree", "list", "--porcelain"], cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    path = None
    for line in out.stdout.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line == f"branch refs/heads/{branch}" and path is not None:
            return Path(path)
    return None


def _marker_stores(root: Path, ref: str | None) -> list[Path]:
    """The worktrees whose marker stores may vouch for incoming `ref`
    (cross-worktree-evidence D1): `root` first, then the worktree holding
    `ref` when it is a local branch (`<branch>` or `refs/heads/<branch>`)
    checked out somewhere other than `root`. Any other ref -- a remote
    branch, a tag, a sha, a branch no worktree holds -- yields `[root]`.

    Reading the holder's store widens where evidence is found, not what
    counts: a marker is keyed on the normalized tree, so the holder's marker
    vouches for exactly the tree `ref` points at, and nothing else."""
    stores = [root]
    branch = (ref or "").removeprefix("refs/heads/")
    if not branch or branch.startswith("-") or branch.startswith("refs/"):
        return stores
    holder = _worktree_holding(root, branch)
    if holder is not None and holder.resolve() != root.resolve():
        stores.append(holder)
    return stores


def _change_for_ref(root: Path, ref: str) -> str | None:
    """The change an incoming ref names: a branch whose name is a change
    directory on that branch (branch name = change name). `None` otherwise."""
    name = ref.removeprefix("refs/heads/")
    if not name or "/" in name or name.startswith("-"):
        return None
    ok = subprocess.run(
        ["git", "cat-file", "-e", f"refs/heads/{name}:openspec/changes/{name}"],
        cwd=root, capture_output=True,
    ).returncode == 0
    return name if ok else None


def _change_ledger_rows(root: Path, change: str, ref: str) -> list[dict]:
    """The change's ledger as the incoming ref carries it (specloop PR 100: never the
    current branch's): the rows committed in `<ref>:.gatedloop/runs/<change>.jsonl`,
    then any not yet committed in the worktree that has the branch checked
    out -- the working file is the append-only continuation of the committed
    one, so a row in both is read once."""
    rows: list[dict] = []
    seen: set[str] = set()

    def take(more: list[dict]) -> None:
        for r in more:
            key = json.dumps(r, sort_keys=True)
            if key not in seen:
                seen.add(key)
                rows.append(r)

    for prefix in LEDGER_PREFIXES:
        blob = subprocess.run(
            ["git", "cat-file", "blob", f"{ref}:{prefix}/{change}.jsonl"],
            cwd=root, capture_output=True, text=True,
        )
        if blob.returncode == 0:
            take(_parse_jsonl_rows(blob.stdout))
            break
    holder = _worktree_holding(root, ref.removeprefix("refs/heads/"))
    if holder is not None:
        take(_read_ledger_rows(holder, change))
    return rows


def cmd_taint(m: dict, root: Path, args) -> int:
    """The merge gate's taint check (design D7), exposed as its own oracle so
    `hooks/gate-merge.sh` can read an exit code. Exit 1 (blocking, fail-loud)
    when the change carries an unresolved taint; 0 otherwise.

    With `--ref`, the change and its ledger come from the incoming ref
    (merge-step, specloop PR 100): during a merge the current branch is the target,
    which names no change, so the check never fired there. A ref that names
    no change falls back to the current branch, as before."""
    if args.taint_cmd != "check":
        sys.exit(f"gatedloop: unknown taint subcommand '{args.taint_cmd}'")
    ref = getattr(args, "ref", None)
    given = getattr(args, "change", None)
    if ref:
        change = _resolve_change_name(root, given) if given else _change_for_ref(root, ref)
        if change is not None:
            if _taint_unresolved(_change_ledger_rows(root, change, ref)):
                print(_taint_refusal(change), file=sys.stderr)
                return 1
            return 0
    change = _resolve_change_name(root, given)
    if change is None:
        return 0
    if _taint_unresolved(_read_ledger_rows(root, change)):
        print(_taint_refusal(change), file=sys.stderr)
        return 1
    return 0


# ---------- convention review (baseline finding 0.3) ---------------------
#
# The 2026-08-17 unattended run reported every commit as "convention-clean"
# and left nothing behind that could confirm or refute it: convention review
# is a subagent call, so the ledger — which sees every `gates run` — never
# saw it. Finding 0.3's remedy is deliberately the smallest one that makes
# the claim falsifiable: record the invocation where gate satisfaction is
# already recorded, using the row shape and the marker that already exist.
#
# What this does NOT do, explicitly (finding 0.1's rule: do not enforce
# silently either way): it adds no third `PreToolUse` denial. Design D1
# gates the commit on `ci` and the merge on `live-check`, both backed by an
# executable oracle. A review verdict is an LLM judgement, so blocking a
# commit on a self-recorded verdict would enforce only that a command was
# typed. What IS gained is an artifact: a review row pinned to the exact
# tree it judged, so a clean claim covering an unreviewed tree can be
# refuted after the fact by joining rows to commits — and a task with no
# review row at all is now visible instead of invisible.
#
# A `clean` verdict additionally writes a `review` marker on the reviewed
# tree, so `gates gate-marker check review <tree>` answers "is the review
# I am about to rely on still about this tree?" with the same
# self-invalidating hash compare `ci` uses. `findings` writes no marker:
# nothing that is not clean may be readable as satisfied.

REVIEW_VERDICTS = ("clean", "findings")
REVIEW_SCOPES = ("authored",)

# escalation-outcomes D1: the one closed set of escalation causes. Every
# writer (`gates halt record`) and reader (`gates stats --outcomes`) resolves
# a cause against this tuple; extending it is a spec change to the
# escalation-record capability, never a prompt-only edit. `other` exists so an
# honest agent is never forced to mislabel -- at the price of explaining
# (`--detail` is required for it).
HALT_CAUSES = (
    "missing-oracle", "weak-spec", "oracle-conflict", "stalled",
    # token-ledger D5: the change's token budget was reached.
    "environment", "budget", "other",
)


def cmd_review(m: dict, root: Path, args) -> int:
    if args.review_cmd != "record":
        sys.exit(f"gatedloop: unknown review subcommand '{args.review_cmd}'")

    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print(
            "gatedloop: no change to key a review row on — a review is recorded "
            "against (change, task), and the loop runs on a change branch. Pass "
            "`--change <name>` if you are recording from elsewhere.",
            file=sys.stderr,
        )
        return 1

    tree = _write_tree(root)
    if tree is None:
        print(
            "gatedloop: could not compute the reviewed tree (git write-tree failed) — "
            "refusing to record a review that names no tree.",
            file=sys.stderr,
        )
        return 1

    clean = args.verdict == "clean"
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": "review", "exit": 0 if clean else 1,
        "duration_ms": None, "change": change, "task": getattr(args, "task", None),
        "tree": tree, "attempt": getattr(args, "attempt", None) or 1,
        "approved_by": _read_approved_by(root, change), "sha": None,
        # split-test-author D7: `authored` marks the review over a change's
        # whole authored test set; `None` is a per-task review, as before.
        "scope": getattr(args, "scope", None),
    })
    if clean:
        _write_marker(root, "review", tree)
    where = f" for task {args.task}" if getattr(args, "task", None) else ""
    print(
        f"gatedloop: recorded convention review ({args.verdict}){where} on tree "
        f"{tree} in {_ledger_path(root, change)}"
    )
    return 0


# ---------- escalation record (escalation-outcomes D1, D2, D4) -------------
#
# A halt's reason used to be free text in the implementer's final report, and
# a human turn left no trace at all. Both become ledger EVENTS here, written
# by this shim only, each carrying a `cause` from a closed vocabulary so the
# outcomes view (`gates stats --outcomes`) groups categories, never strings.
# A refusal writes nothing and exits non-zero naming the accepted set
# (fail-loud-gates): a cause the reader cannot bucket is worse than no row.

HALT_EVENT = "halt"
INTERVENTION_EVENT = "intervention"
INTERVENTION_KINDS = ("ask", "human-commit")


def _escalation_refusal(event: str, cause: str | None, accepted: tuple,
                        detail: str | None, detail_required: tuple) -> str | None:
    """The one validation both writers share: `None` when `cause` is in
    `accepted` and carries detail where `detail_required` demands it, else the
    refusal message naming what was given and what is accepted."""
    if cause not in accepted:
        return (
            f"gatedloop: refusing to record a {event} with {_escalation_noun(event)} "
            f"'{cause}' — it is not in the closed set. Accepted: "
            f"{', '.join(accepted)}. Nothing was written."
        )
    if cause in detail_required and not (detail and detail.strip()):
        return (
            f"gatedloop: refusing to record a {event} with {_escalation_noun(event)} "
            f"'{cause}' and no detail — '{cause}' requires `--detail <text>` "
            "saying what happened, so the record is never a mislabel. Nothing "
            "was written."
        )
    return None


def _escalation_noun(event: str) -> str:
    return "cause" if event == HALT_EVENT else "kind"


def _append_escalation_row(root: Path, args, event: str, cause: str,
                           detail: str | None, tree: str | None,
                           sha: str | None = None, extra: dict | None = None) -> int:
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print(
            f"gatedloop: no change to key a {event} row on — the merge target "
            "(or no branch) is checked out. A halt or intervention is recorded "
            "against (change, task); run it on the change branch or pass "
            "`--change <name>`. Nothing was written.",
            file=sys.stderr,
        )
        return 1
    try:
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": event, "exit": None, "duration_ms": 0,
            "change": change, "task": getattr(args, "task", None), "tree": tree,
            "attempt": None, "approved_by": _read_approved_by(root, change),
            "sha": sha, "cause": cause, "detail": detail, **(extra or {}),
        })
    except OSError as e:
        print(
            f"gatedloop: could not append the {event} row to "
            f"{_ledger_path(root, change)}: {e}",
            file=sys.stderr,
        )
        return 1
    where = f" at task {args.task}" if getattr(args, "task", None) else ""
    print(
        f"gatedloop: recorded {event} ({cause}){where} on change '{change}' in "
        f"{_ledger_path(root, change)}"
    )
    return 0


def _outstanding_halt(rows: list[dict]) -> dict | None:
    """The latest `halt` row when it is newer than the latest `task-start`
    row, else `None` (design D3). Ordered by position in the append-only
    file, never by `ts`, so the answer never depends on clock monotonicity.
    `gates task start` already appends a `task-start` row at every task's
    beginning, so resuming lifts a halt with no new command."""
    for r in reversed(rows):
        g = r.get("gate")
        if g == TASK_BASELINE_EVENT:
            return None
        if g == HALT_EVENT:
            return r
    return None


def cmd_halt(m: dict, root: Path, args) -> int:
    """`gates halt record <cause> --task <N.M> [--detail]` (design D2). The
    row records the head tree, not the staged one: a halt happens at a clean
    task boundary (tdd-implementer §3), and the head is that boundary."""
    if args.halt_cmd != "record":
        sys.exit(f"gatedloop: unknown halt subcommand '{args.halt_cmd}'")
    detail = getattr(args, "detail", None)
    refusal = _escalation_refusal(HALT_EVENT, args.cause, HALT_CAUSES, detail, ("other",))
    if refusal:
        print(refusal, file=sys.stderr)
        return 1
    extra = None
    if args.cause == "stalled":
        # retry-budget D4: computed here, never supplied by the caller, so a
        # dispatcher can trust it when deciding on a fresh restart.
        change = _resolve_change_name(root, getattr(args, "change", None))
        rows = _read_ledger_rows(root, change) if change else []
        _attempts, limit = loop_budget(m)
        task = getattr(args, "task", None)
        extra = {"restart_available": restarts_used(rows, task) < limit}
    return _append_escalation_row(
        root, args, HALT_EVENT, args.cause, detail, _head_tree(root), extra=extra,
    )


def cmd_intervention(m: dict, root: Path, args) -> int:
    """`gates intervention record <kind> [--task] [--detail]` (design D4): the
    hand-written form of the row `hooks/record-ask.sh` writes, for a pause that
    did not go through the question tool. Self-reporting is acceptable here in
    a way it is not for approval: an intervention row can only make a run look
    less autonomous, never more."""
    if args.intervention_cmd != "record":
        sys.exit(f"gatedloop: unknown intervention subcommand '{args.intervention_cmd}'")
    detail = getattr(args, "detail", None)
    refusal = _escalation_refusal(
        INTERVENTION_EVENT, args.kind, INTERVENTION_KINDS, detail, (),
    )
    if refusal:
        print(refusal, file=sys.stderr)
        return 1
    return _append_escalation_row(
        root, args, INTERVENTION_EVENT, args.kind, detail, _head_tree(root),
    )


# ---------- per-task tree baseline (baseline finding 0.4) ----------------
#
# The most serious finding of the 2026-08-17 unattended run: it reported
# that "a background watcher/orchestrator in this environment is actively
# editing files" and disowned three uncommitted changes. No such watcher
# existed — the edits were its own, and they were correct. An agent that
# cannot tell its own writes from another party's will also mis-reason
# about what is safe to commit, revert, or overwrite.
#
# The remedy the finding names is to record the tree hash at task start, so
# "did I change this file?" is answerable from data instead of memory. It
# needs no new store: the ledger row already carries a `tree`, is already
# keyed on `(change, task)`, and is already written only by this shim, so
# the baseline is one more EVENT on it — `task-start` — and
# `gates task changed` reads it back as a set of paths.
#
# Two properties make the answer trustworthy rather than merely available:
#
#   * **Untracked files are included.** The disowned edits were
#     uncommitted; `git diff <tree>` alone never names an untracked file,
#     so an answer built only on it would have *confirmed* the run's wrong
#     conclusion.
#   * **A missing baseline is refused, never rendered as "nothing
#     changed."** With no `task-start` row the question is unanswerable,
#     and an empty answer would recreate the finding exactly.
#
# `.gatedloop/` is excluded from the answer on purpose: it is this shim's own
# bookkeeping, written as a side effect of asking the question. Reporting it
# back as the agent's edit would be a misattribution of the very kind this
# is here to prevent.

TASK_BASELINE_EVENT = "task-start"
_BASELINE_EXCLUDED_PREFIX = STATE_PREFIXES


def _latest_task_start(rows: list[dict], task: str | None) -> dict | None:
    """The most recent usable `task-start` row, optionally for one task. Last
    write wins: a task restarted after a commit is measured from the restart,
    not from the first attempt."""
    for r in reversed(rows):
        if r.get("gate") != TASK_BASELINE_EVENT or not r.get("tree"):
            continue
        if task is not None and r.get("task") != task:
            continue
        return r
    return None


def _changed_since_tree(root: Path, tree: str) -> list[str] | None:
    """Every path that differs from `tree` right now — tracked edits whether
    staged or not, plus untracked files (marked `?`). `None` when git could
    not answer, which is refused rather than reported as an empty set."""
    diff = subprocess.run(
        ["git", "diff", "--name-status", tree],
        cwd=root, capture_output=True, text=True,
    )
    if diff.returncode != 0:
        return None
    others = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"],
        cwd=root, capture_output=True, text=True,
    )
    if others.returncode != 0:
        return None

    lines = [ln for ln in diff.stdout.splitlines() if ln.strip()]
    lines += [f"?\t{p}" for p in others.stdout.splitlines() if p.strip()]
    lines = [ln for ln in lines
             if not ln.split("\t")[-1].startswith(_BASELINE_EXCLUDED_PREFIX)]
    return sorted(lines, key=lambda ln: ln.split("\t")[-1])


def cmd_task(m: dict, root: Path, args) -> int:
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print(
            "gatedloop: no change to key a task baseline on — a baseline is "
            "recorded against (change, task), and the loop runs on a change "
            "branch. Pass `--change <name>` if you are recording from elsewhere.",
            file=sys.stderr,
        )
        return 1

    if args.task_cmd == "start":
        tree = _write_tree(root)
        if tree is None:
            print(
                "gatedloop: could not compute the task-start tree (git write-tree "
                "failed) — refusing to record a baseline that names no tree.",
                file=sys.stderr,
            )
            return 1
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": TASK_BASELINE_EVENT, "exit": 0,
            "duration_ms": None, "change": change, "task": args.task,
            "tree": tree, "attempt": getattr(args, "attempt", None) or 1,
            "approved_by": _read_approved_by(root, change), "sha": None,
        })
        print(
            f"gatedloop: recorded the task-start tree for task {args.task} — {tree} "
            f"in {_ledger_path(root, change)}. `gates task changed` now answers "
            "\"did I change this?\" against it."
        )
        return 0

    if args.task_cmd == "changed":
        task = getattr(args, "task", None)
        base = _latest_task_start(_read_ledger_rows(root, change), task)
        if base is None:
            where = f" for task {task}" if task else ""
            print(
                f"gatedloop: no task-start baseline recorded{where} on change "
                f"'{change}' — \"did I change this?\" is unanswerable from data "
                "here, and recollection is not a substitute (baseline finding "
                "0.4). Run `gates task start <N.M>` when a task begins.",
                file=sys.stderr,
            )
            return 1
        paths = _changed_since_tree(root, base["tree"])
        if paths is None:
            print(
                f"gatedloop: git could not diff the recorded baseline tree "
                f"{base['tree']} — refusing to report an empty answer.",
                file=sys.stderr,
            )
            return 1
        for line in paths:
            print(line)
        return 0

    sys.exit(f"gatedloop: unknown task subcommand '{args.task_cmd}'")


# ---------- authored tests (split-test-author D3, D4, D5) ------------------
#
# A test author writes every task's failing tests before implementation
# begins, into a holding area no test runner discovers:
#
#     .gatedloop/authored/<change>/<N.M>/<real path>.authored
#     .gatedloop/authored/<change>/<N.M>/NO-TESTS      (reason text)
#
# `handoff` records their blobs in the ledger, `place` moves one task's tests
# onto their real paths, and `check` (run by both commit hooks) refuses a
# commit that edits a placed or held test, or that follows a placement with
# no failing `unit` run. The ledger rows are the record; the holding files
# are only the vehicle, and are gone once every task is placed.

AUTHORED_SUFFIX = ".authored"
NO_TESTS_FILE = "NO-TESTS"
# authored-test-kinds D1: beside a task's `*.authored` tests, its reason for
# declaring them characterization tests -- they must pass on the tree as it is.
CHARACTERIZATION_FILE = "CHARACTERIZATION"


def _authored_root(root: Path) -> Path:
    return _state_dir(root) / "authored"


def _authored_dir(root: Path, change: str) -> Path:
    return _authored_root(root) / change


def _holding_rel(root: Path, change: str, task: str, path: str) -> str:
    return _state_rel(root, "authored", change, task, f"{path}{AUTHORED_SUFFIX}")


def _no_tests_rel(root: Path, change: str, task: str) -> str:
    return _state_rel(root, "authored", change, task, NO_TESTS_FILE)


def _characterization_rel(root: Path, change: str, task: str) -> str:
    return _state_rel(root, "authored", change, task, CHARACTERIZATION_FILE)


def _hash_blob(root: Path, data: bytes) -> str | None:
    """The git blob id of `data`, written to the object store so the id the
    ledger keeps stays resolvable. `None` when git cannot answer."""
    out = subprocess.run(
        ["git", "hash-object", "-w", "--stdin"], cwd=root, input=data,
        capture_output=True,
    )
    if out.returncode != 0:
        return None
    return out.stdout.decode().strip() or None


def _file_blob(root: Path, rel: str) -> str | None:
    """The blob id of the working-tree file at `rel`, or `None` if absent."""
    p = root / rel
    if not p.is_file():
        return None
    return _hash_blob(root, p.read_bytes())


def _read_holding_area(root: Path, change: str) -> tuple[dict, dict, dict, list[str]]:
    """`({task: {path: abs holding file}}, {task: reason}, {task:
    characterization reason}, problems)` for the change's holding area as it
    is on disk. A problem is anything the lock could not enforce: a task
    holding both tests and `NO-TESTS`, a task declared both `CHARACTERIZATION`
    and `NO-TESTS`, a declaration with no tests to pin or no reason, a task
    holding nothing, or a file without the `.authored` suffix (a runner might
    discover it)."""
    base = _authored_dir(root, change)
    tests: dict[str, dict[str, Path]] = {}
    reasons: dict[str, str] = {}
    characterization: dict[str, str] = {}
    problems: list[str] = []
    if not base.is_dir():
        return tests, reasons, characterization, problems
    for task_dir in sorted(p for p in base.iterdir() if p.is_dir()):
        task = task_dir.name
        files: dict[str, Path] = {}
        reason = None
        declared = None
        for f in sorted(p for p in task_dir.rglob("*") if p.is_file()):
            rel = f.relative_to(task_dir).as_posix()
            if rel == NO_TESTS_FILE:
                reason = f.read_text().strip()
            elif rel == CHARACTERIZATION_FILE:
                declared = f.read_text().strip()
            elif rel.endswith(AUTHORED_SUFFIX):
                files[rel[: -len(AUTHORED_SUFFIX)]] = f
            else:
                problems.append(
                    f"task {task}: '{rel}' has no '{AUTHORED_SUFFIX}' suffix, so a "
                    "test runner could discover it — rename it to "
                    f"'{rel}{AUTHORED_SUFFIX}'"
                )
        if reason is not None and files:
            problems.append(
                f"task {task}: holds both tests and {NO_TESTS_FILE} — a task either "
                "changes behaviour (tests) or does not (a reason), never both"
            )
        elif reason is not None and not reason:
            problems.append(f"task {task}: {NO_TESTS_FILE} is empty — it must state the reason")
        elif reason is None and not files and declared is None:
            problems.append(f"task {task}: holds nothing")
        if declared is not None:
            if reason is not None:
                problems.append(
                    f"task {task}: declared both {CHARACTERIZATION_FILE} and "
                    f"{NO_TESTS_FILE} — a characterization task's tests pin "
                    "behaviour the tree has; a behaviour-free task has none"
                )
            elif not files:
                problems.append(
                    f"task {task}: {CHARACTERIZATION_FILE} declares tests that pin "
                    "current behaviour, but the task holds no tests"
                )
            if not declared:
                problems.append(
                    f"task {task}: {CHARACTERIZATION_FILE} is empty — it must state the reason"
                )
            characterization[task] = declared
        if reason is not None:
            reasons[task] = reason
        if files:
            tests[task] = files
    return tests, reasons, characterization, problems


def _authoring_state(rows: list[dict]) -> dict | None:
    """The effective handoff, folded over the ledger in file order: a full
    handoff replaces everything; a `--task` handoff replaces that one task's
    entry and adds `base` only for paths not yet known (a path's base is its
    content before the change touched it). `None` when no handoff exists.

    Returns `{"authors": [..], "tests": {task: {path: blob}}, "base": {path:
    blob|None}, "no_behaviour": {task: reason}, "characterization": {task:
    reason}}`."""
    state = None
    for r in rows:
        if r.get("gate") != TESTS_HANDOFF_EVENT:
            continue
        tests = r.get("tests") or {}
        no_behaviour = r.get("no_behaviour") or {}
        characterization = r.get("characterization") or {}
        base = r.get("base") or {}
        if state is None or not r.get("task"):
            authors = (state or {}).get("authors", [])
            state = {"authors": authors, "tests": {}, "base": {}, "no_behaviour": {},
                     "characterization": {}}
        task = r.get("task")
        if task:
            state["tests"].pop(task, None)
            state["no_behaviour"].pop(task, None)
            state["characterization"].pop(task, None)
        state["tests"].update(tests)
        state["no_behaviour"].update(no_behaviour)
        state["characterization"].update(characterization)
        for path, blob in base.items():
            state["base"].setdefault(path, blob)
        if r.get("author") and r.get("author") not in state["authors"]:
            state["authors"].append(r.get("author"))
    return state


def _tests_refuse(message: str) -> int:
    print(f"gatedloop: {message} Nothing was written.", file=sys.stderr)
    return 1


def _oracle_handoff_problems(m: dict, root: Path, change: str, held_tests: dict,
                             reasons: dict, characterization: dict,
                             only: str | None) -> list[str]:
    """task-oracle D3: each way the holding area contradicts a task's tag,
    and, under `loop.task-oracle: required`, the untagged tasks. Only
    contradictions: whether the tests exercise the declared gate is for the
    red run on that gate to show."""
    oracles = _change_task_oracles(root, change)
    problems: list[str] = _oracle_drift_problems(root, change, oracles, only)
    untagged: list[str] = []
    for task, oracle in oracles.items():
        if only is not None and task != only:
            continue
        if oracle is None:
            untagged.append(task)
            continue
        tag = f"[oracle: {_oracle_label(oracle)}]"
        gate = oracle["gate"]
        if gate is None:
            if task in held_tests or task in characterization:
                problems.append(
                    f"task {task} is tagged {tag}: the plan says it adds no tests, so "
                    f"hold only its {NO_TESTS_FILE} reason — no tests and no "
                    f"{CHARACTERIZATION_FILE}"
                )
            continue
        if task in reasons:
            problems.append(
                f"task {task} is tagged {tag}: the plan requires tests that `{gate}` "
                f"runs, not {NO_TESTS_FILE}"
            )
        elif oracle["characterization"] and task in held_tests and task not in characterization:
            problems.append(
                f"task {task} is tagged {tag}: the plan requires its "
                f"{CHARACTERIZATION_FILE} declaration, with its reason, beside its "
                f"tests — they must pass on their first `{gate}` run"
            )
        elif not oracle["characterization"] and task in characterization:
            problems.append(
                f"task {task} is tagged {tag}: the plan requires a red `{gate}` run "
                f"first, so it cannot be declared {CHARACTERIZATION_FILE}"
            )
    if untagged and _task_oracle_mode(m) == "required":
        problems.append(
            "loop.task-oracle is required, and these tasks declare no oracle: "
            f"{', '.join(untagged)}. End each task line with {ORACLE_TAG_SYNTAX}, "
            "and re-approve the plan"
        )
    return problems


def _tests_handoff(m: dict, root: Path, args) -> int:
    change = args.change
    only = getattr(args, "task", None)
    held_tests, reasons, characterization, problems = _read_holding_area(root, change)
    where = _authored_dir(root, change).relative_to(root).as_posix()
    if problems:
        return _tests_refuse(
            f"refusing the handoff for '{change}' — the holding area at {where}/ "
            "can't be locked as it is:\n  - " + "\n  - ".join(problems) + "\n"
        )
    if not held_tests and not reasons:
        return _tests_refuse(
            f"refusing the handoff for '{change}' — the holding area {where}/ is "
            "empty. The author writes each task's tests there as "
            f"<N.M>/<path>{AUTHORED_SUFFIX}, or <N.M>/{NO_TESTS_FILE} with the reason."
        )
    if only is not None:
        if only not in held_tests and only not in reasons:
            return _tests_refuse(
                f"refusing the handoff of task {only} for '{change}' — "
                f"{where}/{only}/ holds nothing."
            )
        held_tests = {only: held_tests[only]} if only in held_tests else {}
        reasons = {only: reasons[only]} if only in reasons else {}
        characterization = (
            {only: characterization[only]} if only in characterization else {}
        )

    contradictions = _oracle_handoff_problems(m, root, change, held_tests, reasons,
                                              characterization, only)
    if contradictions:
        return _tests_refuse(
            f"refusing the handoff for '{change}' — it contradicts the plan's oracle "
            "tags, which only an amended, re-approved plan changes:\n  - "
            + "\n  - ".join(contradictions) + "\n"
        )

    known_base = (_authoring_state(_read_ledger_rows(root, change)) or {}).get("base", {})
    tests: dict[str, dict[str, str]] = {}
    base: dict[str, str | None] = {}
    for task, files in held_tests.items():
        tests[task] = {}
        for path, f in files.items():
            blob = _hash_blob(root, f.read_bytes())
            if blob is None:
                return _tests_refuse(f"git could not hash {f} — refusing the handoff.")
            tests[task][path] = blob
            if only is not None and path in known_base:
                continue
            base[path] = _file_blob(root, path)

    author = "inline" if getattr(args, "inline", False) else "separate"
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": TESTS_HANDOFF_EVENT, "exit": 0, "duration_ms": 0,
        "change": change, "task": only, "tree": None, "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": None,
        "author": author, "tests": tests, "base": base, "no_behaviour": reasons,
        "characterization": characterization,
    })
    n_tests = sum(len(v) for v in tests.values())
    scope = f"task {only}" if only else f"{len(tests) + len(reasons)} task(s)"
    print(
        f"gatedloop: recorded the {author} handoff for '{change}' ({scope}): "
        f"{n_tests} test file(s), {len(reasons)} behaviour-free task(s), "
        f"{len(characterization)} characterization task(s) — in "
        f"{_ledger_path(root, change)}"
    )
    return 0


def _tests_change_or_refuse(root: Path, args, what: str) -> str | None:
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print(
            f"gatedloop: no change to {what} — authored tests are keyed on the "
            "change, and the loop runs on its branch. Pass `--change <name>` if "
            "you are running from elsewhere.",
            file=sys.stderr,
        )
    return change


def _placed_blobs_by_path(rows: list[dict]) -> dict[str, set]:
    """Every blob any `tests-placed` row put on each path."""
    out: dict[str, set] = {}
    for r in rows:
        if r.get("gate") != TESTS_PLACED_EVENT:
            continue
        for paths in (r.get("tests") or {}).values():
            for path, blob in paths.items():
                out.setdefault(path, set()).add(blob)
    return out


def _tests_place(m: dict, root: Path, args) -> int:
    change = _tests_change_or_refuse(root, args, "place tests for")
    if change is None:
        return 1
    task = args.task
    rows = _read_ledger_rows(root, change)
    state = _authoring_state(rows)
    if state is None:
        return _tests_refuse(
            f"no handoff recorded for '{change}' — there is nothing to place. "
            f"Dispatch the test author, then `gates tests handoff {change}`."
        )
    if task in state["no_behaviour"]:
        # The reason lives on in the handoff row; the file's job is done.
        with contextlib.suppress(OSError):
            (root / _no_tests_rel(root, change, task)).unlink()
        _prune_empty_dirs(_authored_dir(root, change) / task, stop=_authored_root(root))
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": TESTS_PLACED_EVENT, "exit": 0, "duration_ms": 0,
            "change": change, "task": task, "tree": None, "attempt": None,
            "approved_by": _read_approved_by(root, change), "sha": None,
            "tests": {task: {}},
        })
        print(
            f"gatedloop: task {task} changes no behaviour, per its author "
            f"(\"{state['no_behaviour'][task]}\") — nothing to place, and no red "
            "run is required."
        )
        return 0
    if task not in state["tests"]:
        return _tests_refuse(
            f"task {task} has no authored tests and no {NO_TESTS_FILE} reason in "
            f"the handoff for '{change}'. Only the author may cover a task — "
            f"re-dispatch it for {task}, then `gates tests handoff {change} --task {task}`."
        )

    wanted = state["tests"][task]
    placed_before = _placed_blobs_by_path(rows)
    problems: list[str] = []
    contents: dict[str, bytes] = {}
    for path, blob in wanted.items():
        held = root / _holding_rel(root, change, task, path)
        if not held.is_file():
            if _file_blob(root, path) == blob:
                continue  # already placed by an earlier, uncommitted run
            problems.append(f"{held.relative_to(root).as_posix()} is missing")
            continue
        data = held.read_bytes()
        if _hash_blob(root, data) != blob:
            problems.append(
                f"{held.relative_to(root).as_posix()} differs from the handoff — "
                f"it goes through `gates tests handoff {change} --task {task}` first"
            )
            continue
        current = _file_blob(root, path)
        allowed = {state["base"].get(path), blob} | placed_before.get(path, set())
        if current not in allowed:
            problems.append(
                f"{path} changed since authoring (it matches neither its content "
                "then nor any placed test) — that is a test defect for the author "
                f"(`gates tests defect {task} --kind setup|assertion --detail ...`), not an overwrite"
            )
            continue
        contents[path] = data
    if problems:
        return _tests_refuse(
            f"refusing to place task {task}'s tests:\n  - " + "\n  - ".join(problems) + "\n"
        )

    for path, data in contents.items():
        dest = root / path
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(data)
        (root / _holding_rel(root, change, task, path)).unlink()
    declared = state["characterization"].get(task)
    if declared is not None:
        # The reason lives on in the handoff row, as NO-TESTS's does.
        with contextlib.suppress(OSError):
            (root / _characterization_rel(root, change, task)).unlink()
    _prune_empty_dirs(_authored_dir(root, change) / task, stop=_authored_root(root))
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": TESTS_PLACED_EVENT, "exit": 0, "duration_ms": 0,
        "change": change, "task": task, "tree": None, "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": None,
        "tests": {task: dict(wanted)},
    })
    print(f"gatedloop: placed task {task}'s tests:")
    for path in wanted:
        print(f"  {path}")
    if declared is not None:
        print(
            f"gatedloop: task {task} is declared characterization (\"{declared}\") — "
            f"now run `gates run unit --task {task}`: it must pass on the tree as "
            "it is, before any implementation (a red run is a test defect: "
            f"`gates tests defect {task} --kind ...`). Stage the placed paths and the "
            "holding-area removal with the task's commit."
        )
        return 0
    print(
        f"gatedloop: now run `gates run unit --task {task}` — it must fail, for "
        "the reason the tests name, before any implementation. Stage the placed "
        "paths and the holding-area removal with the task's commit."
    )
    return 0


# unblock-authored-lock D2: whether a task was completed when a ledger row
# was written is ordered by commits, never read from one tree. A task is
# completed at row i when the commit that checks it in the change's
# `tasks.md` comes strictly before the first commit carrying row i. A tick
# staged with the row is in the same commit (or in none), so a halt in
# flight cannot be carried past its void by ticking the task with it.

_CHECKED_TASK_RE = re.compile(r"^\s*-\s*\[[xX]\]\s+(\d+(?:\.\d+)+)(?:\s|$)")


class _LedgerRewritten(Exception):
    """The change's ledger has fewer rows at a commit than at its first
    parent: rows are append-only, so no order can be read from it."""


def _blob_at(root: Path, commit: str, path: str) -> str | None:
    """`path`'s content at `commit`, or `None` when it has none there. The
    completion walk reads every blob through here -- two per commit."""
    out = subprocess.run(["git", "cat-file", "blob", f"{commit}:{path}"],
                         cwd=root, capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else None


def _checked_task_ids(text: str | None) -> set[str]:
    if not text:
        return set()
    return {mt.group(1) for mt in map(_CHECKED_TASK_RE.match, text.splitlines()) if mt}


class _Completion:
    """D2's two positions, computed once per evaluation: `tick_at[task]`, the
    walk index of the commit that checked the task, and `row_at[i]`, the walk
    index of the first commit carrying ledger row i. Index 0 is the
    merge-base, so a task checked there was not completed on this branch."""

    def __init__(self, tick_at: dict[str, int], row_at: list[int], checked_at_ref: set[str]):
        self.tick_at, self.row_at, self.checked_at_ref = tick_at, row_at, checked_at_ref

    def completed(self, task: str, row: int) -> bool:
        tick = self.tick_at.get(task)
        if tick is None:
            return False
        if row < len(self.row_at):
            return tick < self.row_at[row]
        # Not yet committed (or only in a lane's working tree): after the
        # last commit, so judged against the checked state there.
        return task in self.checked_at_ref


def _task_completion(root: Path, change: str, ref: str) -> _Completion:
    """Walk the change branch's first-parent commits from its merge-base with
    the merge target up to `ref`, reading two blobs per commit: the ledger's
    row count and the checked task ids. Raises `_LedgerRewritten`, naming the
    commit, where the ledger shrinks."""
    sha = _rev(root, ref)
    if sha is None:
        return _Completion({}, [], set())
    commits = [sha]
    target, _reason = _resolve_merge_target(root)
    if target:
        base = subprocess.run(["git", "merge-base", target, sha],
                              cwd=root, capture_output=True, text=True)
        if base.returncode == 0 and base.stdout.strip():
            walk = subprocess.run(
                ["git", "rev-list", "--first-parent", "--reverse", f"{base.stdout.strip()}..{sha}"],
                cwd=root, capture_output=True, text=True,
            )
            if walk.returncode == 0:
                commits = [base.stdout.strip()] + walk.stdout.split()
    ledger_rel = f"{LEDGER_PREFIXES[0]}/{change}.jsonl"
    tasks_rel = f"openspec/changes/{change}/tasks.md"
    tick_at: dict[str, int] = {}
    row_at: list[int] = []
    checked: set[str] = set()
    for k, commit in enumerate(commits):
        text = _blob_at(root, commit, ledger_rel)
        count = len(_parse_jsonl_rows(text)) if text else 0
        now = _checked_task_ids(_blob_at(root, commit, tasks_rel))
        if count < len(row_at):
            raise _LedgerRewritten(
                f"the ledger of '{change}' loses rows at {commit[:12]} ({len(row_at)} "
                f"before, {count} there) — rows are append-only, so the lock cannot order "
                "them against the task ticks; refusing rather than guessing"
            )
        row_at.extend([k] * (count - len(row_at)))
        if k > 0:
            for task in now - checked:
                tick_at.setdefault(task, k)
        checked = now
    return _Completion(tick_at, row_at, checked)


def _lock_completion(root: Path, change: str, rows: list[dict], ref: str) -> _Completion | None:
    """D2's completion for the lock at `ref`, walked only when a row could
    use it (a `halt` or `test-defect` naming a task); `None` otherwise.
    Raises `_LedgerRewritten` where the ledger shrinks."""
    if not any(r.get("task") and r.get("gate") in (HALT_EVENT, TEST_DEFECT_EVENT) for r in rows):
        return None
    return _task_completion(root, change, ref)


def _active_placements(rows: list[dict], completion: _Completion | None = None
                       ) -> dict[str, tuple[int, dict]]:
    """`{task: (row index, {path: blob})}` for each task's latest placement.
    A later `test-defect` row for the same task voids it: the task's tests go
    back to the author and are placed again before it is implemented. A later
    `halt` voids it only at a task not completed at that row (D3, with
    `completion` from D2): the restart that follows places again, while a
    halt at a finished task means "wait" and says nothing about its tests."""
    latest: dict[str, tuple[int, dict]] = {}
    for i, r in enumerate(rows):
        gate, task = r.get("gate"), r.get("task")
        if not task:
            continue
        if gate == TESTS_PLACED_EVENT:
            latest[task] = (i, dict((r.get("tests") or {}).get(task) or {}))
        elif gate == HALT_EVENT and completion is not None and completion.completed(task, i):
            continue
        elif gate in (TEST_DEFECT_EVENT, HALT_EVENT):
            latest.pop(task, None)
    return latest


def _reopened_tasks(rows: list[dict], completion: _Completion | None
                    ) -> dict[str, tuple[int, int, dict]]:
    """D4: `{task: (first placement row, voided placement row, {path: blob})}`
    for each task a `test-defect` reopened after it was completed. The defect
    voids the placement, but the voided content is committed code's test, so
    each path keeps it as the content it must hold until the re-handed-off
    tests are placed; and the red run recorded after the task's first
    placement stays the record for every later placement of it."""
    first: dict[str, int] = {}
    latest: dict[str, tuple[int, dict]] = {}
    reopened: dict[str, tuple[int, int, dict]] = {}
    for i, r in enumerate(rows):
        gate, task = r.get("gate"), r.get("task")
        if not task:
            continue
        if gate == TESTS_PLACED_EVENT:
            first.setdefault(task, i)
            latest[task] = (i, dict((r.get("tests") or {}).get(task) or {}))
            if task in reopened:
                reopened[task] = (first[task], i, {})
        elif gate in (TEST_DEFECT_EVENT, HALT_EVENT):
            placed = latest.pop(task, None)
            if (gate == TEST_DEFECT_EVENT and completion is not None
                    and task in first and completion.completed(task, i)):
                index, paths = placed if placed is not None else reopened.get(task, (0, 0, {}))[1:]
                reopened[task] = (first[task], index, paths)
    return reopened


def _staged_blobs(root: Path) -> dict[str, str] | None:
    """`{path: blob}` for every stage-0 index entry, or `None` if git could
    not list the index."""
    out = subprocess.run(["git", "ls-files", "-s", "-z"], cwd=root, capture_output=True)
    if out.returncode != 0:
        return None
    entries: dict[str, str] = {}
    for rec in out.stdout.split(b"\0"):
        meta, sep, path = rec.partition(b"\t")
        if not sep:
            continue
        parts = meta.split()
        if len(parts) == 3 and parts[2] == b"0":
            entries[path.decode()] = parts[1].decode()
    return entries


def _is_red_gate_row(r: dict, task: str, gate: str = "unit") -> bool:
    """A run of `gate` for `task` that failed for a reason other than a
    precondition (task-oracle D4: the task's oracle gate, `unit` untagged)."""
    exit_code = r.get("exit")
    return (
        r.get("gate") == gate and r.get("task") == task
        and isinstance(exit_code, int) and not isinstance(exit_code, bool)
        and exit_code not in (0, PRECONDITION_EXIT_CODE)
        and r.get("outcome") != "precondition-failed"
    )


def _gate_verdict_row(r: dict, task: str, gate: str = "unit") -> bool:
    """A run of `gate` for `task` that reached a verdict: a precondition
    failure (exit 75) never ran the tests, so it is neither green nor red."""
    exit_code = r.get("exit")
    return (
        r.get("gate") == gate and r.get("task") == task
        and isinstance(exit_code, int) and not isinstance(exit_code, bool)
        and exit_code != PRECONDITION_EXIT_CODE
        and r.get("outcome") != "precondition-failed"
    )


def _tag_text(oracle: dict | None) -> str:
    label = _oracle_label(oracle)
    return f"[oracle: {label}]" if label else "no tag"


def _oracle_drift_problems(root: Path, change: str, here: dict[str, dict | None],
                           only: str | None = None) -> list[str]:
    """task-oracle D9: each task whose tag in the evaluated tree (`here`)
    differs from its tag in the merge target's `tasks.md`. A task absent
    from the target -- or a change not on it, or no target -- is not
    compared: only an approved plan holds a tag."""
    target, _reason = _resolve_merge_target(root)
    if target is None:
        return []
    text = _blob_at(root, target, f"openspec/changes/{change}/tasks.md")
    if text is None:
        return []
    there = {tid: oracle for tid, _t, oracle in _task_lines_text(text)}
    problems = []
    for task, oracle in here.items():
        if only is not None and task != only:
            continue
        if task not in there or there[task] == oracle:
            continue
        problems.append(
            f"task {task}: its oracle tag here is {_tag_text(oracle)}, but the approved "
            f"plan on '{target}' tags it {_tag_text(there[task])} — a tag changes only "
            f"through the plan: amend tasks.md on '{target}' and re-attest the change"
        )
    return problems


def _oracles_in_tree(root: Path, change: str, blobs: dict[str, str]) -> dict[str, dict | None]:
    """`{task: oracle}` from the change's `tasks.md` as the evaluated tree
    holds it -- the staged index, or a commit (task-oracle D2), so a tag
    edited mid-branch is judged as of each commit."""
    blob = blobs.get(f"openspec/changes/{change}/tasks.md")
    text = _blob_text(root, blob) if blob else None
    return {tid: oracle for tid, _text, oracle in _task_lines_text(text or "")}


def _current_task_after_handoff(rows: list[dict]) -> str | None:
    """The task the loop is in: the latest `task-start` recorded after the
    latest full handoff. `None` during the authoring phase itself."""
    task = None
    for r in rows:
        if r.get("gate") == TESTS_HANDOFF_EVENT and not r.get("task"):
            task = None
        elif r.get("gate") == TASK_BASELINE_EVENT and r.get("task"):
            task = r.get("task")
    return task


def _tests_check_problems(root: Path, change: str, rows: list[dict], state: dict,
                          only: str | None) -> list[str] | None:
    """Design D4's three conditions against the staged index; `None` when
    git cannot answer (refused, never read as a pass)."""
    staged = _staged_blobs(root)
    if staged is None:
        return None
    return _lock_problems(root, change, rows, state, staged, only)


def _lock_problems(root: Path, change: str, rows: list[dict], state: dict,
                   staged: dict[str, str], only: str | None,
                   at: str | None = None) -> list[str]:
    """The lock's evaluator (test-lock-remote-check D1): its conditions over
    `staged`, a `{path: blob}` map, and the change's ledger `rows`. With
    `at` (a commit sha) the map is that commit's tree: the wording names the
    commit, and the in-flight condition does not apply (nothing is staged)."""
    try:
        completion = _lock_completion(root, change, rows, at or "HEAD")
    except _LedgerRewritten as rewritten:
        return [str(rewritten)]
    active = _active_placements(rows, completion)
    reopened = _reopened_tasks(rows, completion)
    problems: list[str] = []
    short = at[:12] if at else None

    # 1. Every placed path is staged with exactly its placed blob. A path
    #    whose placements are all void must be back at its authoring-time
    #    content, so a halt or defect cannot carry an edited test past it.
    expected: dict[str, tuple[str | None, str | None]] = {}
    for r in rows:
        if r.get("gate") != TESTS_PLACED_EVENT:
            continue
        for task, paths in (r.get("tests") or {}).items():
            for path in paths:
                expected.setdefault(path, (state["base"].get(path), None))
    # A path whose placement a defect at a completed task voided keeps that
    # content (D4) until the task is placed again, in row order with the
    # placements in force.
    in_force = [(i, task, paths) for task, (i, paths) in active.items()]
    in_force += [(i, task, paths) for task, (_first, i, paths) in reopened.items()
                 if task not in active]
    for _i, task, paths in sorted(in_force, key=lambda t: t[0]):
        for path, blob in paths.items():
            expected[path] = (blob, task)
    for path, (blob, task) in sorted(expected.items()):
        if only is not None and task not in (only, None):
            continue
        have = staged.get(path)
        if have == blob:
            continue
        if short is not None:
            if task is None:
                problems.append(
                    f"{path}: at {short} it differs from its content before this "
                    "change, and no placement of it is in force (a defect or halt "
                    "voided it) — an authored test changes only through its author"
                )
            elif have is None:
                problems.append(f"{path}: task {task}'s placed test is missing at {short}")
            else:
                problems.append(
                    f"{path}: at {short} it differs from the test placed for task "
                    f"{task} — an authored test changes only through `gates tests "
                    f"defect {task} --kind setup|assertion` and its author"
                )
            continue
        if task is None:
            problems.append(
                f"{path}: staged content differs from its content before this "
                "change, and no placement of it is in force — the implementer "
                "never edits an authored test; record `gates tests defect <N.M> "
                "--kind setup|assertion --detail ...` instead"
            )
        elif have is None or _file_blob(root, path) == blob:
            problems.append(
                f"{path}: task {task}'s placed test is not staged — `git add {path}`"
            )
        else:
            problems.append(
                f"{path}: staged content differs from the test placed for task "
                f"{task} — the implementer never edits an authored test. Restore "
                f"it and record `gates tests defect {task} --kind setup|assertion --detail \"<why it is "
                "wrong>\"` for the author instead"
            )

    # 2. Every unplaced task's holding files match the latest handoff, and
    #    nothing else is staged in the holding area.
    held_prefix = _state_rel(root, "authored", change) + "/"
    wanted_held: dict[str, str] = {}
    for task, paths in state["tests"].items():
        if task in active:
            continue
        for path, blob in paths.items():
            wanted_held[_holding_rel(root, change, task, path)] = blob
    reasons_held = {
        _no_tests_rel(root, change, task): reason
        for task, reason in state["no_behaviour"].items() if task not in active
    }
    declared_held = {
        _characterization_rel(root, change, task): reason
        for task, reason in state["characterization"].items() if task not in active
    }
    for rel, blob in sorted(wanted_held.items()):
        if staged.get(rel) != blob:
            task = rel[len(held_prefix):].split("/", 1)[0]
            problems.append(
                f"{rel}: the held test for task {task} differs from the handoff — "
                f"a held test changes only through `gates tests handoff {change} "
                f"--task {task}`"
            )
    for rel, reason in sorted(reasons_held.items()):
        blob = staged.get(rel)
        text = _blob_text(root, blob) if blob else None
        if text is None or text.strip() != reason:
            task = rel[len(held_prefix):].split("/", 1)[0]
            problems.append(
                f"{rel}: task {task}'s behaviour-free reason differs from the "
                f"handoff — it changes only through `gates tests handoff {change} "
                f"--task {task}`"
            )
    for rel, reason in sorted(declared_held.items()):
        blob = staged.get(rel)
        text = _blob_text(root, blob) if blob else None
        if text is None or text.strip() != reason:
            task = rel[len(held_prefix):].split("/", 1)[0]
            problems.append(
                f"{rel}: task {task}'s characterization declaration differs from "
                f"the handoff — only the author declares it, through `gates tests "
                f"handoff {change} --task {task}`"
            )
    for rel in sorted(staged):
        if (rel.startswith(held_prefix) and rel not in wanted_held
                and rel not in reasons_held and rel not in declared_held):
            task = rel[len(held_prefix):].split("/", 1)[0]
            removal = ("stage the holding file's removal" if short is None
                       else f"its holding file is still in {short}")
            why = ("task " + task + " is placed — " + removal
                   if task in active else "it is not in the handoff")
            problems.append(f"{rel}: {why}")

    # 3. For a placed task with tests, a run of its oracle gate recorded
    #    after the placement failed for a reason other than a precondition --
    #    or, for a task declared characterization (authored-test-kinds D2),
    #    the first such run passed: its tests must be seen to pin the tree as
    #    it was. The oracle gate is the plan's tag, read from the evaluated
    #    tree, or `unit` for an untagged task (task-oracle D4).
    oracles = _oracles_in_tree(root, change, staged)
    problems.extend(_oracle_drift_problems(root, change, oracles, only))
    for task, (index, paths) in sorted(active.items()):
        if only is not None and task != only:
            continue
        if not paths:
            continue
        oracle = oracles.get(task)
        gate = (oracle or {}).get("gate") or "unit"
        if task in state["characterization"] or (oracle or {}).get("characterization"):
            first = next((r for r in rows[index + 1:] if _gate_verdict_row(r, task, gate)), None)
            if first is None:
                problems.append(
                    f"task {task} is declared characterization: no passing `{gate}` "
                    "run is recorded after its tests were placed — its tests must "
                    "pass on the tree as it is, before any implementation. Run "
                    f"`gates run {gate} --task {task}` (a precondition failure, exit "
                    "75, is not a run)"
                )
            elif first.get("exit") != 0:
                problems.append(
                    f"task {task} is declared characterization, but its first "
                    f"`{gate}` run after placement was red (exit {first.get('exit')}) "
                    "— its tests do not describe the tree as it is. That is a test "
                    "defect: discard the task's work and record "
                    f"`gates tests defect {task} --kind setup|assertion --detail ...` for the author"
                )
            continue
        # D4: a task reopened after completion keeps the red run its first
        # placement recorded; none can exist against its committed code.
        since = reopened[task][0] if task in reopened else index
        if not any(_is_red_gate_row(r, task, gate) for r in rows[since + 1:]):
            problems.append(
                f"task {task}: no failing `{gate}` run is recorded after its tests "
                f"were placed — red before green is required. Run `gates run {gate} "
                f"--task {task}` and read why it fails before implementing (a "
                "precondition failure, exit 75, is not a red run; placed tests "
                f"that pass are a defect: `gates tests defect {task} --kind green --detail ...`)"
            )

    # 3, the other half: the task in flight has its tests placed before any
    # implementation is committed for it. At a commit nothing is staged and
    # nothing is in flight (D1).
    if short is not None:
        return problems
    current = only or _current_task_after_handoff(rows)
    staged_paths = _staged_diff_paths(root)
    implementing = staged_paths is None or any(
        not p.startswith(STATE_PREFIXES) for p in staged_paths
    )
    if current and implementing and current not in active:
        if current in state["tests"]:
            gate = (oracles.get(current) or {}).get("gate") or "unit"
            problems.append(
                f"task {current}: its authored tests are not placed — run "
                f"`gates tests place {current}` and a red `gates run {gate} --task "
                f"{current}` before implementing it"
            )
        elif current not in state["no_behaviour"]:
            problems.append(
                f"task {current}: the handoff has neither tests nor a "
                f"{NO_TESTS_FILE} reason for it, and only the author may cover a "
                f"task — re-dispatch the author, then `gates tests handoff "
                f"{change} --task {current}`"
            )
    return problems


def _blob_text(root: Path, blob: str) -> str | None:
    out = subprocess.run(["git", "cat-file", "blob", blob], cwd=root, capture_output=True)
    if out.returncode != 0:
        return None
    return out.stdout.decode(errors="replace")


def _tree_blobs(root: Path, commit: str) -> dict[str, str] | None:
    """`{path: blob}` for every file in `commit`'s tree, or `None` if git
    could not list it."""
    out = subprocess.run(["git", "ls-tree", "-r", "-z", commit], cwd=root, capture_output=True)
    if out.returncode != 0:
        return None
    entries: dict[str, str] = {}
    for rec in out.stdout.split(b"\0"):
        meta, sep, path = rec.partition(b"\t")
        parts = meta.split()
        if sep and len(parts) == 3 and parts[1] == b"blob":
            entries[path.decode()] = parts[2].decode()
    return entries


class _LockAtCommit:
    """The lock evaluated at one commit (test-lock-remote-check D1/D2):
    `handoff` False means no authored tests to verify; `problems` empty
    means it holds; `placed` and `held` are the tasks it verified."""

    def __init__(self, change: str, sha: str, handoff: bool, problems: list[str],
                 placed: list[str], held: list[str]):
        self.change, self.sha, self.handoff = change, sha, handoff
        self.problems, self.placed, self.held = problems, placed, held

    def summary(self) -> str:
        if not self.handoff:
            return (f"gatedloop: tests check — no authored tests for '{self.change}' at "
                    f"{self.sha[:12]}, nothing to verify")
        held = f"; held as handed off: {', '.join(self.held)}" if self.held else ""
        return (f"gatedloop: authored tests check passed for '{self.change}' at "
                f"{self.sha[:12]} — verified placed task(s): "
                f"{', '.join(self.placed) or 'none'}{held}")

    def refusal(self) -> str:
        return (f"gatedloop: authored tests check failed for '{self.change}' at "
                f"{self.sha[:12]}:\n  - " + "\n  - ".join(self.problems))


def _lock_at_commit(root: Path, change: str, ref: str) -> _LockAtCommit:
    """The lock's conditions against `ref`'s tree and the change's ledger as
    `ref` carries it (plus the uncommitted rows of a worktree holding `ref`,
    when it is a branch -- `_change_ledger_rows`). Raises `_ForgeRefusal`
    when git cannot answer: refused, never read as a pass."""
    sha = _rev(root, ref)
    if sha is None:
        raise _ForgeRefusal(f"gatedloop: tests check — '{ref}' is not a commit in this repository.")
    rows = _change_ledger_rows(root, change, ref)
    state = _authoring_state(rows)
    if state is None:
        return _LockAtCommit(change, sha, False, [], [], [])
    blobs = _tree_blobs(root, sha)
    if blobs is None:
        raise _ForgeRefusal(
            f"gatedloop: tests check could not list the tree of {sha[:12]} — refusing "
            "rather than reporting a pass."
        )
    problems = _lock_problems(root, change, rows, state, blobs, None, at=sha)
    try:
        active = _active_placements(rows, _lock_completion(root, change, rows, sha))
    except _LedgerRewritten:
        active = _active_placements(rows)  # the refusal is already in `problems`
    tasks = set(state["tests"]) | set(state["no_behaviour"]) | set(active)
    return _LockAtCommit(change, sha, True, problems, sorted(active),
                         sorted(t for t in tasks if t not in active))


def _tests_check_ref(root: Path, args) -> int:
    """`gates tests check --ref <commit> [--change]` (test-lock-remote-check D1)."""
    ref = args.ref
    if getattr(args, "task", None):
        print("gatedloop: tests check --ref checks every task of the change; it takes "
              "no --task.", file=sys.stderr)
        return 1
    change = getattr(args, "change", None)
    if change is None:
        branch = _current_branch(root) if ref == "HEAD" else ref
        change = _change_for_ref(root, branch) if branch else None
    if change is None:
        print(
            f"gatedloop: tests check — '{ref}' names no change branch, so there is no "
            "ledger to check it against. Pass `--change <name>`.",
            file=sys.stderr,
        )
        return 1
    change = _resolve_change_name(root, change)
    try:
        result = _lock_at_commit(root, change, ref)
    except _ForgeRefusal as refusal:
        print(refusal.message, file=sys.stderr)
        return 1
    if result.problems:
        print(result.refusal(), file=sys.stderr)
        return 1
    print(result.summary())
    return 0


def _tests_check(m: dict, root: Path, args) -> int:
    if getattr(args, "ref", None):
        return _tests_check_ref(root, args)
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print("gatedloop: tests check — no change branch checked out, nothing to check")
        return 0
    rows = _read_ledger_rows(root, change)
    state = _authoring_state(rows)
    if state is None:
        print(f"gatedloop: tests check — no handoff recorded for '{change}', nothing to check")
        return 0
    problems = _tests_check_problems(root, change, rows, state, getattr(args, "task", None))
    if problems is None:
        print(
            "gatedloop: tests check could not read the git index — refusing rather "
            "than reporting a pass.",
            file=sys.stderr,
        )
        return 1
    if problems:
        print(
            f"gatedloop: authored tests check failed for '{change}':\n  - "
            + "\n  - ".join(problems),
            file=sys.stderr,
        )
        return 1
    print(f"gatedloop: authored tests check passed for '{change}'")
    return 0


# authored-test-kinds D3: each kind has its own cap per task, and past it its
# own halt. `setup`: the test cannot run as written (path, import, fixture,
# environment). `assertion`: it runs and asserts the wrong behaviour.
# `green` (unblock-authored-lock D5): the placed tests passed before any
# implementation -- an observation, not a claim that they are wrong; the
# author re-declares the task or rewrites its tests, and a second one goes
# to a human.
TEST_DEFECT_KINDS = ("setup", "assertion", "green")
MAX_TEST_DEFECTS_BY_KIND = {"setup": 3, "assertion": 2, "green": 1}
TEST_DEFECT_HALT_CAUSE = {"setup": "weak-spec", "assertion": "oracle-conflict",
                          "green": "oracle-conflict"}


def test_defect_kind(row: dict) -> str:
    """Pure: a `test-defect` row's kind; a row from before kinds existed
    reads as `assertion`, the conservative reading (design D3)."""
    kind = row.get("kind")
    return kind if kind in TEST_DEFECT_KINDS else "assertion"


def _tests_defect(m: dict, root: Path, args) -> int:
    """`gates tests defect <N.M> --kind setup|assertion|green --detail` (design D5
    of `split-test-author`, D3 of `authored-test-kinds`): the implementer's
    only move against an authored test it judges wrong. Each kind is capped
    per task; past a cap the defect is refused and names the halt instead."""
    change = _tests_change_or_refuse(root, args, "record a test defect on")
    if change is None:
        return 1
    task, detail, kind = args.task, (args.detail or "").strip(), getattr(args, "kind", None)
    if kind not in TEST_DEFECT_KINDS:
        return _tests_refuse(
            f"refusing a test defect for task {task} with no --kind — say "
            "`--kind setup` (the test cannot run as written), `--kind "
            "assertion` (it asserts the wrong behaviour) or `--kind green` (it "
            "passed before any implementation); the kind decides which cap it "
            "spends."
        )
    if not detail:
        return _tests_refuse(
            f"refusing a test defect for task {task} with no detail — say why the "
            "test is wrong, so the author can revise or defend it."
        )
    rows = _read_ledger_rows(root, change)
    if _authoring_state(rows) is None:
        return _tests_refuse(
            f"no handoff recorded for '{change}' — there is no authored test to "
            "record a defect against."
        )
    earlier = [r for r in rows if r.get("gate") == TEST_DEFECT_EVENT
               and r.get("task") == task and test_defect_kind(r) == kind]
    cap = MAX_TEST_DEFECTS_BY_KIND[kind]
    if len(earlier) >= cap:
        prior = "; ".join(str(r.get("detail")) for r in earlier)
        cause = TEST_DEFECT_HALT_CAUSE[kind]
        if kind == "green":
            return _tests_refuse(
                f"refusing green test defect {cap + 1} for task {task} — its tests "
                f"were green before implementation again after the author's answer "
                f"({prior}). This goes to a human: `gates halt record {cause} --task "
                f"{task} --detail \"test-defect {task}: still green after re-handoff\"`."
            )
        if kind == "assertion":
            return _tests_refuse(
                f"refusing assertion test defect {cap + 1} for task {task} — "
                f"author and implementer have disagreed {len(earlier)} times "
                f"({prior}). This goes to a human: `gates halt record {cause} "
                f"--task {task} --detail \"test-defect {task}: <both positions>\"`."
            )
        return _tests_refuse(
            f"refusing setup test defect {cap + 1} for task {task} — the author "
            f"has handed off tests that cannot run {len(earlier)} times "
            f"({prior}), so its brief is missing something. Halt: `gates halt "
            f"record {cause} --task {task} --detail \"test-defect {task}: <what "
            "the tests could not run against>\"`."
        )
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": TEST_DEFECT_EVENT, "exit": None, "duration_ms": 0,
        "change": change, "task": task, "tree": _head_tree(root), "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": None,
        "detail": detail, "kind": kind,
    })
    print(
        f"gatedloop: recorded {kind} test defect {len(earlier) + 1} of "
        f"{cap} for task {task} on '{change}'. Stop at the "
        "task boundary with a clean tree; the author is re-dispatched for this "
        "task by whoever dispatched it."
    )
    return 0


def _tests_show_doc(m: dict, root: Path, change: str) -> dict:
    rows = _read_ledger_rows(root, change)
    state = _authoring_state(rows)
    try:
        active = _active_placements(rows, _lock_completion(root, change, rows, "HEAD"))
    except _LedgerRewritten:
        active = _active_placements(rows)
    # authored-test-kinds D3: each defect with its kind, so a mislabelled
    # one is visible; a kindless legacy row reads as `assertion`.
    defect_log: dict[str, list[dict]] = {}
    for r in rows:
        if r.get("gate") == TEST_DEFECT_EVENT and r.get("task"):
            defect_log.setdefault(r["task"], []).append(
                {"kind": test_defect_kind(r), "detail": r.get("detail")})
    tasks: dict[str, dict] = {}
    oracles = _change_task_oracles(root, change)
    if state is not None:
        for task in sorted(set(state["tests"]) | set(state["no_behaviour"]),
                           key=lambda t: [int(x) if x.isdigit() else x for x in t.split(".")]):
            log = defect_log.get(task, [])
            tasks[task] = {
                "oracle": _oracle_label(oracles.get(task)),
                "tests": sorted(state["tests"].get(task, {})),
                "no_behaviour": state["no_behaviour"].get(task),
                "characterization": state["characterization"].get(task),
                "placed": task in active,
                "defects": len(log),
                "defects_by_kind": {k: sum(1 for d in log if d["kind"] == k)
                                    for k in TEST_DEFECT_KINDS},
                "defect_log": log,
            }
    return {
        "change": change,
        "mode": _test_author_mode(m),
        "handoff": state is not None,
        "authors": state["authors"] if state is not None else [],
        "tasks": tasks,
    }


def _tests_show(m: dict, root: Path, args) -> int:
    change = args.change or _tests_change_or_refuse(root, args, "show")
    if change is None:
        return 1
    doc = _tests_show_doc(m, root, change)
    if getattr(args, "json", False):
        print(json.dumps(doc, sort_keys=True))
        return 0
    print(f"change: {change}   loop.test-author: {doc['mode']}")
    if not doc["handoff"]:
        print("no handoff recorded — the tests are not authored yet")
        return 0
    print(f"authored by: {', '.join(doc['authors'])}")
    for task, t in doc["tasks"].items():
        state = "placed" if t["placed"] else "held"
        extra = f", {t['defects']} defect(s)" if t["defects"] else ""
        oracle = f"oracle: {t['oracle'] or 'undeclared'}"
        if t["no_behaviour"] is not None:
            print(f"  {task}  {oracle}  no behaviour change — {t['no_behaviour']}{extra}")
        else:
            if t["characterization"] is not None:
                state += f", characterization — {t['characterization']}"
            print(f"  {task}  {oracle}  {state}{extra}")
            for path in t["tests"]:
                print(f"        {path}")
        for d in t["defect_log"]:
            print(f"        defect ({d['kind']}): {d['detail']}")
    return 0


# ---------- the author's brief (split-test-author D9) ----------------------
#
# The test author works from the project's own conventions, handed to it by
# the shim rather than left for it to discover. Everything here is printed,
# nothing decided: paths, rule-ids, the bound command (never run), and "none"
# lines where the project has nothing to offer.

_TASK_LINE_RE = re.compile(r"^\s*-\s*\[[ xX]\]\s+(\d+(?:\.\d+)+)\s+(.*)$")
_PATH_SPAN_RE = re.compile(r"`([^`\s<>]+)`")
_TEST_NAME_RE = re.compile(r"(^|[._-])(tests?|specs?)([._-]|$)", re.IGNORECASE)
_TEST_DIR_NAMES = frozenset({"test", "tests", "spec", "specs", "__tests__"})
_SHARED_NAME_RE = re.compile(r"conftest|fixtures?|helpers?|factor(y|ies)|support", re.IGNORECASE)
_BRIEF_MAX_SIBLINGS = 5


# task-oracle D1: a task line may end with its oracle -- `[oracle: <gate>]`,
# `[oracle: <gate> characterization]` or `[oracle: none]` -- as its last
# bracketed span. The gates below cannot judge one task: `ci` is green at
# every commit, `live-check` probes a surface, `eval` is an advisory score,
# and `confirm` runs only on the merged tree.
NON_ORACLE_GATES = ("ci", "live-check", "eval", "confirm")
ORACLE_TAG_SYNTAX = "[oracle: <gate>], [oracle: <gate> characterization] or [oracle: none]"
_ORACLE_TAG_RE = re.compile(r"\s*(\[\s*oracle\s*:([^\[\]]*)\])\s*$")
_ORACLE_GATE_NAME_RE = re.compile(r"^[A-Za-z0-9][\w.-]*$")


def _parse_oracle_body(body: str) -> dict | None:
    """The oracle a tag's body declares, or `None` when it is malformed."""
    words = body.split()
    if words == ["none"]:
        return {"gate": None, "characterization": False}
    if not words or len(words) > 2 or words[0] in ("none", "characterization"):
        return None
    if len(words) == 2 and words[1] != "characterization":
        return None
    if not _ORACLE_GATE_NAME_RE.match(words[0]):
        return None
    return {"gate": words[0], "characterization": len(words) == 2}


def _split_oracle_tag(text: str) -> tuple[str, dict | None, str | None]:
    """`(text without the tag, oracle, raw tag)` for one task's text (D1,
    D2). An untagged text is `(text, None, None)`; a malformed tag keeps its
    text whole and its oracle `None`, for `gates validate` to name."""
    text = text.strip()
    mt = _ORACLE_TAG_RE.search(text)
    if not mt:
        return text, None, None
    oracle = _parse_oracle_body(mt.group(2))
    if oracle is None:
        return text, None, mt.group(1)
    return text[: mt.start()].rstrip(), oracle, mt.group(1)


def _task_lines_text(text: str) -> list[tuple[str, str, dict | None]]:
    """`(id, text, oracle)` per task line of a `tasks.md`'s text (task-oracle
    D2): the one parser every consumer reads, with the tag stripped from the
    text. `oracle` is `None` untagged, `{"gate": None, ...}` for `none`."""
    out = []
    for line in text.splitlines():
        mt = _TASK_LINE_RE.match(line)
        if mt:
            body, oracle, _tag = _split_oracle_tag(mt.group(2))
            out.append((mt.group(1), body, oracle))
    return out


def _task_lines(tasks_md: Path) -> list[tuple[str, str, dict | None]]:
    if not tasks_md.is_file():
        return []
    return _task_lines_text(tasks_md.read_text())


def _oracle_label(oracle: dict | None) -> str | None:
    """A declared oracle as one word or two: `<gate>`, `<gate>
    characterization` or `none`; `None` for an untagged task."""
    if oracle is None:
        return None
    if oracle["gate"] is None:
        return "none"
    return oracle["gate"] + (" characterization" if oracle["characterization"] else "")


def _change_task_oracles(root: Path, change: str) -> dict[str, dict | None]:
    """`{task: oracle}` from the change's `tasks.md` in the working tree."""
    tasks_md = root / "openspec" / "changes" / change / "tasks.md"
    return {tid: oracle for tid, _text, oracle in _task_lines(tasks_md)}


def _oracle_brief_line(oracle: dict | None) -> str:
    """What the test author is told about one task's declared oracle (D3)."""
    if oracle is None:
        return ("undeclared — the author decides: red first on `unit`, "
                "CHARACTERIZATION or NO-TESTS")
    gate = oracle["gate"]
    if gate is None:
        return "none — the task needs no tests: write its NO-TESTS reason and nothing else"
    if oracle["characterization"]:
        return (f"characterization on `{gate}` — tests that pass on their first `{gate}` "
                "run, with a CHARACTERIZATION reason")
    return (f"`{gate}`, red first — tests that `{gate}` runs and that fail on their "
            "first run after placement")


_REPO_PATH_RE = re.compile(r"^[\w.\-]+(/[\w.\-*]+)+$")


def _named_paths(text: str, root: Path | None = None) -> list[str]:
    """Backticked spans that look like repository paths — relative, with at
    least one `/` — or, given `root`, that name an existing file. Planning
    prose names files this way."""
    out: list[str] = []
    for span in _PATH_SPAN_RE.findall(text):
        span = span.rstrip("/")
        if not span or span in out:
            continue
        if _REPO_PATH_RE.match(span) or (root is not None and (root / span).is_file()):
            out.append(span)
    return out


def _is_test_path(rel: str) -> bool:
    parts = rel.split("/")
    if any(p in _TEST_DIR_NAMES for p in parts[:-1]):
        return True
    return bool(_TEST_NAME_RE.search(parts[-1].rsplit(".", 1)[0]))


def _core_stem(name: str) -> str:
    stem = name.rsplit(".", 1)[0].lower()
    for affix in ("test_", "tests_", "spec_"):
        if stem.startswith(affix):
            stem = stem[len(affix):]
    for affix in ("_test", "_tests", "_spec", ".test", ".spec", "-test", "-spec"):
        if stem.endswith(affix):
            stem = stem[: -len(affix)]
    return stem.replace("-", "_")


def _sibling_tests(paths: list[str], test_files: list[str]) -> list[str]:
    """Up to five existing test paths near `paths`: a shared file stem first,
    then a shared directory. Paths only — the author reads no contents."""
    stems = {_core_stem(p.rsplit("/", 1)[-1]) for p in paths}
    dirs = {p.rsplit("/", 1)[0] if "/" in p else "" for p in paths}
    by_stem = [t for t in test_files if _core_stem(t.rsplit("/", 1)[-1]) in stems]
    by_dir = [t for t in test_files if (t.rsplit("/", 1)[0] if "/" in t else "") in dirs]
    out: list[str] = []
    for t in by_stem + by_dir:
        if t not in out:
            out.append(t)
    return out[:_BRIEF_MAX_SIBLINGS]


def _rule_sections_text(text: str) -> dict[str, str]:
    """`{rule_id: section text}` for every `### <id>` section."""
    out: dict[str, str] = {}
    current = None
    for line in text.splitlines():
        mt = _CONV_HEADING_RE.match(line)
        if mt:
            current = mt.group(1)
            out[current] = ""
        elif line.startswith("## "):
            current = None
        elif current is not None:
            out[current] += line + "\n"
    return out


def _tracked_files(root: Path) -> list[str]:
    out = subprocess.run(["git", "ls-files"], cwd=root, capture_output=True, text=True)
    if out.returncode != 0:
        return []
    return [p for p in out.stdout.splitlines()
            if p.strip() and not p.startswith(STATE_PREFIXES)]


def _render_tests_brief(m: dict, root: Path, change: str) -> str | None:
    change_dir = root / "openspec" / "changes" / change
    if not change_dir.is_dir():
        return None

    def rel(p: Path) -> str:
        return p.relative_to(root).as_posix()

    tasks_md = change_dir / "tasks.md"
    design_md = change_dir / "design.md"
    tasks = _task_lines(tasks_md)
    design_paths = _named_paths(design_md.read_text(), root) if design_md.is_file() else []
    tracked = _tracked_files(root)
    test_files = [p for p in tracked if _is_test_path(p)]
    lines: list[str] = [f"# Test author brief: {change}", ""]

    lines.append("## Artifacts")
    for p in [tasks_md, design_md]:
        if p.is_file():
            lines.append(f"- {rel(p)}")
    for p in sorted((change_dir / "specs").rglob("*.md")) if (change_dir / "specs").is_dir() else []:
        lines.append(f"- {rel(p)}")
    lines.append("Tasks:")
    for tid, text, _oracle in tasks:
        lines.append(f"  {tid} {text}")
    if not tasks:
        lines.append("  none — tasks.md lists no `- [ ] N.M` task lines")
    lines.append("")

    # task-oracle D3: the plan's declaration, so the author does not infer it.
    lines.append("## Declared oracles")
    for tid, _text, oracle in tasks:
        lines.append(f"{tid}: {_oracle_brief_line(oracle)}")
    if not tasks:
        lines.append("none — no tasks")
    lines.append("")

    conv = m.get("conventions") or {}
    rules_doc = conv.get("rules-doc")
    test_rule_ids = _project_test_rule_ids(m, root)
    lines.append("## Project test rules")
    capture = ("capture them with `/gatedloop:gates-init` step 6 (the test-conventions "
               "pass), as `Applies to: tests` rules")
    if test_rule_ids:
        for rid in test_rule_ids:
            lines.append(f"- {rid}")
        lines.append(f"These apply to every task, whatever its surfaces. Resolve "
                     f"against: {rules_doc}. A project rule outranks any built-in "
                     "item it contradicts.")
    elif rules_doc:
        lines.append(f"none — no rule in {rules_doc} is tagged `Applies to: tests`; {capture}")
    else:
        lines.append(f"none — no conventions.rules-doc is declared; {capture}")
    lines.append("")

    lines.append("## Surface rules per task")
    task_paths: dict[str, list[str]] = {}
    for tid, text, _oracle in tasks:
        paths = _named_paths(text, root)
        source = "task line"
        if not paths:
            paths, source = design_paths, "design.md"
        task_paths[tid] = paths
        ids: list[str] = []
        for s in hot_surfaces(m, paths) if paths else []:
            for r in s.get("rules") or []:
                if r not in ids:
                    ids.append(r)
        where = f" (paths from {source}: {', '.join(paths)})" if paths else " (no paths named)"
        lines.append(f"{tid}{where}: {', '.join(ids) if ids else 'none'}")
    if not tasks:
        lines.append("none — no tasks")
    lines.append("")

    lines.append("## Built-in rules")
    for r in BUILTIN_RULE_IDS:
        lines.append(f"- {r}")
    lines.append(f"Resolve against: {BUILTIN_RULES_FILE}")
    lines.append("")

    lines.append("## Runner")
    unit_run, unit_requires = _gate_spec((m.get("gates") or {}).get("unit"))
    if unit_run:
        lines.append(f"`unit` is bound to: {unit_run}")
        if unit_requires:
            lines.append(f"`unit` requires (precondition): {unit_requires}")
        lines.append("Printed, never run. Tests run only through `gates run unit`.")
    else:
        ci_run, _ = _gate_spec((m.get("gates") or {}).get("ci"))
        lines.append(f"none — no `unit` gate is declared (`ci` is bound to: {ci_run}). "
                     "Printed, never run.")
    lines.append("")

    lines.append("## Where tests live")
    sibling_dirs: list[str] = []
    for tid, _text, _oracle in tasks:
        near = _sibling_tests(task_paths.get(tid) or [], test_files)
        lines.append(f"{tid}: {', '.join(near) if near else 'none found near its paths'}")
        for t in near:
            d = t.rsplit("/", 1)[0] if "/" in t else ""
            if d not in sibling_dirs:
                sibling_dirs.append(d)
    if not tasks:
        lines.append("none — no tasks")
    lines.append("Paths only: follow their location and naming; do not read their contents.")
    lines.append("")

    lines.append("## Shared fixtures and helpers")
    shared: list[str] = []
    if rules_doc and test_rule_ids:
        try:
            sections = _rule_sections_text((root / rules_doc).read_text())
        except OSError:
            sections = {}
        for rid in test_rule_ids:
            for p in _named_paths(sections.get(rid, ""), root):
                if (root / p).exists() and p not in shared:
                    shared.append(p)
    source = "named by the project's test rules"
    if not shared:
        source = "found by name beside the tests above"
        for p in tracked:
            d = p.rsplit("/", 1)[0] if "/" in p else ""
            in_sibling = any(d == s or d.startswith(s + "/") for s in sibling_dirs if s)
            if in_sibling and _SHARED_NAME_RE.search(p[len(d):] if d else p) and p not in shared:
                shared.append(p)
    if shared:
        lines.append(f"({source}; you may read these)")
        for p in shared:
            lines.append(f"- {p}")
    else:
        lines.append("none — no test rule names shared fixtures or helpers, and none "
                     "were found beside the existing tests")
    return "\n".join(lines) + "\n"


def _tests_brief(m: dict, root: Path, args) -> int:
    text = _render_tests_brief(m, root, args.change)
    if text is None:
        print(
            f"gatedloop: no change '{args.change}' under openspec/changes/ — the "
            "brief is generated from a change's tasks, specs and design.",
            file=sys.stderr,
        )
        return 1
    sys.stdout.write(text)
    return 0


def _prune_empty_dirs(start: Path, stop: Path) -> None:
    """Remove `start` and its now-empty descendants and ancestors, up to and
    including `stop` — a fully placed change leaves no holding directory."""
    if start.is_dir():
        for d in sorted((p for p in start.rglob("*") if p.is_dir()),
                        key=lambda p: len(p.parts), reverse=True):
            with contextlib.suppress(OSError):
                d.rmdir()
    cur = start
    while True:
        with contextlib.suppress(OSError):
            cur.rmdir()
        if cur == stop or stop not in cur.parents:
            break
        cur = cur.parent


def cmd_tests(m: dict, root: Path, args) -> int:
    handlers = {
        "handoff": _tests_handoff,
        "place": _tests_place,
        "check": _tests_check,
        "defect": _tests_defect,
        "show": _tests_show,
        "brief": _tests_brief,
    }
    handler = handlers.get(args.tests_cmd)
    if handler is None:
        sys.exit(f"gatedloop: unknown tests subcommand '{args.tests_cmd}'")
    return handler(m, root, args)


# ---------- token accounting (token-ledger D1-D3) ---------------------------
#
# What the host session spent on a task, as counts in the durable ledger. The
# host writes per-message usage next to the session, and the plugin's hooks
# already receive that transcript's path, so the gap was a reader, not a
# source. A `usage` row stores counts only -- never a line of transcript text
# -- and names the reader that produced them (`source`). One reader exists, for
# the Claude Code transcript; a session with none records null counts and the
# reason, never a failure.

USAGE_EVENT = "usage"
USAGE_SOURCE_CLAUDE = "claude-code-transcript"
USAGE_SOURCE_NONE = "no-transcript"
USAGE_SOURCE_UNREADABLE = "unreadable-transcript"
USAGE_SOURCES = (USAGE_SOURCE_CLAUDE, USAGE_SOURCE_NONE, USAGE_SOURCE_UNREADABLE)
TOKEN_FIELDS = ("input", "output", "cache_read", "cache_write")
# The Claude Code transcript's usage keys, in TOKEN_FIELDS order.
_CLAUDE_USAGE_KEYS = ("input_tokens", "output_tokens", "cache_read_input_tokens",
                      "cache_creation_input_tokens")


def _usage_none(source: str, detail: str) -> dict:
    return {"source": source, "messages": None, "tokens": None, "detail": detail}


def _jsonl_objects(path: Path) -> tuple[list[dict], int]:
    """Every JSON object line of `path`, and how many non-empty lines were
    not one. Raises OSError / UnicodeDecodeError on a file that cannot be read."""
    objects: list[dict] = []
    bad = 0
    with path.open(encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                bad += 1
                continue
            if isinstance(obj, dict):
                objects.append(obj)
            else:
                bad += 1
    return objects, bad


def _count(value) -> int:
    return value if isinstance(value, int) and not isinstance(value, bool) and value > 0 else 0


def transcript_usage(path, window_from, window_to) -> dict:
    """The Claude Code adapter (design D3): `{"source", "messages", "tokens",
    "detail"}` for the session transcript at `path`, counting the assistant
    messages whose `timestamp` is after `window_from` (`None`: open) and at or
    before `window_to`.

    Subagent turns count with the session: sidechain entries in the main file,
    and every `*.jsonl` under the session's own directory (`<stem>/`) whose
    entries carry the same `sessionId`. The host writes one entry per content
    block, each repeating the message's usage, so a message id counts once.
    A missing usage field reads as zero; a line that does not parse (a live
    writer's truncated tail) is skipped. No path or no file is
    `no-transcript`; a file with nothing readable in it is
    `unreadable-transcript`. Never raises."""
    if not path:
        return _usage_none(USAGE_SOURCE_NONE, "the hook input carried no transcript path")
    main = Path(path)
    if not main.is_file():
        return _usage_none(USAGE_SOURCE_NONE, f"no transcript file at {main}")
    try:
        entries, bad = _jsonl_objects(main)
    except (OSError, UnicodeDecodeError) as e:
        return _usage_none(USAGE_SOURCE_UNREADABLE, f"could not read {main}: {e}")
    if not entries and bad:
        return _usage_none(USAGE_SOURCE_UNREADABLE,
                           f"no line of {main} parsed as a JSON object ({bad} line(s) tried)")

    lo = _stats_parse_ts(window_from) if window_from else None
    hi = _stats_parse_ts(window_to) if window_to else None
    lo = _outcomes_utc(lo) if lo is not None else None
    hi = _outcomes_utc(hi) if hi is not None else None

    session = next((e.get("sessionId") for e in entries if e.get("sessionId")), None) or main.stem
    sources = [(entries, False)]
    sibling_dir = main.parent / main.stem
    if sibling_dir.is_dir():
        for sib in sorted(sibling_dir.rglob("*.jsonl")):
            try:
                sib_entries, _bad = _jsonl_objects(sib)
            except (OSError, UnicodeDecodeError):
                continue
            sources.append((sib_entries, True))

    tokens: dict[str, dict] = {}
    seen: set = set()
    messages = 0
    for batch, sibling in sources:
        for e in batch:
            if sibling and e.get("sessionId") != session:
                continue
            msg = e.get("message")
            if e.get("type") != "assistant" or not isinstance(msg, dict):
                continue
            usage = msg.get("usage")
            if not isinstance(usage, dict):
                continue
            ts = _stats_parse_ts(e.get("timestamp"))
            if ts is None:
                continue
            ts = _outcomes_utc(ts)
            if (lo is not None and ts <= lo) or (hi is not None and ts > hi):
                continue
            mid = msg.get("id")
            if mid:
                if mid in seen:
                    continue
                seen.add(mid)
            model = msg.get("model") if isinstance(msg.get("model"), str) and msg.get("model") else "unknown"
            bucket = tokens.setdefault(model, {f: 0 for f in TOKEN_FIELDS})
            for field, key in zip(TOKEN_FIELDS, _CLAUDE_USAGE_KEYS):
                bucket[field] += _count(usage.get(key))
            messages += 1
    return {"source": USAGE_SOURCE_CLAUDE, "messages": messages, "tokens": tokens,
            "detail": None}


def _utc_key(value):
    """`value` (an ISO timestamp) as a comparable UTC datetime, or `None`."""
    ts = _stats_parse_ts(value)
    return _outcomes_utc(ts) if ts is not None else None


def usage_row_counted(r: dict) -> bool:
    """A `usage` row that carries counts. A null-count row (no readable
    transcript) records that a moment passed uncosted; it never bounds a
    window, so the next readable record still covers that span (design D7)."""
    return r.get("gate") == USAGE_EVENT and isinstance(r.get("tokens"), dict)


def _usage_row_end(r: dict):
    window = r.get("window") if isinstance(r.get("window"), dict) else {}
    return window.get("to") or r.get("ts")


def usage_window_start(rows: list[dict], task: str | None) -> str | None:
    """Design D2: where a new usage record for `task` begins -- the later of
    the task's latest `task-start` and the end of its latest counted usage
    row. For `task: null` (no task in flight) the bounds are the change's
    first ledger row, the latest `task-start` of any task, and the latest
    counted null-task row, so the unattributed bucket never overlaps a task's
    window. With no bound at all, `None` (an open start). Pure."""
    bounds: list[str] = []
    first = next((r.get("ts") for r in rows if _utc_key(r.get("ts")) is not None), None)
    for r in rows:
        g = r.get("gate")
        if g == TASK_BASELINE_EVENT and (task is None or r.get("task") == task):
            bounds.append(r.get("ts"))
        elif usage_row_counted(r) and r.get("task") == task:
            bounds.append(_usage_row_end(r))
    if task is None or not bounds:
        bounds.append(first)
    keyed = [(_utc_key(b), b) for b in bounds if _utc_key(b) is not None]
    return max(keyed, key=lambda kb: kb[0])[1] if keyed else None


def usage_total(tokens) -> int:
    """Every count in a usage row's `tokens` map: input, output, cache-read
    and cache-write across every model (0 for `None`). Totals are derived by
    readers, never stored (design D1)."""
    if not isinstance(tokens, dict):
        return 0
    return sum(_count(c.get(f)) for c in tokens.values() if isinstance(c, dict)
               for f in TOKEN_FIELDS)


def recorded_usage(rows: list[dict]) -> int:
    """Pure: the change's recorded tokens, summed over every usage row."""
    return sum(usage_total(r.get("tokens")) for r in rows if r.get("gate") == USAGE_EVENT)


def _usage_only_append(root: Path, rel: str) -> bool:
    """Whether the working copy of ledger file `rel` differs from HEAD only
    by appended `usage` rows -- what a commit-hook or stop flush leaves. Such
    a tree is still at a task boundary: no task's work is in it."""
    if not _is_ledger_path(rel):
        return False
    head = _git(root, "show", f"HEAD:{rel}")
    if head.returncode != 0:
        return False
    try:
        now = (root / rel).read_text()
    except (OSError, UnicodeDecodeError):
        return False
    if not now.startswith(head.stdout):
        return False
    for line in now[len(head.stdout):].splitlines():
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            return False
        if not isinstance(obj, dict) or obj.get("gate") != USAGE_EVENT:
            return False
    return True


def _dirt_beyond_usage(root: Path, porcelain: str) -> list[str]:
    """The `git status --porcelain` lines that are not a usage-only append to
    a tracked ledger (`_usage_only_append`)."""
    return [ln for ln in porcelain.splitlines()
            if ln.strip() and not (ln[:2] in (" M", "M ", "MM")
                                   and _usage_only_append(root, ln[3:]))]


def cmd_usage(m: dict, root: Path, args) -> int:
    if args.usage_cmd == "record":
        return _usage_record(root, args)
    if args.usage_cmd == "show":
        return _usage_show(root, args)
    sys.exit(f"gatedloop: unknown usage subcommand '{args.usage_cmd}'")


def _usage_record(root: Path, args) -> int:
    """`gates usage record [--task] [--transcript] [--stage]` (design D1/D2).
    Exit 0 whatever the source: a missing or unreadable transcript is a row
    with null counts and the reason, never a failure of the commit or the
    stop that asked. Only a ledger that cannot be written exits 1."""
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print("gatedloop: no change branch checked out — no usage recorded")
        return 0
    if not _ledger_path(root, change).exists():
        print(f"gatedloop: change '{change}' has no ledger yet — no usage recorded "
              "(usage is attributed once the loop has written a row)")
        return 0
    rows = _read_ledger_rows(root, change)
    task = getattr(args, "task", None) or _current_task_after_handoff(rows)
    start = usage_window_start(rows, task)
    now = _now_iso()
    got = transcript_usage(getattr(args, "transcript", None), start, now)
    try:
        _append_ledger_row(root, {
            "ts": now, "gate": USAGE_EVENT, "exit": None, "duration_ms": None,
            "change": change, "task": task, "tree": None, "attempt": None,
            "approved_by": _read_approved_by(root, change), "sha": None,
            "detail": got["detail"], "tokens": got["tokens"],
            "window": {"from": start, "to": now}, "messages": got["messages"],
            "source": got["source"],
        })
    except OSError as e:
        print(f"gatedloop: could not append the usage row to {_ledger_path(root, change)}: {e}",
              file=sys.stderr)
        return 1
    who = f"task {task}" if task else "no task (unattributed)"
    if got["tokens"] is None:
        print(f"gatedloop: recorded usage for {who} with null counts ({got['source']}: "
              f"{got['detail']})")
    else:
        print(f"gatedloop: recorded usage for {who}: {got['messages']} message(s), "
              f"{usage_total(got['tokens'])} token(s) since {start or 'the session began'}")
    if getattr(args, "stage", False):
        rel = _ledger_rel(change, root)
        r = _git(root, "add", "--", rel)
        if r.returncode != 0:
            print(f"gatedloop: could not stage {rel}: {r.stderr.strip()}", file=sys.stderr)
    return 0


def _usage_show(root: Path, args) -> int:
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print("gatedloop: no change to show — pass `--change <name>` (the current "
              "branch is not a change branch).", file=sys.stderr)
        return 1
    if not _ledger_path(root, change).exists():
        print(f"gatedloop: no ledger for change '{change}' — {_ledger_path(root, change)} "
              "does not exist.", file=sys.stderr)
        return 1
    usage = [r for r in _read_ledger_rows(root, change) if r.get("gate") == USAGE_EVENT]
    by_task: dict[str, int] = {}
    for r in usage:
        key = r.get("task") or "(unattributed)"
        by_task[key] = by_task.get(key, 0) + usage_total(r.get("tokens"))
    total = sum(by_task.values())
    if getattr(args, "json", False):
        print(json.dumps({"change": change, "rows": usage, "tasks": by_task, "total": total},
                         sort_keys=True))
        return 0
    lines = [f"=== usage: {change} ===",
             f"{'recorded':<34} {'task':<15} {'source':<23} {'messages':>8}  {'tokens':>12}"]
    for r in usage:
        counted = r.get("tokens") is not None
        lines.append(
            f"{str(r.get('ts') or '?'):<34} {str(r.get('task') or '(unattributed)'):<15} "
            f"{str(r.get('source') or '?'):<23} "
            f"{(r.get('messages') if counted else '-'):>8}  "
            f"{(usage_total(r.get('tokens')) if counted else '-'):>12}")
    lines.append("")
    for task in sorted(by_task):
        lines.append(f"{task:<15} {by_task[task]:>12}")
    lines.append(f"{'total':<15} {total:>12}")
    print("\n".join(lines))
    return 0


# ---------- gate economics (`gates stats`, design gates-stats) ------------
#
# A pure reader over the durable ledger: turns the event rows `gates run` /
# `gates task` / `gates review` / `gates ledger` already write into the
# bottleneck report field report #18 derived by hand. No new row field, no
# writer change — this reads only fields the fixed LEDGER_ROW_FIELDS shape
# already carries (design D1/D2).
#
# `gate` names the EVENT, and nine values are not gates: `merge`, `taint`,
# `taint-clear`, `review`, `task-start` (TASK_BASELINE_EVENT), the
# escalation-outcomes events `halt`, `intervention` and the audit's
# `unclassified-commit` disclosure, and acceptance-gate's `acceptance`. This is
# deliberately a denylist, not an allowlist of the six known gate names:
# adopters cannot declare arbitrary gate names today, but the non-gate event
# vocabulary is owned by the shim itself, so the denylist is the set this
# code controls. A future event kind added to the shim must be added here
# too — a test pins today's set.

TESTS_HANDOFF_EVENT = "tests-handoff"
TESTS_PLACED_EVENT = "tests-placed"
TEST_DEFECT_EVENT = "test-defect"

NON_GATE_EVENTS = frozenset({
    "merge", "taint", "taint-clear", "review", TASK_BASELINE_EVENT,
    # escalation-outcomes D2/D5: escalation events and the audit's
    # unclassifiable-commit disclosure, never gate outcomes.
    "halt", "intervention", UNCLASSIFIED_COMMIT_EVENT,
    # acceptance-gate D2: a human's verdict on the increment, never a gate run.
    ACCEPTANCE_EVENT,
    # split-test-author D4: the authored-test lifecycle, never a gate run.
    TESTS_HANDOFF_EVENT, TESTS_PLACED_EVENT, TEST_DEFECT_EVENT,
    # merge-pull-request D4: the implementer's readiness, never a gate run.
    READY_EVENT,
    # retry-budget D3/D4: a lesson and a fresh restart, never a gate run.
    "attempt-note", "restart",
    # token-ledger D1: what the session spent on a task, never a gate run.
    USAGE_EVENT,
})

DEFAULT_IDLE_GAP_MINUTES = 30


def _stats_parse_ts(value):
    """A usable `datetime`, or `None`. Never raises: an unparseable or
    missing `ts` degrades the row to *excluded, but counted* (design D4)
    rather than crashing the report. `_now_iso()` never writes a trailing
    `Z`, but a lenient reader tolerates one anyway — one ledger can span
    plugin versions."""
    if not isinstance(value, str) or not value.strip():
        return None
    import datetime
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        return datetime.datetime.fromisoformat(text)
    except Exception:
        return None


def _stats_is_gate_row(gate) -> bool:
    return gate is not None and gate not in NON_GATE_EVENTS


def _stats_bucket() -> dict:
    return {"active_ms": 0, "gate_ms": 0, "failed": 0}


def stats_from_rows(rows: list[dict], idle_gap_ms: int) -> dict:
    """Pure aggregation (design D2): parsed ledger rows in, a stats
    structure out. No I/O, no git, no clock — `cmd_stats` alone does scope
    resolution, reading, and formatting.

    `rows` is whatever ledger reading produced: a list of dicts that may
    carry unknown extra fields (era tolerance, e.g. `scope` from
    `scale-gate-cost`) or be missing optional ones — iterated by the fields
    this function needs, never by the row's full key set. Rows with an
    unusable `ts` are excluded from every aggregate but counted in
    `rows_without_ts` (design D4: disclosed, never a crash, never a silent
    drop).
    """
    # token-ledger D6: usage rows are reported by `tokens_from_rows`, beside
    # time -- never inside it, so the time figures are byte-identical with or
    # without them (a stop flush would otherwise lengthen an interval).
    rows = [r for r in rows if r.get("gate") != USAGE_EVENT]
    usable: list[tuple] = []
    rows_without_ts = 0
    for r in rows:
        ts = _stats_parse_ts(r.get("ts"))
        if ts is None:
            rows_without_ts += 1
            continue
        usable.append((ts, r))
    usable.sort(key=lambda pair: pair[0])  # stable sort: ties keep file order

    gate_totals: dict[str, dict] = {}
    events: dict[str, int] = {}
    tasks: dict[str, dict] = {}
    unattributed = _stats_bucket()

    def gate_bucket(name: str) -> dict:
        return gate_totals.setdefault(name, {"runs": 0, "failed": 0, "total_ms": 0})

    def task_bucket(name) -> dict:
        if name:
            return tasks.setdefault(name, _stats_bucket())
        return unattributed

    # Gate/event aggregation is independent of active-time gap-filtering:
    # `duration_ms` is exact, measured by the writer around the command.
    for _ts, r in usable:
        gate = r.get("gate")
        if gate is None:
            continue
        if gate in NON_GATE_EVENTS:
            events[gate] = events.get(gate, 0) + 1
            continue
        dur = r.get("duration_ms")
        dur = dur if isinstance(dur, (int, float)) else 0
        exit_code = r.get("exit")
        failed = isinstance(exit_code, int) and exit_code != 0

        b = gate_bucket(gate)
        b["runs"] += 1
        b["total_ms"] += dur
        if failed:
            b["failed"] += 1

        tb = task_bucket(r.get("task"))
        tb["gate_ms"] += dur
        if failed:
            tb["failed"] += 1

    # Active loop time: sum of consecutive-row wall intervals (rows sorted
    # by `ts`), gaps above the idle threshold excluded entirely (design D1).
    # Each interval is attributed to the *ending* row's task — "the interval
    # before a row is the work that led to it." The first row opens the
    # window at zero elapsed (there is no interval before it).
    active_ms = 0
    for i in range(1, len(usable)):
        ts_i, r_i = usable[i]
        ts_prev, _r_prev = usable[i - 1]
        interval_ms = round((ts_i - ts_prev).total_seconds() * 1000)
        if interval_ms > idle_gap_ms:
            continue
        active_ms += interval_ms
        task_bucket(r_i.get("task"))["active_ms"] += interval_ms

    # The final row's own duration is added explicitly: an interval only
    # exists *between* rows, so the last gate's execution would otherwise
    # vanish. Every other gate row's duration already lands inside the
    # *following* interval (each row's `ts` is written at completion), so
    # this is not double-counted (design Risks).
    if usable:
        _last_ts, last_r = usable[-1]
        if _stats_is_gate_row(last_r.get("gate")):
            dur = last_r.get("duration_ms")
            if isinstance(dur, (int, float)):
                active_ms += dur
                task_bucket(last_r.get("task"))["active_ms"] += dur

    for b in gate_totals.values():
        b["share"] = (b["total_ms"] / active_ms) if active_ms else 0.0

    return {
        "rows": len(rows),
        "rows_without_ts": rows_without_ts,
        "active_ms": active_ms,
        "gates": gate_totals,
        "tasks": tasks,
        "unattributed": unattributed,
        "events": events,
    }


# ---------- the outcomes view (`gates stats --outcomes`, escalation-outcomes D7)
#
# A second pure aggregation beside `stats_from_rows`, not an extension of it:
# `stats_from_rows`'s contract is byte-stable output for the same input, and
# adding keys there would change every existing `--json` consumer's document
# for a view it did not ask for. Terminal states come from rows only -- the
# ledger cannot see `tasks.md`, so a change with tasks remaining and no halt
# is `in-progress`, never guessed at.

OUTCOME_TERMINALS = ("merged", "halted", "in-progress")
_SESSION_VALUES = ("agent", "human")


def _outcomes_utc(dt):
    """A parsed timestamp made comparable: naive -> assumed UTC, aware ->
    converted to UTC. One ledger can span plugin versions."""
    import datetime
    if dt.tzinfo is None:
        return dt.replace(tzinfo=datetime.timezone.utc)
    return dt.astimezone(datetime.timezone.utc)


def outcomes_from_rows(rows: list[dict], acceptance_policy: str | None = None) -> dict:
    """Pure (design D7): one change's parsed ledger rows in, its outcome out.
    No I/O, no git, no clock. `terminal` is `merged` if any `merge` row;
    else `halted` if the last `halt` follows the last `task-start` in file
    order; else `in-progress`. `hands_off` is merged with zero `halt`,
    `intervention` and `taint` rows -- a taint counts because it is a commit
    that bypassed the loop's own gate, whoever made it. Malformed or pre-era
    rows are counted and skipped (disclosed), never a crash, never zeroed.

    acceptance-gate D7: `acceptance_policy` is the manifest's declared
    acceptance policy, read by the caller. `None` ignores `acceptance` rows
    entirely -- the result is exactly what it was before acceptance existed.
    Declared: `accepted` when the latest acceptance verdict for the `merge`
    row's tree is `accept` (an acceptance of an earlier tree followed by an
    edit is not an acceptance of what shipped); a merge without one is
    `merged` and `assisted` by the missing acceptance; hands-off requires
    `accepted`; a `reject` counts under halts by its cause."""
    declared = acceptance_policy is not None
    halts = {c: 0 for c in HALT_CAUSES}
    interventions = {k: 0 for k in INTERVENTION_KINDS}
    dq = {
        "malformed_halts": 0, "malformed_interventions": 0,
        "rows_without_session": 0, "rows_without_ts": 0,
        "unclassified_commits": 0,
    }
    taints = 0
    merged = False
    merge_tree = None
    verdict_by_tree: dict = {}
    first = None  # (utc datetime, original string)
    for r in rows:
        gate = r.get("gate")
        if gate == ACCEPTANCE_EVENT and not declared:
            continue
        if r.get("session") not in _SESSION_VALUES:
            dq["rows_without_session"] += 1
        ts = _stats_parse_ts(r.get("ts"))
        if ts is None:
            dq["rows_without_ts"] += 1
        else:
            key = _outcomes_utc(ts)
            if first is None or key < first[0]:
                first = (key, r.get("ts"))
        if gate == "merge":
            merged = True
            merge_tree = r.get("tree")
        elif gate == ACCEPTANCE_EVENT:
            verdict_by_tree[r.get("tree")] = r.get("verdict")
            if r.get("verdict") == "reject":
                cause = r.get("cause")
                if cause in halts:
                    halts[cause] += 1
                else:
                    dq["malformed_halts"] += 1
        elif gate == HALT_EVENT:
            cause = r.get("cause")
            if cause in halts:
                halts[cause] += 1
            else:
                dq["malformed_halts"] += 1
        elif gate == INTERVENTION_EVENT:
            kind = r.get("cause")
            if kind in interventions:
                interventions[kind] += 1
            else:
                dq["malformed_interventions"] += 1
        elif gate == "taint":
            taints += 1
        elif gate == UNCLASSIFIED_COMMIT_EVENT:
            dq["unclassified_commits"] += 1

    outstanding = None if merged else _outstanding_halt(rows)
    accepted = (
        declared and merged and merge_tree is not None
        and verdict_by_tree.get(merge_tree) == "accept"
    )
    if accepted:
        terminal = "accepted"
    elif merged:
        terminal = "merged"
    elif outstanding is not None:
        terminal = "halted"
    else:
        terminal = "in-progress"

    assisted_by = [
        name for name, n in (
            ("halt", sum(halts.values()) + dq["malformed_halts"]),
            ("intervention", sum(interventions.values()) + dq["malformed_interventions"]),
            ("taint", taints),
        ) if n
    ]
    if declared and merged and not accepted:
        assisted_by.append("missing acceptance")
    hands_off = merged and not assisted_by
    if merged:
        verdict = "hands-off" if hands_off else "assisted"
    else:
        verdict = None
    # split-test-author D11: who authored the tests, from the handoff rows'
    # `author`; `none` when no handoff was recorded (a change from before
    # handoffs existed reads exactly as it did, plus these two fields).
    authors = {r.get("author") for r in rows
               if r.get("gate") == TESTS_HANDOFF_EVENT and r.get("author")}
    if not authors:
        authorship = "none"
    elif len(authors) == 1:
        authorship = next(iter(authors))
    else:
        authorship = "mixed"
    test_defects = sum(1 for r in rows if r.get("gate") == TEST_DEFECT_EVENT)
    # authored-test-kinds D3: the same count by kind; kindless rows are `assertion`.
    test_defects_by_kind = {k: 0 for k in TEST_DEFECT_KINDS}
    for r in rows:
        if r.get("gate") == TEST_DEFECT_EVENT:
            test_defects_by_kind[test_defect_kind(r)] += 1
    restarts, restart_recovered = _restart_outcomes(rows)
    return {
        "restarts": restarts,
        "restart_recovered": restart_recovered,
        "authorship": authorship,
        "test_defects": test_defects,
        "test_defects_by_kind": test_defects_by_kind,
        "terminal": terminal,
        "hands_off": hands_off,
        "verdict": verdict,
        "assisted_by": assisted_by,
        "halt_cause": outstanding.get("cause") if outstanding is not None else None,
        "halts": halts,
        "interventions": interventions,
        "taints": taints,
        "first_ts": first[1] if first else None,
        "data_quality": dq,
    }


def _restart_outcomes(rows: list[dict]) -> tuple[int, int]:
    """retry-budget D6: `(restarts, recovered)`. A restart recovered when its
    task reached a green `ci` after it with no `halt` of that task in between
    (and before the task's next restart). A restart is never an intervention:
    no human acted, so it is counted here and nowhere else."""
    restarts = recovered = 0
    for i, r in enumerate(rows):
        if r.get("gate") != "restart":
            continue
        restarts += 1
        task = r.get("task")
        for later in rows[i + 1:]:
            if later.get("task") != task:
                continue
            g = later.get("gate")
            if g in (HALT_EVENT, "restart"):
                break
            if g == "ci" and later.get("exit") == 0:
                recovered += 1
                break
    return restarts, recovered


def outcomes_aggregate(per_change: list[dict], acceptance_policy: str | None = None) -> dict:
    """Pure: the `--all` north-star view composed from `outcomes_from_rows`
    results. The hands-off share is hands-off / merged, both counts shown,
    and `value` is `None` -- not computable, never zero -- when nothing is
    merged. The trend is keyed on each change's month of first activity.

    acceptance-gate D7: under a declared acceptance policy `by_terminal`
    gains `accepted` and the share's denominator is merged + accepted (a
    hands-off change is by then always an accepted one). Undeclared, the
    document is exactly what it was."""
    terminals = OUTCOME_TERMINALS + (("accepted",) if acceptance_policy is not None else ())
    by_terminal = {t: 0 for t in terminals}
    halts = {c: 0 for c in HALT_CAUSES}
    interventions = {k: 0 for k in INTERVENTION_KINDS}
    taints = 0
    hands_off = 0
    trend: dict[str, dict] = {}
    for c in per_change:
        by_terminal[c["terminal"]] = by_terminal.get(c["terminal"], 0) + 1
        for k, n in c["halts"].items():
            halts[k] = halts.get(k, 0) + n
        for k, n in c["interventions"].items():
            interventions[k] = interventions.get(k, 0) + n
        taints += c["taints"]
        if c["hands_off"]:
            hands_off += 1
        ts = _stats_parse_ts(c.get("first_ts"))
        if ts is not None:
            month = _outcomes_utc(ts).strftime("%Y-%m")
            b = trend.setdefault(month, {"changes": 0, "merged": 0, "hands_off": 0})
            b["changes"] += 1
            if c["terminal"] in ("merged", "accepted"):
                b["merged"] += 1
            if c["hands_off"]:
                b["hands_off"] += 1
    merged = by_terminal["merged"] + by_terminal.get("accepted", 0)
    return {
        "changes": len(per_change),
        "by_terminal": by_terminal,
        "hands_off_share": {
            "numerator": hands_off, "denominator": merged,
            "value": (hands_off / merged) if merged else None,
        },
        "halts_by_cause": halts,
        "interventions_by_kind": interventions,
        "taints": taints,
        "trend": dict(sorted(trend.items())),
    }


def _token_bucket() -> dict:
    return {"total": 0, "models": {}}


def _token_add(bucket: dict, tokens: dict) -> None:
    for model, c in tokens.items():
        if not isinstance(c, dict):
            continue
        mb = bucket["models"].setdefault(model, dict({f: 0 for f in TOKEN_FIELDS}, total=0))
        for f in TOKEN_FIELDS:
            n = _count(c.get(f))
            mb[f] += n
            mb["total"] += n
            bucket["total"] += n


def _uncovered_ms(span: tuple, windows: list[tuple]) -> int:
    """How much of `span` (a `(start, end)` pair of datetimes) no window in
    `windows` covers, in milliseconds."""
    lo, hi = span
    covered = 0
    cursor = lo
    for a, b in sorted((max(a, lo), min(b, hi)) for a, b in windows):
        if b <= cursor:
            continue
        a = max(a, cursor)
        covered += (b - a).total_seconds()
        cursor = b
    return max(0, round(((hi - lo).total_seconds() - covered) * 1000))


def tokens_from_rows(rows: list[dict]) -> dict:
    """Pure (design D6): a change's usage rows summed into tokens per task,
    per model and unattributed, with what is unrecorded disclosed -- the
    tasks the ledger knows with no counted usage row, and how much of the
    ledger's span (first row to last) no counted window covers."""
    usage = [r for r in rows if r.get("gate") == USAGE_EVENT]
    counted = [r for r in usage if usage_row_counted(r)]
    whole = _token_bucket()
    tasks: dict[str, dict] = {}
    unattributed = _token_bucket()
    for r in counted:
        _token_add(whole, r["tokens"])
        task = r.get("task")
        _token_add(tasks.setdefault(task, _token_bucket()) if task else unattributed, r["tokens"])
    known = {r.get("task") for r in rows if r.get("task") and r.get("gate") != USAGE_EVENT}
    unrecorded = sorted(t for t in known if t not in tasks)
    stamps = sorted(k for k in (_utc_key(r.get("ts")) for r in rows) if k is not None)
    span_ms = uncovered = 0
    if stamps:
        span = (stamps[0], stamps[-1])
        span_ms = round((span[1] - span[0]).total_seconds() * 1000)
        windows = []
        for r in counted:
            w = r.get("window") if isinstance(r.get("window"), dict) else {}
            a, b = _utc_key(w.get("from")) or span[0], _utc_key(w.get("to") or r.get("ts"))
            if b is not None:
                windows.append((a, b))
        uncovered = _uncovered_ms(span, windows)
    return {
        "recorded": bool(counted),
        "total": whole["total"],
        "models": whole["models"],
        "tasks": tasks,
        "unattributed": unattributed,
        "unrecorded": {"tasks": unrecorded, "count": len(unrecorded),
                       "uncovered_ms": uncovered, "span_ms": span_ms},
        "usage_rows": len(usage),
    }


def cost_from_tokens(t: dict, m: dict) -> dict:
    """Pure (design D4): `tokens_from_rows`' figures priced with the
    manifest's `economics.prices` -- per-million-token prices per model, in
    one declared currency. A recorded model with no price is named with its
    tokens and left out of the amounts; without prices nothing is priced."""
    econ = m.get("economics") if isinstance(m, dict) else None
    prices = econ.get("prices") if isinstance(econ, dict) else None
    if not isinstance(prices, dict) or not prices:
        return {"prices_declared": False, "currency": None, "total": None, "tasks": {},
                "unattributed": None, "unpriced": {}}

    def price(models: dict) -> tuple[float, dict]:
        amount, unpriced = 0.0, {}
        for model, mb in models.items():
            p = prices.get(model)
            if not isinstance(p, dict):
                unpriced[model] = unpriced.get(model, 0) + mb["total"]
                continue
            for key, field in PRICE_FIELDS.items():
                v = p.get(key)
                if isinstance(v, (int, float)) and not isinstance(v, bool):
                    amount += mb[field] * v / 1_000_000
        return amount, unpriced

    total, unpriced = price(t["models"])
    return {
        "prices_declared": True,
        "currency": econ.get("currency"),
        "total": round(total, 6),
        "tasks": {task: round(price(b["models"])[0], 6) for task, b in t["tasks"].items()},
        "unattributed": round(price(t["unattributed"]["models"])[0], 6),
        "unpriced": unpriced,
    }


def _cost_format_human(cost: dict) -> list[str]:
    if not cost["prices_declared"]:
        return ["cost: no prices declared (`economics.prices` in .gates.yaml) -- tokens only"]
    cur = cost["currency"] or ""
    scope = "priced models only" if cost["unpriced"] else "every recorded model priced"
    lines = [f"cost ({cur}): {cost['total']:.4f} total ({scope})"]
    for task in sorted(cost["tasks"]):
        lines.append(f"  {task:<15} {cost['tasks'][task]:>12.4f}")
    if cost["unattributed"]:
        lines.append(f"  {'(unattributed)':<15} {cost['unattributed']:>12.4f}")
    if cost["unpriced"]:
        lines.append("unpriced (no `economics.prices` entry): " + ", ".join(
            f"{model} ({n} tokens)" for model, n in sorted(cost["unpriced"].items())))
    return lines


def _read_ledger_rows_and_skipped(root: Path, change: str) -> tuple[list[dict], int]:
    """Like `_read_ledger_rows`, but also discloses how many lines could not
    be read as a JSON object (design D2) — a new function, not a change to
    `_read_ledger_rows`'s signature, so the audit/taint paths that already
    call it are untouched."""
    p = _ledger_path(root, change)
    if not p.exists():
        return [], 0
    rows: list[dict] = []
    skipped = 0
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except Exception:
            skipped += 1
            continue
        if not isinstance(obj, dict):
            skipped += 1
            continue
        rows.append(obj)
    return rows, skipped


def _stats_change_report(root: Path, change: str, idle_gap_ms: int) -> dict:
    rows, skipped = _read_ledger_rows_and_skipped(root, change)
    report = stats_from_rows(rows, idle_gap_ms)
    report["change"] = change
    report["skipped_lines"] = skipped
    report["tokens"] = tokens_from_rows(rows)
    return report


def _stats_totals(reports: list[dict]) -> dict:
    return {
        "active_ms": sum(c["active_ms"] for c in reports),
        "gate_ms": sum(sum(g["total_ms"] for g in c["gates"].values()) for c in reports),
        "failed": sum(sum(g["failed"] for g in c["gates"].values()) for c in reports),
        "tokens": sum(c["tokens"]["total"] for c in reports if "tokens" in c),
    }


def _stats_fmt_ms(ms) -> str:
    return f"{(ms or 0) / 60000:.1f}m"


def _stats_format_human(doc: dict) -> str:
    """The human table (design D3): a header line, a per-gate table, a
    per-task table (with an `(unattributed)` row when applicable), a
    data-quality line, a limitations sentence, and a closing pointer to the
    playbook -- per change. Column cosmetics are not the contract; the
    presence of each section is."""
    idle_minutes = doc["idle_gap_ms"] / 60000
    lines: list[str] = []
    for c in doc["changes"]:
        lines.append(f"=== {c['change']} ===")
        lines.append(
            f"rows={c['rows']}  active={_stats_fmt_ms(c['active_ms'])}  "
            f"idle-threshold={idle_minutes:g}m"
        )
        lines.append("")
        lines.append("gate            runs  failed      time  share")
        for name in sorted(c["gates"]):
            g = c["gates"][name]
            share_pct = min(g["share"], 1.0) * 100
            lines.append(
                f"{name:<15} {g['runs']:>4}  {g['failed']:>6}  "
                f"{_stats_fmt_ms(g['total_ms']):>8}  {share_pct:5.1f}%"
            )
        lines.append("")
        lines.append("task            active      gate  failed")
        for name in sorted(c["tasks"]):
            t = c["tasks"][name]
            lines.append(
                f"{name:<15} {_stats_fmt_ms(t['active_ms']):>8}  "
                f"{_stats_fmt_ms(t['gate_ms']):>8}  {t['failed']:>6}"
            )
        u = c["unattributed"]
        if u["active_ms"] or u["gate_ms"] or u["failed"]:
            lines.append(
                f"{'(unattributed)':<15} {_stats_fmt_ms(u['active_ms']):>8}  "
                f"{_stats_fmt_ms(u['gate_ms']):>8}  {u['failed']:>6}"
            )
        lines.append("")
        lines.append(
            f"data quality: {c['skipped_lines']} unparseable line(s) skipped, "
            f"{c['rows_without_ts']} row(s) had no usable timestamp"
        )
        if "tokens" in c:
            lines.extend(_tokens_format_human(c["tokens"]))
        if "cost" in c:
            lines.extend(_cost_format_human(c["cost"]))
        lines.append("")
    lines.append(
        "limitations: the ledger records event timestamps and durations only "
        "-- it cannot say how time between events was spent (edit vs. think), "
        "measure host contention, count the tokens of a task with no usage "
        "row, or account for a loop that predates the ledger."
    )
    lines.append(
        "next: see docs/gate-economics.md for how to restructure gates once "
        "the bottleneck is visible."
    )
    return "\n".join(lines) + "\n"


def _tokens_format_human(t: dict) -> list[str]:
    """The tokens section of one change's report (design D6). Every line of
    it follows the time sections, and its first line starts `tokens`."""
    if not t["recorded"]:
        why = ("no usage rows" if not t["usage_rows"] else
               f"{t['usage_rows']} usage row(s), none with counts")
        return [f"tokens: not recorded for this change ({why})"]
    u = t["unrecorded"]
    known = len(t["tasks"]) + u["count"]
    lines = [
        f"tokens: {t['total']} total; {u['count']} of {known} task(s) unrecorded; "
        f"{_stats_fmt_ms(u['uncovered_ms'])} of {_stats_fmt_ms(u['span_ms'])} not "
        "covered by a usage window",
        f"{'task':<15} {'tokens':>12}",
    ]
    for name in sorted(set(t["tasks"]) | set(u["tasks"])):
        value = t["tasks"][name]["total"] if name in t["tasks"] else "unrecorded"
        lines.append(f"{name:<15} {value:>12}")
    if t["unattributed"]["total"]:
        lines.append(f"{'(unattributed)':<15} {t['unattributed']['total']:>12}")
    lines.append(f"{'model':<28} {'input':>11} {'output':>11} {'cache-read':>12} "
                 f"{'cache-write':>12} {'total':>12}")
    for model in sorted(t["models"]):
        mb = t["models"][model]
        lines.append(f"{model:<28} {mb['input']:>11} {mb['output']:>11} "
                     f"{mb['cache_read']:>12} {mb['cache_write']:>12} {mb['total']:>12}")
    return lines


_OUTCOMES_DQ_KEYS = (
    "malformed_halts", "malformed_interventions", "rows_without_session",
    "rows_without_ts", "unclassified_commits",
)


def _outcomes_counts(d: dict) -> str:
    return ", ".join(f"{k}: {n}" for k, n in d.items())


def _outcomes_dq_prose(dq: dict) -> str:
    text = (
        f"data quality: {dq['unparseable_lines']} unparseable line(s) skipped, "
        f"{dq['rows_without_ts']} row(s) had no usable timestamp, "
        f"{dq['malformed_halts']} halt row(s) with a missing or unknown cause, "
        f"{dq['malformed_interventions']} intervention row(s) of an unknown kind, "
        f"{dq['rows_without_session']} row(s) without a session value"
    )
    if dq["rows_without_session"]:
        text += " (human-commit classification unavailable for them)"
    text += f", {dq['unclassified_commits']} commit(s) the audit could not classify"
    return text


def _outcomes_format_human(doc: dict, show_aggregate: bool,
                           acceptance_policy: str | None = None) -> str:
    """The human outcomes report. Column cosmetics are not the contract; the
    presence of each section and the closing blind-spots line are."""
    lines: list[str] = []
    for c in doc["changes"]:
        lines.append(f"=== {c['change']} ===")
        terminal = c["terminal"]
        if terminal == "halted":
            terminal += f" (cause {c['halt_cause']})"
        if c["verdict"] == "assisted":
            verdict = f"assisted ({', '.join(c['assisted_by'])})"
        else:
            verdict = c["verdict"] or "n/a (not merged)"
        lines.append(f"terminal: {terminal}   verdict: {verdict}")
        lines.append(f"halts:          {_outcomes_counts(c['halts'])}")
        lines.append(f"interventions:  {_outcomes_counts(c['interventions'])}")
        lines.append(f"taints:         {c['taints']}")
        lines.append(f"authorship:     {c['authorship']}")
        by_kind = c["test_defects_by_kind"]
        lines.append(f"test defects:   {c['test_defects']} (setup {by_kind['setup']}, "
                     f"assertion {by_kind['assertion']}, green {by_kind['green']})")
        lines.append(f"restarts:       {c['restarts']} ({c['restart_recovered']} recovered)")
        lines.append(f"first activity: {c['first_ts'] or 'unknown'}")
        lines.append(_outcomes_dq_prose(c["data_quality"]))
        lines.append("")
    if show_aggregate:
        a = doc["aggregate"]
        lines.append("=== all changes ===")
        lines.append(
            f"changes: {a['changes']} ({_outcomes_counts(a['by_terminal'])})"
        )
        share = a["hands_off_share"]
        if share["value"] is None:
            lines.append(
                "hands-off: not computable -- no change is merged yet "
                f"({_outcomes_counts(a['by_terminal'])})"
            )
        else:
            reached = "merged" if acceptance_policy is None else "merged or accepted"
            lines.append(
                f"hands-off: {share['numerator']} of {share['denominator']} {reached} "
                f"changes ({share['value'] * 100:.1f}%)"
            )
        lines.append(f"halts by cause:        {_outcomes_counts(a['halts_by_cause'])}")
        lines.append(f"interventions by kind: {_outcomes_counts(a['interventions_by_kind'])}")
        lines.append(f"taints:                {a['taints']}")
        lines.append("trend (month of first activity):")
        for month, t in a["trend"].items():
            lines.append(
                f"  {month}  changes {t['changes']}  merged {t['merged']}  "
                f"hands-off {t['hands_off']}"
            )
        lines.append(_outcomes_dq_prose(doc["data_quality"]))
        lines.append("")
    if acceptance_policy is None:
        terminal_note = (
            "the terminal event is `merged` (metric ends at merged — no acceptance "
            "policy declared)."
        )
    else:
        terminal_note = (
            f"the terminal event is `accepted` (approval.acceptance: "
            f"{acceptance_policy}) — a merge with no acceptance of the merged tree "
            "is `merged`, never hands-off."
        )
    lines.append(
        "limitations: human-commit detection depends on the CLAUDECODE session "
        f"marker, and {terminal_note}"
    )
    lines.append(
        "cannot answer: a halt that was never recorded; a human turn that went "
        "through neither the question tool nor a gated commit; any commit "
        "created after the last audit."
    )
    return "\n".join(lines) + "\n"


def _outcomes_report(root: Path, changes: list[str], as_json: bool,
                     show_aggregate: bool, acceptance_policy: str | None = None) -> int:
    """`gates stats --outcomes`: read and format only -- all the arithmetic
    is in `outcomes_from_rows` / `outcomes_aggregate`. JSON is one
    `sort_keys` document, always carrying `changes`, `aggregate` and
    `data_quality` so its shape never depends on the scope flag."""
    per_change: list[dict] = []
    dq_total = {k: 0 for k in ("unparseable_lines",) + _OUTCOMES_DQ_KEYS}
    for name in changes:
        rows, skipped = _read_ledger_rows_and_skipped(root, name)
        out = outcomes_from_rows(rows, acceptance_policy)
        out["change"] = name
        out["data_quality"]["unparseable_lines"] = skipped
        for k in dq_total:
            dq_total[k] += out["data_quality"][k]
        per_change.append(out)
    doc = {
        "changes": per_change,
        "aggregate": outcomes_aggregate(per_change, acceptance_policy),
        "data_quality": dq_total,
    }
    if as_json:
        print(json.dumps(doc, sort_keys=True))
    else:
        sys.stdout.write(_outcomes_format_human(doc, show_aggregate, acceptance_policy))
    return 0


def cmd_stats(m: dict, root: Path, args) -> int:
    """CLI surface for gate economics (design D2: thin -- scope resolution,
    reading, and formatting only; all the math lives in `stats_from_rows`)."""
    idle_gap_ms = int(round(getattr(args, "idle_gap", DEFAULT_IDLE_GAP_MINUTES) * 60000))

    if getattr(args, "epic", None):
        # epic-linkage D6: the same per-change economics, grouped by child.
        return _epic_stats_report(root, m, args.epic, getattr(args, "json", False), idle_gap_ms)

    if getattr(args, "all", False):
        runs_dir = _state_dir(root) / "runs"
        paths = sorted(runs_dir.glob("*.jsonl")) if runs_dir.exists() else []
        if not paths:
            print(
                f"gatedloop: no ledger files found under {runs_dir} -- nothing "
                "to report (`gates stats --all` needs at least one recorded "
                "change).",
                file=sys.stderr,
            )
            return 1
        changes = [p.stem for p in paths]
    else:
        change = _resolve_change_name(root, getattr(args, "change", None))
        if change is None:
            print(
                "gatedloop: no change to report on -- `gates stats` resolves "
                "the current branch, which is `main`/`master` here. Pass "
                "`--change <name>` or use `--all`.",
                file=sys.stderr,
            )
            return 1
        if not _ledger_path(root, change).exists():
            print(
                f"gatedloop: no ledger for change '{change}' -- "
                f"{_ledger_path(root, change)} does not exist. Nothing to "
                "report.",
                file=sys.stderr,
            )
            return 1
        changes = [change]

    if getattr(args, "outcomes", False):
        # escalation-outcomes D7: the same scope resolution and fail-loud
        # rules as above; only reading and formatting differ.
        return _outcomes_report(
            root, changes, getattr(args, "json", False), getattr(args, "all", False),
            _acceptance_policy(m),
        )

    reports = [_stats_change_report(root, c, idle_gap_ms) for c in changes]
    if getattr(args, "cost", False):
        # token-ledger D4: priced only on request, from the adopter's binding.
        for report in reports:
            report["cost"] = cost_from_tokens(report["tokens"], m)
    doc = {
        "idle_gap_ms": idle_gap_ms,
        "changes": reports,
        "totals": _stats_totals(reports),
    }

    if getattr(args, "json", False):
        # Deterministic: the same ledger content + flags produce the same
        # dict-construction order every run, and `sort_keys` makes the key
        # order canonical on top of that -- one document, nothing else on
        # stdout (design D3).
        print(json.dumps(doc, sort_keys=True))
    else:
        sys.stdout.write(_stats_format_human(doc))
    return 0


# ---------- approval (D10/D12: merged + attested, never self-reported) ----
#
# `approved_sha` pins an approval to exact content, computed over the
# change's PLAN artifacts only — `proposal.md`, `design.md`, and every
# `specs/**/*.md`, plus the oracle-tag digest of `tasks.md` when it carries
# a tag (task-oracle D9) — never the rest of `tasks.md` (SETUP.md: it is *derived* from the
# already-approved plan, not independently agreed) and never `.openspec.yaml`
# itself (it would have to hash its own field). Two ways to read that
# content, because the two callers see it at different times: `sha`/`attest`
# run against the local working tree (right after authoring, or right after
# pulling a merged `main`); `check` runs against a resolved git ref directly
# — it fires at `git checkout -b <change>`, before the change branch (or
# necessarily a fresh fetch of the artifacts into the working tree) exists.

PLAN_ARTIFACT_NAMES = ("proposal.md", "design.md")


def _is_plan_artifact_relpath(rel: str) -> bool:
    if rel in PLAN_ARTIFACT_NAMES:
        return True
    return rel.startswith("specs/") and rel.endswith(".md")


def _oracle_tag_pairs(text: str | None) -> list[tuple[str, str]]:
    """task-oracle D9: `(task id, tag)` for every tagged task line of a
    `tasks.md`'s text, in file order -- checkbox state and task text left
    out, so a tick or a reworded task never moves the approval sha."""
    out = []
    for line in (text or "").splitlines():
        mt = _TASK_LINE_RE.match(line)
        if not mt:
            continue
        _body, oracle, tag = _split_oracle_tag(mt.group(2))
        if tag is not None:
            label = _oracle_label(oracle)
            out.append((mt.group(1), f"[oracle: {label}]" if label else " ".join(tag.split())))
    return out


def _update_with_oracle_tags(h, tasks_text: str | None) -> None:
    """Add the tag digest to an approval hash, only when the plan has a tag:
    an untagged plan hashes exactly as before (D9)."""
    pairs = _oracle_tag_pairs(tasks_text)
    if not pairs:
        return
    h.update(b"tasks.md#oracle-tags\n")
    for tid, tag in pairs:
        h.update(f"{tid} {tag}\n".encode())


def _approval_sha_worktree(root: Path, change: str) -> str | None:
    change_dir = root / "openspec" / "changes" / change
    if not change_dir.exists():
        return None
    files = []
    for name in PLAN_ARTIFACT_NAMES:
        p = change_dir / name
        if p.exists():
            files.append(p)
    specs_dir = change_dir / "specs"
    if specs_dir.exists():
        files.extend(sorted(specs_dir.rglob("*.md")))
    if not files:
        return None
    files = sorted(files, key=lambda p: str(p.relative_to(change_dir)).replace("\\", "/"))
    h = hashlib.sha256()
    for f in files:
        rel = str(f.relative_to(change_dir)).replace("\\", "/")
        h.update(rel.encode() + b"\n")
        h.update(f.read_bytes())
        h.update(b"\n")
    tasks_md = change_dir / "tasks.md"
    _update_with_oracle_tags(h, tasks_md.read_text() if tasks_md.is_file() else None)
    return h.hexdigest()


def _approval_sha_ref(root: Path, change: str, ref: str) -> str | None:
    prefix = f"openspec/changes/{change}/"
    out = subprocess.run(
        ["git", "ls-tree", "-r", "--name-only", ref, "--", prefix],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    rel_paths = sorted(
        p[len(prefix):] for p in out.stdout.splitlines()
        if p.strip() and _is_plan_artifact_relpath(p[len(prefix):])
    )
    if not rel_paths:
        return None
    h = hashlib.sha256()
    for rel in rel_paths:
        content = subprocess.run(
            ["git", "show", f"{ref}:{prefix}{rel}"],
            cwd=root, capture_output=True, text=True,
        )
        if content.returncode != 0:
            return None
        h.update(rel.encode() + b"\n")
        h.update(content.stdout.encode())
        h.update(b"\n")
    _update_with_oracle_tags(h, _blob_at(root, ref, f"{prefix}tasks.md"))
    return h.hexdigest()


def _change_present_on_ref(root: Path, change: str, ref: str) -> bool:
    out = subprocess.run(
        ["git", "ls-tree", ref, "--", f"openspec/changes/{change}/"],
        cwd=root, capture_output=True, text=True,
    )
    return out.returncode == 0 and out.stdout.strip() != ""


def _openspec_yaml_at_ref(root: Path, change: str, ref: str) -> dict | None:
    out = subprocess.run(
        ["git", "show", f"{ref}:openspec/changes/{change}/.openspec.yaml"],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    try:
        return _parse_yaml_text(out.stdout) or {}
    except Exception:
        return None


def _local_counterpart_branch(target: str | None) -> str | None:
    """The local counterpart branch name for a resolved ORIGIN merge target
    (design D5, worktree-native-loop) — `'main'` for `'origin/main'`. `None`
    for a target that is already local (no `origin/` prefix) or absent —
    there is no "local counterpart" of a ref that already is one."""
    if target and target.startswith("origin/"):
        return target[len("origin/"):]
    return None


def _local_branch_exists(root: Path, name: str) -> bool:
    out = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", f"refs/heads/{name}"],
        cwd=root, capture_output=True, text=True,
    )
    return out.returncode == 0


_UNPUSHED_MERGE_ADVISORY = (
    " — merged locally but not yet pushed to origin; push before ending the session"
)


def _approval_check(root: Path, change: str, m: dict | None = None) -> tuple[bool, str]:
    ok, _ref, reason = _approval_check_at(root, change, m)
    return ok, reason


def _approval_check_at(root: Path, change: str, m: dict | None = None) -> tuple[bool, str | None, str]:
    """`_approval_check` as `(ok, ref, reason)`: `ref` is the ref it read
    the approval from (`None` on a refusal) -- what `gates handoff` names as the target.

    Both D10 conditions in one place (tasks 1c.4/1c.5): the change's plan
    must be present on the resolved merge target (proof it was reviewed and
    merged, not just written), and its `.openspec.yaml` there must carry a
    populated `approved_by` whose `approved_sha` still matches the merged
    content (an edit after approval invalidates it). Returns `(ok, reason)`.

    design D5 (worktree-native-loop): under approval policy `self`, a local
    counterpart branch of the merge target (`main` when the target resolves
    to `origin/main`) is accepted when the origin ref itself doesn't carry
    the change — the origin ref is tried FIRST (the stronger evidence), the
    local counterpart only as a fallback, with a loud advisory. Under
    `review`, this fallback never applies: the attestation is anchored to
    the forge's approving review, which a purely local ref cannot evidence,
    so the origin ref is unconditionally required — a local-only merge is
    refused exactly as if it weren't merged at all.
    """
    policy = _approval_policy(m or {})
    target, reason = _resolve_merge_target(root)
    if target is None:
        return False, None, (
            f"no merge target resolved ({reason}) — push a branch to a remote "
            "with an 'origin/HEAD', or create a local 'main', then retry"
        )
    ref = target
    advisory = ""
    if not _change_present_on_ref(root, change, target):
        local = _local_counterpart_branch(target) if policy == "self" else None
        if local and _local_branch_exists(root, local) and _change_present_on_ref(root, change, local):
            ref = local
            advisory = _UNPUSHED_MERGE_ADVISORY
        else:
            return False, None, (
                f"change '{change}' is not present on '{target}' — the plan must be "
                f"reviewed and merged to '{target}' before implementation starts"
            )
    data = _openspec_yaml_at_ref(root, change, ref)
    if data is None:
        return False, None, (
            f"no .openspec.yaml found for '{change}' on '{ref}' — cannot verify "
            f"approval; ensure the change's full plan (including .openspec.yaml) is "
            f"merged to '{ref}'"
        )
    approved_by, _approved_at, approved_sha = _approval_meta(data)
    if not approved_by:
        return False, None, (
            f"change '{change}' is merged but its .openspec.yaml has no approved_by — "
            "a merge proves the plan landed, not that a human agreed with it — "
            f"attest it (`gates approval attest {change} --local` under a self-"
            "approval policy, or get its PR reviewed and attested with `--pr`)"
        )
    computed = _approval_sha_ref(root, change, ref)
    if not approved_sha or computed != approved_sha:
        return False, None, (
            f"change '{change}'s approved_sha does not match its current plan content on "
            f"'{ref}' — it was edited after approval — get it re-approved (re-attest "
            f"with `gates approval attest {change} --local` or a fresh PR review) before "
            "implementing"
        )
    return True, ref, f"change '{change}' is merged to '{ref}' and approved by {approved_by}{advisory}"


def cmd_approval(m: dict, root: Path, args) -> int:
    if args.approval_cmd == "policy":
        print(f"plan={_approval_policy(m)}")
        return 0

    if args.approval_cmd == "sha":
        sha = _approval_sha_worktree(root, args.change)
        if sha is None:
            sys.exit(f"gatedloop: no plan artifact files found for change '{args.change}' to hash")
        print(sha)
        return 0

    if args.approval_cmd == "check":
        ok, reason = _approval_check(root, args.change, m)
        print(f"gatedloop: {reason}", file=sys.stderr if not ok else sys.stdout)
        return 0 if ok else 1

    if args.approval_cmd == "migrate":
        return cmd_approval_migrate(root, args)

    if args.approval_cmd == "attest":
        if getattr(args, "as_name", None) and not args.local:
            print(
                "gatedloop: --as only applies to --local — a --pr attestation's "
                "approved_by comes from the PR's actual approving review, never a "
                "supplied override.",
                file=sys.stderr,
            )
            return 1
        if args.local:
            return cmd_approval_attest_local(m, root, args)
        if args.merged is not None:
            return cmd_approval_attest_merged(m, root, args.change, args.merged)
        return cmd_approval_attest(root, args)

    sys.exit(f"gatedloop: unknown approval subcommand '{args.approval_cmd}'")


_TOP_LEVEL_KEY_RE = re.compile(r"^([A-Za-z0-9_][A-Za-z0-9_.-]*)\s*:")


def _top_level_key(line: str) -> str | None:
    """The key a column-0 `key: value` line sets, else `None`."""
    m = _TOP_LEVEL_KEY_RE.match(line)
    return m.group(1) if m else None


def _yaml_quoted(value) -> str:
    """`value` as a double-quoted YAML scalar, `\\` and `"` escaped, so
    every reader gets back the string as written: unquoted, ` #` opens a
    comment (a `--merged` approval's `(merged #42)`) and PyYAML reads a
    bare ISO time as a datetime."""
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def _write_approval_keys(root: Path, change: str, approved_by: str, approved_at: str, sha: str) -> Path | None:
    """The one place both attestation writers (`--pr` and `--local`) commit
    the approval to `.openspec.yaml`: the `x-gatedloop-approved-*` keys,
    with every approval key in either spelling removed first, so a re-attest
    migrates the file as a side effect (openspec-1-14-compat D2). Other
    lines are kept as written. Returns the path written, or `None` if the
    change's `.openspec.yaml` doesn't exist (reported by the caller — this
    function never prints)."""
    yaml_path = _openspec_yaml_path(root, change)
    if not yaml_path.exists():
        return None
    drop = {key for pair in APPROVAL_KEYS for key in pair} | {
        _earlier_meta_key(new) for new, _old in APPROVAL_KEYS}
    lines = [line for line in yaml_path.read_text().splitlines()
             if _top_level_key(line) not in drop]
    while lines and not lines[-1].strip():
        lines.pop()
    values = (approved_by, approved_at, sha)
    lines += [f"{new}: {_yaml_quoted(value)}" for (new, _old), value in zip(APPROVAL_KEYS, values)]
    yaml_path.write_text("\n".join(lines) + "\n")
    return yaml_path


def _migrate_approval_text(text: str) -> str | None:
    """`text` with every 0.5.0-spelled approval key renamed to its
    `x-gatedloop-` spelling, values and order kept, or `None` when it has none
    (design D3). Where both spellings are present the new one already wins
    (D2), so the old line is dropped rather than renamed into a duplicate."""
    old_to_new = {old: new for new, old in APPROVAL_KEYS}
    lines = text.splitlines(keepends=True)
    present = {_top_level_key(line) for line in lines}
    out, changed = [], False
    for line in lines:
        key = _top_level_key(line)
        if key in old_to_new:
            changed = True
            new = old_to_new[key]
            if new in present or _earlier_meta_key(new) in present:
                continue
            line = new + line[len(key):]
        out.append(line)
    return "".join(out) if changed else None


def _active_change_dirs(root: Path) -> list[Path]:
    base = root / "openspec" / "changes"
    if not base.is_dir():
        return []
    return [d for d in sorted(base.iterdir()) if d.is_dir() and d.name != "archive"]


def _changes_with_old_approval_keys(root: Path) -> list[str]:
    """Active changes whose `.openspec.yaml` still carries a 0.5.0-spelled
    approval key -- the one fact doctor's `approval-keys` row and the
    `old-approval-keys` adoption detector read. Archived changes are never
    rewritten and nothing reads their approvals, so they are not listed."""
    out = []
    for d in _active_change_dirs(root):
        p = d / ".openspec.yaml"
        with contextlib.suppress(OSError):
            if p.is_file() and _migrate_approval_text(p.read_text()) is not None:
                out.append(d.name)
    return out


def cmd_approval_migrate(root: Path, args) -> int:
    """`gates approval migrate [<change>]` (design D3): rename the 0.5.0
    approval keys to the `x-gatedloop-` spelling in each active change's
    `.openspec.yaml` (or the named one's), in place. The approval sha hashes
    no `.openspec.yaml`, so a migrated approval still checks. It never
    commits: the rewrite is a planning-path edit, committed at planning grade."""
    if args.change:
        d = root / "openspec" / "changes" / args.change
        if args.change == "archive" or not d.is_dir():
            print(f"gatedloop: no active change '{args.change}' under openspec/changes/",
                  file=sys.stderr)
            return 1
        dirs = [d]
    else:
        dirs = _active_change_dirs(root)
    migrated = 0
    for d in dirs:
        p = d / ".openspec.yaml"
        if not p.is_file():
            continue
        new_text = _migrate_approval_text(p.read_text())
        if new_text is None:
            continue
        p.write_text(new_text)
        migrated += 1
        print(f"gatedloop: migrated approval keys to x-gatedloop-approved-* in {p.relative_to(root)}")
    if not migrated:
        print("gatedloop: no active change carries an earlier-spelled approval key — nothing to migrate.")
    else:
        print(f"gatedloop: {migrated} file(s) migrated; commit them (a planning-grade commit).")
    return 0


def _local_git_identity(root: Path) -> str:
    """`approved_by`'s default under `--local`: the configured git identity —
    "Name <email>", or whichever half is set. Never a GitHub login (there is
    no forge review to read one from); this is the honest boundary D3 asks
    docs to state plainly (identity is only as strong as git config)."""
    name = subprocess.run(
        ["git", "config", "user.name"], cwd=root, capture_output=True, text=True,
    ).stdout.strip()
    email = subprocess.run(
        ["git", "config", "user.email"], cwd=root, capture_output=True, text=True,
    ).stdout.strip()
    if name and email:
        return f"{name} <{email}>"
    return name or email


def cmd_approval_attest_local(m: dict, root: Path, args) -> int:
    """`gates approval attest <change> --local` (design D2): legitimate only
    under a declared `self` policy. Computes `approved_sha` with the exact
    same worktree computation `--pr` uses (`_approval_sha_worktree` — one
    code path for both writers), sets `approved_by` from the configured git
    identity (or `--as <name>`, which never touches the sha), and
    `approved_at` from the clock. The D10 gate (`_approval_check`) does not
    change: it still refuses on a stale sha regardless of which writer
    produced it, so a post-attestation edit invalidates exactly as with
    `--pr` (design D2's "writer, not a bypass").
    """
    change = args.change
    policy = _approval_policy(m)
    if policy != "self":
        print(
            f"gatedloop: local attestation is not legitimate under the declared "
            f"approval policy ({policy!r}) — use "
            f"`gates approval attest {change} --pr <n>` instead.",
            file=sys.stderr,
        )
        return 1

    sha = _approval_sha_worktree(root, change)
    if sha is None:
        print(f"gatedloop: no plan artifact files found for change '{change}' to hash — nothing to attest.", file=sys.stderr)
        return 1

    approved_by = args.as_name or _local_git_identity(root)
    if not approved_by:
        print(
            "gatedloop: no git identity configured (user.name/user.email) and no "
            "--as given — refusing to write an unattested value.",
            file=sys.stderr,
        )
        return 1
    approved_at = _now_iso()

    written = _write_approval_keys(root, change, approved_by, approved_at, sha)
    if written is None:
        print(f"gatedloop: {_openspec_yaml_path(root, change)} does not exist.", file=sys.stderr)
        return 1

    print(f"gatedloop: locally attested approval of '{change}' — approved_by={approved_by}")
    _record_approval_row(root, change, approved_by, approved_at, sha)
    return 0


def _first_approving_review(root: Path, pr, what: str, not_enough: str) -> tuple[dict | None, str]:
    """The one reading of "a pull request's approving review" shared by the
    plan-approval and acceptance writers (acceptance-gate D3), so the two
    attestations cannot drift in what they accept as a review. Returns
    `({"login", "submittedAt"}, "")` for the FIRST review in the `APPROVED`
    state, else `(None, <refusal message>)`. Fails closed on every forge
    problem -- `gh` missing, unauthenticated, offline, unparseable output --
    and never falls back to a local identity. `what` names the thing being
    attested ("approval", "acceptance"); `not_enough` is the caller's
    sentence for a PR that has reviews but none approving."""
    try:
        out = subprocess.run(
            ["gh", "pr", "view", str(pr), "--json", "reviews"],
            cwd=root, capture_output=True, text=True, timeout=30,
        )
    except FileNotFoundError:
        return None, (
            f"gatedloop: `gh` is not installed — {what} cannot be attested; refusing "
            "to write an unattested value."
        )
    except Exception as e:
        return None, (
            f"gatedloop: could not run `gh pr view` ({e}) — refusing to write an "
            "unattested value."
        )
    if out.returncode != 0:
        return None, (
            f"gatedloop: `gh pr view {pr}` failed ({out.stderr.strip()}) — gh may be "
            "unauthenticated or offline; refusing to write an unattested value."
        )
    try:
        payload = json.loads(out.stdout)
    except json.JSONDecodeError as e:
        return None, f"gatedloop: `gh pr view {pr} --json reviews` did not return valid JSON: {e}"

    approved = [r for r in (payload.get("reviews") or []) if r.get("state") == "APPROVED"]
    if not approved:
        return None, (
            f"gatedloop: PR #{pr} has no APPROVED review — {not_enough}; refusing to "
            f"write {what} metadata."
        )
    first = approved[0]
    login = (first.get("author") or {}).get("login")
    if not login:
        return None, (
            f"gatedloop: PR #{pr}'s approving review has no author login — refusing to "
            f"write {what} metadata."
        )
    return {"login": login, "submittedAt": first.get("submittedAt")}, ""


def cmd_approval_attest(root: Path, args) -> int:
    """Task 1d.3-1d.6: write `approved_by`/`approved_at`/`approved_sha` from
    the pull request's ACTUAL approving review — never a value the model
    supplies. This is the only legitimate writer of those three keys; a
    hand-edit of `.openspec.yaml` fails the `approved_sha` check in
    `_approval_check` the moment the plan content and the recorded hash
    diverge (design D12).

    Fails closed (never falls back to an unattested value) when `gh` is
    missing/unauthenticated/offline, or when the PR has no `APPROVED`
    review — both are reported, neither is silently skipped.
    """
    change, pr = args.change, args.pr
    review, reason = _first_approving_review(root, pr, "approval", "merged is not approved")
    if review is None:
        print(reason, file=sys.stderr)
        return 1
    approved_by, approved_at = review["login"], review["submittedAt"]

    sha = _approval_sha_worktree(root, change)
    if sha is None:
        print(f"gatedloop: no plan artifact files found for change '{change}' to hash — nothing to attest.", file=sys.stderr)
        return 1

    written = _write_approval_keys(root, change, approved_by, approved_at, sha)
    if written is None:
        print(f"gatedloop: {_openspec_yaml_path(root, change)} does not exist.", file=sys.stderr)
        return 1
    print(f"gatedloop: attested approval of '{change}' from PR #{pr} — approved_by={approved_by}")
    return 0


_MERGED_PR_FIELDS = "state,mergedAt,mergedBy,baseRefName,mergeCommit,headRefName"


def _merged_pr_record(root: Path, pr: int, head: str | None,
                      merged_what: str) -> tuple[dict | None, str]:
    """The forge checks both `--merged` writers share (planner-handoff D2,
    merged-acceptance D1): `({"commit", "login", "merged_at"}, "")` from the
    forge's record of PR `pr`'s merge into the merge target, or `(None,
    refusal)` naming the first unmet condition. `head`, when given, is the
    head branch the PR must have come from. `merged_what` finishes "only
    ..." in the not-merged refusal. Reads only; the caller writes."""
    nothing = "Nothing was written."
    try:
        state, detail = _forge_cli_state(root)
        if state != "ready":
            raise _ForgeRefusal(detail)
        rec = _gh_json(root, "pr", "view", str(pr), "--json", _MERGED_PR_FIELDS)
    except _ForgeRefusal as refusal:
        return None, f"{refusal.message} {nothing}"
    rec = rec if isinstance(rec, dict) else {}
    if rec.get("state") != "MERGED":
        return None, (
            f"gatedloop: PR #{pr} is {rec.get('state') or 'in no known state'}, not MERGED — "
            f"only {merged_what}. {nothing}"
        )
    if head is not None and rec.get("headRefName") != head:
        return None, (
            f"gatedloop: PR #{pr}'s head branch is '{rec.get('headRefName')}', not "
            f"'{head}' — it is not this change's pull request. {nothing}"
        )
    target, reason = _resolve_merge_target(root)
    if target is None:
        return None, f"gatedloop: no merge target resolved ({reason}). {nothing}"
    target_branch = _local_counterpart_branch(target) or target
    base = rec.get("baseRefName")
    if base != target_branch:
        return None, (
            f"gatedloop: PR #{pr} was merged into '{base}', not the merge target "
            f"'{target_branch}' ({target}). {nothing}"
        )
    commit = str((rec.get("mergeCommit") or {}).get("oid") or "").strip()
    if not commit or _rev(root, commit) is None or not _is_ancestor(root, commit, target):
        return None, (
            f"gatedloop: PR #{pr}'s merge commit {commit[:12] or '(none)'} is not on "
            f"'{target}' — fetch the target and run this again. {nothing}"
        )
    login = str((rec.get("mergedBy") or {}).get("login") or "").strip()
    merged_at = str(rec.get("mergedAt") or "").strip()
    if not login or not merged_at:
        return None, (
            f"gatedloop: PR #{pr}'s merge record names no merger or no merge time — "
            f"refusing to write an unattested value. {nothing}"
        )
    return {"commit": commit, "login": login, "merged_at": merged_at}, ""


def _merged_plan_approval(m: dict, root: Path, change: str, pr: int) -> tuple[tuple | None, str]:
    """planner-handoff D1/D2: `((approved_by, approved_at, sha), "")` from
    the forge's record of plan PR `pr`'s merge, or `(None, refusal)` naming
    the first unmet condition. Reads only; the caller writes."""
    nothing = "Nothing was written."
    policy = _approval_policy(m)
    if policy != "self":
        return None, (
            f"gatedloop: --merged is legitimate only under `approval.plan: self` (the "
            f"declared policy is {policy!r}) — under review the approval comes from the "
            f"PR's approving review: `gates approval attest {change} --pr {pr}`. {nothing}"
        )
    rec, reason = _merged_pr_record(root, pr, None, "a merged plan PR attests the plan")
    if rec is None:
        return None, reason
    commit = rec["commit"]
    proposal = f"openspec/changes/{change}/proposal.md"
    if _git(root, "cat-file", "-e", f"{commit}:{proposal}").returncode != 0:
        return None, (
            f"gatedloop: {proposal} is absent from PR #{pr}'s merge commit {commit[:12]} — "
            f"that PR did not merge this change's plan. {nothing}"
        )
    sha = _approval_sha_ref(root, change, commit)
    if sha is None:
        return None, (
            f"gatedloop: PR #{pr}'s merge commit holds no plan to hash — refusing to "
            f"write an unattested value. {nothing}"
        )
    return (f"{rec['login']} (merged #{pr})", rec["merged_at"], sha), ""


def cmd_handoff(m: dict, root: Path, args) -> int:
    """`gates handoff <change> [--json]` (planner-handoff D5): the payload a
    planner sends the orchestrator, printed only when the approval check
    `check-implement` runs passes on the merge target. It reads only: a
    doorbell, never evidence, so the receiver re-runs `verify`."""
    change = args.change
    ok, ref, reason = _approval_check_at(root, change, m)
    if not ok:
        print(f"gatedloop: {reason}", file=sys.stderr)
        return 1
    data = _openspec_yaml_at_ref(root, change, ref) or {}
    by, at, sha = _approval_meta(data)
    epic = _meta_value(data, EPIC_KEY)
    tasks = _git(root, "show", f"{ref}:openspec/changes/{change}/tasks.md")
    payload = {
        "handoff": 1, "change": change, "schema": data.get("schema"),
        "target": ref, "target_head": _rev(root, ref),
        "approval": {"by": by, "at": at, "sha": sha},
        "epic": epic.strip() if isinstance(epic, str) and epic.strip() else None,
        "tasks": _tasks_progress_text(tasks.stdout if tasks.returncode == 0 else ""),
        "verify": f"gates approval check {change}",
    }
    if args.json:
        print(json.dumps(payload))
        return 0
    approval, progress = payload["approval"], payload["tasks"]
    payload["approval"] = f"{approval['by']} at {approval['at']}, sha {approval['sha']}"
    payload["tasks"] = f"{progress['done']} of {progress['total']} done"
    payload["epic"] = payload["epic"] or "none"
    for key, value in payload.items():
        print(f"{key}: {value}")
    return 0


def _record_approval_row(root: Path, change: str, approved_by: str, approved_at: str, sha: str) -> None:
    """D4: the one approval row both machine-side writers append."""
    _append_ledger_row(root, {
        "ts": approved_at, "gate": "approval-local", "exit": 0, "duration_ms": 0,
        "change": change, "task": None, "tree": _head_tree(root), "attempt": None,
        "approved_by": approved_by, "sha": sha,
    })


def cmd_approval_attest_merged(m: dict, root: Path, change: str, pr: int) -> int:
    """`gates approval attest <change> --merged <pr>` (planner-handoff D1,
    D2, D4): under `self`, the merge of the plan PR is the approval. The
    identity and time are the forge's; the sha is the shim's, over the plan
    as it stands in the merge commit, never the working tree."""
    approval, reason = _merged_plan_approval(m, root, change, pr)
    if approval is None:
        print(reason, file=sys.stderr)
        return 1
    approved_by, approved_at, sha = approval
    if _write_approval_keys(root, change, approved_by, approved_at, sha) is None:
        print(f"gatedloop: {_openspec_yaml_path(root, change)} does not exist. Nothing was written.",
              file=sys.stderr)
        return 1
    _record_approval_row(root, change, approved_by, approved_at, sha)
    print(f"gatedloop: attested approval of '{change}' from the merge of PR #{pr} — "
          f"approved_by={approved_by}")
    return 0


# ---------- acceptance (acceptance-gate D1-D5) -----------------------------
#
# The human gate AFTER the loop, built to plan approval's standard: attested
# from a human act, pinned to exact content, never self-reported. Two things
# differ from plan approval, both on purpose:
#
#   * The pin is a TREE, not a content hash, so the record cannot live in any
#     file inside that tree (writing it would change what it pins). It is a
#     ledger row: `.gatedloop/runs/**` is stripped from every normalized tree
#     (`_normalize_tree`) and survives the squash, so it is the one place an
#     acceptance can be recorded without invalidating itself (D2).
#   * Acceptance is opt-in, so the check reads the policy to decide whether to
#     require anything at all (D1); once declared it reads rows, never the
#     policy's value (D4).
#
# A rejection is an escalation (D2): at acceptance every declared oracle has
# already passed, so "no" means either the spec asked for the wrong thing
# (`weak-spec`) or nothing checked what it asked for (`missing-oracle`). The
# other halt causes describe the loop's own stopping, which is over by now.

ACCEPTANCE_VERDICTS = ("accept", "reject")
ACCEPTANCE_REJECT_CAUSES = ("weak-spec", "missing-oracle")


def _acceptance_no_policy_refusal() -> str:
    return (
        "gatedloop: no acceptance policy is declared — add `approval.acceptance: "
        "review | self` to the manifest before recording an acceptance. With none "
        "declared no acceptance is required and nothing would read the row. "
        "Nothing was written."
    )


def _acceptance_branch_head(root: Path, change: str) -> tuple[str | None, str | None]:
    """`(raw tree, commit sha)` of the change branch's head: the local branch
    named `change` when one exists (branch name = change name), else the
    current HEAD. Computed here, never supplied by the caller (D3)."""
    for ref in (f"refs/heads/{change}", "HEAD"):
        sha = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
            cwd=root, capture_output=True, text=True,
        ).stdout.strip()
        if sha:
            return _commit_tree(root, sha), sha
    return None, None


def _append_acceptance_row(root: Path, change: str, verdict: str, accepted_by: str,
                           ts: str, cause: str | None = None,
                           detail: str | None = None,
                           pin: tuple[str, str] | None = None) -> int:
    """`pin` is `(normalized tree, commit sha)` when the caller computed what
    the row pins (a merged PR pins its merge commit, merged-acceptance D2);
    otherwise the change branch's head."""
    if pin is not None:
        tree, sha = pin
    else:
        raw, sha = _acceptance_branch_head(root, change)
        if not raw:
            print(
                f"gatedloop: could not resolve the head tree of change '{change}' — "
                "refusing to record an acceptance that pins no tree. Nothing was written.",
                file=sys.stderr,
            )
            return 1
        tree = _normalize_tree(root, raw)
    try:
        _append_ledger_row(root, {
            "ts": ts, "gate": ACCEPTANCE_EVENT, "exit": None, "duration_ms": 0,
            "change": change, "task": None, "tree": tree, "attempt": None,
            "approved_by": _read_approved_by(root, change), "sha": sha,
            "verdict": verdict, "cause": cause, "detail": detail,
            "accepted_by": accepted_by,
        })
    except OSError as e:
        print(
            f"gatedloop: could not append the acceptance row to "
            f"{_ledger_path(root, change)}: {e}",
            file=sys.stderr,
        )
        return 1
    extra = f" (cause {cause})" if cause else ""
    print(
        f"gatedloop: recorded acceptance {verdict}{extra} of '{change}' by "
        f"{accepted_by} on (ledger-normalized) tree {tree} in "
        f"{_ledger_path(root, change)}. Commit the row with the change — the "
        "ledger is outside the accepted tree, so committing it cannot disturb it."
    )
    return 0


def _merged_acceptance(m: dict, root: Path, change: str, pr: int) -> tuple[tuple | None, str]:
    """merged-acceptance D1/D2: `((accepted_by, ts, normalized tree, merge
    commit), "")` from the forge's record of implementation PR `pr`'s merge,
    or `(None, refusal)`. Legitimate only under `approval.acceptance: self`,
    where the owner's merge is the acceptance. The tree is the merge
    commit's, normalized as the merge row records it. Reads only."""
    policy = _acceptance_policy(m)
    if policy is None:
        return None, _acceptance_no_policy_refusal()
    if policy != "self":
        return None, (
            f"gatedloop: --merged is legitimate only under `approval.acceptance: self` "
            f"(the declared policy is {policy!r}) — under review a second party accepts "
            f"through the pull request's approving review: `gates acceptance attest "
            f"{change} --pr {pr}`. Nothing was written."
        )
    rec, reason = _merged_pr_record(
        root, pr, change, "a merged implementation PR of this change attests its acceptance",
    )
    if rec is None:
        return None, reason
    raw = _commit_tree(root, rec["commit"])
    if not raw:
        return None, (
            f"gatedloop: could not read the tree of PR #{pr}'s merge commit "
            f"{rec['commit'][:12]} — refusing to record an acceptance that pins no tree. "
            "Nothing was written."
        )
    tree = _normalize_tree(root, raw)
    return (f"{rec['login']} (merged #{pr})", rec["merged_at"], tree, rec["commit"]), ""


def _accepted_already(root: Path, change: str, tree: str) -> dict | None:
    """The latest acceptance row for normalized `tree` in the change's
    ledger, when its verdict is `accept`; else `None`."""
    latest = None
    for r in _read_ledger_rows(root, change):
        if r.get("gate") == ACCEPTANCE_EVENT and r.get("tree") == tree:
            latest = r
    return latest if latest is not None and latest.get("verdict") == "accept" else None


def _acceptance_attest_merged(m: dict, root: Path, change: str, pr: int) -> int:
    """`gates acceptance attest <change> --merged <pr>` (merged-acceptance
    D1): under `self`, the owner's merge of the implementation PR is the
    acceptance. Writes nothing when that tree is already accepted."""
    accepted, reason = _merged_acceptance(m, root, change, pr)
    if accepted is None:
        print(reason, file=sys.stderr)
        return 1
    accepted_by, ts, tree, commit = accepted
    existing = _accepted_already(root, change, tree)
    if existing is not None:
        print(
            f"gatedloop: (ledger-normalized) tree {tree} of '{change}' is already accepted "
            f"(by {existing.get('accepted_by') or 'unknown'}) — nothing was written."
        )
        return 0
    return _append_acceptance_row(root, change, "accept", accepted_by, ts, pin=(tree, commit))


def _acceptance_attest(m: dict, root: Path, args) -> int:
    """`gates acceptance attest <change> --local | --pr <n> | --merged <n>`
    (D3). Legitimacy mirrors plan approval: `--local` and `--merged` only
    under `self`; `--pr` under either policy, since a real review is always
    acceptable evidence; none with no policy declared. The tree is computed
    here; the identity comes from git config (`--local`, with an optional
    `--as` display override), from the review itself (`--pr`) or from the
    forge's merge record (`--merged`), where `--as` is refused."""
    change = args.change
    if getattr(args, "as_name", None) and not args.local:
        print(
            "gatedloop: --as only applies to --local — a --pr or --merged acceptance's "
            "accepted_by comes from the pull request's actual approving review or merge, "
            "never a supplied override.",
            file=sys.stderr,
        )
        return 1
    if getattr(args, "merged", None) is not None:
        return _acceptance_attest_merged(m, root, change, args.merged)
    policy = _acceptance_policy(m)
    if policy is None:
        print(_acceptance_no_policy_refusal(), file=sys.stderr)
        return 1

    if args.local:
        if policy != "self":
            print(
                f"gatedloop: local acceptance is not legitimate under the declared "
                f"acceptance policy ({policy!r}) — a second party accepts via the "
                f"pull request's review: `gates acceptance attest {change} --pr <n>`.",
                file=sys.stderr,
            )
            return 1
        who = args.as_name or _local_git_identity(root)
        if not who:
            print(
                "gatedloop: no git identity configured (user.name/user.email) and no "
                "--as given — refusing to record an unattributed acceptance.",
                file=sys.stderr,
            )
            return 1
        return _append_acceptance_row(root, change, "accept", who, _now_iso())

    review, reason = _first_approving_review(
        root, args.pr, "acceptance", "merged or commented is not accepted",
    )
    if review is None:
        print(reason, file=sys.stderr)
        return 1
    return _append_acceptance_row(
        root, change, "accept", review["login"], review["submittedAt"] or _now_iso(),
    )


def _acceptance_reject(m: dict, root: Path, args) -> int:
    """`gates acceptance reject <change> --cause <c> --detail <t>` (D2, D3):
    legitimate under either declared policy, identity as for `--local`."""
    if _acceptance_policy(m) is None:
        print(_acceptance_no_policy_refusal(), file=sys.stderr)
        return 1
    cause = args.cause
    if cause not in ACCEPTANCE_REJECT_CAUSES:
        print(
            f"gatedloop: refusing to record a rejection with cause '{cause}'. At "
            "acceptance every declared oracle has already passed, so a rejection "
            "means either the spec asked for the wrong thing (weak-spec) or the "
            "spec was right and no oracle checked it (missing-oracle). Accepted: "
            f"{', '.join(ACCEPTANCE_REJECT_CAUSES)}. Nothing was written.",
            file=sys.stderr,
        )
        return 1
    detail = getattr(args, "detail", None)
    if not (detail and detail.strip()):
        print(
            "gatedloop: refusing to record a rejection with no detail — pass "
            "`--detail <text>` saying what the behaviour did and what was meant, "
            "so the escalation can be acted on. Nothing was written.",
            file=sys.stderr,
        )
        return 1
    who = getattr(args, "as_name", None) or _local_git_identity(root)
    if not who:
        print(
            "gatedloop: no git identity configured (user.name/user.email) and no "
            "--as given — refusing to record an unattributed rejection.",
            file=sys.stderr,
        )
        return 1
    return _append_acceptance_row(
        root, args.change, "reject", who, _now_iso(), cause=cause, detail=detail,
    )


def _parse_jsonl_rows(text: str) -> list[dict]:
    rows: list[dict] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except Exception:
            continue
        if isinstance(obj, dict):
            rows.append(obj)
    return rows


def _acceptance_rows_for(root: Path, tree: str, change: str | None) -> list[dict]:
    """Every `acceptance` row that could speak about `tree`, in ledger order.

    Two sources, because the check runs in two places. On the change branch
    the working-tree ledger holds every row, committed or not. At squash-merge
    time the merge target is checked out and its working tree has no ledger
    for the change at all -- but a committed row travels INSIDE the incoming
    tree, so its `.gatedloop/runs/*.jsonl` blobs are read too. Committed rows
    come first, then working-tree rows not already seen (the working-tree
    file is the append-only continuation of the committed one), so "latest"
    is file order across both. `change` narrows to that change's ledger when
    it is known; on the merge target it is not, and every ledger is read --
    the tree pin, not the file name, is what identifies the increment."""
    names: list[str] | None = [f"{change}.jsonl"] if change else None
    seen: set[str] = set()
    out: list[dict] = []

    def take(rows: list[dict]) -> None:
        for r in rows:
            if r.get("gate") != ACCEPTANCE_EVENT:
                continue
            key = json.dumps(r, sort_keys=True)
            if key in seen:
                continue
            seen.add(key)
            out.append(r)

    ls = subprocess.run(
        ["git", "ls-tree", "-r", "--name-only", tree, "--", *LEDGER_PREFIXES],
        cwd=root, capture_output=True, text=True,
    )
    if ls.returncode == 0:
        for rel in sorted(p for p in ls.stdout.splitlines() if p.endswith(".jsonl")):
            if names is not None and Path(rel).name not in names:
                continue
            blob = subprocess.run(
                ["git", "cat-file", "blob", f"{tree}:{rel}"],
                cwd=root, capture_output=True, text=True,
            )
            if blob.returncode == 0:
                take(_parse_jsonl_rows(blob.stdout))

    runs = _state_dir(root) / "runs"
    if runs.is_dir():
        for p in sorted(runs.glob("*.jsonl")):
            if names is not None and p.name not in names:
                continue
            try:
                take(_parse_jsonl_rows(p.read_text()))
            except OSError:
                continue
    return out


def _acceptance_check(m: dict, root: Path, args) -> int:
    """`gates acceptance check <tree>` (D4): the merge gate's fourth piece of
    evidence. A ledger read -- no gate runs."""
    policy = _acceptance_policy(m)
    if policy is None:
        print(
            "gatedloop: acceptance not required — no `approval.acceptance` is declared."
        )
        return 0
    tree = args.tree
    normalized = _normalize_tree(root, tree)
    change = _resolve_change_name(root, getattr(args, "change", None))
    latest = None
    for r in _acceptance_rows_for(root, tree, change):
        if r.get("tree") == normalized:
            latest = r
    name = change or "<change>"
    writer = (
        f"gates acceptance attest {name} --local" if policy == "self"
        else f"gates acceptance attest {name} --pr <n>"
    )
    if latest is None:
        print(
            f"gatedloop: no acceptance recorded for (ledger-normalized) tree "
            f"{normalized!r} — `approval.acceptance: {policy}` requires a human to "
            f"accept this exact tree before the merge. Generate the brief with "
            f"`gates acceptance brief {name}`, have it accepted, then record it with "
            f"`{writer}` on the change branch.",
            file=sys.stderr,
        )
        return 1
    if latest.get("verdict") == "accept":
        print(
            f"gatedloop: acceptance matches — tree {tree} accepted by "
            f"{latest.get('accepted_by') or 'unknown'} ({latest.get('ts') or 'no timestamp'})"
        )
        return 0
    if latest.get("verdict") == "reject":
        print(
            f"gatedloop: the latest acceptance verdict for (ledger-normalized) tree "
            f"{normalized!r} is a REJECTION (cause {latest.get('cause')}: "
            f"{latest.get('detail') or 'no detail'}) by "
            f"{latest.get('accepted_by') or 'unknown'}. The merge stays blocked until "
            f"a later acceptance of this tree (`{writer}`) or of a revised one.",
            file=sys.stderr,
        )
        return 1
    print(
        f"gatedloop: the latest acceptance row for (ledger-normalized) tree "
        f"{normalized!r} has an unknown verdict {latest.get('verdict')!r} — treating "
        f"it as not accepted. Record a fresh verdict with `{writer}`.",
        file=sys.stderr,
    )
    return 1


# ---- the acceptance brief (D5) --------------------------------------------
#
# A deterministic view generated from data the shim owns -- spec scenarios,
# the files under `acceptance.match`, and ledger rows for the head tree --
# never authored or amended by a model: self-reported evidence is what the
# acceptance gate exists to remove. Stack-blind by construction: the shim
# knows one glob and the marker set below, never a format or a runner.

# The documented marker set: a line of an `acceptance.match` file whose text,
# after one of these markers, equals a spec scenario title (compared
# case-insensitively, surrounding whitespace trimmed) makes that scenario
# `covered`. Longest first, so `#### Scenario:` is never read as `Scenario:`.
ACCEPTANCE_TITLE_MARKERS = ("#### Scenario:", "Scenario Outline:", "- Scenario:", "Scenario:")
_SPEC_SCENARIO_RE = re.compile(r"^####\s+Scenario:\s*(.+?)\s*$")
BRIEF_VERDICT_GATES = ("verify", "live-check", "integration", "ci")


def _brief_spec_scenarios(change_dir: Path) -> list[tuple[str, list[str]]]:
    """`[(capability, [scenario titles...]), ...]` ordered by spec path, then
    file order."""
    specs = change_dir / "specs"
    out: list[tuple[str, list[str]]] = []
    if not specs.is_dir():
        return out
    for spec in sorted(specs.rglob("spec.md"), key=lambda p: p.relative_to(specs).as_posix()):
        capability = spec.parent.relative_to(specs).as_posix()
        titles = []
        for line in spec.read_text().splitlines():
            mt = _SPEC_SCENARIO_RE.match(line.strip())
            if mt:
                titles.append(mt.group(1))
        out.append((capability, titles))
    return out


def _brief_title_key(title: str) -> str:
    return title.strip().casefold()


def _brief_acceptance_titles(root: Path, glob: str) -> tuple[set[str], int]:
    """Casefolded scenario titles found in the files `glob` matches (tracked
    or untracked-but-not-ignored), and how many files matched."""
    listed = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        cwd=root, capture_output=True, text=True,
    )
    paths = sorted(set(p for p in listed.stdout.splitlines() if p.strip())) if listed.returncode == 0 else []
    # `**/` is zero or more directories here (`features/**/*.feature` must
    # match `features/login.feature`), so each pattern is also tried with it
    # removed; `_matches` alone collapses `**` to `*`, which demands one.
    patterns = []
    for g in _expand_braces(glob):
        patterns.append(g)
        if "**/" in g:
            patterns.append(g.replace("**/", ""))
    matched = [p for p in paths if any(_matches(p, g) for g in patterns)]
    titles: set[str] = set()
    for rel in matched:
        try:
            text = (root / rel).read_text(errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            s = line.strip()
            for marker in ACCEPTANCE_TITLE_MARKERS:
                if s.startswith(marker):
                    title = s[len(marker):]
                    if title.strip():
                        titles.add(_brief_title_key(title))
                    break
    return titles, len(matched)


def _brief_verdicts(root: Path, change: str, head_raw: str, head_norm: str) -> list[str]:
    """One line per gate in BRIEF_VERDICT_GATES plus `review`: the latest row
    recorded for the (ledger-normalized) head tree, or `absent`. A row for
    any other tree is never shown -- a verdict on an earlier tree says
    nothing about this one."""
    cache: dict[str, str] = {head_raw: head_norm}

    def same_tree(raw) -> bool:
        if not isinstance(raw, str) or not raw:
            return False
        if raw not in cache:
            cache[raw] = _normalize_tree(root, raw)
        return cache[raw] == head_norm

    rows = _read_ledger_rows(root, change)
    lines = []
    for gate in BRIEF_VERDICT_GATES + ("review",):
        latest = None
        for r in reversed(rows):
            if r.get("gate") == gate and same_tree(r.get("tree")):
                latest = r
                break
        if latest is None:
            lines.append(f"- {gate}: absent")
            continue
        exit_code = latest.get("exit")
        if gate == "review":
            word = "clean" if exit_code == 0 else "findings"
        elif latest.get("verdict") == "skip":
            word = "skip"
        else:
            word = "pass" if exit_code == 0 else "fail"
        lines.append(f"- {gate}: {word} (exit {exit_code}, {latest.get('ts') or 'no timestamp'})")
    return lines


def _render_acceptance_brief(m: dict, root: Path, change: str) -> str | None:
    change_dir = root / "openspec" / "changes" / change
    if not change_dir.is_dir():
        return None
    head_raw, _sha = _acceptance_branch_head(root, change)
    head_norm = _normalize_tree(root, head_raw) if head_raw else None
    policy = _acceptance_policy(m)
    acc_block = m.get("acceptance") if isinstance(m.get("acceptance"), dict) else {}
    glob = acc_block.get("match") if isinstance(acc_block.get("match"), str) else None

    lines = [f"# Acceptance brief: {change}", ""]
    lines.append(f"Tree: {head_norm or 'unresolved'} (ledger-normalized head of `{change}`)")
    if policy is None:
        lines.append(
            "Acceptance policy: none declared — acceptance is not required to merge; "
            "this brief is information for whoever merges."
        )
    else:
        lines.append(
            f"Acceptance policy: {policy} — the merge requires an `accept` recorded "
            "against exactly this tree."
        )
    if glob is None:
        known: set[str] = set()
        lines.append(
            "Coverage: no acceptance artifact location is declared (`acceptance.match` "
            "is absent), so no scenario can be matched — every scenario is `check by hand`."
        )
    else:
        known, n_files = _brief_acceptance_titles(root, glob)
        lines.append(
            f"Coverage: scenario titles matched against {n_files} file(s) under "
            f"`acceptance.match` (`{glob}`)."
        )
    lines.append("")

    lines.append("## Scenarios")
    lines.append("")
    by_hand: list[str] = []
    scenarios = _brief_spec_scenarios(change_dir)
    if not any(titles for _cap, titles in scenarios):
        lines.append("No `#### Scenario:` found in this change's specs.")
        lines.append("")
    for capability, titles in scenarios:
        if not titles:
            continue
        lines.append(f"### {capability}")
        lines.append("")
        for title in titles:
            if _brief_title_key(title) in known:
                lines.append(f"- covered — {title}")
            else:
                lines.append(f"- check by hand — {title}")
                by_hand.append(f"- {capability}: {title}")
        lines.append("")

    lines.append("## Verdicts for this tree")
    lines.append("")
    if head_raw and head_norm:
        lines.extend(_brief_verdicts(root, change, head_raw, head_norm))
    else:
        lines.append("- the head tree could not be resolved, so no verdict can be shown")
    lines.append("")

    lines.append("## Check these by hand")
    lines.append("")
    if by_hand:
        lines.extend(by_hand)
    else:
        lines.append("Nothing — every scenario has a same-titled acceptance scenario.")
    lines.append("")

    lines.append("## What this brief can and cannot claim")
    lines.append("")
    lines.append(
        "`covered` means an acceptance artifact of that name exists and the declared "
        "gate ran green on this tree (read it with the verdicts above); it does not "
        "mean the artifact asserts the scenario's outcome. No artifact links "
        "(screenshots, traces, recordings) are included yet. This brief is generated "
        "from the specs, the ledger and the head tree — not written by a model."
    )
    return "\n".join(lines) + "\n"


def _acceptance_brief(m: dict, root: Path, args) -> int:
    change = args.change
    text = _render_acceptance_brief(m, root, change)
    if text is None:
        print(
            f"gatedloop: no change '{change}' — "
            f"{root / 'openspec' / 'changes' / change} does not exist, so there are "
            "no scenarios to brief.",
            file=sys.stderr,
        )
        return 1
    out = getattr(args, "out", None)
    if out:
        dest = Path(out)
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(text)
        except OSError as e:
            print(f"gatedloop: could not write the brief to {dest}: {e}", file=sys.stderr)
            return 1
        print(f"gatedloop: wrote the acceptance brief for '{change}' to {dest}")
        return 0
    sys.stdout.write(text)
    return 0


def cmd_acceptance(m: dict, root: Path, args) -> int:
    sub = args.acceptance_cmd
    if sub == "brief":
        return _acceptance_brief(m, root, args)
    if sub == "policy":
        print(f"acceptance={_acceptance_policy(m) or 'none'}")
        return 0
    if sub == "attest":
        return _acceptance_attest(m, root, args)
    if sub == "reject":
        return _acceptance_reject(m, root, args)
    if sub == "check":
        return _acceptance_check(m, root, args)
    sys.exit(f"gatedloop: unknown acceptance subcommand '{sub}'")


# ---------- git discipline (D9: enforced, not described) ------------------

def _resolve_current_branch_or_none(root: Path) -> str | None:
    return _current_branch(root)


# ---------- D9 admits plan branches (design D3, unblock-parallel-planning) -

def _shares_history_with_target(root: Path, target: str) -> bool:
    """Whether HEAD and `target` share any commit history at all (a real
    merge-base exists) -- this is deliberately NOT "is target's CURRENT tip
    an ancestor of HEAD": once `target` receives new commits after a plan
    branch was cut, its tip is never an ancestor of the plan branch's
    (unchanged) HEAD, yet design D3 explicitly still allows that stale
    branch. A merge-base existing is what actually guards against the
    disqualifying case -- a `plan/*` branch built on wholly unrelated
    history (e.g. an orphan branch) -- without penalizing a merely-behind
    one."""
    try:
        out = subprocess.run(
            ["git", "merge-base", target, "HEAD"],
            cwd=root, capture_output=True, text=True,
        )
        return out.returncode == 0 and bool(out.stdout.strip())
    except Exception:
        return False


def _stale_plan_branch_advisory(root: Path, target: str) -> str:
    """Empty string if `target`'s tip is already reachable from HEAD (the
    plan branch is current); otherwise a one-line advisory naming how many
    commits behind -- printed, never refused (design D3: "refusing would
    make every long review block its own amendments")."""
    if _is_ancestor(root, target, "HEAD"):
        return ""
    out = subprocess.run(
        ["git", "rev-list", "--count", f"HEAD..{target}"],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0 or not out.stdout.strip():
        return ""
    count = out.stdout.strip()
    return (
        f"this branch is {count} commit(s) behind '{target}' — still "
        "allowed, but consider rebasing before merging the plan."
    )


DEFAULT_AGENT_ENV = ("CLAUDECODE",)
_ENV_NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def _agent_env_problem(value) -> str | None:
    """Why `discipline.agent-env` is not a non-empty list of environment
    variable names (git-layer-enforcement D1), or None when it is."""
    if (not isinstance(value, list) or not value
            or not all(isinstance(v, str) and _ENV_NAME_RE.match(v) for v in value)):
        return ("discipline.agent-env must be a non-empty list of environment variable "
                f"names (letters, digits and _, not starting with a digit); got {value!r}")
    return None


def _agent_env_names(root: Path) -> list[str]:
    """The variables that mark an agent session: the manifest's
    `discipline.agent-env` when it is valid, else the default `[CLAUDECODE]`.
    Read without `load_manifest`, because the git hooks ask this in
    repositories with no manifest yet. A malformed declaration falls back to
    the default and says so on stderr -- never an error, which would make
    every hook deny, a human's commit included; `gates validate` is where it
    fails loud."""
    path, _ignored = _find_manifest(root)
    if path is None:
        return list(DEFAULT_AGENT_ENV)
    try:
        data = _load(path) or {}
    except Exception as e:
        print(f"gatedloop: could not read {path.name} ({e}); deciding the agent session "
              f"by the default discipline.agent-env {list(DEFAULT_AGENT_ENV)}", file=sys.stderr)
        return list(DEFAULT_AGENT_ENV)
    disc = data.get("discipline") if isinstance(data, dict) else None
    if not isinstance(disc, dict) or "agent-env" not in disc:
        return list(DEFAULT_AGENT_ENV)
    problem = _agent_env_problem(disc.get("agent-env"))
    if problem:
        print(f"gatedloop: {problem} — deciding the agent session by the default "
              f"{list(DEFAULT_AGENT_ENV)}; `gates validate` reports it", file=sys.stderr)
        return list(DEFAULT_AGENT_ENV)
    return list(disc["agent-env"])


def cmd_agent_session(root: Path) -> int:
    """`gates discipline agent-session` (git-layer-enforcement D1): exit 0
    when any declared agent-env variable is set to a non-empty value, else 1.
    The git-layer hooks are a no-op on 1, so the decision lives here, once."""
    names = _agent_env_names(root)
    return 0 if any(os.environ.get(n) for n in names) else 1


def _declared_propose_branch_patterns(m: dict) -> list[str]:
    """The accepted non-target branch-name globs (design D3, worktree-
    native-loop): the manifest's `discipline.propose-branches` when present
    and valid (REPLACES the default, not appended to), else exactly today's
    `['plan/*']`. A malformed block is `gates validate`'s business, not a
    silent behavior change here -- an invalid declaration falls back to the
    default rather than accepting everything or nothing."""
    disc = m.get("discipline")
    if isinstance(disc, dict) and isinstance(disc.get("propose-branches"), list):
        patterns = [p for p in disc["propose-branches"] if isinstance(p, str) and p.strip()]
        if patterns:
            return patterns
    return ["plan/*"]


def _propose_branch_verdict(root: Path, m: dict | None = None) -> tuple[bool, str]:
    """(allowed, message) for the proposal-authoring discipline shared by
    `check-propose` (an artifact write) and `check-propose --scaffold` (the
    `openspec new change` step, design D4) -- one judgement, reused, so the
    two callers can never disagree. `message` is a refusal rationale when
    `allowed` is False, or a possibly-empty advisory when True.

    `m` is the loaded manifest (design D3, worktree-native-loop): when it
    declares `discipline.propose-branches`, those patterns replace the
    default `plan/*` for every non-target branch. The merge target itself is
    always accepted and cannot be de-declared; every non-target branch,
    declared pattern or default, must still share history with it -- a
    pattern admits a NAME, never an orphan history."""
    patterns = _declared_propose_branch_patterns(m or {})
    branch = _resolve_current_branch_or_none(root)
    target, _reason = _resolve_merge_target(root)
    main_name = (target or "main").split("/")[-1]
    if branch is None:
        # Fail closed, not open (a `PreToolUse` denial that errors open is
        # worse than no hook): detached HEAD or an unreadable git state
        # means "on the target" cannot be confirmed either way.
        return False, "could not determine the current branch — refusing until git state is resolved."
    if branch == main_name or branch in ("main", "master"):
        return True, ""
    if (
        any(fnmatch.fnmatch(branch, pat) for pat in patterns)
        and target is not None
        and _shares_history_with_target(root, target)
    ):
        return True, _stale_plan_branch_advisory(root, target)
    permitted = ", ".join(f"'{p}'" for p in patterns)
    # An exact, runnable example (design D5 of harden-hook-matching: name the
    # command, not just the rule) for the first `<prefix>/*`-shaped pattern —
    # covers the unmodified default (`plan/*`) and any declared equivalent
    # (`worktree/*`) alike; patterns with no `*` wildcard have no single
    # branch name to demonstrate, so they're only named in the permitted set.
    example = ""
    for pat in patterns:
        if pat.endswith("/*"):
            prefix = pat[: -len("/*")]
            example = f" (e.g. `git checkout -b {prefix}/<name> {main_name}`)"
            break
    return False, (
        f"branch '{branch}' is neither the merge target ('{main_name}') nor "
        f"a declared accepted pattern ({permitted}) based on it — proposals "
        "run on the merge target, or on an accepted branch, where other "
        f"in-flight changes and the authoritative specs are visible (design "
        f"D9) — switch to it (`git checkout {main_name}`) or start a branch "
        f"matching an accepted pattern based on it{example}, then retry."
    )


def _rev(root: Path, ref: str) -> str | None:
    out = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
        cwd=root, capture_output=True, text=True,
    )
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


def _is_integrating(root: Path) -> bool:
    """Whether a merge run in this checkout integrates INTO the target
    (hook-correctness D2): the current branch is the target's branch, or a
    detached HEAD sits exactly at the target's tip (the merge recipe's
    detach onto it). An unresolvable target counts as integrating -- the
    merge stays gated rather than slipping through on missing evidence."""
    target, _reason = _resolve_merge_target(root)
    if target is None:
        return True
    branch = _current_branch(root)
    if branch is not None:
        return branch == target.split("/")[-1]
    head = _rev(root, "HEAD")
    return head is not None and head == _rev(root, target)


def _untracked_unproposed_change_dirs(root: Path) -> list[str]:
    """`openspec/changes/<name>` directories that are wholly untracked --
    debris from an earlier scaffold that was refused or abandoned before
    ever being committed (design D4, closing issue #7's debris half).
    `--untracked-files=all` (not the default) is required here: git's
    default collapses a wholly-untracked directory to one `?? openspec/`
    line rather than descending into it, which would hide the change name."""
    out = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=all"],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return []
    # hook-correctness D5: "unproposed" means untracked at the integration
    # target's tip -- a directory the target already tracks is proposed, even
    # when this checkout (an older branch) holds it untracked.
    target, _reason = _resolve_merge_target(root)
    names: list[str] = []
    for line in out.stdout.splitlines():
        if not line.startswith("??"):
            continue
        path = line[3:].strip().replace("\\", "/")
        m_ = re.match(r"^openspec/changes/([^/]+)/", path)
        if not m_ or m_.group(1) in names or m_.group(1) == "archive":
            continue
        if target is not None and _change_present_on_ref(root, m_.group(1), target):
            continue
        names.append(m_.group(1))
    return names


def _debris_advisory(root: Path) -> str:
    """Empty string if there's no debris; otherwise a message naming each
    untracked, unproposed change directory with its cleanup command --
    appended to a refusal, never surfaced on its own (design D4)."""
    names = _untracked_unproposed_change_dirs(root)
    if not names:
        return ""
    cleanup = "\n".join(f"    rm -r openspec/changes/{n}" for n in names)
    return (
        "found an untracked, unproposed change directory from an earlier "
        f"partial run — clean it up if it's stale:\n{cleanup}"
    )


# ---------- planning-grade commit classification (design D2, unblock-
# parallel-planning) --------------------------------------------------------
#
# A docs-only proposal commit can't break the running stack -- so it's gated
# on what it CAN break (the manifest and the OpenSpec artifacts it touches),
# not on a green `ci` that has nothing to do with prose. The planning set is
# the OpenSpec planning home (hardcoded `openspec/`, matching every other
# reference to it in this shim -- there is no existing knob for overriding
# it, and inventing one here would be a knob with no legitimate second
# value) plus the manifest's own declared `conventions.rules-doc` path, if any.

def _is_planning_path(rel: str, m: dict) -> bool:
    rel = rel.replace("\\", "/")
    if rel == "openspec" or rel.startswith("openspec/"):
        return True
    rules_doc = ((m.get("conventions") or {}).get("rules-doc") or "").replace("\\", "/")
    return bool(rules_doc) and rel == rules_doc


def _is_ledger_path(rel: str) -> bool:
    """design D5: the durable ledger (`.gatedloop/runs/**`) is excluded from
    the marker's ledger-blind hash (D1), so a staged diff consisting solely
    of ledger rows normalizes to the SAME tree as HEAD -- demanding a fresh
    `ci` marker over a delta the marker literally cannot see is a
    requirement with no possible evidence. The exclusion set is exact: one
    non-ledger path anywhere in the staged diff removes the discount."""
    rel = rel.replace("\\", "/")
    return any(rel == prefix or rel.startswith(prefix + "/") for prefix in LEDGER_PREFIXES)


def _staged_diff_paths(root: Path) -> list[str] | None:
    """The staged diff's paths, or `None` if `git diff --cached` itself
    failed (an unreadable git state -- the caller falls back to the full
    `ci` requirement rather than trusting an empty result)."""
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        return None
    return [p for p in out.stdout.splitlines() if p.strip()]


def _staged_change_dirs(staged: list[str]) -> list[str]:
    """The distinct `openspec/changes/<name>` directories touched by the
    staged diff, in a stable order -- what `openspec validate` runs against,
    one call per change rather than a blanket `--all` (a mixed-repo commit
    should not have to validate every OTHER in-flight change too). `archive`
    is the reserved namespace for archived changes (design D4 of
    `harden-hook-matching`) and never a change id on its own -- a path
    under `openspec/changes/archive/<dated-name>/…` never mints one."""
    names: list[str] = []
    for p in staged:
        parts = p.replace("\\", "/").split("/")
        if len(parts) > 2 and parts[0] == "openspec" and parts[1] == "changes":
            if parts[2] == "archive":
                continue
            if parts[2] not in names:
                names.append(parts[2])
    return names


class _ChangeStageUnreadable(Exception):
    """Raised by `_change_has_delta_content` when a change's `.openspec.yaml`
    exists but cannot be parsed — its `skip_specs` declaration is missing
    evidence, not a `False` to infer (fail-loud-gates: "missing evidence is
    never a pass", design D4's own words for the sibling `status`-unreadable
    case, applied here too)."""


def _change_has_delta_content(root: Path, change: str) -> bool:
    """Whether `change` has anything `openspec validate` can actually judge
    (design D4, worktree-native-loop): a file under its `specs/`, or its
    `.openspec.yaml` declaring `skip_specs: true` (an explicit, honest
    opt-out — never inferred). A change with neither is a legitimate
    proposal-only backlog entry, not a change lacking artifacts it claims to
    have. Raises `_ChangeStageUnreadable` if `.openspec.yaml` exists but
    can't be parsed — never silently treated as "no skip_specs"."""
    change_dir = root / "openspec" / "changes" / change
    specs_dir = change_dir / "specs"
    if specs_dir.exists() and any(p.is_file() for p in specs_dir.rglob("*")):
        return True
    yaml_path = change_dir / ".openspec.yaml"
    if yaml_path.exists():
        try:
            data = _load(yaml_path) or {}
        except Exception as e:
            raise _ChangeStageUnreadable(
                f"'{yaml_path}' could not be parsed: {e}"
            ) from e
        if isinstance(data, dict) and data.get("skip_specs") is True:
            return True
    return False


def _check_worktree(root: Path) -> int:
    """hook-correctness D7: refuse a commit on a branch checked out in more
    than one worktree. The commit would move the ref under the other
    checkout, whose index and working tree then silently describe a commit
    that is no longer the branch tip. A detached HEAD holds no branch and
    passes. An unreadable worktree list denies -- missing evidence never
    opens a commit gate."""
    branch = _current_branch(root)
    if branch is None:
        return 0
    out = subprocess.run(
        ["git", "worktree", "list", "--porcelain"], cwd=root, capture_output=True, text=True,
    )
    if out.returncode != 0:
        print(
            f"gatedloop: commit denied — `git worktree list` failed, so whether branch "
            f"'{branch}' is shared with another worktree is unknown: {out.stderr.strip()}",
            file=sys.stderr,
        )
        return 1
    holders: list[str] = []
    path = None
    for line in out.stdout.splitlines():
        if line.startswith("worktree "):
            path = line[len("worktree "):]
        elif line == f"branch refs/heads/{branch}" and path is not None:
            holders.append(path)
    if len(holders) <= 1:
        return 0
    print(
        f"gatedloop: commit denied — branch '{branch}' is checked out in "
        f"{len(holders)} worktrees: {', '.join(holders)}. A commit here moves the "
        "ref under the other checkout. Give this worktree a branch of its own; "
        "never force a checkout onto a branch another worktree holds.",
        file=sys.stderr,
    )
    return 1


def _change_in_implementation(root: Path, change: str) -> str | None:
    """Why `change` is in implementation, or `None` when it isn't
    (hook-correctness D5): a branch named `change` with commits beyond the
    integration target, or a `task-start` row in its ledger. With no target
    resolvable, an existing branch counts -- missing evidence never opens
    the gate."""
    if _local_branch_exists(root, change):
        target, _reason = _resolve_merge_target(root)
        if target is None:
            return f"a branch '{change}' exists and no merge target resolves"
        out = subprocess.run(
            ["git", "rev-list", "--count", f"{target}..refs/heads/{change}"],
            cwd=root, capture_output=True, text=True,
        )
        count = out.stdout.strip()
        if out.returncode != 0 or not count.isdigit():
            return f"a branch '{change}' exists and its distance from '{target}' could not be read"
        if int(count) > 0:
            return f"branch '{change}' has {count} commit(s) beyond '{target}'"
    if any(r.get("gate") == TASK_BASELINE_EVENT for r in _read_ledger_rows(root, change)):
        return f"its ledger records a task start (`{_state_rel(root, 'runs', change + '.jsonl')}`)"
    return None


def _check_propose_write(root: Path, m: dict, rel: str | None) -> int:
    """The Write-tool half of `check-propose` (hook-correctness D5). The
    change comes from the written path, never from HEAD, and every artifact
    under the change directory is treated alike -- except `tasks.md` (its
    checkboxes flip during implementation) and `.openspec.yaml` (attestation
    metadata). HEAD is consulted only as a fast path: on the target, or an
    accepted plan branch based on it, a planning write is always allowed.
    Anywhere else -- another branch, a detached HEAD -- it is allowed unless
    the change is in implementation, which is what design D9 of
    `harden-unattended-loop` actually forbids: authoring a plan from inside
    its own implementation."""
    m_ = re.match(r"^openspec/changes/([^/]+)/(.+)$", (rel or "").replace("\\", "/"))
    if not m_:
        return 0
    change_name, tail = m_.group(1), m_.group(2)
    if change_name == "archive" or tail in ("tasks.md", ".openspec.yaml"):
        return 0
    allowed, message = _propose_branch_verdict(root, m)
    if allowed:
        if message:
            print(f"gatedloop: {message}")
        return 0
    why = _change_in_implementation(root, change_name)
    if why is None:
        return 0
    target, _reason = _resolve_merge_target(root)
    main_name = (target or "main").split("/")[-1]
    print(
        f"gatedloop: refusing to author '{rel}' — change '{change_name}' is in "
        f"implementation ({why}), and a plan is not re-authored from inside its "
        f"own implementation (design D9). Amend it on '{main_name}' "
        f"(`git checkout {main_name}`) or on a plan branch based on it "
        f"(`git checkout -b plan/{change_name} {main_name}`), then retry.",
        file=sys.stderr,
    )
    debris = _debris_advisory(root)
    if debris:
        print(f"gatedloop: {debris}", file=sys.stderr)
    return 1


# ---------- epics (epic-linkage) -------------------------------------------
#
# An epic is an ordinary change that at least one other change names, with a
# top-level `x-gatedloop-epic: <epic>` key in its own `.openspec.yaml` (design
# D1). The `x-` prefix is the form OpenSpec 1.14 reserves for tool metadata,
# so the key survives `openspec validate --strict`. Read through `_load`, so
# PyYAML is used when importable and never required.

EPIC_KEY = f"x-{NAME}-epic"
_ARCHIVED_CHANGE_RE = re.compile(r"\d{4}-\d{2}-\d{2}-(.+)")


def _change_dirs(root: Path) -> list[tuple[str, Path, bool]]:
    """Every change directory as `(name, dir, archived)`: active ones under
    `openspec/changes/<name>`, archived ones under
    `openspec/changes/archive/<YYYY-MM-DD>-<name>`."""
    changes = root / "openspec" / "changes"
    out: list[tuple[str, Path, bool]] = []
    if not changes.is_dir():
        return out
    for p in sorted(changes.iterdir()):
        if p.is_dir() and p.name != "archive":
            out.append((p.name, p, False))
    archive = changes / "archive"
    if archive.is_dir():
        for p in sorted(archive.iterdir()):
            m = _ARCHIVED_CHANGE_RE.fullmatch(p.name)
            if p.is_dir() and m:
                out.append((m.group(1), p, True))
    return out


def _read_epic(change_dir: Path) -> str | None:
    """The epic a change names, or `None`. An unreadable `.openspec.yaml`
    names none here; `gates validate` is where malformed state fails."""
    p = change_dir / ".openspec.yaml"
    if not p.exists():
        return None
    try:
        data = _load(p) or {}
    except Exception:
        return None
    val = _meta_value(data, EPIC_KEY)
    return val.strip() if isinstance(val, str) and val.strip() else None


def _epic_links(root: Path) -> list[dict]:
    """Every change that names an epic, active or archived, as
    `{"change", "epic", "archived"}`, sorted by change name."""
    links = []
    for name, d, archived in _change_dirs(root):
        epic = _read_epic(d)
        if epic is not None:
            links.append({"change": name, "epic": epic, "archived": archived})
    return sorted(links, key=lambda link: (link["change"], link["archived"]))


def _epic_errors(root: Path) -> list[str]:
    """`gates validate`'s epic checks (design D2): one message per broken
    link of an active change, each naming the child. The epic is missing,
    is the child itself, itself names an epic (one level only), or is
    archived while the child is still active."""
    dirs = _change_dirs(root)
    active = {name for name, _d, archived in dirs if not archived}
    archived_names = {name for name, _d, archived in dirs if archived}
    links = _epic_links(root)
    active_epic_of = {l["change"]: l["epic"] for l in links if not l["archived"]}
    errors = []
    for child, epic in active_epic_of.items():
        if epic == child:
            errors.append(f"change '{child}' names itself as its epic ({EPIC_KEY})")
        elif epic in active:
            if epic in active_epic_of:
                errors.append(
                    f"change '{child}' names epic '{epic}', which itself names epic "
                    f"'{active_epic_of[epic]}' — epics are one level deep"
                )
        elif epic in archived_names:
            errors.append(
                f"change '{child}' is active but its epic '{epic}' is archived — an "
                "epic archives only after every child; archive the child or name "
                f"an active epic in its {EPIC_KEY}"
            )
        else:
            errors.append(
                f"change '{child}' names epic '{epic}' ({EPIC_KEY}), which is neither "
                "an active nor an archived change"
            )
    return errors

def _active_children(root: Path, epic: str) -> list[str]:
    """The active changes naming `epic` as theirs, sorted."""
    return [l["change"] for l in _epic_links(root)
            if l["epic"] == epic and not l["archived"] and l["change"] != epic]


def _tasks_progress(change_dir: Path) -> dict:
    """Tasks done of total from a change's `tasks.md`; `0/0` without one."""
    p = change_dir / "tasks.md"
    return _tasks_progress_text(p.read_text() if p.exists() else "")


def _tasks_progress_text(text: str) -> dict:
    """Tasks done of total in a `tasks.md`'s text."""
    done = len(re.findall(r"^\s*- \[[xX]\] ", text, re.MULTILINE))
    todo = len(re.findall(r"^\s*- \[ \] ", text, re.MULTILINE))
    return {"done": done, "total": done + todo}


def _epic_child_state(root: Path, m: dict, change: str, archived: bool) -> tuple[str, str | None]:
    """A child's state and halt cause (design D5). The ledger part starts
    from the outcomes classifier, and where it answers it wins, so this
    view never contradicts `gates stats --outcomes`."""
    if archived:
        return "archived", None
    rows, _skipped = _read_ledger_rows_and_skipped(root, change)
    out = outcomes_from_rows(rows, _acceptance_policy(m))
    if out["terminal"] in ("merged", "accepted"):
        return "merged", None
    if out["terminal"] == "halted":
        return "halted", out["halt_cause"]
    latest = next((r.get("gate") for r in reversed(rows)
                   if r.get("gate") in (READY_EVENT, HALT_EVENT)), None)
    if latest == READY_EVENT:
        return "ready", None
    if any(r.get("gate") == TASK_BASELINE_EVENT for r in rows):
        return "implementing", None
    if _read_approved_by(root, change):
        return "approved", None
    return "proposed", None


def _epic_children(root: Path, m: dict, epic: str) -> list[dict]:
    """Every change naming `epic`, active or archived, with its state and
    tasks done of total, sorted by name."""
    dirs = {(name, archived): d for name, d, archived in _change_dirs(root)}
    kids = []
    for link in _epic_links(root):
        if link["epic"] != epic or link["change"] == epic:
            continue
        state, cause = _epic_child_state(root, m, link["change"], link["archived"])
        kids.append({
            "change": link["change"], "state": state, "halt_cause": cause,
            "tasks": _tasks_progress(dirs[(link["change"], link["archived"])]),
        })
    return kids


def _epic_child_label(kid: dict) -> str:
    if kid["state"] == "halted" and kid["halt_cause"]:
        return f"halted: {kid['halt_cause']}"
    return kid["state"]


EPIC_CHILD_STATES = ("archived", "merged", "halted", "ready", "implementing", "approved", "proposed")


def _epics_doc(root: Path, m: dict) -> dict:
    """`gates epics --json` (design D5): every epic, active or archived, with
    its children. A name no change carries is not an epic -- that dangling
    link is `gates validate`'s failure, not a listing entry."""
    dirs = _change_dirs(root)
    active = {name for name, _d, archived in dirs if not archived}
    archived_names = {name for name, _d, archived in dirs if archived}
    names = sorted({l["epic"] for l in _epic_links(root) if l["epic"] != l["change"]})
    epics = []
    for epic in names:
        if epic not in active and epic not in archived_names:
            continue
        kids = _epic_children(root, m, epic)
        epics.append({
            "epic": epic,
            "archived": epic not in active,
            "drained": bool(kids) and all(k["state"] == "archived" for k in kids),
            "children": kids,
        })
    return {"epics": epics}


def _epic_state_counts(kids: list[dict]) -> str:
    counts = [(s, sum(1 for k in kids if k["state"] == s)) for s in EPIC_CHILD_STATES]
    return ", ".join(f"{n} {s}" for s, n in counts if n)


def cmd_epics(m: dict, root: Path, args) -> int:
    doc = _epics_doc(root, m)
    if getattr(args, "json", False):
        print(json.dumps(doc, sort_keys=True))
        return 0
    if not doc["epics"]:
        print(f"gatedloop: no epics — no change names one with `{EPIC_KEY}` in its .openspec.yaml")
        return 0
    lines = []
    for e in doc["epics"]:
        flags = ["archived" if e["archived"] else "active"] + (["drained"] if e["drained"] else [])
        lines.append(f"{e['epic']} ({', '.join(flags)}): {_epic_state_counts(e['children'])}")
        for k in e["children"]:
            t = k["tasks"]
            lines.append(f"  - {k['change']:<28} {_epic_child_label(k):<24} {t['done']}/{t['total']}")
    print("\n".join(lines))
    return 0


def _epic_stats_report(root: Path, m: dict, epic: str, as_json: bool, idle_gap_ms: int) -> int:
    """`gates stats --epic <name>` (design D6): the existing per-change
    economics grouped by child and summed. No new math -- each child's
    numbers are `stats_from_rows`' and `outcomes_from_rows`' own."""
    kids = _epic_children(root, m, epic)
    if not kids:
        print(
            f"gatedloop: no change names '{epic}' as its epic (`{EPIC_KEY}` in a "
            "change's .openspec.yaml) -- nothing to roll up. `gates epics` lists "
            "the epics there are.",
            file=sys.stderr,
        )
        return 1
    children = []
    totals = {"tasks": {"done": 0, "total": 0}, "gate_runs": 0, "gate_ms": 0,
              "red_runs": 0, "halts": {c: 0 for c in HALT_CAUSES}, "tokens": 0}
    for kid in kids:
        rows, _skipped = _read_ledger_rows_and_skipped(root, kid["change"])
        gates_ = stats_from_rows(rows, idle_gap_ms)["gates"].values()
        halts = outcomes_from_rows(rows, _acceptance_policy(m))["halts"]
        entry = dict(kid,
                     gate_runs=sum(g["runs"] for g in gates_),
                     gate_ms=sum(g["total_ms"] for g in gates_),
                     red_runs=sum(g["failed"] for g in gates_),
                     halts=halts,
                     tokens=recorded_usage(rows))  # token-ledger D6
        children.append(entry)
        for k in ("done", "total"):
            totals["tasks"][k] += kid["tasks"][k]
        for k in ("gate_runs", "gate_ms", "red_runs", "tokens"):
            totals[k] += entry[k]
        for cause, n in halts.items():
            totals["halts"][cause] = totals["halts"].get(cause, 0) + n
    doc = {"epic": epic, "children": children, "totals": totals}
    if as_json:
        print(json.dumps(doc, sort_keys=True))
        return 0

    def _halts(h: dict) -> str:
        return ", ".join(f"{c}: {n}" for c, n in h.items() if n) or "-"

    lines = [f"=== epic {epic} ===",
             f"{'child':<28} {'state':<22} {'tasks':>7}  {'runs':>4}  {'red':>4}  {'gate time':>9}  "
             f"{'tokens':>12}  halts"]
    for c in children + [dict(totals, change="(total)", state="", halt_cause=None)]:
        t = c["tasks"]
        label = _epic_child_label(c) if c["state"] else ""
        lines.append(
            f"{c['change']:<28} {label:<22} {t['done']:>3}/{t['total']:<3}  {c['gate_runs']:>4}  "
            f"{c['red_runs']:>4}  {_stats_fmt_ms(c['gate_ms']):>9}  {c['tokens']:>12}  "
            f"{_halts(c['halts'])}"
        )
    print("\n".join(lines))
    return 0



# ---------- the push gate (git-layer-enforcement D3) ------------------------
#
# `gates discipline check-push <sha> --remote-ref <ref>`: what the git
# `pre-push` hook asks for each ref a push updates. Only an update of the
# merge target's branch is checked; every other branch, and a deletion (the
# zero sha), passes silently. The target passes when the pushed commit is
# proven, two ways, and no gate runs in either:
#
#   1. a `merge` row in a ledger the pushed commit carries names it -- or
#      names an ancestor S of it such that S..<sha> touches only ledger and
#      planning paths. That is `gates merge`'s own push: its merge row names
#      the squash commit, and the archive commit pushed on top carries only
#      the move under `openspec/` and the row itself.
#   2. the merge gate's incoming-tree checks hold for the pushed commit's
#      tree (the same set `_merge_prove_head` applies to a change head).

_ZERO_SHA_RE = re.compile(r"^0+$")


def _ledger_rows_at(root: Path, sha: str) -> list[dict]:
    """Every ledger row the commit `sha` carries, from every change's file."""
    rows: list[dict] = []
    for prefix in LEDGER_PREFIXES:
        listed = _git(root, "ls-tree", "-r", "--name-only", sha, "--", prefix + "/")
        if listed.returncode != 0:
            continue
        for rel in listed.stdout.splitlines():
            if not rel.endswith(".jsonl"):
                continue
            blob = _git(root, "cat-file", "blob", f"{sha}:{rel}")
            if blob.returncode == 0:
                rows.extend(_parse_jsonl_rows(blob.stdout))
    return rows


def _push_merge_row(root: Path, m: dict, sha: str, rows: list[dict]) -> str | None:
    """The squash commit a merge row names that vouches for `sha` (way 1)."""
    for r in rows:
        named = r.get("sha") if r.get("gate") == "merge" else None
        if not isinstance(named, str) or not named.strip():
            continue
        named = _rev(root, named.strip())
        if named is None:
            continue
        if named == sha:
            return named
        if not _is_ancestor(root, named, sha):
            continue
        diff = _git(root, "diff", "--name-only", named, sha)
        if diff.returncode != 0:
            continue
        if all(_is_ledger_path(p) or _is_planning_path(p, m) for p in diff.stdout.splitlines() if p):
            return named
    return None


def _push_changes(root: Path, sha: str, target_branch: str) -> list[str]:
    """The changes a pushed commit carries in: local change branches whose tip
    it contains and whose change is still active in its tree."""
    out = _git(root, "for-each-ref", "--merged", sha, "--format=%(refname:short)", "refs/heads/")
    names = []
    for name in out.stdout.splitlines() if out.returncode == 0 else []:
        name = name.strip()
        if not name or name == target_branch or "/" in name:
            continue
        has = _git(root, "cat-file", "-e", f"{sha}:openspec/changes/{name}")
        if has.returncode == 0:
            names.append(name)
    return sorted(names)


def _push_tree_problems(m: dict, root: Path, sha: str, changes: list[str]) -> list[str]:
    """The merge gate's incoming-tree checks against the pushed commit (way
    2), each unmet one named: a `live-check` marker and a full `ci` marker for
    its tree, `verify` where declared, and -- for each change it carries in --
    no unresolved taint, the authored-test lock, and acceptance where a
    policy is declared."""
    tree = _commit_tree(root, sha)
    if tree is None:
        return [f"gatedloop: could not resolve the tree of {sha[:12]}."]
    problems: list[str] = []
    stores = [root]
    for change in changes:
        for store in _marker_stores(root, change):
            if store not in stores:
                stores.append(store)
    for gate, scope in (("live-check", None), ("ci", "full")):
        texts = []
        for store in stores:
            rc, _out, err = _captured(_check_marker_and_report, store, gate, tree, scope)
            if rc == 0:
                break
            texts.append(err.strip())
        else:
            hint = ("run `gates run live-check` on the pushed commit" if gate == "live-check"
                    else "run an unscoped `gates run ci` (nothing staged) on the pushed commit")
            problems.append(f"{texts[0]}\n  -> {hint}.")
    rows = _ledger_rows_at(root, sha)
    change_rows = {c: _change_ledger_rows(root, c, sha) for c in changes}
    if (m.get("gates") or {}).get("verify"):
        norm = _normalize_tree(root, tree)
        every = rows + [r for rs in change_rows.values() for r in rs]
        if not any(r.get("gate") == "verify" and r.get("exit") == 0 and r.get("tree")
                   and _normalize_tree(root, r["tree"]) == norm for r in every):
            problems.append(
                f"gatedloop: `verify` is declared, and no green `verify` is recorded for "
                f"(ledger-normalized) tree {norm!r}.\n  -> run `gates run verify` on it.")
    for change in changes:
        if _taint_unresolved(change_rows[change]):
            problems.append(_taint_refusal(change))
        try:
            lock = _lock_at_commit(root, change, sha)
        except _ForgeRefusal as refusal:
            problems.append(refusal.message)
        else:
            if lock.problems:
                problems.append(lock.refusal())
    if _acceptance_policy(m):
        for change in changes or [None]:
            rc, _out, err = _captured(_acceptance_check, m, root,
                                      argparse.Namespace(tree=tree, change=change))
            if rc != 0:
                problems.append(err.strip())
    return problems


def _check_push(m: dict, root: Path, sha: str, remote_ref: str | None) -> int:
    if _ZERO_SHA_RE.match(sha or ""):
        return 0  # a deletion updates no tree
    target, reason = _resolve_merge_target(root)
    if target is None:
        print(f"gatedloop: push denied — no merge target resolves ({reason}), so whether "
              "this push updates it cannot be decided.", file=sys.stderr)
        return 1
    branch = _split_target(target)[1]
    if remote_ref is not None and remote_ref != f"refs/heads/{branch}":
        return 0  # not the merge target: passes untouched
    full = _rev(root, sha)
    if full is None:
        print(f"gatedloop: push denied — {sha} is not a commit in this repository.",
              file=sys.stderr)
        return 1
    rows = _ledger_rows_at(root, full)
    vouched = _push_merge_row(root, m, full, rows)
    if vouched is not None:
        how = "it" if vouched == full else f"{vouched[:12]}, and only ledger and planning paths follow it"
        print(f"gatedloop: push of {full[:12]} to '{branch}' allowed — a merge row records {how}")
        return 0
    changes = _push_changes(root, full, branch)
    problems = _push_tree_problems(m, root, full, changes)
    if not problems:
        print(f"gatedloop: push of {full[:12]} to '{branch}' allowed — the merge gate's "
              "incoming-tree checks hold for its tree")
        return 0
    name = changes[0] if len(changes) == 1 else "<change>"
    print(
        f"gatedloop: push to '{branch}' denied at the git layer — commit {full[:12]} is not "
        f"proven: no merge row records it, and the incoming-tree checks fail:\n"
        + "\n".join(problems)
        + f"\ngatedloop: integrate through `gates merge {name}`: it proves the head, records "
        "the merge row and pushes once. A raw merge pushed by hand reaches the shared "
        "history unchecked, which is what this hook refuses.",
        file=sys.stderr,
    )
    return 1


def _write_verdict_token(args, token: str) -> None:
    """unblock-authored-lock D1: `--verdict-file` gets exactly one token on
    success -- `ledger`, `planning` or `marker` -- so the commit hooks branch
    on the verdict, never on the human-readable line, which is free to
    change. Without the flag nothing is written and nothing else differs."""
    path = getattr(args, "verdict_file", None)
    if path:
        Path(path).write_text(token + "\n")


def cmd_discipline(m: dict, root: Path, args) -> int:
    if args.discipline_cmd == "check-commit":
        rc, token = _check_commit_verdict(m, root, args.tree)
        if rc == 0 and token:
            _write_verdict_token(args, token)
        return rc
    return _cmd_discipline_other(m, root, args)


def _check_commit_verdict(m: dict, root: Path, tree: str) -> tuple[int, str | None]:
    """`discipline check-commit`'s verdict: `(exit, token)`, the token naming
    the grade that allowed the commit (`None` on a denial)."""
    staged = _staged_diff_paths(root)
    # A non-empty planning-only diff earns the lighter gate; an EMPTY
    # diff is deliberately not treated as vacuously planning-only (design
    # D2's own scope is "committing something that can only break
    # planning artifacts" -- zero evidence should never be a free pass),
    # so it falls through to the unchanged marker requirement below.
    # Ledger rows may ride along (merge-pull-request D3: the archive
    # commit carries the change's merge row): no marker can see them --
    # they are stripped from every hashed tree -- so they neither earn
    # nor cost anything. The planning part must still be non-empty.
    planning_part = [p for p in (staged or []) if not _is_ledger_path(p)]
    if planning_part and all(_is_planning_path(p, m) for p in planning_part):
        # Planning-grade (design D2): manifest validation + per-staged-
        # change-dir OpenSpec validation, instead of a green `ci` marker.
        errs = _errors(m, root)
        if errs:
            print("gatedloop: commit denied — the manifest is invalid:", file=sys.stderr)
            for e in errs:
                print(f"  - {e}", file=sys.stderr)
            return 1, None
        skipped: list[str] = []
        fully_validated: list[str] = []
        proposal_only: list[str] = []
        for change in _staged_change_dirs(staged):
            # The archive move's source half (design D4 of
            # harden-hook-matching): the staged diff removed this change
            # directory and it is no longer on the working tree -- its
            # artifacts were validated across their whole life, the move
            # is mechanical, and validating a directory that is no
            # longer there can only fail for the wrong reason. Skip it,
            # and announce the skip (fail-loud in both directions --
            # never a silent skip).
            if not (root / "openspec" / "changes" / change).exists():
                skipped.append(change)
                continue
            # design D4 of worktree-native-loop: validate each staged
            # change at the STAGE IT IS AT, not demand delta content a
            # deliberately proposal-only backlog entry doesn't claim.
            try:
                has_delta = _change_has_delta_content(root, change)
            except _ChangeStageUnreadable as e:
                print(
                    f"gatedloop: commit denied — change '{change}'s stage "
                    f"could not be determined: {e}",
                    file=sys.stderr,
                )
                return 1, None
            if has_delta:
                r = _openspec(["validate", change, "--type", "change", "--json"],
                              root, capture_output=True, text=True)
                if r.returncode != 0:
                    print(
                        f"gatedloop: commit denied — `openspec validate {change}` failed:\n"
                        f"{r.stdout}{r.stderr}",
                        file=sys.stderr,
                    )
                    return 1, None
                fully_validated.append(change)
            else:
                r = _openspec(["status", "--change", change, "--json"],
                              root, capture_output=True, text=True)
                if r.returncode != 0:
                    print(
                        f"gatedloop: commit denied — change '{change}' has no delta "
                        f"content yet (proposal-only), and its status could not be "
                        f"read (`openspec status --change {change} --json` failed):\n"
                        f"{r.stdout}{r.stderr}",
                        file=sys.stderr,
                    )
                    return 1, None
                proposal_only.append(change)
        notes: list[str] = []
        if fully_validated:
            notes.append("full: " + ", ".join(fully_validated))
        if proposal_only:
            notes.append("proposal-only: " + ", ".join(proposal_only))
        stage_note = f" ({'; '.join(notes)})" if notes else ""
        skip_note = ""
        if skipped:
            names = ", ".join(skipped)
            skip_note = (
                f" — skipped validation for archived-away change(s) "
                f"{names} (directory no longer present on the working tree)"
            )
        ledger_count = len(staged) - len(planning_part)
        ledger_note = (
            f" (with {ledger_count} ledger path(s), which no marker sees)" if ledger_count else ""
        )
        print(
            f"gatedloop: planning-grade commit allowed{stage_note}{ledger_note} — {tree}{skip_note}"
        )
        return 0, "planning"
    if staged and all(_is_ledger_path(p) for p in staged):
        # Ledger-grade (design D5): a non-empty, ledger-only staged diff
        # is allowed outright -- the verdict is printed, never silent
        # (fail-loud-gates). An EMPTY diff still falls through to the
        # full requirement below (unchanged "zero evidence is never a
        # free pass" stance); one non-ledger path anywhere removes this
        # discount entirely.
        print(f"gatedloop: ledger-grade commit allowed (staged diff is entirely "
              f"`.gatedloop/runs/**`) — {tree}")
        return 0, "ledger"
    # Mixed, empty, or the staged diff couldn't be read: the full
    # requirement.
    rc = _check_marker_and_report(root, "ci", tree)
    return rc, ("marker" if rc == 0 else None)


def _cmd_discipline_other(m: dict, root: Path, args) -> int:

    if args.discipline_cmd == "check-propose":
        rel = args.path
        subject = "the change scaffold (`openspec new change`)"
        if not args.scaffold:
            return _check_propose_write(root, m, rel)
        allowed, message = _propose_branch_verdict(root, m)
        if allowed:
            if message:
                print(f"gatedloop: {message}")
            return 0
        print(f"gatedloop: refusing to author {subject} — {message}", file=sys.stderr)
        debris = _debris_advisory(root)
        if debris:
            print(f"gatedloop: {debris}", file=sys.stderr)
        return 1

    if args.discipline_cmd == "check-worktree":
        return _check_worktree(root)

    if args.discipline_cmd == "check-push":
        return _check_push(m, root, args.sha, args.remote_ref)

    if args.discipline_cmd == "merge-scope":
        # hook-correctness D2: the merge hook guards integration only. Prints
        # `integrating` or `not-integrating`; the hook skips its marker work
        # on the latter alone, so any other outcome (an error, no output)
        # keeps the merge gated -- this can fail closed, never open.
        print("integrating" if _is_integrating(root) else "not-integrating")
        return 0

    if args.discipline_cmd == "check-archive":
        change = args.change
        # epic-linkage D4: an epic archives only after every child. The merge
        # check below still applies to the epic itself.
        open_kids = [k for k in _epic_children(root, m, change) if k["state"] != "archived"]
        if open_kids:
            listing = "; ".join(f"{k['change']} ({_epic_child_label(k)})" for k in open_kids)
            print(
                f"gatedloop: '{change}' is an epic with {len(open_kids)} child "
                f"change(s) not yet archived — an epic archives only after every "
                f"child (epic-linkage D4): {listing}. Archive each child first, "
                f"then re-run `openspec archive {change}`.",
                file=sys.stderr,
            )
            return 1
        target, reason = _resolve_merge_target(root)
        if target is None:
            print(
                f"gatedloop: cannot verify merge status ({reason}) — refusing to "
                "archive until a merge target resolves (push a branch to a remote "
                "with an 'origin/HEAD', or create a local 'main').",
                file=sys.stderr,
            )
            return 1
        if _change_present_on_ref(root, change, target):
            return 0
        # design D5: check-archive's guarantee is ORDERING (merge precedes
        # archive), not durability -- a sound LOCAL counterpart of the merge
        # target proves that ordering just as well, so it's accepted with a
        # loud advisory instead of demanding an interim push every time a
        # serialized merge lane archives right after merging.
        local = _local_counterpart_branch(target)
        if local and _local_branch_exists(root, local) and _change_present_on_ref(root, change, local):
            print(
                f"gatedloop: change '{change}' is merged to the local '{local}' but "
                f"not yet on '{target}'{_UNPUSHED_MERGE_ADVISORY}."
            )
            return 0
        print(
            f"gatedloop: change '{change}' has not been merged to '{target}' — "
            "archive follows merge, never precedes it (design D9) — merge "
            f"branch '{change}' to '{target}' (and push, if '{target}' is a "
            f"remote ref), then re-run `openspec archive {change}`.",
            file=sys.stderr,
        )
        return 1

    if args.discipline_cmd == "check-implement":
        change = args.change
        # epic-linkage D3: an epic is never implemented, whatever its schema.
        # Checked first, so an approved epic is refused all the same.
        children = _active_children(root, change)
        if children:
            print(
                f"gatedloop: '{change}' is an epic for {', '.join(children)}; "
                "implement its children, not the epic (epic-linkage D3)",
                file=sys.stderr,
            )
            return 1
        # Only a name that is actually an OpenSpec change is this gate's
        # business — otherwise every ordinary `git checkout -b` in the repo
        # (unrelated to the loop) would be denied by a check that has
        # nothing to say about it. "Known" means present either in the local
        # working tree (freshly authored, not yet merged) or on the resolved
        # merge target (merged).
        target, _reason = _resolve_merge_target(root)
        known_locally = (root / "openspec" / "changes" / change).exists()
        known_on_target = target is not None and _change_present_on_ref(root, change, target)
        # design D5: also known if merged to the local counterpart of the
        # target (e.g. local `main` for `origin/main`) -- a change can be
        # merged-but-unpushed with no working-tree copy in THIS checkout.
        local_counterpart = _local_counterpart_branch(target)
        known_on_local_counterpart = (
            local_counterpart is not None
            and _local_branch_exists(root, local_counterpart)
            and _change_present_on_ref(root, change, local_counterpart)
        )
        if not known_locally and not known_on_target and not known_on_local_counterpart:
            return 0
        ok, reason = _approval_check(root, change, m)
        print(f"gatedloop: {reason}", file=sys.stderr if not ok else sys.stdout)
        return 0 if ok else 1

    if args.discipline_cmd == "next-task":
        # PreCompact state persistence (task 5.2): the same (change, first
        # unchecked task) lookup as check-continue, but WITHOUT the clean-
        # tree requirement -- compaction can land mid-edit, and this is a
        # convenience snapshot for reorienting after it, not an enforcement
        # gate. Prints "<change>\t<next task line>", or exits 1 if there is
        # no change branch or no unchecked task to report.
        branch = _current_branch(root)
        if branch is None or branch in ("main", "master"):
            return 1
        tasks_path = root / "openspec" / "changes" / branch / "tasks.md"
        if not tasks_path.exists():
            return 1
        m = re.search(r"^- \[ \] (.+)$", tasks_path.read_text(), re.MULTILINE)
        if not m:
            return 1
        print(f"{branch}\t{m.group(1).strip()[:120]}")
        return 0

    if args.discipline_cmd == "check-continue":
        # design D3: continue the loop only when (change branch) AND
        # (tasks.md has an unchecked task) AND (tree is clean at a task
        # boundary — done means committed, so "clean" is the only signal
        # that the last task actually finished rather than being mid-edit).
        branch = _current_branch(root)
        if branch is None or branch in ("main", "master"):
            return 1
        tasks_path = root / "openspec" / "changes" / branch / "tasks.md"
        if not tasks_path.exists():
            return 1
        m = re.search(r"^- \[ \] (.+)$", tasks_path.read_text(), re.MULTILINE)
        if not m:
            return 1
        # escalation-outcomes D3: a recorded halt is what stops the loop. It
        # is checked BEFORE the clean-tree condition only so the cause is
        # named even while the halt row itself is still uncommitted -- the
        # exit code in that dirty case is 1 either way, so this adds exactly
        # one new non-continuing case (a halt row newer than the latest
        # task-start on a clean tree) and removes none.
        halt = _outstanding_halt(_read_ledger_rows(root, branch))
        if halt is not None:
            task = halt.get("task") or "<N.M>"
            detail = f": {halt.get('detail')}" if halt.get("detail") else ""
            print(
                f"gatedloop: change '{branch}' halted at task {task} (cause "
                f"{halt.get('cause')}{detail}) — the loop does not continue past "
                f"a recorded halt. Resume with `gates task start {task}` once "
                "the cause is addressed.",
                file=sys.stderr,
            )
            return 1
        status = subprocess.run(
            ["git", "status", "--porcelain"], cwd=root, capture_output=True, text=True,
        ).stdout
        # token-ledger D1: a usage row the commit hook or this stop's flush
        # appended is not a task left mid-edit.
        if _dirt_beyond_usage(root, status):
            return 1
        print(m.group(1).strip()[:120])
        return 0

    sys.exit(f"gatedloop: unknown discipline subcommand '{args.discipline_cmd}'")


# ---------- running gates -------------------------------------------------

def _exec(cmd: str, root: Path) -> int:
    print(f"gatedloop: $ {cmd}", file=sys.stderr)
    return subprocess.run(cmd, shell=True, cwd=root).returncode


# ---------- quiet-on-green gate output (design D3, scale-gate-cost) --------
#
# Field data (#13): raw gate output accumulating in the loop's own context is
# one of the two measured token drivers (the other is inline convention
# review, closed by task 4). The shim owns process execution, so it owns
# output discipline too, rather than teaching every adopter's agent `| tail`
# (which truncates the one output that matters most -- a failure's).

_OUT_LOG_KEEP = 5


def _out_log_dir(root: Path) -> Path:
    return _state_dir(root) / "out"


def _rotate_out_logs(root: Path, gate: str, keep: int = _OUT_LOG_KEEP) -> None:
    """Keep only the last `keep` captured logs per gate -- small, in-shim
    rotation (design Risks: "output files accumulate")."""
    logs = sorted((_out_log_dir(root)).glob(f"{gate}-*.log"))
    for stale in logs[:-keep] if keep > 0 else logs:
        stale.unlink(missing_ok=True)


def _run_gate_captured(cmd: str, root: Path, gate: str, scope: str, verbose: bool) -> int:
    """Run a declared gate's command. Default: capture combined stdout+stderr
    to `.gatedloop/out/<gate>-<ts>.log`; print exactly one summary line on a
    green exit, the full captured output (then the same summary) on red --
    the exit-code contract is untouched either way. `--verbose` restores
    unfiltered streaming with no capture file, exactly like `_exec`."""
    if verbose:
        print(f"gatedloop: $ {cmd}", file=sys.stderr)
        return subprocess.run(cmd, shell=True, cwd=root).returncode

    started = time.monotonic()
    d = _out_log_dir(root)
    d.mkdir(parents=True, exist_ok=True)
    # Self-ignoring, so a `git add -A` in ANY adopter repo can never stage a
    # captured log into the tree the `ci` marker hashes: the marker's
    # ledger-blind normalization is exactly `.gatedloop/runs/**` (fix-marker-
    # mechanics D1, deliberately not `.gatedloop/**`), so an out-log that
    # reached the index would stale the very marker its run just earned --
    # the #10 class of defect. Nested `.gitignore` with `*` is the standard
    # cache-directory idiom; it ignores itself too.
    ignore = d / ".gitignore"
    if not ignore.exists():
        ignore.write_text("*\n")
    ts = _now_iso().replace(":", "").replace("+00:00", "Z")
    log_path = d / f"{gate}-{ts}.log"
    with log_path.open("w") as f:
        proc = subprocess.run(cmd, shell=True, cwd=root, stdout=f, stderr=subprocess.STDOUT)
    duration = time.monotonic() - started
    rc = proc.returncode
    if rc == 0:
        print(f"gatedloop: {gate}[{scope}] green in {duration:.0f}s — full output: {log_path}")
    else:
        try:
            sys.stderr.write(log_path.read_text())
        except Exception as e:
            # fail-loud-gates: a swallowed read failure here would leave the
            # one-line summary as the ONLY signal on a red gate -- exactly
            # the case where the full output matters most.
            print(f"gatedloop: could not read captured output {log_path}: {e}", file=sys.stderr)
        print(
            f"gatedloop: {gate}[{scope}] red (exit {rc}) in {duration:.0f}s — full output: {log_path}",
            file=sys.stderr,
        )
    _rotate_out_logs(root, gate)
    return rc


# ---------- cross-worktree gate mutex (design D6, worktree-native-loop) ---
#
# `concurrency.serialize` names gates to serialize MACHINE-WIDE across every
# worktree of a repository. The lock lives under the COMMON git dir (`git
# rev-parse --git-common-dir`) -- shared by every worktree, unlike the
# per-worktree marker store -- so an `fcntl.flock` there is exactly "one
# heavy suite per machine", the thundering herd this exists to serialize.
# Held only around the gate COMMAND itself (design D6): marker writes,
# ledger rows, and taint resolution all happen outside it, in the caller.

_LOCK_POLL_INTERVAL_SECONDS = 0.2


def _git_common_dir(root: Path) -> Path:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--git-common-dir"],
            cwd=root, capture_output=True, text=True, check=True,
        ).stdout.strip()
        p = Path(out)
        return p if p.is_absolute() else (root / p)
    except Exception:
        return root / ".git"


def _lock_path(root: Path, gate: str) -> Path:
    return _git_common_dir(root) / NAME / "locks" / f"{gate}.lock"


def _serialized_gates(m: dict) -> set[str]:
    conc = m.get("concurrency")
    if not isinstance(conc, dict):
        return set()
    names = conc.get("serialize")
    return set(names) if isinstance(names, list) else set()


# lock-and-ledger-hygiene D2: the host caps one Bash tool call at 600 s and
# backgrounds anything longer (#33 item 6); 480 leaves 120 s to report and exit.
_DEFAULT_LOCK_MAX_WAIT_SECONDS = 480


def _lock_max_wait(m: dict) -> int:
    """`concurrency.max-wait-seconds`, or the default when it is absent or
    invalid (an invalid value is `gates validate`'s business)."""
    conc = m.get("concurrency")
    bound = conc.get("max-wait-seconds") if isinstance(conc, dict) else None
    if isinstance(bound, int) and not isinstance(bound, bool) and bound > 0:
        return bound
    return _DEFAULT_LOCK_MAX_WAIT_SECONDS


def _lock_merge_wait(m: dict) -> int:
    """`concurrency.merge-wait-seconds`, bounding a `gates merge` step's wait
    on a serialized gate's lock; `_lock_max_wait` when it is absent or
    invalid (merge-lane-friction D3)."""
    conc = m.get("concurrency")
    bound = conc.get("merge-wait-seconds") if isinstance(conc, dict) else None
    if isinstance(bound, int) and not isinstance(bound, bool) and bound > 0:
        return bound
    return _lock_max_wait(m)


class _LockBusy(Exception):
    """The wait for a serialized gate's lock reached its bound (D2). Raised
    before the lock is acquired, so the gate command never runs."""

    def __init__(self, gate: str, holder: str, waited: float, bound: int,
                 bound_key: str = "max-wait-seconds"):
        self.gate = gate
        self.holder = holder
        self.waited = waited
        self.bound = bound
        self.bound_key = bound_key
        super().__init__(self.message())

    def message(self) -> str:
        # The `gatedloop: lock busy` prefix is a stable contract (SETUP.md's
        # gate contract): the loop retries on it and halts on any other 75.
        return (
            f"gatedloop: lock busy — gate '{self.gate}' is still held by "
            f"{self.holder} after waiting {_fmt_duration(self.waited)} "
            f"(concurrency.{self.bound_key}: {self.bound}); the gate was not "
            "run. Re-run the same command; `gates lock status` shows the holder."
        )


def _read_lock_holder(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


# lock-and-ledger-hygiene D1: the wait polls every 0.2 s (acquiring promptly
# matters) but prints at most one notice every 30 s -- a five-minute wait is
# 11 lines, not ~1,500 that overflow the caller's tool-output cap.
_LOCK_NOTICE_INTERVAL_SECONDS = 30.0


def _fmt_duration(seconds: float) -> str:
    """`45s`, `3m12s`, `6h12m` -- the two most significant units."""
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60}s"
    return f"{s // 3600}h{(s % 3600) // 60}m"


def _pid_alive(pid) -> bool | None:
    """D1: `os.kill(pid, 0)` probes without signalling. `ProcessLookupError`
    means dead; `PermissionError` means alive under another user. `None` when
    the metadata names no usable pid."""
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return None
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return None
    return True


def _liveness_word(alive: bool | None) -> str:
    return {True: "alive", False: "dead?", None: "unknown"}[alive]


def _holder_age_seconds(holder: dict, now_epoch: float) -> float | None:
    """How long the holder has held the lock, from the `ts` it recorded on
    acquiring; `None` when that metadata is missing or unreadable."""
    import datetime
    ts = holder.get("ts")
    if not isinstance(ts, str):
        return None
    try:
        since = datetime.datetime.fromisoformat(ts)
    except ValueError:
        return None
    if since.tzinfo is None:
        since = since.replace(tzinfo=datetime.timezone.utc)
    return now_epoch - since.timestamp()


def _describe_lock_holder(holder: dict, now_epoch: float) -> str:
    """`pid 4312 (alive) for 3m12s` -- the holder's part of every lock line."""
    pid = holder.get("pid", "?")
    age = _holder_age_seconds(holder, now_epoch)
    age_txt = _fmt_duration(age) if age is not None else "an unknown time"
    return f"pid {pid} ({_liveness_word(_pid_alive(pid))}) for {age_txt}"


def _priority_claim_path(lock_path: Path) -> Path:
    """merge-lane-friction D2: `<lockfile>.priority`, written by a waiting
    `gates merge` so other waiters let it take the lock next."""
    return lock_path.with_name(lock_path.name + ".priority")


def _live_priority_claim(claim: Path, me: int) -> int | None:
    """The pid of a live claim that is not `me`'s own, or None. A claim whose
    pid is dead (or names no usable pid) is stale: it is removed and ignored."""
    data = _read_lock_holder(claim)
    if not data and not claim.exists():
        return None
    pid = data.get("pid")
    if pid == me:
        return None
    if _pid_alive(pid):
        return pid
    with contextlib.suppress(OSError):
        claim.unlink()
    return None


@contextlib.contextmanager
def _gate_lock(root: Path, m: dict, gate: str, *, max_wait: int | None = None,
               clock=None, wall=None, sleep=None, always: bool = False,
               priority: bool = False, bound_key: str = "max-wait-seconds"):
    """Acquire the machine-wide lock for `gate` if (and only if) it's named
    in `concurrency.serialize`, or `always` is set; a no-op context otherwise
    (identical to today's unlocked behavior). Degrades LOUDLY, never silently, on a
    platform with no `fcntl` (design D6: a gate must never fail for want of
    a lock).

    With `max_wait` set, a wait reaching that many seconds raises
    `_LockBusy` instead of acquiring (lock-and-ledger-hygiene D2).

    With `priority` set (a waiting `gates merge`, merge-lane-friction D2), a
    claim beside the lock file is held from before the first attempt until
    the lock is taken or the wait gives up. Every waiter without it defers to
    a live claim, even when the lock is free; the holder is never pre-empted.

    `clock` (monotonic, for the wait), `wall` (epoch, for the holder's age)
    and `sleep` are injectable so the wait loop is testable without a real
    timer. Resolved at call time, not definition time, so a test replacing
    the `time` module's functions reaches a wait started from `cmd_run`."""
    clock = clock or time.monotonic
    wall = wall or time.time
    sleep = sleep or time.sleep
    if not always and gate not in _serialized_gates(m):
        yield
        return
    try:
        import fcntl
    except ImportError:
        print(
            f"gatedloop: gate '{gate}' is declared serialized, but this "
            "platform has no fcntl — serialization is unavailable; running "
            "unlocked.",
            file=sys.stderr,
        )
        yield
        return

    path = _lock_path(root, gate)
    path.parent.mkdir(parents=True, exist_ok=True)
    fh = open(path, "a+")
    claim = _priority_claim_path(path)
    me = os.getpid()
    try:
        wait_started = clock()
        last_notice: float | None = None
        if priority:
            # Written whole, then renamed into place: a waiter must never
            # read half a claim, which would look stale and be removed.
            staged = claim.with_name(f"{claim.name}.{me}.tmp")
            staged.write_text(json.dumps({"pid": me, "ts": _now_iso()}))
            os.replace(staged, claim)
        try:
            while True:
                deferred_to = None if priority else _live_priority_claim(claim, me)
                if deferred_to is None:
                    try:
                        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                        break
                    except OSError:
                        pass
                now = clock()
                if deferred_to is not None:
                    holder = f"a waiting merge (pid {deferred_to}), which has priority"
                else:
                    holder = _describe_lock_holder(_read_lock_holder(path), wall())
                if max_wait is not None and now - wait_started >= max_wait:
                    raise _LockBusy(gate, holder, now - wait_started, max_wait, bound_key)
                if last_notice is None or now - last_notice >= _LOCK_NOTICE_INTERVAL_SECONDS:
                    waited = "" if last_notice is None else f", waited {_fmt_duration(now - wait_started)}"
                    print(
                        f"gatedloop: waiting for gate '{gate}' — held by {holder}{waited}",
                        file=sys.stderr,
                    )
                    last_notice = now
                sleep(_LOCK_POLL_INTERVAL_SECONDS)
        finally:
            if priority and _read_lock_holder(claim).get("pid") == me:
                with contextlib.suppress(OSError):
                    claim.unlink()
        fh.seek(0)
        fh.truncate()
        fh.write(json.dumps({"pid": os.getpid(), "ts": _now_iso()}))
        fh.flush()
        yield
    finally:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        except Exception:
            pass
        fh.close()


# merge-step D4: the lock `gates merge` holds for its whole run. Always
# serialized -- two local merges into one target from one machine can't both
# be right -- so it needs no `concurrency.serialize` entry, and it is bounded
# by `concurrency.max-wait-seconds` like every serialized gate.
MERGE_LOCK = "merge"


def _merge_lock(root: Path, m: dict, *, clock=None, wall=None, sleep=None):
    return _gate_lock(root, m, MERGE_LOCK, max_wait=_lock_max_wait(m),
                      clock=clock, wall=wall, sleep=sleep, always=True)


# lock-and-ledger-hygiene D3: a live holder past this is flagged "possibly
# hung" for a human to inspect. gatedloop never kills a holder: a crashed one
# frees its flock with its file descriptors, and a hung one is a human's call.
_LOCK_POSSIBLY_HUNG_SECONDS = 3600


def lock_status(root: Path, m: dict, wall=None) -> list[dict]:
    """One entry per serialized gate (D3). The lock is probed with
    `LOCK_EX | LOCK_NB` on a separate handle and released at once if
    acquired: acquired means free, whatever the metadata says; refused means
    held, by the pid the metadata names. The `merge` lock (merge-step D4) is
    serialized without a declaration, so it is listed once it has ever been
    taken -- its lock file is the evidence."""
    import fcntl
    wall = wall or time.time
    out: list[dict] = []
    names = set(_serialized_gates(m))
    if _lock_path(root, MERGE_LOCK).exists():
        names.add(MERGE_LOCK)
    for gate in sorted(names):
        entry = {"gate": gate, "state": "free", "pid": None, "alive": None,
                 "held_seconds": None, "possibly_hung": False}
        path = _lock_path(root, gate)
        # merge-lane-friction D2: a live claim is a merge waiting with
        # priority. Read only: status never removes a stale claim.
        claim = _read_lock_holder(_priority_claim_path(path))
        claim_pid = claim.get("pid")
        entry["priority_pid"] = claim_pid if _pid_alive(claim_pid) else None
        if path.exists():
            with open(path, "r") as fh:
                try:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    holder = _read_lock_holder(path)
                    pid = holder.get("pid")
                    alive = _pid_alive(pid)
                    age = _holder_age_seconds(holder, wall())
                    entry.update({
                        "state": "held", "pid": pid, "alive": alive,
                        "held_seconds": int(age) if age is not None else None,
                        "possibly_hung": bool(
                            alive and age is not None and age > _LOCK_POSSIBLY_HUNG_SECONDS
                        ),
                    })
                else:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        out.append(entry)
    return out


def cmd_lock(m: dict, root: Path, args) -> int:
    try:
        import fcntl  # noqa: F401
    except ImportError:
        print(
            "gatedloop: lock status is unavailable — this platform has no fcntl, "
            "so no gate is serialized here.",
            file=sys.stderr,
        )
        return 1
    entries = lock_status(root, m)
    if args.json:
        print(json.dumps({"locks": entries}, indent=2))
        return 0
    if not entries:
        print("gatedloop: no gate is serialized (concurrency.serialize is absent or empty) — no locks to report")
        return 0
    for e in entries:
        waiting = (f"; merge pid {e['priority_pid']} waiting with priority"
                   if e.get("priority_pid") is not None else "")
        if e["state"] == "free":
            print(f"{e['gate']}: free{waiting}")
            continue
        age = _fmt_duration(e["held_seconds"]) if e["held_seconds"] is not None else "an unknown time"
        line = (f"{e['gate']}: held by pid {e['pid'] if e['pid'] is not None else '?'} "
                f"({_liveness_word(e['alive'])}) for {age}")
        if e["possibly_hung"]:
            line += (f" — possibly hung; inspect with `ps -o pid,etime,command -p {e['pid']}` "
                     "(gatedloop never terminates a holder)")
        print(line + waiting)
    return 0


_FRESH_WORKTREE_HINT_STAMP_REL = Path(NAME) / "fresh-worktree-hinted"


def _worktree_has_gate_history(root: Path) -> bool:
    """Whether ANY gate has ever recorded a marker in THIS worktree's git
    dir — legacy single-slot or tree-keyed, either counts (design D7,
    worktree-native-loop: "no marker store" is the freshness signal)."""
    d = _markers_dir(root)
    if not d.exists():
        return False
    return any(d.rglob("*.json"))


def _fresh_worktree_hint_stamp_path(root: Path) -> Path:
    return _git_dir(root) / _FRESH_WORKTREE_HINT_STAMP_REL


def _maybe_print_fresh_worktree_hint(root: Path, rc: int) -> None:
    """Design D7: a gate failing in a worktree with NO prior recorded gate
    history (no marker store, and this hint hasn't fired before) earns one
    stack-agnostic line pointing at the adopter's own manifest — never a
    concrete tool name, since the shim doesn't know the stack. Prints at
    most once per worktree (a stamp file, not a re-derivable condition,
    survives even after the worktree stops being fresh); never touches the
    gate's own exit code."""
    if rc == 0:
        return
    if _worktree_has_gate_history(root):
        return
    stamp = _fresh_worktree_hint_stamp_path(root)
    if stamp.exists():
        return
    stamp.parent.mkdir(parents=True, exist_ok=True)
    stamp.write_text(_now_iso())
    print(
        "gatedloop: hint: this worktree looks fresh — its dependencies may "
        "not be installed yet; your project's setup lives in your own "
        "gates (.gates.yaml)",
        file=sys.stderr,
    )


def _ledger_context(root: Path, args) -> tuple[str | None, str | None, int]:
    change = _resolve_change_name(root, getattr(args, "change", None))
    task = getattr(args, "task", None)
    attempt = getattr(args, "attempt", None) or 1
    return change, task, attempt


def cmd_run(m: dict, root: Path, args) -> int:
    gate = args.gate
    extra = args.gate_args or []
    change, task, attempt = _ledger_context(root, args)
    if gate in BUDGETED_GATES and change is not None and not getattr(args, "full", False):
        # retry-budget D2: a run with no `--task` belongs to the task the loop
        # is in (the latest `task-start` after the handoff), and its row says
        # so; with no task at all, nothing is budgeted. The merge's unscoped
        # proof (`full`) is never a task's attempt.
        rows = _read_ledger_rows(root, change)
        if task is None:
            task = _current_task_after_handoff(rows)
        if task is not None:
            refusal = (_budget_refusal(m, rows, task, _task_oracle_gate(root, change, task))
                       or _token_budget_refusal(m, rows, change, task))
            if refusal:
                print(refusal, file=sys.stderr)
                return 1
    if change is None and _current_branch(root) is None:
        # hook-correctness D6: say so rather than silently record nothing.
        print(
            "gatedloop: detached HEAD — no ledger row written; pass --change <name> to record one",
            file=sys.stderr,
        )

    def record(
        rc: int, tree: str | None, started: float,
        verdict: str | None = None, scope: str | None = None,
    ) -> None:
        if change is None:
            return
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": gate, "exit": rc,
            "duration_ms": int((time.monotonic() - started) * 1000),
            "change": change, "task": task, "tree": tree, "attempt": attempt,
            "approved_by": _read_approved_by(root, change), "sha": None,
            "verdict": verdict,
            "outcome": None, "precondition": None, "precondition_exit": None,
            "scope": scope,
        })

    def record_precondition_failure(precondition: str, precondition_exit: int | None, started: float) -> None:
        # design D3: a discriminated row that claims the OPPOSITE of a green
        # run — `exit` is the reserved PRECONDITION_EXIT_CODE (never 0, so it
        # can never read as green or satisfy `_maybe_resolve_taint`'s join on
        # green `ci` rows), `tree` is always None (nothing ran against a
        # tree, so nothing can join one), and `outcome` names the row kind
        # unmistakably for a human or agent reading the ledger.
        if change is None:
            return
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": gate, "exit": PRECONDITION_EXIT_CODE,
            "outcome": "precondition-failed",
            "precondition": precondition, "precondition_exit": precondition_exit,
            "duration_ms": int((time.monotonic() - started) * 1000),
            "change": change, "task": task, "tree": None, "attempt": attempt,
            "approved_by": _read_approved_by(root, change), "sha": None,
            "verdict": None,
            # No oracle ran, so no scope was exercised — `None`, not the
            # scope that would have been selected.
            "scope": None,
        })

    def lock_busy(busy: _LockBusy, started: float) -> int:
        # lock-and-ledger-hygiene D2: the same exit (75, "try again") and the
        # same not-run row shape as a failed precondition, told apart by the
        # message prefix and `precondition: "lock-busy"` (no command ran, so
        # `precondition_exit` is None).
        print(busy.message(), file=sys.stderr)
        record_precondition_failure("lock-busy", None, started)
        return PRECONDITION_EXIT_CODE

    # merge-lane-friction D2/D3: a merge step's run waits with priority, for
    # `merge-wait-seconds`.
    priority = bool(getattr(args, "merge_priority", False))
    max_wait = _lock_merge_wait(m) if priority else _lock_max_wait(m)
    bound_key = "merge-wait-seconds" if priority else "max-wait-seconds"

    if gate == "live-check":
        started = time.monotonic()
        changed, evidence = _change_level_changed_files(args, root)
        hot = hot_surfaces(m, changed)
        checks = []
        for s in hot:
            if not s.get("live-check"):
                continue
            run_cmd, surf_requires = _gate_spec(s["live-check"])
            if not run_cmd:
                sys.exit(
                    f"gatedloop: surface '{s['name']}' live-check has no 'run' command"
                )
            checks.append((s["name"], run_cmd, surf_requires))
        if not checks:
            # design D2: a resolved-empty check set is a recorded SKIP
            # verdict, not an absence -- the empty-check-set path used to end
            # here with neither a marker nor a ledger row ("nothing ran"),
            # which made the merge gate unsatisfiable for every docs-only
            # diff and every project declaring no live-check at all (#9,
            # #14.1, #17.2). The marker and ledger row now carry the same
            # evidence (baseline, target, files considered) the message
            # prints, bound to the current head tree; a declared probe that
            # actually runs red still writes nothing (this branch is never
            # reached in that case).
            tree = _head_tree(root)
            if tree:
                _write_marker(root, "live-check", tree, verdict="skip", evidence=evidence)
            print(
                "gatedloop: no live-check for the hot surfaces "
                f"({_describe_change_level_evidence(evidence)}) — skipping (not a failure)"
            )
            record(0, tree, started, verdict="skip")
            return 0

        # Design D4 (gate-preconditions): every hot surface's declared
        # `requires` runs BEFORE any probe body. A partial "some probes ran"
        # state on a down environment would mix "gate failed" with
        # "environment absent" — the ambiguity this change removes — so any
        # failure blocks every probe, not just its own surface's.
        failed: list[tuple[str, str, int]] = []
        for name, _cmd, surf_requires in checks:
            if not surf_requires:
                continue
            prc = _exec(surf_requires, root)
            if prc != 0:
                failed.append((name, surf_requires, prc))
        if failed:
            for name, surf_requires, prc in failed:
                print(
                    f"gatedloop: precondition '{surf_requires}' failed (exit {prc}) — "
                    f"live-check [{name}] was not run",
                    file=sys.stderr,
                )
            precondition_desc = "; ".join(f"{name}: {cmd}" for name, cmd, _prc in failed)
            record_precondition_failure(precondition_desc, failed[0][2], started)
            return PRECONDITION_EXIT_CODE

        # design D3 (fix-marker-mechanics): dedupe by *exact* command string
        # -- the manifest binds plain strings, so string equality is recipe
        # identity in this system. First-declaration order is kept (an
        # ordinary dict already does this); the log line attributes the one
        # execution to every surface that binds it, so a shared recipe's
        # flake is never double-counted as two independent failures (#14).
        recipes: dict[str, list[str]] = {}
        for name, cmd, _requires in checks:
            recipes.setdefault(cmd, []).append(name)
        rc = 0
        # design D6: one lock acquisition covers the whole live-check run --
        # "one heavy suite per machine" is the point, not per-surface
        # granularity (a `--all` run and a per-surface run take the SAME
        # single gate-level lock).
        try:
            with _gate_lock(root, m, "live-check", max_wait=max_wait, priority=priority,
                            bound_key=bound_key):
                for cmd, names in recipes.items():
                    print(f"gatedloop: live-check [{', '.join(names)}]", file=sys.stderr)
                    rc = _exec(cmd, root) or rc
        except _LockBusy as busy:
            return lock_busy(busy, started)
        tree = _head_tree(root)
        if rc == 0 and tree:
            _write_marker(root, "live-check", tree)
        record(rc, tree, started)
        _maybe_print_fresh_worktree_hint(root, rc)
        return rc

    gates = m.get("gates") or {}
    scope = "full"
    if gate in ("ci", "unit"):
        # scale-gate-cost D1: `ci` scopes off the staged diff (what will
        # actually be committed); `unit` off the working tree (tests are
        # written before staging, per tdd-apply's 5c/5e) -- the open
        # question the design left for implementation to decide. Either
        # `None` (unreadable diff) or `[]` (nothing changed) falls back to
        # the global gate identically, the err-full direction. The selected
        # value is a raw manifest spec (scalar or {run, requires}) and goes
        # through `_gate_spec` below like any other gate value.
        changed_for_scope = _staged_diff_paths(root) if gate == "ci" else _working_set_files()
        if getattr(args, "full", False):
            # merge-step D2 step 3: the merged tree gets the full oracle,
            # whatever the staged squash would otherwise scope to.
            changed_for_scope = []
        spec, scope = _select_scoped_gate(m, gate, changed_for_scope)
    else:
        spec = gates.get(gate)
    if not spec:
        if gate in REQUIRED_GATES:
            sys.exit(f"gatedloop: required gate '{gate}' is not declared in the manifest")
        print(f"gatedloop: optional gate '{gate}' not declared — skipping (not a failure)")
        return 0

    cmd, requires = _gate_spec(spec)
    if not cmd:
        sys.exit(f"gatedloop: gate '{gate}' has no 'run' command")

    if requires:
        pre_started = time.monotonic()
        prc = _exec(requires, root)
        if prc != 0:
            print(
                f"gatedloop: precondition '{requires}' failed (exit {prc}) — "
                f"gate '{gate}' was not run",
                file=sys.stderr,
            )
            record_precondition_failure(requires, prc, pre_started)
            return PRECONDITION_EXIT_CODE

    if gate == "eval":
        dataset = extra[0] if len(extra) > 0 else ""
        score = extra[1] if len(extra) > 1 else ""
        cmd = cmd.replace("{dataset}", dataset).replace("{score}", score)
    elif extra:
        cmd = cmd + " " + " ".join(extra)
    if gate in ("ci", "unit"):
        why = "nothing scoped narrower" if scope == "full" else f"hot surface '{scope}' declares an override"
        print(f"gatedloop: {gate}[{scope}] — {why}", file=sys.stderr)
    started = time.monotonic()
    # design D6 (worktree-native-loop): the lock is held strictly around the
    # gate command; the marker write, ledger row and taint resolution below
    # all happen outside it.
    try:
        with _gate_lock(root, m, gate, max_wait=max_wait, priority=priority,
                        bound_key=bound_key):
            rc = _run_gate_captured(cmd, root, gate, scope, getattr(args, "verbose", False))
    except _LockBusy as busy:
        return lock_busy(busy, started)
    tree = _write_tree(root)
    if gate == "ci" and rc == 0 and tree:
        _write_marker(root, "ci", tree, scope=scope)
    record(rc, tree, started, scope=scope if gate in ("ci", "unit") else None)
    if gate == "ci" and rc == 0 and tree and change is not None:
        # A green ci on the branch head clears an outstanding audit taint (D7).
        _maybe_resolve_taint(root, change, tree)
    _maybe_print_fresh_worktree_hint(root, rc)
    return rc


# ---------- the attempt budget (retry-budget D1, D2) ----------------------
#
# "If a gate stays red after 2 focused fix attempts, HALT" was a sentence in a
# prompt, and `--attempt` a label nothing read back. The count now comes from
# the ledger alone, so a caller's `--attempt` buys nothing: for task T, a
# failed attempt is a red row of T's oracle gate (`unit` untagged; task-oracle
# D4) or of `ci` after T's RED run (its first red oracle-gate row since its
# latest `task-start`) and after its latest `restart`.
# Exit 75 (a down environment, a busy lock) never counts -- nothing judged
# the code. A green row never resets the count.

RESTART_EVENT = "restart"
ATTEMPT_NOTE_EVENT = "attempt-note"
BUDGETED_GATES = ("unit", "ci")


def _attempt_state(rows: list[dict], task: str, gate: str = "unit") -> tuple[bool, int]:
    """`(red_run_seen, failed_attempts)` for `task`, per design D1, from the
    rows after the later of its latest `task-start` and its latest test
    placement (all rows when it has neither). Starting at the placement
    (unblock-authored-lock D6) means a test-defect cycle's red runs, against
    tests the author has since replaced, are not attempts: the first red run
    against the re-placed tests is the task's red run. `gate` is the task's
    oracle gate (task-oracle D4): its first red run is the RED run, and its
    later red runs and red `ci` runs are the attempts."""
    start = 0
    for i, r in enumerate(rows):
        if r.get("gate") in (TASK_BASELINE_EVENT, TESTS_PLACED_EVENT) and r.get("task") == task:
            start = i + 1
    red_seen, count = False, 0
    for r in rows[start:]:
        if r.get("gate") == RESTART_EVENT and r.get("task") == task:
            count = 0
        elif _is_red_gate_row(r, task, gate):
            if red_seen:
                count += 1
            red_seen = True
        elif red_seen and _is_red_gate_row(r, task, "ci"):
            count += 1
    return red_seen, count


def _task_oracle_gate(root: Path, change: str, task: str) -> str:
    """The task's oracle gate from the change's `tasks.md` in the working
    tree: its tag's gate, or `unit` when it declares none (task-oracle D4)."""
    oracle = _change_task_oracles(root, change).get(task)
    return (oracle or {}).get("gate") or "unit"


def failed_attempt_count(rows: list[dict], task: str, gate: str = "unit") -> int:
    """Pure: task's failed attempts since its RED run and its last restart."""
    return _attempt_state(rows, task, gate)[1]


def restarts_used(rows: list[dict], task: str) -> int:
    """Pure: how many `restart` rows the task has, across the whole ledger."""
    return sum(1 for r in rows if r.get("gate") == RESTART_EVENT and r.get("task") == task)


def _budget_refusal(m: dict, rows: list[dict], task: str, gate: str = "unit") -> str | None:
    """Design D2: the refusal message once the task's budget is used, else
    `None`. Never refuses before the RED run -- that run is required."""
    attempts, limit = loop_budget(m)
    red_seen, count = _attempt_state(rows, task, gate)
    if not red_seen or count < attempts:
        return None
    used = restarts_used(rows, task)
    since = "since its RED run" + (" and its restart" if used else "")
    lines = [
        f"gatedloop: task {task} has used its attempt budget ({count} failed "
        f"attempt(s) {since}; loop.attempts is {attempts}). The gate was not run.",
    ]
    halt = f"`gates halt record stalled --task {task} --detail \"<what was tried>\"`"
    if used < limit:
        lines.append(
            f"  A fresh restart remains ({limit - used} of {limit}): `gates attempt restart "
            f"{task}` from a clean tree, in a new context that reads only `gates attempt "
            f"notes {task}`. The restart is the dispatcher's; an implementer halts instead."
        )
        lines.append(f"  Otherwise: halt with cause `stalled` ({halt}).")
    else:
        lines.append(
            f"  No fresh restart remains ({used} of {limit} used): halt with cause "
            f"`stalled` ({halt}); a human takes it from there."
        )
    return "\n".join(lines)


def token_budget(m: dict) -> int | None:
    """The declared `loop.token-budget`, or `None` (absent or malformed --
    a malformed value is `gates validate`'s business, and is no budget)."""
    loop = m.get("loop") if isinstance(m, dict) else None
    v = loop.get("token-budget") if isinstance(loop, dict) else None
    return v if isinstance(v, int) and not isinstance(v, bool) and v > 0 else None


def _token_budget_refusal(m: dict, rows: list[dict], change: str, task: str) -> str | None:
    """token-ledger D5: the refusal once the change's recorded usage reaches
    `loop.token-budget`, else `None`. Recorded rows only: the task in flight
    is counted at its commit or the session stop, and the message says so."""
    budget = token_budget(m)
    if budget is None:
        return None
    spent = recorded_usage(rows)
    if spent < budget:
        return None
    return "\n".join([
        f"gatedloop: change '{change}' has reached its token budget: {spent} tokens "
        f"recorded, loop.token-budget is {budget}. The gate was not run.",
        "  The count is recorded usage only: the task in flight is counted at its "
        "commit or the session stop, so it may have spent more than this says.",
        f"  Halt with cause `budget` (`gates halt record budget --task {task} --detail "
        "\"<what remains>\"`) and never retry: a human decides whether to raise the "
        "budget, cheapen the gates, or split the change.",
    ])


# ---------- attempt notes and fresh restarts (retry-budget D3, D4) ---------
#
# The ledger recorded outcomes, not lessons: a resuming agent got `tasks.md`
# and git, never "what was tried and why it failed". A note is four short,
# required, single-line fields -- the issue's own structure -- refused rather
# than truncated when one is long, so it stays a lesson and never becomes a
# transcript. A resuming or restarted agent reads the notes, not a history.

NOTE_FIELDS = ("hypothesis", "changed", "oracle", "next")
NOTE_FIELD_MAX = 200


def _note_field_problem(name: str, value) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return f"--{name} is required and must not be empty"
    if "\n" in value or "\r" in value:
        return f"--{name} spans lines; each field is one line"
    if len(value) > NOTE_FIELD_MAX:
        return (f"--{name} is {len(value)} characters; the limit is {NOTE_FIELD_MAX} "
                "(a note is a lesson, not a transcript)")
    return None


def _task_notes(rows: list[dict], task: str) -> list[dict]:
    """The task's notes, oldest first (file order), across restarts."""
    out = []
    for r in rows:
        if r.get("gate") != ATTEMPT_NOTE_EVENT or r.get("task") != task:
            continue
        note = r.get("note") if isinstance(r.get("note"), dict) else {}
        out.append({"attempt": r.get("attempt"),
                    **{k: note.get(k) for k in NOTE_FIELDS}})
    return out


def cmd_attempt(m: dict, root: Path, args) -> int:
    change = _resolve_change_name(root, getattr(args, "change", None))
    if change is None:
        print(
            "gatedloop: no change to key an attempt row on — the merge target (or no "
            "branch) is checked out. Run it on the change branch or pass `--change "
            "<name>`. Nothing was written.",
            file=sys.stderr,
        )
        return 1
    rows = _read_ledger_rows(root, change)
    task = args.task
    if args.attempt_cmd == "note":
        fields = {k: getattr(args, k, None) for k in NOTE_FIELDS}
        problems = [p for p in (_note_field_problem(k, v) for k, v in fields.items()) if p]
        if problems:
            print(f"gatedloop: refusing the attempt note for task {task}:", file=sys.stderr)
            for p in problems:
                print(f"  - {p}", file=sys.stderr)
            print("Nothing was written.", file=sys.stderr)
            return 1
        attempt = failed_attempt_count(rows, task, _task_oracle_gate(root, change, task))
        _append_ledger_row(root, {
            "ts": _now_iso(), "gate": ATTEMPT_NOTE_EVENT, "exit": None, "duration_ms": 0,
            "change": change, "task": task, "tree": None, "attempt": attempt,
            "approved_by": _read_approved_by(root, change), "sha": None,
            "note": fields,
        })
        print(f"gatedloop: recorded the note for task {task}, attempt {attempt}, in "
              f"{_ledger_path(root, change)}")
        return 0
    if args.attempt_cmd == "notes":
        notes = _task_notes(rows, task)
        if getattr(args, "json", False):
            print(json.dumps({"task": task, "notes": notes}, sort_keys=True))
            return 0
        if not notes:
            print(f"gatedloop: task {task} has no attempt notes")
            return 0
        for n in notes:
            print(f"attempt {n['attempt']}:")
            print(f"  hypothesis: {n['hypothesis']}")
            print(f"  changed:    {n['changed']}")
            print(f"  oracle:     {n['oracle']}")
            print(f"  next:       {n['next']}")
        return 0
    if args.attempt_cmd == "restart":
        return _attempt_restart(m, root, change, rows, task)
    sys.exit(f"gatedloop: unknown attempt subcommand '{args.attempt_cmd}'")


def _restart_dirt(root: Path, change: str, rows: list[dict], task: str,
                  lines: list[str]) -> tuple[list[str], list[str]]:
    """unblock-authored-lock D7: `(dirty, edited)` from `git status
    --porcelain --no-renames` lines, minus what the task's placement made:
    each of its placed paths holding exactly its placed blob (in the worktree,
    and in the index when staged) and each removal of its holding files.
    `edited` names a placed path holding anything else."""
    try:
        active = _active_placements(rows, _lock_completion(root, change, rows, "HEAD"))
    except _LedgerRewritten:
        active = _active_placements(rows)
    placed = active[task][1] if task in active else {}
    holding = _state_rel(root, "authored", change, task) + "/"
    staged = _staged_blobs(root) or {}
    dirty: list[str] = []
    edited: list[str] = []
    for ln in lines:
        code, path = ln[:2], ln[3:]
        if path in placed:
            blob = placed[path]
            in_index = staged.get(path)
            head = _git(root, "rev-parse", "--verify", "--quiet", f"HEAD:{path}").stdout.strip() or None
            if _file_blob(root, path) == blob and in_index in (blob, head):
                continue
            edited.append(path)
            continue
        if path.startswith(holding) and "D" in code and not (root / path).exists():
            continue
        dirty.append(path)
    return dirty, edited


def _attempt_restart(m: dict, root: Path, change: str, rows: list[dict], task: str) -> int:
    """Design D4: one fresh start for the task, in a new agent context. It
    needs the halt discipline to hold already -- a clean tree at the task's
    last commit, where the task's placed tests at exactly their placed
    content and their holding files' removal count as clean (D7 of
    unblock-authored-lock) -- and refuses once `loop.fresh-restarts`
    restarts are used. Otherwise it records a `restart` row, which resets
    D1's count."""
    status = _git(root, "status", "--porcelain", "--untracked-files=all", "--no-renames")
    if status.returncode != 0:
        print(f"gatedloop: could not read the working tree ({status.stderr.strip()}); "
              "refusing to restart. Nothing was written.", file=sys.stderr)
        return 1
    # token-ledger D1: a usage-only ledger append (a stop flush) is not work;
    # unblock-authored-lock D7: nor are the task's placed tests at their
    # placed content.
    dirty, edited = _restart_dirt(root, change, rows, task,
                                  _dirt_beyond_usage(root, status.stdout))
    if edited:
        print(
            f"gatedloop: refusing to restart task {task}: its placed test(s) "
            f"{', '.join(edited)} differ from their placed content. A placed test "
            "changes only through its author (`gates tests defect`); restore it. "
            "Nothing was written.",
            file=sys.stderr,
        )
        return 1
    if dirty:
        shown = ", ".join(dirty[:5]) + (" ..." if len(dirty) > 5 else "")
        print(
            f"gatedloop: refusing to restart task {task}: the working tree is not clean "
            f"({shown}). A restart begins at the task's last commit: commit the halt row "
            "and discard the halted run's partial work first. Nothing was written.",
            file=sys.stderr,
        )
        return 1
    _attempts, limit = loop_budget(m)
    used = restarts_used(rows, task)
    if used >= limit:
        print(
            f"gatedloop: refusing to restart task {task}: {used} of {limit} fresh "
            f"restart(s) used (loop.fresh-restarts). The way forward is a halt with cause "
            f"`stalled` (`gates halt record stalled --task {task} --detail \"<what was "
            "tried>\"`); a human takes it from there. Nothing was written.",
            file=sys.stderr,
        )
        return 1
    _append_ledger_row(root, {
        "ts": _now_iso(), "gate": RESTART_EVENT, "exit": None, "duration_ms": 0,
        "change": change, "task": task, "tree": _head_tree(root), "attempt": None,
        "approved_by": _read_approved_by(root, change), "sha": None,
    })
    print(
        f"gatedloop: recorded fresh restart {used + 1} of {limit} for task {task} in "
        f"{_ledger_path(root, change)}. Its failed-attempt count starts again from zero; "
        f"read `gates attempt notes {task}` before touching the task."
    )
    return 0


# ---------- gates merge (merge-step) ---------------------------------------
#
# A local-squash-merge as six ordered steps, run in code rather than recited
# from a prompt (design D1): ordering, rollback and publishing are decisions
# the loop mustn't improvise. The shim invokes git as a subprocess, so the
# Bash PreToolUse hooks never see its merge or commits; it runs the same
# checks itself instead -- the merge hook's incoming-tree checks in step 1,
# `discipline check-commit` before each commit -- and the git-layer
# pre-commit hook still fires on every commit it makes.
#
# Every refusal exits with the number of the step that refused (0, the
# preconditions, exits 1 like step 1), so an orchestrator can route on the
# code without parsing prose; the step's own message is always printed.
# Nothing reaches the remote until step 6's single push.

MERGE_STEP_NAMES = {
    0: "preconditions", 1: "prove the head", 2: "integrate",
    3: "prove the merged tree", 4: "record", 5: "confirm", 6: "archive and publish",
}
_MERGE_STATE_REL = Path(NAME) / "merge-state"


class _MergeHalt(Exception):
    """A step refused. `code` defaults to the step number."""

    def __init__(self, step: int, message: str, code: int | None = None):
        self.step = step
        self.message = message
        self.code = code if code is not None else max(step, 1)
        super().__init__(message)


def _captured(fn, *args) -> tuple[int, str, str]:
    """Run a check that prints its own verdict, keeping that text so a
    refusal can quote it."""
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            rc = fn(*args)
        except SystemExit as e:
            rc = e.code if isinstance(e.code, int) else 1
            if not isinstance(e.code, int) and e.code:
                print(e.code, file=sys.stderr)
    return rc, out.getvalue(), err.getvalue()


def _git(root: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)


def _merge_state_path(root: Path) -> Path:
    return _git_dir(root) / _MERGE_STATE_REL


def _head_position(root: Path) -> dict:
    branch = _current_branch(root)
    if branch:
        return {"branch": branch}
    return {"sha": _rev(root, "HEAD")}


def _restore_position(root: Path, position: dict) -> None:
    """Put the primary checkout back where step 0 found it. Loud on failure:
    a primary left somewhere else must never look restored."""
    if position.get("branch"):
        out = _git(root, "checkout", "-q", position["branch"])
    else:
        out = _git(root, "checkout", "-q", "--detach", position.get("sha") or "HEAD")
    if out.returncode != 0:
        print(
            f"gatedloop: could not restore the primary checkout to {position}: "
            f"{out.stderr.strip()}",
            file=sys.stderr,
        )


def _ledger_rel(change: str, root: Path) -> str:
    return _state_rel(root, "runs", f"{change}.jsonl")


def _commit_ledger_rows(wt: Path, change: str, message: str, step: int = 1) -> str | None:
    """Commit the change's ledger file in worktree `wt` when it has rows git
    has not recorded, as a commit holding that one path (ledger grade by
    construction). Returns the new sha, or `None` when nothing was pending."""
    rel = _ledger_rel(change, wt)
    pending = _git(wt, "status", "--porcelain", "--", rel)
    if pending.returncode != 0:
        raise _MergeHalt(step, f"could not read the ledger's status in {wt}: {pending.stderr.strip()}")
    if not pending.stdout.strip():
        return None
    for cmd in (("add", "--", rel), ("commit", "-q", "-m", message, "--", rel)):
        out = _git(wt, *cmd)
        if out.returncode != 0:
            raise _MergeHalt(
                step, f"could not commit the ledger rows in {wt} (`git {cmd[0]}`): "
                f"{(out.stderr or out.stdout).strip()}",
            )
    return _rev(wt, "HEAD")


def _record_on_branch(root: Path, change: str, row: dict, message: str, step: int) -> str | None:
    """Append `row` to the change's ledger ON ITS BRANCH and commit it there:
    in the worktree that has the branch checked out, or, when none does, in
    a temporary one removed afterwards."""
    holder = _worktree_holding(root, change)
    if holder is not None:
        _append_ledger_row(holder, row)
        return _commit_ledger_rows(holder, change, message, step)
    with tempfile.TemporaryDirectory(prefix=f"{NAME}-merge-") as tmp:
        wt = Path(tmp) / "branch"
        added = _git(root, "worktree", "add", "-q", str(wt), change)
        if added.returncode != 0:
            print(
                f"gatedloop: could not check '{change}' out to record the row there: "
                f"{added.stderr.strip()}",
                file=sys.stderr,
            )
            return None
        try:
            _append_ledger_row(wt, row)
            return _commit_ledger_rows(wt, change, message, step)
        finally:
            _git(root, "worktree", "remove", "--force", str(wt))
            _git(root, "worktree", "prune")


def _unrecorded_commits(root: Path, change: str, rows: list[dict]) -> list[str]:
    """The audit's verdict, read-only, for a branch no worktree has checked
    out: commits on `<change>` beyond the target whose tree no green-`ci`
    row vouches for and that no earlier row already recorded."""
    target, _reason = _resolve_merge_target(root)
    if target is None:
        return []
    out = _git(root, "rev-list", f"refs/heads/{change}", "--not", target)
    if out.returncode != 0:
        return []
    matcher = _GreenCiMatcher(root, rows)
    already = _existing_taint_shas(rows) | _existing_classified_shas(rows)
    bad = []
    for sha in reversed([s for s in out.stdout.splitlines() if s.strip()]):
        tree = _commit_tree(root, sha)
        if sha in already or tree is None:
            continue
        if not matcher.rows_for(tree):
            bad.append(sha)
    return bad


def _merge_recover(root: Path, change: str) -> None:
    """Design Risks: a crash between the local commits and the push leaves
    the primary detached on commits nobody published. A rerun that finds the
    state file of a merge of this change, and a detached HEAD whose tree
    carries this change's merge row for a commit HEAD contains, puts the
    primary back where that merge found it before starting again."""
    path = _merge_state_path(root)
    if not path.exists() or _current_branch(root) is not None:
        return
    try:
        state = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    position = state.get("position") or {}
    if state.get("change") != change or not position:
        return
    blob = _git(root, "cat-file", "blob", f"HEAD:{_ledger_rel(change, root)}")
    rows = _parse_jsonl_rows(blob.stdout) if blob.returncode == 0 else []
    if not any(
        r.get("gate") == "merge" and r.get("sha") and _is_ancestor(root, r["sha"], "HEAD")
        for r in rows
    ):
        return
    head = _rev(root, "HEAD") or "HEAD"
    _git(root, "reset", "-q", "--hard")
    _restore_position(root, position)
    print(
        f"gatedloop: step 0 — recovered from an interrupted merge of '{change}': the "
        f"primary was detached at {head[:12]} on the merge's own local commits; "
        f"restored it to {position.get('branch') or position.get('sha')} before starting again"
    )


def _merge_preconditions(m: dict, root: Path, change: str) -> dict:
    """Step 0 (design D2): the change resolves to a directory on its branch,
    the primary checkout is clean apart from untracked files, and where HEAD
    is gets recorded so every exit can restore it."""
    _merge_recover(root, change)
    if _rev(root, f"refs/heads/{change}") is None:
        raise _MergeHalt(0, f"there is no branch '{change}' (branch name = change name).")
    if _change_for_ref(root, change) is None:
        raise _MergeHalt(
            0, f"branch '{change}' has no openspec/changes/{change}/ directory, so it is "
            "not a change this command can merge.",
        )
    status = _git(root, "status", "--porcelain", "--untracked-files=no")
    if status.returncode != 0:
        raise _MergeHalt(0, f"could not read the primary checkout's status: {status.stderr.strip()}")
    on_branch = _current_branch(root) == change
    dirty = [
        line[3:] for line in status.stdout.splitlines()
        if line.strip() and not (on_branch and line[3:] == _ledger_rel(change, root))
    ]
    if dirty:
        raise _MergeHalt(
            0, "the primary checkout has uncommitted changes, which the detach in step 2 "
            "would carry or refuse: " + ", ".join(dirty),
        )
    target, reason = _resolve_merge_target(root)
    if target is None:
        raise _MergeHalt(0, f"no integration target resolves ({reason}).")
    position = _head_position(root)
    state = _merge_state_path(root)
    state.parent.mkdir(parents=True, exist_ok=True)
    state.write_text(json.dumps({
        "change": change, "position": position, "target": target,
        "pid": os.getpid(), "ts": _now_iso(),
    }))
    return {"position": position, "target": target}


def _merge_prove_head(m: dict, root: Path, change: str, require_acceptance: bool = True) -> str:
    """Step 1 (design D2): commit trailing ledger rows on the branch, then
    the merge hook's incoming-tree checks against `<change>^{tree}` and the
    named change's ledger -- never the current branch's (specloop PR 100). Returns
    the incoming tree. `require_acceptance=False` is pull-request mode
    (merge-pull-request D2): there a declared acceptance decides whether
    auto-merge is enabled instead of refusing here -- under `acceptance:
    review` it can only be given on the pull request this run opens."""
    lane = _worktree_holding(root, change)
    if lane is not None:
        # The hook audits right before deciding (escalation-outcomes D5);
        # here that is the lane's own audit, so a new taint is recorded
        # where the branch lives and committed with the trailing rows.
        _captured(cmd_audit, m, lane, argparse.Namespace(change=change))
        sha = _commit_ledger_rows(lane, change, f"record trailing ledger rows: {change}")
        if sha:
            print(f"gatedloop: step 1 — committed trailing ledger rows on '{change}' ({sha[:12]})")
    tree = _commit_tree(root, f"refs/heads/{change}")
    if tree is None:
        raise _MergeHalt(1, f"could not resolve the tree of '{change}'.")
    rows = _change_ledger_rows(root, change, f"refs/heads/{change}")
    problems: list[str] = []

    # The live-check marker and an unscoped ci marker on the incoming tree.
    # Markers are per worktree, and the lane's gates ran in the lane, so
    # either store vouches for the tree -- the same lookup the merge hook's
    # `gate-marker check --ref` uses (cross-worktree-evidence D1).
    stores = _marker_stores(root, change)
    for gate, scope in (("live-check", None), ("ci", "full")):
        texts = []
        for store in stores:
            rc, _out, err = _captured(_check_marker_and_report, store, gate, tree, scope)
            if rc == 0:
                break
            texts.append(err.strip())
        else:
            hint = (
                "run `gates run live-check` on the branch head" if gate == "live-check"
                else "run an unscoped `gates run ci` (nothing staged) on the branch head"
            )
            problems.append(f"{texts[0]}\n  -> {hint}.")

    if (m.get("gates") or {}).get("verify"):
        norm = _normalize_tree(root, tree)
        green = any(
            r.get("gate") == "verify" and r.get("exit") == 0 and r.get("tree")
            and _normalize_tree(root, r["tree"]) == norm
            for r in rows
        )
        if not green:
            problems.append(
                f"gatedloop: `verify` is declared, and no green `verify` is recorded in "
                f"'{change}''s ledger for (ledger-normalized) tree {norm!r}.\n  -> run "
                "`gates run verify` on the branch head."
            )
    else:
        print("gatedloop: step 1 — `verify` is not declared; nothing to require of it")

    if _taint_unresolved(rows):
        problems.append(_taint_refusal(change))
    elif lane is None:
        unrecorded = _unrecorded_commits(root, change, rows)
        if unrecorded:
            problems.append(
                f"gatedloop: change '{change}' has commit(s) with no green-ci record: "
                f"{', '.join(s[:12] for s in unrecorded)} (no worktree has the branch "
                "checked out, so the audit ran read-only). Check the branch out, run "
                "`gates run ci` green on its head, then merge."
            )

    # test-lock-remote-check D3: the authored-test lock holds at the head,
    # in both modes -- the commit hooks saw only what was committed through them.
    try:
        lock = _lock_at_commit(root, change, f"refs/heads/{change}")
    except _ForgeRefusal as refusal:
        problems.append(refusal.message)
    else:
        if lock.problems:
            problems.append(
                f"{lock.refusal()}\n  -> a placed test changes only through `gates tests "
                f"defect <N.M>` and its author; restore it on '{change}', then merge."
            )

    if require_acceptance:
        rc, _out, err = _captured(_acceptance_check, m, root, argparse.Namespace(tree=tree, change=change))
        if rc != 0:
            problems.append(err.strip())

    if problems:
        raise _MergeHalt(1, "the head is not proven:\n" + "\n".join(problems))

    policy = _acceptance_policy(m)
    brief = _render_acceptance_brief(m, root, change)
    if brief is None and lane is not None:
        brief = _render_acceptance_brief(m, lane, change)
    if policy and not require_acceptance:
        how = f"`approval.acceptance: {policy}` decides auto-merge at the pull request"
    elif policy:
        how = f"enforced: `approval.acceptance: {policy}` accepted this tree"
    else:
        how = "advisory: no acceptance policy is declared"
    print(f"gatedloop: step 1 — the head is proven (tree {tree}); acceptance coverage ({how}):")
    if brief is None:
        print(f"  (openspec/changes/{change}/ is not in this checkout; run `gates acceptance brief {change}` where it is)")
    else:
        for line in brief.splitlines():
            if line.startswith("- covered — ") or line.startswith("- check by hand — "):
                print(f"  {line}")
    return tree


def _split_target(target: str) -> tuple[str | None, str]:
    """`origin/main` -> (`origin`, `main`); a local-only `main` -> (None, `main`)."""
    if "/" in target:
        remote, branch = target.split("/", 1)
        return remote, branch
    return None, target


def _abandon_integration(root: Path, tip: str, position: dict) -> None:
    """Throw away whatever this attempt put in the primary and put it back
    where step 0 found it. The commits made on the detached HEAD are left
    unreachable; nothing was published."""
    _git(root, "reset", "-q", "--merge")
    _git(root, "reset", "-q", "--hard", tip)
    _restore_position(root, position)


def _merge_integrate(root: Path, change: str, target: str, position: dict) -> str:
    """Step 2 (design D2): fetch, detach onto the target's tip, squash. A
    conflict aborts and restores, exit 2, naming the paths; the target is
    never touched. Returns the tip squashed onto."""
    remote, branch = _split_target(target)
    if remote is not None:
        fetched = _git(root, "fetch", "-q", remote, branch)
        if fetched.returncode != 0:
            raise _MergeHalt(2, f"`git fetch {remote} {branch}` failed: {fetched.stderr.strip()}")
    tip = _rev(root, target)
    if tip is None:
        raise _MergeHalt(2, f"the target '{target}' does not resolve to a commit.")
    detached = _git(root, "checkout", "-q", "--detach", tip)
    if detached.returncode != 0:
        _restore_position(root, position)
        raise _MergeHalt(2, f"could not detach onto '{target}' ({tip[:12]}): {detached.stderr.strip()}")
    squashed = _git(root, "merge", "--squash", f"refs/heads/{change}")
    if squashed.returncode != 0:
        conflicts = _git(root, "diff", "--name-only", "--diff-filter=U").stdout.split()
        _abandon_integration(root, tip, position)
        if conflicts:
            raise _MergeHalt(
                2, f"squash conflict between '{change}' and '{target}' ({tip[:12]}) in: "
                + ", ".join(conflicts)
                + ". The squash was aborted; the target and the primary checkout are as "
                "they were. Sync the target into the change branch, resolve, re-run its "
                "gates, then merge again.",
            )
        raise _MergeHalt(
            2, f"`git merge --squash {change}` failed: "
            f"{(squashed.stderr or squashed.stdout).strip()}",
        )
    staged = _git(root, "diff", "--cached", "--name-only")
    if not staged.stdout.strip():
        _abandon_integration(root, tip, position)
        raise _MergeHalt(2, f"nothing to integrate: '{target}' already holds everything on '{change}'.")
    print(f"gatedloop: step 2 — squashed '{change}' onto '{target}' ({tip[:12]})")
    return tip


def _change_title(root: Path, change: str) -> str:
    """"<change>: <proposal title>" from the branch's proposal, or the bare
    name -- the squash subject (merge-step D2) and the PR title
    (merge-pull-request D2)."""
    title = None
    proposal = _git(root, "cat-file", "blob", f"refs/heads/{change}:openspec/changes/{change}/proposal.md")
    for line in proposal.stdout.splitlines() if proposal.returncode == 0 else []:
        if line.startswith("# "):
            title = re.sub(r"^proposal:\s*", "", line[2:].strip(), flags=re.IGNORECASE).strip()
            break
    return f"{change}: {title}" if title and title != change else change


def _squash_message(root: Path, change: str, tip: str) -> str:
    """Design D2 step 3: "<change>: <proposal title>", the change's commit
    subjects as the body."""
    subject = _change_title(root, change)
    log = _git(root, "log", "--reverse", "--no-merges", "--format=%s", f"refs/heads/{change}", "--not", tip)
    subjects = [s for s in log.stdout.splitlines() if s.strip()] if log.returncode == 0 else []
    body = "\n".join(f"- {s}" for s in subjects)
    return subject + (f"\n\n{body}" if body else "") + "\n"


def _merge_commit(m: dict, root: Path, step: int, message: str, tip: str, position: dict,
                  amend: bool = False) -> str:
    """Commit the staged index after the same `discipline check-commit` the
    commit hooks run (design D1). Any refusal abandons the attempt."""
    tree = _write_tree(root)
    if tree is None:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(step, "could not write the staged tree.")
    rc, out, err = _captured(cmd_discipline, m, root, argparse.Namespace(discipline_cmd="check-commit", tree=tree))
    if rc != 0:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(step, f"the commit check refused the commit:\n{(err or out).strip()}")
    cmd = ["git", "commit", "-q"] + (["--amend"] if amend else []) + ["-F", "-"]
    done = subprocess.run(cmd, cwd=root, capture_output=True, text=True, input=message)
    if done.returncode != 0:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(step, f"`git commit` failed: {(done.stderr or done.stdout).strip()}")
    return _rev(root, "HEAD") or ""


class _Tee(io.TextIOBase):
    """A stream that writes through to `stream` and keeps a copy, so a merge
    step's gate output still reaches the reader as it happens (the lock's
    waiting lines included) and the step can quote it afterwards."""

    def __init__(self, stream):
        self.stream = stream
        self.copy = io.StringIO()

    def write(self, s):
        self.copy.write(s)
        return self.stream.write(s)

    def flush(self):
        self.stream.flush()


def _merge_gate_run(m: dict, root: Path, ns: argparse.Namespace) -> tuple[int, str]:
    """`cmd_run` for a merge step, its output teed: (exit, what it printed)."""
    out, err = _Tee(sys.stdout), _Tee(sys.stderr)
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        rc = cmd_run(m, root, ns)
    return rc, out.copy.getvalue() + err.copy.getvalue()


_LOCK_BUSY_LINE_RE = re.compile(
    r"gatedloop: lock busy — gate '(?P<gate>[^']+)' is still held by (?P<holder>.+?) "
    r"after waiting (?P<waited>\S+) \("
)
_PRECONDITION_LINE_RE = re.compile(
    r"gatedloop: precondition '(?P<cmd>.*)' failed \(exit (?P<exit>-?\d+)\)"
)


def _not_run_reason(text: str) -> str:
    """Why a merge step's gate exited 75 without running (merge-lane-friction
    D1), from its own output: the lock's holder and wait, or the failed
    precondition."""
    busy = _LOCK_BUSY_LINE_RE.search(text)
    if busy:
        return (f"the '{busy['gate']}' lock is still held by {busy['holder']} after "
                f"waiting {busy['waited']}")
    pre = _PRECONDITION_LINE_RE.search(text)
    if pre:
        return (f"its precondition '{pre['cmd']}' failed (exit {pre['exit']}) — the "
                "environment is absent, not the code wrong")
    return f"it exited {PRECONDITION_EXIT_CODE}, the not-run exit"


def _merge_prove_merged_tree(m: dict, root: Path, change: str, target: str, tip: str,
                             position: dict) -> str:
    """Step 3 (design D2): the full `ci` oracle on the staged squash; green,
    the squash is committed. Returns its sha. Exit 75 is not a red merged
    tree: `ci` never ran, so the merge exits 75 too (merge-lane-friction D1).
    While `ci` waits on its serialized lock, the merge holds priority (D2)."""
    rc, text = _merge_gate_run(m, root, argparse.Namespace(
        gate="ci", gate_args=[], changed=None, all=False, change=change, task=None,
        attempt=None, verbose=False, full=True, merge_priority=True,
    ))
    if rc == PRECONDITION_EXIT_CODE:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(
            3, f"`ci` did not run on the squash of '{change}' onto '{target}' "
            f"({tip[:12]}): {_not_run_reason(text)}. Nothing was committed; the primary "
            f"checkout is restored. Re-run `gates merge {change}`; nothing about the "
            "merged tree is known yet.",
            code=PRECONDITION_EXIT_CODE,
        )
    if rc != 0:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(
            3, f"the unscoped `ci` is red (exit {rc}) on the squash of '{change}' onto "
            f"'{target}' ({tip[:12]}). Nothing was committed; the primary checkout is "
            "restored. The merged tree is what failed: sync the target into the change "
            "branch and fix it there.",
        )
    sha = _merge_commit(m, root, 3, _squash_message(root, change, tip), tip, position)
    print(f"gatedloop: step 3 — the merged tree is green; squash committed ({sha[:12]})")
    return sha


def _merge_record(m: dict, root: Path, change: str, squash: str, tip: str, position: dict) -> str:
    """Step 4 (design D2): the merge row names the squash commit's real sha,
    committed at ledger grade on top of it."""
    rc, out, err = _captured(cmd_ledger, m, root, argparse.Namespace(ledger_cmd="record-merge", change=change, sha=squash))
    if rc != 0:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(4, f"`gates ledger record-merge` failed: {(err or out).strip()}")
    added = _git(root, "add", "--", _ledger_rel(change, root))
    if added.returncode != 0:
        _abandon_integration(root, tip, position)
        raise _MergeHalt(4, f"could not stage the merge row: {added.stderr.strip()}")
    sha = _merge_commit(m, root, 4, f"record merge ledger row: {change}\n", tip, position)
    print(f"gatedloop: step 4 — merge row recorded against {squash[:12]} ({sha[:12]})")
    return sha


def _merge_confirm(m: dict, root: Path, change: str, tip: str, position: dict) -> None:
    """Step 5 (design D2/D3): the `confirm` gate on the merged tree, where
    declared. Red or 75: discard the local commits, restore, and record the
    failure on the change's branch -- it would otherwise vanish with them."""
    if not (m.get("gates") or {}).get("confirm"):
        print("gatedloop: step 5 — live confirmation skipped: no `confirm` gate is declared (not a failure)")
        return
    rc, text = _merge_gate_run(m, root, argparse.Namespace(
        gate="confirm", gate_args=[], changed=None, all=False, change=change, task=None,
        attempt=None, verbose=False, merge_priority=True,
    ))
    if rc == 0:
        # Its green row joins the merge row's ledger-grade commit, so the
        # target still gains exactly three commits.
        added = _git(root, "add", "--", _ledger_rel(change, root))
        if added.returncode != 0:
            _abandon_integration(root, tip, position)
            raise _MergeHalt(5, f"could not stage the confirm row: {added.stderr.strip()}")
        _merge_commit(m, root, 5, f"record merge ledger row: {change}\n", tip, position, amend=True)
        print("gatedloop: step 5 — `confirm` is green on the merged tree")
        return
    row = next((r for r in reversed(_read_ledger_rows(root, change)) if r.get("gate") == "confirm"), None)
    _abandon_integration(root, tip, position)
    recorded = None
    if row is not None:
        recorded = _record_on_branch(root, change, row, f"record confirm failure: {change}", 5)
    where = (
        f"the failure is recorded on '{change}' ({recorded[:12]})" if recorded
        else f"the failure row could NOT be recorded on '{change}'"
    )
    if rc == PRECONDITION_EXIT_CODE:
        # merge-lane-friction D1: not run is not red, and exits 75 like any
        # gate that did not run.
        raise _MergeHalt(
            5, f"`confirm` did not run on the merged tree: {_not_run_reason(text)}. "
            f"Nothing was pushed, the local commits are discarded, the primary checkout "
            f"is restored, and {where}. Re-run `gates merge {change}`; nothing about the "
            "merged tree's confirmation is known yet.",
            code=PRECONDITION_EXIT_CODE,
        )
    why = f"it exited {rc}"
    raise _MergeHalt(
        5, f"`confirm` did not pass on the merged tree: {why}. Nothing was pushed, the "
        f"local commits are discarded, the primary checkout is restored, and {where}.",
    )


def _merge_archive(m: dict, root: Path, change: str, tip: str, position: dict) -> str:
    """Step 6, first half: `openspec archive`, then the archive commit with
    all three paths of the move (commands/archive.md)."""
    archive_dir = root / "openspec" / "changes" / "archive"
    before = set(archive_dir.glob(f"*-{change}")) if archive_dir.is_dir() else set()
    try:
        out = _openspec(["archive", change, "--yes"], root, capture_output=True, text=True)
        failed = out.returncode != 0
        detail = (out.stderr or out.stdout).strip()
    except FileNotFoundError:
        failed, detail = True, "the OpenSpec CLI (`openspec`) is not on PATH"
    if failed:
        for leftover in (set(archive_dir.glob(f"*-{change}")) if archive_dir.is_dir() else set()) - before:
            _git(root, "clean", "-fdq", "--", str(leftover.relative_to(root)))
        _abandon_integration(root, tip, position)
        raise _MergeHalt(6, f"`openspec archive {change} --yes` failed, so nothing was pushed: {detail}")
    candidates = [f"openspec/changes/{change}", "openspec/specs"] + sorted(
        p.relative_to(root).as_posix() for p in archive_dir.glob(f"*-{change}")
    )
    paths = [
        c for c in candidates
        if (root / c).exists() or _git(root, "ls-files", "--", c).stdout.strip()
    ]
    # Never a bare `git add -A --`: with no pathspec it would stage everything.
    added = _git(root, "add", "-A", "--", *paths) if paths else None
    staged = _git(root, "diff", "--cached", "--name-only")
    if added is None or added.returncode != 0 or not staged.stdout.strip():
        added = added or subprocess.CompletedProcess([], 1, "", "")
        _abandon_integration(root, tip, position)
        raise _MergeHalt(
            6, f"`openspec archive {change}` left nothing to commit "
            f"({(added.stderr or 'no change under ' + ', '.join(candidates)).strip()}), so nothing was pushed.",
        )
    sha = _merge_commit(m, root, 6, f"archive change: {change}\n", tip, position)
    print(f"gatedloop: step 6 — archived '{change}' ({sha[:12]})")
    return sha


def _merge_publish(root: Path, target: str, tip: str, position: dict) -> bool:
    """Step 6, second half: the one push. `False` when the target moved
    since the fetch (the caller retries from step 2 once)."""
    remote, branch = _split_target(target)
    if remote is not None:
        pushed = _git(root, "push", remote, f"HEAD:refs/heads/{branch}")
        if pushed.returncode == 0:
            return True
        text = (pushed.stderr or pushed.stdout).strip()
        if any(s in text for s in ("non-fast-forward", "fetch first", "[rejected]")):
            return False
        _abandon_integration(root, tip, position)
        raise _MergeHalt(6, f"`git push {remote} HEAD:{branch}` failed, so nothing was published: {text}")
    holder = _worktree_holding(root, branch)
    if holder is not None and holder.resolve() != root.resolve():
        _abandon_integration(root, tip, position)
        raise _MergeHalt(
            6, f"the local target '{branch}' is checked out in {holder}; moving it would "
            "move the ref under that checkout. Nothing was published.",
        )
    moved = _git(root, "update-ref", f"refs/heads/{branch}", "HEAD", tip)
    if moved.returncode == 0:
        return True
    if _rev(root, f"refs/heads/{branch}") != tip:
        return False
    _abandon_integration(root, tip, position)
    raise _MergeHalt(6, f"could not move '{branch}' to the merged tip: {moved.stderr.strip()}")


def _merge_finish(root: Path, target: str, position: dict) -> None:
    """Back to where step 0 found the primary; when that was the target's
    own branch, fast-forwarded to the pushed tip."""
    remote, branch = _split_target(target)
    pushed = _rev(root, "HEAD")
    if remote is not None and position.get("branch") == branch and pushed:
        local = _rev(root, f"refs/heads/{branch}")
        if local is None or _is_ancestor(root, local, pushed):
            moved = _git(root, "branch", "-f", branch, pushed)
            if moved.returncode != 0:
                print(f"gatedloop: could not fast-forward '{branch}': {moved.stderr.strip()}", file=sys.stderr)
        else:
            print(
                f"gatedloop: local '{branch}' has commits '{target}' lacks, so it was not "
                "fast-forwarded to the pushed tip.",
                file=sys.stderr,
            )
    _restore_position(root, position)


def _merge_run(m: dict, root: Path, change: str) -> int:
    state = _merge_state_path(root)
    try:
        ctx = _merge_preconditions(m, root, change)
        _merge_prove_head(m, root, change)
        target, position = ctx["target"], ctx["position"]
        for attempt in (1, 2):
            tip = _merge_integrate(root, change, target, position)
            squash = _merge_prove_merged_tree(m, root, change, target, tip, position)
            _merge_record(m, root, change, squash, tip, position)
            _merge_confirm(m, root, change, tip, position)
            _merge_archive(m, root, change, tip, position)
            commits = _git(root, "rev-list", "--reverse", f"{tip}..HEAD").stdout.split()
            if _merge_publish(root, target, tip, position):
                _merge_finish(root, target, position)
                print(
                    f"gatedloop: merged '{change}' — {len(commits)} commit(s) "
                    f"({', '.join(c[:12] for c in commits)}) published to '{target}' in one push"
                )
                return 0
            _abandon_integration(root, tip, position)
            if attempt == 1:
                print(f"gatedloop: step 6 — '{target}' moved since the fetch; retrying once from step 2")
        raise _MergeHalt(
            6, f"the push was rejected twice: '{target}' moved again during the retry. "
            "Nothing was published; the primary checkout is restored. Run `gates merge` "
            "again once the target is quiet.",
        )
    except _MergeHalt as h:
        print(
            f"gatedloop: merge of '{change}' stopped at step {h.step} "
            f"({MERGE_STEP_NAMES[h.step]}) — {h.message}",
            file=sys.stderr,
        )
        return h.code
    finally:
        state.unlink(missing_ok=True)


# ---- pull-request mode (merge-pull-request D2) ----------------------------
#
# The loop's own finish when the forge integrates: prove the head exactly as
# local mode does, push the branch, publish the head's markers as statuses,
# open or update the pull request with the acceptance brief as its body, and
# enable squash auto-merge only when nothing the declared process names
# stands in the way. The checkout and the target are never touched -- the
# merge is the forge's, and `gates record-merged` writes its ledger facts.

PR_MERGE_STEP_NAMES = {
    0: "preconditions", 1: "prove the head", 2: "push", 3: "publish statuses",
    4: "pull request",
}


def _open_or_update_pr(root: Path, change: str, base: str, title: str, body: str) -> str:
    """The change's open pull request, its body set to `body`, opened when
    there is none. Returns its URL."""
    with tempfile.TemporaryDirectory(prefix=f"{NAME}-pr-") as tmp:
        body_file = Path(tmp) / "body.md"
        body_file.write_text(body)
        view = _gh(root, "pr", "view", change, "--json", "url,number,state")
        existing = None
        if view.returncode == 0:
            try:
                existing = json.loads(view.stdout)
            except json.JSONDecodeError:
                existing = None
        if isinstance(existing, dict) and existing.get("state") == "OPEN" and existing.get("url"):
            edited = _gh(root, "pr", "edit", change, "--body-file", str(body_file))
            if edited.returncode != 0:
                raise _ForgeRefusal(
                    f"gatedloop: `gh pr edit {change}` failed: "
                    f"{(edited.stderr or edited.stdout).strip()}"
                )
            print(f"gatedloop: step 4 — updated {existing['url']} with the acceptance brief")
            return existing["url"]
        created = _gh(root, "pr", "create", "--head", change, "--base", base,
                      "--title", title, "--body-file", str(body_file))
        if created.returncode != 0:
            raise _ForgeRefusal(
                f"gatedloop: `gh pr create --head {change}` failed: "
                f"{(created.stderr or created.stdout).strip()}"
            )
        url = (created.stdout.strip().splitlines() or [""])[-1].strip()
        print(f"gatedloop: step 4 — opened {url}")
        return url


def _merge_pr_steps(m: dict, root: Path, change: str) -> int:
    if _rev(root, f"refs/heads/{change}") is None:
        raise _MergeHalt(0, f"there is no branch '{change}' (branch name = change name).")
    if _change_for_ref(root, change) is None:
        raise _MergeHalt(
            0, f"branch '{change}' has no openspec/changes/{change}/ directory, so it is "
            "not a change this command can merge.",
        )
    target, reason = _resolve_merge_target(root)
    if target is None:
        raise _MergeHalt(0, f"no integration target resolves ({reason}).")
    remote, base = _split_target(target)
    if remote is None:
        raise _MergeHalt(
            0, f"pull-request mode needs a remote integration target, and '{target}' is "
            "local-only.",
        )

    # Step 1. Nothing leaves the machine unless the head is proven.
    tree = _merge_prove_head(m, root, change, require_acceptance=False)
    lane = _worktree_holding(root, change)
    head = _rev(root, f"refs/heads/{change}") or ""

    # Step 2.
    pushed = _git(root, "push", "-u", remote, f"refs/heads/{change}:refs/heads/{change}")
    if pushed.returncode != 0:
        raise _MergeHalt(
            2, f"`git push -u {remote} {change}` failed: "
            f"{(pushed.stderr or pushed.stdout).strip()}",
        )
    print(f"gatedloop: step 2 — pushed '{change}' ({head[:12]}) to {remote}")

    # Step 3. The head's markers, wherever its gates ran.
    stores = _marker_stores(root, change)
    try:
        for gate in ("live-check", "ci"):
            _publish_marker_status(root, gate, head, stores)
    except _ForgeRefusal as refusal:
        raise _MergeHalt(
            3, f"{refusal.message}\n  The branch is pushed; no pull request was opened or "
            "changed. Run `gates merge` again once the forge is reachable.",
        )

    # Step 4.
    brief = None
    for where in ([lane] if lane is not None else []) + [root]:
        brief = _render_acceptance_brief(m, where, change)
        if brief is not None:
            break
    body = brief or (
        f"`gates acceptance brief {change}` could not be rendered where `gates merge` ran; "
        "run it on the change branch.\n"
    )
    try:
        url = _open_or_update_pr(root, change, base, _change_title(root, change), body)
        require_approval = bool((m.get("integration") or {}).get("requireApproval", False))
        acc_rc, _out, acc_err = _captured(
            _acceptance_check, m, root, argparse.Namespace(tree=tree, change=change),
        )
        if not require_approval and acc_rc == 0:
            enabled = _gh(root, "pr", "merge", change, "--squash", "--auto")
            if enabled.returncode != 0:
                raise _ForgeRefusal(
                    f"gatedloop: `gh pr merge {change} --squash --auto` failed: "
                    f"{(enabled.stderr or enabled.stdout).strip()} (the pull request is "
                    f"open: {url})"
                )
    except _ForgeRefusal as refusal:
        raise _MergeHalt(4, refusal.message)
    if not require_approval and acc_rc == 0:
        print(
            f"gatedloop: step 4 — auto-merge (squash) enabled on {url}: the forge integrates "
            f"'{change}' once its required checks pass. After it merges, `gates "
            "record-merged <squash sha>` records the merge and archives the change."
        )
        return 0
    print(f"gatedloop: step 4 — waiting for review: {url}")
    if require_approval:
        print("  auto-merge not enabled — `integration.requireApproval` is true: a reviewer "
              "approves and merges it in the forge")
    if acc_rc != 0:
        print("  auto-merge not enabled — the declared acceptance is not satisfied for this "
              f"tree: {acc_err.strip()}")
    return 0


def _merge_pr_run(m: dict, root: Path, change: str) -> int:
    try:
        return _merge_pr_steps(m, root, change)
    except _MergeHalt as h:
        print(
            f"gatedloop: merge of '{change}' stopped at step {h.step} "
            f"({PR_MERGE_STEP_NAMES[h.step]}) — {h.message}",
            file=sys.stderr,
        )
        return h.code


def cmd_merge(m: dict, root: Path, args) -> int:
    """`gates merge <change>`, under the machine-wide `merge` lock: the
    six-step local-squash-merge (merge-step), or under `integration.mode:
    pull-request` the hand-off to the forge (merge-pull-request D2)."""
    change = _resolve_change_name(root, args.change)
    mode = (m.get("integration") or {}).get("mode") or "local-squash-merge"
    if mode not in ("local-squash-merge", "pull-request"):
        print(
            f"gatedloop: merge of '{change}' stopped at step 0 (preconditions) — the "
            f"declared integration.mode '{mode}' is not one `gates merge` knows "
            "(local-squash-merge | pull-request); `gates validate` names the fix.",
            file=sys.stderr,
        )
        return 1
    run = _merge_pr_run if mode == "pull-request" else _merge_run
    try:
        with _merge_lock(root, m):
            return run(m, root, change)
    except _LockBusy as busy:
        print(busy.message(), file=sys.stderr)
        return PRECONDITION_EXIT_CODE


# ---------- recording a forge merge (merge-pull-request D3) ----------------
#
# A merge in the forge's UI writes no ledger row, so without this every
# PR-merged change reads as in progress forever. `gates record-merged <sha>`
# is the whole of the bookkeeping a maintainer did by hand after each such
# merge, and what a CI job calls after a push to the target: find the change
# the squash came from through its pull request's head branch, record the
# merge row against that sha, archive the change, and commit both in ONE
# local commit. That commit is ledger- plus planning-grade, so it needs no
# `ci` marker. It never pushes: whether it lands by a push or a follow-up PR
# is the caller's decision.


def _archived_change_exists(root: Path, change: str) -> bool:
    archive = root / "openspec" / "changes" / "archive"
    dated = re.compile(r"\d{4}-\d{2}-\d{2}-" + re.escape(change))
    return archive.is_dir() and any(p.is_dir() and dated.fullmatch(p.name) for p in archive.iterdir())


def _discard_record_attempt(root: Path, before: set) -> None:
    """Back to HEAD: the record row and any half-made archive move go."""
    _git(root, "reset", "-q", "--hard", "HEAD")
    archive_dir = root / "openspec" / "changes" / "archive"
    after = set(archive_dir.iterdir()) if archive_dir.is_dir() else set()
    for leftover in after - before:
        _git(root, "clean", "-fdq", "--", str(leftover.relative_to(root)))


def _is_active_change(root: Path, name: str) -> bool:
    return (
        bool(name) and "/" not in name and name != "archive"
        and (root / "openspec" / "changes" / name).is_dir()
    )


def _dirty_record_refusal(root: Path) -> str | None:
    """Why the record commit must not be made in this checkout, or `None`."""
    status = _git(root, "status", "--porcelain", "--untracked-files=no")
    if status.returncode == 0 and not status.stdout.strip():
        return None
    return (
        "gatedloop: the checkout has uncommitted changes to tracked files, which the "
        "record commit could sweep in or a failed attempt would discard: "
        + ", ".join(line[3:] for line in status.stdout.splitlines() if line.strip())
        + ". Commit or stash them, then run this again. Nothing was recorded."
    )


def _record_merged_plan(m: dict, root: Path, change: str, number) -> int:
    """planner-handoff D3: a merged `plan/<change>` PR. Under `self`, for a
    change with no approval yet, attest it from the merge (D1/D2) and make
    the one local commit; otherwise skip, saying why. Never pushes."""
    policy = _approval_policy(m)
    if policy != "self":
        print(f"gatedloop: PR #{number} merged the plan of '{change}', but the approval policy "
              f"is {policy!r} — under review only an approving review approves a plan "
              f"(`gates approval attest {change} --pr {number}`). Nothing was recorded.")
        return 0
    approved_by = _read_approved_by(root, change)
    if approved_by:
        print(f"gatedloop: PR #{number} merged the plan of '{change}', which is already approved "
              f"(by {approved_by}). Nothing was recorded.")
        return 0
    refusal = _dirty_record_refusal(root)
    if refusal:
        print(refusal, file=sys.stderr)
        return 1
    ledger_rel = _ledger_rel(change, root)
    ledger_tracked = bool(_git(root, "ls-files", "--", ledger_rel).stdout.strip())

    def refuse(message: str) -> int:
        _git(root, "reset", "-q", "--hard", "HEAD")
        if not ledger_tracked:
            (root / ledger_rel).unlink(missing_ok=True)
        print(message, file=sys.stderr)
        return 1

    rc, out, err = _captured(cmd_approval_attest_merged, m, root, change, number)
    if rc != 0:
        return refuse((err or out).strip())
    yaml_rel = _openspec_yaml_path(root, change).relative_to(root).as_posix()
    added = _git(root, "add", "-A", "--", yaml_rel, ledger_rel)
    tree = _write_tree(root) if added.returncode == 0 else None
    if tree is None:
        return refuse(f"gatedloop: could not stage the approval: {added.stderr.strip()}")
    rc, out, err = _captured(cmd_discipline, m, root, argparse.Namespace(discipline_cmd="check-commit", tree=tree))
    if rc != 0:
        return refuse(f"gatedloop: the commit check refused the approval commit:\n{(err or out).strip()}")
    message = (
        f"attest approval: {change} (merged #{number})\n\nUnder `approval.plan: self` the merge "
        f"of plan PR #{number} is the approval; recorded by `gates record-merged`.\n"
    )
    committed = subprocess.run(["git", "commit", "-q", "-F", "-"], cwd=root, capture_output=True, text=True, input=message)
    if committed.returncode != 0:
        return refuse(f"gatedloop: `git commit` failed: {(committed.stderr or committed.stdout).strip()}")
    new = _rev(root, "HEAD") or ""
    print(f"gatedloop: attested '{change}' from the merge of plan PR #{number} in {new[:12]}. "
          "Nothing was pushed — landing this commit is the caller's.")
    return 0


def cmd_record_merged(m: dict, root: Path, args) -> int:
    """`gates record-merged <sha>` (design D3)."""
    sha = _rev(root, args.sha)
    head = _rev(root, "HEAD")
    if sha is None:
        print(f"gatedloop: '{args.sha}' is not a commit in this checkout — fetch it first. "
              "Nothing was recorded.", file=sys.stderr)
        return 1
    if head is None or not _is_ancestor(root, sha, head):
        print(
            f"gatedloop: {sha[:12]} is not in this checkout's history (HEAD is "
            f"{(head or 'unborn')[:12]}) — check out the target at or after that commit, "
            "then run this again. Nothing was recorded.",
            file=sys.stderr,
        )
        return 1
    try:
        repo = _forge_repo(root)
        pulls = _gh_json(root, "api", f"repos/{repo}/commits/{sha}/pulls")
    except _ForgeRefusal as refusal:
        print(refusal.message, file=sys.stderr)
        return 1
    merged = [p for p in pulls if isinstance(p, dict) and p.get("merged_at")] if isinstance(pulls, list) else []
    if not merged:
        print(f"gatedloop: {sha[:12]} came from no merged pull request — nothing to record.")
        return 0
    pr = merged[0]
    number = pr.get("number")
    change = ((pr.get("head") or {}).get("ref") or "").strip()
    if change.startswith("plan/") and _is_active_change(root, change[len("plan/"):]):
        return _record_merged_plan(m, root, change[len("plan/"):], number)
    if not _is_active_change(root, change):
        if change and "/" not in change and _archived_change_exists(root, change):
            print(f"gatedloop: PR #{number}'s head '{change}' is a change already archived — "
                  "nothing to record.")
        else:
            print(f"gatedloop: PR #{number}'s head branch '{change}' names no active change "
                  f"(no openspec/changes/{change}/) — nothing to record.")
        return 0

    refusal = _dirty_record_refusal(root)
    if refusal:
        print(refusal, file=sys.stderr)
        return 1

    archive_dir = root / "openspec" / "changes" / "archive"
    before = set(archive_dir.iterdir()) if archive_dir.is_dir() else set()
    rc, out, err = _captured(cmd_ledger, m, root, argparse.Namespace(ledger_cmd="record-merge", change=change, sha=sha))
    if rc != 0:
        _discard_record_attempt(root, before)
        print(f"gatedloop: `gates ledger record-merge` failed: {(err or out).strip()}", file=sys.stderr)
        return 1
    try:
        done = _openspec(["archive", change, "--yes"], root, capture_output=True, text=True)
        failed, detail = done.returncode != 0, (done.stderr or done.stdout).strip()
    except FileNotFoundError:
        failed, detail = True, "the OpenSpec CLI (`openspec`) is not on PATH"
    if failed:
        _discard_record_attempt(root, before)
        print(f"gatedloop: `openspec archive {change} --yes` failed, so nothing was recorded: {detail}",
              file=sys.stderr)
        return 1
    candidates = [_ledger_rel(change, root), f"openspec/changes/{change}", "openspec/specs"] + sorted(
        p.relative_to(root).as_posix() for p in archive_dir.glob(f"*-{change}")
    )
    paths = [c for c in candidates if (root / c).exists() or _git(root, "ls-files", "--", c).stdout.strip()]
    added = _git(root, "add", "-A", "--", *paths)
    tree = _write_tree(root) if added.returncode == 0 else None
    if tree is None:
        _discard_record_attempt(root, before)
        print(f"gatedloop: could not stage the record: {added.stderr.strip()}", file=sys.stderr)
        return 1
    rc, out, err = _captured(cmd_discipline, m, root, argparse.Namespace(discipline_cmd="check-commit", tree=tree))
    if rc != 0:
        _discard_record_attempt(root, before)
        print(f"gatedloop: the commit check refused the record commit:\n{(err or out).strip()}", file=sys.stderr)
        return 1
    message = f"archive change: {change}\n\nMerged in the forge as {sha} (PR #{number}); recorded by `gates record-merged`.\n"
    committed = subprocess.run(["git", "commit", "-q", "-F", "-"], cwd=root, capture_output=True, text=True, input=message)
    if committed.returncode != 0:
        _discard_record_attempt(root, before)
        print(f"gatedloop: `git commit` failed: {(committed.stderr or committed.stdout).strip()}", file=sys.stderr)
        return 1
    new = _rev(root, "HEAD") or ""
    files = _git(root, "diff-tree", "--no-commit-id", "-r", "--name-only", f"{new}~1", new).stdout.split()
    print(
        f"gatedloop: recorded the merge of '{change}' (PR #{number}) against {sha[:12]} and "
        f"archived it in {new[:12]} ({len(files)} file(s)). Nothing was pushed — landing "
        "this commit is the caller's."
    )
    return 0


# ---------- cli -----------------------------------------------------------

def main() -> int:
    p = argparse.ArgumentParser(prog="gates", description="gatedloop gate/surface shim")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_changed(sp):
        sp.add_argument("--changed", nargs="*", help="explicit changed-file list")
        sp.add_argument("--all", action="store_true", help="treat every surface as hot")

    sub.add_parser("init", help="write a starter .gates.yaml from the template")

    sub.add_parser(
        "doctor",
        help="onboarding preflight: OpenSpec CLI/version, gatesVersion, plugin registration",
    )

    sp = sub.add_parser("adoption", help="what this plugin version asks the project to decide: status, record")
    adopt_sub = sp.add_subparsers(dest="adoption_cmd", required=True)
    sp_ast = adopt_sub.add_parser("status", help="list the adoption items this project hasn't decided on; exit non-zero only when it cannot decide")
    sp_ast.add_argument("--json", action="store_true", help='one document: {"version", "undecided": [{id, since, what}]}')
    sp_arec = adopt_sub.add_parser("record", help="write a decision to .gatedloop/adoption.json (adopted | declined | later)")
    sp_arec.add_argument("id", help="a catalogue item id (see `gates adoption status`)")
    sp_arec.add_argument("decision", help=f"one of: {', '.join(ADOPTION_DECISIONS)}")

    sp = sub.add_parser("validate", help="validate the manifest")
    sp.set_defaults(fn=cmd_validate)

    sp = sub.add_parser("run", help="run a gate (or live-check)")
    sp.add_argument("gate")
    sp.add_argument("gate_args", nargs="*")
    add_changed(sp)
    sp.add_argument("--change", help="change name for the ledger row (default: current branch)")
    sp.add_argument("--task", help="task id for the ledger row (e.g. 1.2)")
    sp.add_argument("--attempt", type=int, help="attempt number for the ledger row (default: 1)")
    sp.add_argument(
        "--verbose", action="store_true",
        help="stream the gate's output unfiltered instead of the default quiet-on-green summary",
    )
    sp.set_defaults(fn=cmd_run)

    sp = sub.add_parser("surfaces", help="print hot surfaces for the changed set")
    add_changed(sp)
    sp.set_defaults(fn=cmd_surfaces)

    sp = sub.add_parser("rules", help="print applicable rule-ids for the changed set")
    add_changed(sp)
    sp.set_defaults(fn=cmd_rules)

    sp = sub.add_parser("gate-marker", help="O(1) marker read/check for PreToolUse hooks")
    gm_sub = sp.add_subparsers(dest="gate_marker_cmd", required=True)
    sp_check = gm_sub.add_parser("check", help="exit 0 if the gate's marker matches <tree>, else 1")
    sp_check.add_argument("gate")
    sp_check.add_argument("tree")
    sp_check.add_argument(
        "--require-scope", choices=["full"],
        help="also refuse a marker whose recorded scope isn't this (scale-gate-cost D2: the completion/pre-merge requirement)",
    )
    sp_check.add_argument(
        "--ref",
        help="the incoming ref of a merge: when it is a local branch checked out in another worktree, that worktree's marker store is read too (cross-worktree-evidence D2)",
    )
    sp_check.set_defaults(fn=cmd_gate_marker)
    sp_clear = gm_sub.add_parser("clear", help="clear a gate's marker (or all markers if omitted)")
    sp_clear.add_argument("gate", nargs="?", default=None)
    sp_clear.set_defaults(fn=cmd_gate_marker)

    sp = sub.add_parser("marker", help="gate markers as forge commit statuses: publish, check-remote (needs `gh`)")
    marker_sub = sp.add_subparsers(dest="marker_cmd", required=True)
    sp_pub = marker_sub.add_parser(
        "publish",
        help="post a `gatedloop/<gate>` success status carrying the tree, on a commit whose tree has a green local marker; `tests` is computed from the authored-test lock at the commit instead (failure names the path, exit 1)",
    )
    sp_pub.add_argument("gate")
    sp_pub.add_argument("--sha", help="the commit to publish on (default: HEAD)")
    sp_pub.set_defaults(fn=cmd_marker)
    sp_crm = marker_sub.add_parser(
        "check-remote",
        help="exit 0 only if the latest `gatedloop/<gate>` status on <sha> is a success naming that sha's own normalized tree",
    )
    sp_crm.add_argument("gate")
    sp_crm.add_argument("sha")
    sp_crm.set_defaults(fn=cmd_marker)

    sub.add_parser("migrate-name", help="move this project onto the gatedloop names: state directory, change metadata, hook markers; prints the edits it does not make")
    sp = sub.add_parser("hook", help="install the git-layer commit hook (composes with a manager, never clobbers)")
    hook_sub = sp.add_subparsers(dest="hook_cmd", required=True)
    sp_inst = hook_sub.add_parser("install", help="install/compose the git pre-commit and pre-push hooks; refuses-and-instructs when unsafe")
    inst_which = sp_inst.add_mutually_exclusive_group()
    inst_which.add_argument("--commit-only", action="store_true", help="install or refresh only the pre-commit hook, and record the `git-push-hook` adoption item as declined (a plain install then skips pre-push)")
    inst_which.add_argument("--push", action="store_true", help="install both hooks even after a decline, and record the `git-push-hook` adoption item as adopted")
    sp_inst.set_defaults(fn=cmd_hook)
    sp_gcwd = hook_sub.add_parser("git-cwd", help="print the guarded command's effective directory, resolved from hook JSON on stdin (design D1)")
    sp_gcwd.add_argument("kind", nargs="?", default=None, choices=_GIT_CWD_KINDS, help="the invocation kind being guarded (omit for a non-command hook, e.g. a Write tool call)")
    sp_gcwd.set_defaults(fn=cmd_hook)

    sp = sub.add_parser("ledger", help="the durable per-change gate-outcome ledger")
    ledger_sub = sp.add_subparsers(dest="ledger_cmd", required=True)
    sp_merge = ledger_sub.add_parser("record-merge", help="append the one change -> squash-SHA row at merge time")
    sp_merge.add_argument("change")
    sp_merge.add_argument("--sha", help="the squash commit's SHA (default: current HEAD)")
    sp_merge.set_defaults(fn=cmd_ledger)
    sp_ready = ledger_sub.add_parser("record-ready", help="append the `ready` row an implementer commits before reporting READY TO MERGE")
    sp_ready.add_argument("change")
    sp_ready.set_defaults(fn=cmd_ledger)

    sp = sub.add_parser("review", help="record a convention review's invocation and verdict")
    review_sub = sp.add_subparsers(dest="review_cmd", required=True)
    sp_rec = review_sub.add_parser("record", help="append a review row (and, when clean, a review marker)")
    sp_rec.add_argument("verdict", choices=REVIEW_VERDICTS)
    sp_rec.add_argument("--change", help="change name for the row (default: current branch)")
    sp_rec.add_argument("--task", help="task id the review covered (e.g. 1.2)")
    sp_rec.add_argument("--attempt", type=int, help="attempt number (default: 1)")
    sp_rec.add_argument(
        "--scope", choices=REVIEW_SCOPES,
        help="`authored`: the review over a change's whole authored test set, before implementation (default: a per-task review)",
    )
    sp_rec.set_defaults(fn=cmd_review)

    sp = sub.add_parser("halt", help="record why the loop stopped: a `halt` ledger row with a cause from the closed set")
    halt_sub = sp.add_subparsers(dest="halt_cmd", required=True)
    sp_hrec = halt_sub.add_parser("record", help=f"append a halt row; cause is one of: {', '.join(HALT_CAUSES)}")
    sp_hrec.add_argument("cause", help=f"one of: {', '.join(HALT_CAUSES)} (`other` requires --detail)")
    sp_hrec.add_argument("--task", help="task id the loop halted at (e.g. 2.3)")
    sp_hrec.add_argument("--detail", help="free text; required for cause `other`")
    sp_hrec.add_argument("--change", help="change name for the row (default: current branch)")
    sp_hrec.set_defaults(fn=cmd_halt)

    sp = sub.add_parser("intervention", help="record a human turn in the loop: an `intervention` ledger row")
    int_sub = sp.add_subparsers(dest="intervention_cmd", required=True)
    sp_irec = int_sub.add_parser("record", help=f"append an intervention row; kind is one of: {', '.join(INTERVENTION_KINDS)}")
    sp_irec.add_argument("kind", help=f"one of: {', '.join(INTERVENTION_KINDS)}")
    sp_irec.add_argument("--task", help="task id the human turn happened at (e.g. 2.3)")
    sp_irec.add_argument("--detail", help="free text, e.g. the question asked")
    sp_irec.add_argument("--change", help="change name for the row (default: current branch)")
    sp_irec.set_defaults(fn=cmd_intervention)

    sp = sub.add_parser("attempt", help="the retry budget: attempt notes per task, and fresh restarts")
    att_sub = sp.add_subparsers(dest="attempt_cmd", required=True)
    sp_an = att_sub.add_parser("note", help="append an `attempt-note` row: four required one-line fields, at most 200 characters each")
    sp_an.add_argument("task", help="task id the note belongs to (e.g. 1.2)")
    sp_an.add_argument("--hypothesis", help="what you believed was wrong")
    sp_an.add_argument("--changed", help="what you changed to test it")
    sp_an.add_argument("--oracle", help="what the gate said")
    sp_an.add_argument("--next", help="what to rule out next")
    sp_an.add_argument("--change", help="change name for the row (default: current branch)")
    sp_an.set_defaults(fn=cmd_attempt)
    sp_ans = att_sub.add_parser("notes", help="print a task's attempt notes, oldest first, across restarts")
    sp_ans.add_argument("task", help="task id (e.g. 1.2)")
    sp_ans.add_argument("--json", action="store_true", help='one document: {"task", "notes": [{attempt, hypothesis, changed, oracle, next}]}')
    sp_ans.add_argument("--change", help="change name to read (default: current branch)")
    sp_ans.set_defaults(fn=cmd_attempt)
    sp_ar = att_sub.add_parser("restart", help="record a fresh restart for a task: clean tree only, at most loop.fresh-restarts times; resets its failed-attempt count")
    sp_ar.add_argument("task", help="task id to restart (e.g. 1.2)")
    sp_ar.add_argument("--change", help="change name for the row (default: current branch)")
    sp_ar.set_defaults(fn=cmd_attempt)

    sp = sub.add_parser("usage", help="token usage per task: `usage` ledger rows read from the host session's transcript (counts only)")
    use_sub = sp.add_subparsers(dest="usage_cmd", required=True)
    sp_ur = use_sub.add_parser("record", help="append a `usage` row for the task in flight, counting the transcript since the task's start or its last counted row; exit 0 whatever the source")
    sp_ur.add_argument("--task", help="task id (default: the task in flight; none: unattributed)")
    sp_ur.add_argument("--transcript", help="the session transcript (a hook input's `transcript_path`); omitted: a `no-transcript` row with null counts")
    sp_ur.add_argument("--change", help="change name for the row (default: current branch)")
    sp_ur.add_argument("--stage", action="store_true", help="stage the ledger after appending, so the row lands in the commit being made (the commit hook's form)")
    sp_ur.set_defaults(fn=cmd_usage)
    sp_us = use_sub.add_parser("show", help="print a change's usage rows and the tokens per task")
    sp_us.add_argument("--change", help="change to show (default: current branch)")
    sp_us.add_argument("--json", action="store_true", help='one document: {"change", "rows", "tasks", "total"}')
    sp_us.set_defaults(fn=cmd_usage)

    sp = sub.add_parser("task", help="the per-task tree baseline: what has changed since a task began")
    task_sub = sp.add_subparsers(dest="task_cmd", required=True)
    sp_ts = task_sub.add_parser("start", help="record the tree at task start (a `task-start` ledger row)")
    sp_ts.add_argument("task", help="task id the baseline belongs to (e.g. 1.2)")
    sp_ts.add_argument("--change", help="change name for the row (default: current branch)")
    sp_ts.add_argument("--attempt", type=int, help="attempt number (default: 1)")
    sp_ts.set_defaults(fn=cmd_task)
    sp_tc = task_sub.add_parser("changed", help="print every path that differs from the task-start tree")
    sp_tc.add_argument("--change", help="change name to read the baseline from (default: current branch)")
    sp_tc.add_argument("--task", help="task id whose baseline to measure from (default: the latest recorded)")
    sp_tc.set_defaults(fn=cmd_task)

    sp = sub.add_parser("lock", help="inspect the machine-wide locks of serialized gates")
    lock_sub = sp.add_subparsers(dest="lock_cmd", required=True)
    sp_ls = lock_sub.add_parser(
        "status",
        help="per serialized gate: free, or held by which pid, since when, alive or not (never kills a holder)",
    )
    sp_ls.add_argument("--json", action="store_true", help="emit the same data as one JSON document")
    sp_ls.set_defaults(fn=cmd_lock)

    sp = sub.add_parser("tests", help="the authored-test lock: handoff, place, check, defect, show, brief")
    tests_sub = sp.add_subparsers(dest="tests_cmd", required=True)
    sp_th = tests_sub.add_parser("handoff", help="record the holding area's tests (a `tests-handoff` ledger row)")
    sp_th.add_argument("change")
    sp_th.add_argument("--task", help="re-record one task only; supersedes that task's earlier entry")
    sp_th.add_argument("--inline", action="store_true", help="the implementer authored these itself (loop.test-author: inline)")
    sp_th.set_defaults(fn=cmd_tests)
    sp_tp = tests_sub.add_parser("place", help="move one task's held tests onto their real paths (a `tests-placed` row)")
    sp_tp.add_argument("task", help="task id (e.g. 1.2)")
    sp_tp.add_argument("--change", help="change name (default: current branch)")
    sp_tp.set_defaults(fn=cmd_tests)
    sp_tk = tests_sub.add_parser("check", help="exit 1 unless the staged index (or, with --ref, a commit) keeps the authored tests locked (run by both commit hooks)")
    sp_tk.add_argument("--task", help="check this task only (default: every placed task and the one in flight)")
    sp_tk.add_argument("--change", help="change name (default: current branch; with --ref, the branch the ref names)")
    sp_tk.add_argument("--ref", help="check this commit's tree and the ledger it carries, every task, instead of the staged index")
    sp_tk.set_defaults(fn=cmd_tests)
    sp_td = tests_sub.add_parser("defect", help="record that a task's authored tests are wrong, or green before implementation (a `test-defect` row; per task at most three `setup`, two `assertion`, one `green`)")
    sp_td.add_argument("task", help="task id (e.g. 1.2)")
    sp_td.add_argument("--kind", required=True, choices=TEST_DEFECT_KINDS,
                       help="setup: the test cannot run as written; assertion: it asserts the wrong behaviour; green: it passed before any implementation")
    sp_td.add_argument("--detail", required=True, help="why the test is wrong")
    sp_td.add_argument("--change", help="change name (default: current branch)")
    sp_td.set_defaults(fn=cmd_tests)
    sp_tw = tests_sub.add_parser("show", help="print the authoring state: author, each task's tests or reason, placement, defects")
    sp_tw.add_argument("change", nargs="?", help="change name (default: current branch)")
    sp_tw.add_argument("--json", action="store_true", help="one machine-readable JSON document")
    sp_tw.set_defaults(fn=cmd_tests)
    sp_tb = tests_sub.add_parser("brief", help="print the test author's brief: artifacts, test and surface rules, runner (never run), nearby test paths, shared fixtures")
    sp_tb.add_argument("change")
    sp_tb.set_defaults(fn=cmd_tests)

    sp = sub.add_parser("integration", help="print the declared integration process (mode + requireApproval)")
    sp.set_defaults(fn=cmd_integration)

    sp = sub.add_parser("stats", help="report gate economics from the durable ledger")
    sp.add_argument("--change", help="change to report on (default: current branch)")
    sp.add_argument("--all", action="store_true", help="report every ledger under .gatedloop/runs/")
    sp.add_argument("--epic", help="report an epic's children: state, tasks, gate runs, gate time, red runs, halts, and totals")
    sp.add_argument("--json", action="store_true", help="emit one machine-readable JSON document")
    sp.add_argument(
        "--outcomes", action="store_true",
        help="report autonomy instead of cost: terminal state, hands-off verdict, halts by cause, interventions by kind",
    )
    sp.add_argument(
        "--cost", action="store_true",
        help="price the recorded tokens with `economics.prices` (per million tokens, one currency); unpriced models are named, and without prices tokens are printed alone",
    )
    sp.add_argument(
        "--idle-gap", type=float, default=DEFAULT_IDLE_GAP_MINUTES, dest="idle_gap",
        help=f"idle-gap threshold in minutes (default: {DEFAULT_IDLE_GAP_MINUTES})",
    )
    sp.set_defaults(fn=cmd_stats)

    sp = sub.add_parser("epics", help="every epic (a change other changes name in x-gatedloop-epic) with each child's derived state")
    sp.add_argument("--json", action="store_true", help='one document: {"epics": [{epic, archived, drained, children: [{change, state, halt_cause, tasks}]}]}')
    sp.set_defaults(fn=cmd_epics)

    sp = sub.add_parser("audit", help="post-hoc reflog audit: taint the ledger on a commit with no green-ci record (Stop hook)")
    sp.add_argument("--change", help="change name (default: current branch)")
    sp.add_argument("--ref", help="audit the change this incoming ref names, in the worktree holding it (the merge gate)")
    sp.set_defaults(fn=cmd_audit)

    sp = sub.add_parser("taint", help="the ledger taint that blocks a merge until the head is re-verified")
    taint_sub = sp.add_subparsers(dest="taint_cmd", required=True)
    sp_tchk = taint_sub.add_parser("check", help="exit 1 if the change carries an unresolved taint, else 0")
    sp_tchk.add_argument("--change", help="change name (default: current branch)")
    sp_tchk.add_argument("--ref", help="a merge's incoming ref: read the change it names, and that change's ledger as the ref carries it, instead of the current branch's")
    sp_tchk.set_defaults(fn=cmd_taint)

    sp = sub.add_parser("merge", help="integrate a change: local-squash-merge in six gated steps (one push at the end), or under pull-request mode prove the head, push, publish statuses and open/update the PR")
    sp.add_argument("change")
    sp.set_defaults(fn=cmd_merge)

    sp = sub.add_parser(
        "record-merged",
        help="for a forge squash commit: resolve its PR's change, record the merge row, archive, one local commit (never pushes; needs `gh`)",
    )
    sp.add_argument("sha", help="the squash commit the forge made")
    sp.set_defaults(fn=cmd_record_merged)

    sp = sub.add_parser(
        "handoff",
        help="print the planner-to-orchestrator handoff payload for <change>, only if its plan is approved on the merge target (reads only)",
    )
    sp.add_argument("change")
    sp.add_argument("--json", action="store_true", help="the payload as one JSON document")
    sp.set_defaults(fn=cmd_handoff)

    sp = sub.add_parser("conventions", help="generate config.yaml's rules: from the conventions source")
    conv_sub = sp.add_subparsers(dest="conventions_cmd", required=True)
    sp_sync = conv_sub.add_parser("sync", help="sync openspec/config.yaml's rules: from conventions.rules-doc")
    sp_sync.set_defaults(fn=cmd_conventions_sync)

    sp = sub.add_parser("schema", help="inspect a workflow schema before trusting it (design D8)")
    schema_sub = sp.add_subparsers(dest="schema_cmd", required=True)
    sp_insp = schema_sub.add_parser(
        "inspect",
        help="deterministic report: artifact DAG, apply-block presence, tool-name-shaped strings",
    )
    sp_insp.add_argument("name", nargs="?", help="schema name, resolved via `openspec schema which`")
    sp_insp.add_argument("--path", help="inspect a schema directory directly, bypassing OpenSpec resolution (e.g. an uninstalled packs/<name>)")
    sp_insp.add_argument("--json", action="store_true", help="machine-readable report")
    sp_insp.set_defaults(fn=cmd_schema_inspect)
    sp_disp = schema_sub.add_parser(
        "dispatch",
        help="the tdd-apply route for a schema: refuse | per-task | regression-first (needs no PyYAML)",
    )
    sp_disp.add_argument("name", nargs="?", help="schema name, resolved via `openspec schema which`")
    sp_disp.add_argument("--path", help="a schema directory, bypassing OpenSpec resolution")
    sp_disp.add_argument("--json", action="store_true", help="machine-readable decision")
    sp_disp.set_defaults(fn=cmd_schema_dispatch)

    sp = sub.add_parser("approval", help="plan approval: policy, hash, check, attest from a PR review")
    ap_sub = sp.add_subparsers(dest="approval_cmd", required=True)
    sp_pol = ap_sub.add_parser("policy", help="print the declared plan-approval policy (plan=review|self)")
    sp_pol.set_defaults(fn=cmd_approval)
    sp_sha = ap_sub.add_parser("sha", help="print the plan-artifact content hash for a change")
    sp_sha.add_argument("change")
    sp_sha.set_defaults(fn=cmd_approval)
    sp_chk = ap_sub.add_parser("check", help="exit 0 if <change> is merged AND approved, else 1")
    sp_chk.add_argument("change")
    sp_chk.set_defaults(fn=cmd_approval)
    sp_mig = ap_sub.add_parser("migrate", help="rename the earlier approved_by/at/sha keys to x-gatedloop-approved-* in each active change's .openspec.yaml (or <change>'s)")
    sp_mig.add_argument("change", nargs="?")
    sp_mig.set_defaults(fn=cmd_approval)
    sp_att = ap_sub.add_parser("attest", help="write x-gatedloop-approved-by/at/sha -- from the PR's approving review (--pr) or, under a declared self policy, from the plan PR's merge (--merged) or machine-computed (--local)")
    sp_att.add_argument("change")
    att_group = sp_att.add_mutually_exclusive_group(required=True)
    att_group.add_argument("--pr", type=int, help="the plan pull request's number")
    att_group.add_argument("--merged", type=int, metavar="PR", help="the merged plan pull request's number: its merger and merge time are the approval; legitimate only under the declared self policy")
    att_group.add_argument("--local", action="store_true", help="write approval keys machine-side; legitimate only under the declared self policy")
    sp_att.add_argument("--as", dest="as_name", help="override approved_by's display name (--local only; never affects the sha)")
    sp_att.set_defaults(fn=cmd_approval)

    sp = sub.add_parser("acceptance", help="the human acceptance of the increment: policy, attest, reject")
    acc_sub = sp.add_subparsers(dest="acceptance_cmd", required=True)
    sp_apol = acc_sub.add_parser("policy", help="print the declared acceptance policy (acceptance=review|self|none)")
    sp_apol.set_defaults(fn=cmd_acceptance)
    sp_aatt = acc_sub.add_parser(
        "attest",
        help="append an `accept` ledger row pinned to the change branch's head tree -- from the PR's approving review (--pr) or, under a declared self policy, the git identity (--local) or the merged PR's merge commit (--merged)",
    )
    sp_aatt.add_argument("change")
    aatt_group = sp_aatt.add_mutually_exclusive_group(required=True)
    aatt_group.add_argument("--pr", type=int, help="the implementation pull request's number")
    aatt_group.add_argument("--merged", type=int, metavar="PR", help="the merged implementation pull request's number: its merger, merge time and merge commit's tree are the acceptance; legitimate only under `approval.acceptance: self`")
    aatt_group.add_argument("--local", action="store_true", help="accept as the configured git identity; legitimate only under `approval.acceptance: self`")
    sp_aatt.add_argument("--as", dest="as_name", help="override accepted_by's display name (--local only; never affects the tree)")
    sp_aatt.set_defaults(fn=cmd_acceptance)
    sp_arej = acc_sub.add_parser(
        "reject",
        help="append a `reject` ledger row pinned to the change branch's head tree -- an escalation with a cause",
    )
    sp_arej.add_argument("change")
    sp_arej.add_argument("--cause", required=True, help=f"one of: {', '.join(ACCEPTANCE_REJECT_CAUSES)}")
    sp_arej.add_argument("--detail", help="required: what the behaviour did and what was meant")
    sp_arej.add_argument("--as", dest="as_name", help="override accepted_by's display name")
    sp_arej.set_defaults(fn=cmd_acceptance)
    sp_achk = acc_sub.add_parser(
        "check",
        help="exit 0 if no acceptance policy is declared or the latest acceptance row for <tree> is an accept, else 1 (merge gate)",
    )
    sp_achk.add_argument("tree")
    sp_achk.add_argument("--change", help="read only this change's ledger (default: the current branch; every ledger on the merge target)")
    sp_achk.set_defaults(fn=cmd_acceptance)
    sp_abrf = acc_sub.add_parser(
        "brief",
        help="print the deterministic acceptance brief: spec scenarios (covered / check by hand), verdicts for the head tree, what it cannot claim",
    )
    sp_abrf.add_argument("change")
    sp_abrf.add_argument("--out", help="write the brief to this path instead of stdout (documented location: .gatedloop/runs/<change>.acceptance.md)")
    sp_abrf.set_defaults(fn=cmd_acceptance)

    sp = sub.add_parser("discipline", help="OpenSpec git discipline checks (D9)")
    disc_sub = sp.add_subparsers(dest="discipline_cmd", required=True)
    sp_commit = disc_sub.add_parser("check-commit", help="planning-grade for a planning-only staged diff (D2), else the full ci marker check")
    sp_commit.add_argument("tree")
    sp_commit.add_argument("--verdict-file", dest="verdict_file", default=None,
                           help="on success, write one token naming the grade that allowed the commit: ledger, planning or marker (unblock-authored-lock D1)")
    sp_commit.set_defaults(fn=cmd_discipline)
    sp_prop = disc_sub.add_parser("check-propose", help="exit 1 if <path> is a plan artifact of a change in implementation (off the target or a based plan/* branch); with --scaffold, if the branch is neither")
    sp_prop.add_argument("path", nargs="?", default=None, help="omit with --scaffold")
    sp_prop.add_argument("--scaffold", action="store_true", help="check the openspec-new-change step itself, before any file exists (design D4)")
    sp_prop.set_defaults(fn=cmd_discipline)
    sp_push = disc_sub.add_parser("check-push", help="the pre-push hook's check: exit 1 unless an update of the merge target pushes a proven commit (a merge row records it, or the merge gate's incoming-tree checks hold); other refs and deletions pass")
    sp_push.add_argument("sha", help="the local sha being pushed (all zeros: a deletion)")
    sp_push.add_argument("--remote-ref", help="the remote ref it updates (refs/heads/<branch>); only the merge target's is checked. Omitted: the sha is checked as a push of the target")
    sp_push.set_defaults(fn=cmd_discipline)
    sp_wt = disc_sub.add_parser("check-worktree", help="exit 1 if the current branch is checked out in more than one worktree, naming each")
    sp_wt.set_defaults(fn=cmd_discipline)
    sp_ms = disc_sub.add_parser("merge-scope", help="print 'integrating' if a merge here lands on the integration target (its branch, or a detached HEAD at its tip), else 'not-integrating'")
    sp_ms.set_defaults(fn=cmd_discipline)
    sp_arch = disc_sub.add_parser("check-archive", help="exit 1 if <change> is not yet merged to the target branch")
    sp_arch.add_argument("change")
    sp_arch.set_defaults(fn=cmd_discipline)
    sp_impl = disc_sub.add_parser("check-implement", help="exit 1 unless <change> is merged AND approved (D10)")
    sp_impl.add_argument("change")
    sp_impl.set_defaults(fn=cmd_discipline)
    sp_cont = disc_sub.add_parser("check-continue", help="exit 0 + next task line if the Stop hook should continue the loop")
    sp_cont.set_defaults(fn=cmd_discipline)
    sp_next = disc_sub.add_parser("next-task", help="print '<change>\\t<next unchecked task>' regardless of tree state (PreCompact snapshot)")
    sp_next.set_defaults(fn=cmd_discipline)
    disc_sub.add_parser(
        "agent-session",
        help="exit 0 if a variable `discipline.agent-env` lists (default CLAUDECODE) is set, else 1 -- the git-layer hooks no-op on 1",
    )

    args = p.parse_args()
    if args.cmd == "discipline" and args.discipline_cmd == "agent-session":
        # Special-cased ahead of everything (git-layer-enforcement D1): the
        # git hooks ask it first, in any repository, with or without a
        # manifest, and it reads nothing but the manifest's one key.
        return cmd_agent_session(_repo_root())
    if args.cmd not in ("doctor", "migrate-name"):
        # Design D2 of the earlier name's expiry: from 0.9.0 nothing reads
        # the earlier state directory, so a project still holding it (alone
        # or beside `.gatedloop/`) would split its ledger. Nothing runs on
        # it but the two commands that report and move it.
        refusal = _earlier_state_refusal(_repo_root())
        if refusal:
            print(refusal, file=sys.stderr)
            return 1
    if args.cmd == "init":
        return cmd_init(args)
    if args.cmd == "doctor":
        # Special-cased ahead of load_manifest: doctor is gates-init's step 0,
        # so it must run before any .gates.yaml exists (design D3).
        return cmd_doctor(args)
    if args.cmd == "migrate-name":
        # Special-cased ahead of load_manifest: it moves state and metadata,
        # and reads no .gates.yaml (rename-to-gatedloop D3).
        return cmd_migrate_name(args)
    if args.cmd == "hook":
        # Special-cased ahead of load_manifest: `hook install` operates on git
        # state and the shipped template only — it reads no .gates.yaml, and
        # must work at the point gates-init offers it regardless of manifest.
        return cmd_hook(args)
    if args.cmd == "adoption":
        # Special-cased ahead of load_manifest: decisions are recorded and read
        # whether or not a manifest exists or parses (adoption-prompts D2/D3).
        return cmd_adoption(args)
    if args.cmd == "schema" and args.schema_cmd == "dispatch":
        # Special-cased ahead of load_manifest: the route depends only on the
        # schema, and dispatch must not inherit a manifest-parsing dependency.
        return cmd_schema_dispatch({}, _repo_root(), args)
    m, _ = load_manifest()
    root = Path(m["__root__"])
    return args.fn(m, root, args)


if __name__ == "__main__":
    sys.exit(main())
