"""Both positions reach the human with their evidence (change
`checkable-disputes`, design D4 and D6; the show-and-cap requirement).

`gates tests show` lists, under each task, its defects and defences in
ledger order, each with its citations; `--json` adds a top-level
`exchanges` key and leaves every existing key alone. The refusal past the
`assertion` cap prints every defect and defence of the task, one line each,
with a `cites:` line under each row that has citations. A legacy kindless
defect reads as `assertion` in both.

Real git through `_dispute_fixture.DisputeRepo`, the exchange written by
the real shim (defect, defence, defect); a legacy row is appended as an
older shim wrote it.

Stdlib only, per `zero-dep-shim`. Run with: python3 -m unittest discover -s tests
"""

from __future__ import annotations

import json
import tempfile
import unittest

from _dispute_fixture import SPEC_CITE, authored_repo, held_rel
from _merge_fixture import CHANGE

HELD = held_rel("1.1")
D1 = "expects 2 where the spec says 1"
W1 = "the scenario says 1, the test asserts 1"
D2 = "still expects the wrong value"
D3 = "a third time"


def _exchange(tmp):
    """Task 1.1: defect (two citations), defence (one), defect (one)."""
    repo = authored_repo(tmp)
    for r in (
        repo.defect("1.1", "assertion", D1, ".gates.yaml", HELD),
        repo.handoff("--task", "1.1", "--defend", W1, "--cite", SPEC_CITE),
        repo.defect("1.1", "assertion", D2, SPEC_CITE),
    ):
        assert r.returncode == 0, r.stdout + r.stderr
    return repo


def _legacy_defects(repo, *details):
    """Kindless, citation-free defect rows for 1.1, as an older shim wrote them."""
    for d in details:
        repo.append_lane_row({
            "ts": "2026-09-01T00:00:00+00:00", "gate": "test-defect", "exit": None,
            "duration_ms": 0, "change": CHANGE, "task": "1.1", "detail": d,
        })


class TestShowListsTheExchange(unittest.TestCase):
    """Regression guarded: the human at a halt reading a defect with no
    evidence and no answer, or the answer before the claim it answers."""

    def test_text_form_lists_defect_defence_defect_in_order_with_citations(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = _exchange(tmp)
            out = repo.gates("tests", "show", CHANGE, cwd=repo.lane).stdout

        lines = out.splitlines()
        first = next(i for i, ln in enumerate(lines) if D1 in ln)
        block = lines[first:first + 6]
        self.assertIn(D1, block[0])
        self.assertEqual(block[1], f"          cites: .gates.yaml, {HELD}")
        self.assertEqual(block[2], f"        defence: {W1}")
        self.assertEqual(block[3], f"          cites: {SPEC_CITE}")
        self.assertIn(D2, block[4])
        self.assertEqual(block[5], f"          cites: {SPEC_CITE}")

    def test_text_form_prints_no_cites_line_for_a_row_without_citations(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)
            _legacy_defects(repo, "legacy 1", "legacy 2")
            lines = repo.gates("tests", "show", CHANGE, cwd=repo.lane).stdout.splitlines()

        first = next(i for i, ln in enumerate(lines) if "legacy 1" in ln)
        self.assertIn("legacy 2", lines[first + 1])

    def test_json_exchanges_hold_every_entry_in_ledger_order(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = _exchange(tmp)
            _legacy_defects(repo, "legacy")
            doc = json.loads(repo.gates("tests", "show", CHANGE, "--json", cwd=repo.lane).stdout)

        self.assertEqual(doc["exchanges"], {"1.1": [
            {"event": "test-defect", "kind": "assertion", "detail": D1,
             "cites": [".gates.yaml", HELD]},
            {"event": "test-defence", "kind": None, "detail": W1, "cites": [SPEC_CITE]},
            {"event": "test-defect", "kind": "assertion", "detail": D2, "cites": [SPEC_CITE]},
            {"event": "test-defect", "kind": "assertion", "detail": "legacy", "cites": []},
        ]})  # 1.2 and 1.3 have no defect or defence, so they are not listed

    def test_json_keeps_what_it_had(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = _exchange(tmp)
            doc = json.loads(repo.gates("tests", "show", CHANGE, "--json", cwd=repo.lane).stdout)

        for key in ("handoff", "mode", "authors", "tasks"):
            self.assertIn(key, doc)
        self.assertEqual(doc["tasks"]["1.1"]["defects_by_kind"],
                         {"assertion": 2, "setup": 0, "green": 0})


class TestTheCapRefusalCarriesBothSides(unittest.TestCase):
    """Regression guarded: the refusal that hands a dispute to a human
    quoting only the defects' details, so the author's answer and every
    piece of evidence are lost at the moment they matter."""

    def test_the_third_assertion_defect_is_refused_with_the_whole_exchange(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = _exchange(tmp)

            r = repo.defect("1.1", "assertion", D3, ".gates.yaml")

        self.assertEqual(r.returncode, 1, r.stdout)
        self.assertIn("oracle-conflict", r.stderr)
        lines = r.stderr.splitlines()
        want = [
            f"  defect 1 (assertion): {D1}",
            f"    cites: .gates.yaml, {HELD}",
            f"  defence: {W1}",
            f"    cites: {SPEC_CITE}",
            f"  defect 2 (assertion): {D2}",
            f"    cites: {SPEC_CITE}",
        ]
        at = [lines.index(w) for w in want]
        self.assertEqual(at, list(range(at[0], at[0] + len(want))))

    def test_kindless_rows_without_citations_get_one_line_each(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)
            _legacy_defects(repo, "legacy 1", "legacy 2")

            r = repo.defect("1.1", "assertion", D3, ".gates.yaml")

        self.assertEqual(r.returncode, 1, r.stdout)
        lines = r.stderr.splitlines()
        i = lines.index("  defect 1 (assertion): legacy 1")
        self.assertEqual(lines[i + 1], "  defect 2 (assertion): legacy 2")


if __name__ == "__main__":
    unittest.main()
