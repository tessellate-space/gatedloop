"""The citation resolver (change `checkable-disputes`, design D1 and D6).

`unresolved_citations(root, change, citations)` returns the citations that do
not resolve against the worktree at `root`, in input order, and an empty list
when all do. A citation is a path, `path:line`, `path:a-b`, or
`spec:<capability>#<scenario>`. A path resolves only to a regular file inside
the root, with 1-based lines; the resolver never searches the holding area, so
a held copy resolves only by its full path under
`.gatedloop/authored/<change>/<N.M>/`. A scenario is looked up in the change's
delta specs, then in `openspec/specs/`, ignoring case and runs of whitespace.

Stdlib only, per `zero-dep-shim`. Pure filesystem cases: a throwaway directory
tree, no git, the shim loaded by path as `bin/gates` has no `.py` suffix.

Run with:  python3 -m unittest discover -s tests
"""

import importlib.machinery
import importlib.util
import tempfile
import unittest
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
GATES_SHIM = REPO / "bin" / "gates"

_loader = importlib.machinery.SourceFileLoader("gates_shim_dispute_citations", str(GATES_SHIM))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
gates = importlib.util.module_from_spec(_spec)
_loader.exec_module(gates)

CHANGE = "demo-change"
HELD_ONLY = "tests/test_calc.py"
HELD = f".gatedloop/authored/{CHANGE}/1.1/{HELD_ONLY}.authored"

DELTA = """\
# Spec Delta

## ADDED Requirements

### Requirement: Expired cards are declined

#### Scenario: Expired card is declined
- **WHEN** a card past its expiry is charged
- **THEN** the charge is declined
"""

MAIN = """\
# Orders

### Requirement: Duplicates are rejected

#### Scenario: Duplicate order is rejected
- **WHEN** the same order is submitted twice
- **THEN** the second is rejected with 409
"""


def _tree(tmp):
    """A worktree root one level below `tmp`, so a `..` escape has a real
    file to land on outside the root."""
    base = Path(tmp)
    (base / "outside.py").write_text("one\ntwo\nthree\n")
    root = base / "work"
    (root / "src").mkdir(parents=True)
    (root / "src" / "api.py").write_text("one\ntwo\nthree\n")
    (root / "src" / "long.py").write_text("".join(f"line {n}\n" for n in range(1, 21)))
    held = root / HELD
    held.parent.mkdir(parents=True)
    held.write_text("def test_add():\n    assert add(2, 3) == 5\n")
    delta = root / "openspec" / "changes" / CHANGE / "specs" / "checkout"
    delta.mkdir(parents=True)
    (delta / "spec.md").write_text(DELTA)
    main = root / "openspec" / "specs" / "orders"
    main.mkdir(parents=True)
    (main / "spec.md").write_text(MAIN)
    return root


def _unresolved(root, *citations):
    return gates.unresolved_citations(root, CHANGE, list(citations))


class TestPathCitations(unittest.TestCase):
    """Regressions guarded: a citation to a file that is not there, or to
    something that is not a regular file inside the worktree, accepted as
    evidence."""

    def test_an_existing_path_resolves(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(_unresolved(_tree(tmp), "src/api.py"), [])

    def test_a_missing_file_is_returned(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(_unresolved(_tree(tmp), "src/missing.py"), ["src/missing.py"])

    def test_a_held_test_by_its_full_holding_path_resolves(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            self.assertEqual(_unresolved(root, HELD, f"{HELD}:2"), [])

    def test_a_bare_path_that_exists_only_as_a_held_copy_is_returned(self):
        # The resolver never searches the holding area for a real path.
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            self.assertEqual(
                _unresolved(root, HELD_ONLY, f"{HELD_ONLY}:1"),
                [HELD_ONLY, f"{HELD_ONLY}:1"])

    def test_paths_that_are_not_a_regular_file_inside_the_root_are_returned(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            absolute = str(root / "src" / "api.py")
            cases = [absolute, "../outside.py", "../outside.py:1", "src", "src:1"]
            for cite in cases:
                with self.subTest(cite=cite):
                    self.assertEqual(_unresolved(root, cite), [cite])


class TestLineCitations(unittest.TestCase):
    """Regressions guarded: a line or range that is not inside the file
    accepted, lines counted from 0, or a malformed suffix read as a path."""

    def test_lines_and_ranges_within_the_file_resolve(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            self.assertEqual(
                _unresolved(root, "src/api.py:1", "src/api.py:3", "src/api.py:1-3",
                            "src/api.py:2-2", "src/long.py:10-14"),
                [])

    def test_lines_and_ranges_outside_the_file_are_returned(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            cases = [
                "src/api.py:4",       # one past the last line
                "src/api.py:2-9",     # range ending past the last line
                "src/api.py:5-9",     # range starting after the last line
                "src/long.py:14-10",  # start greater than end, both in the file
                "src/api.py:0",       # lines are 1-based
                "src/api.py:abc",     # non-numeric suffix
                "src/gone.py:1",      # line of a missing file
            ]
            for cite in cases:
                with self.subTest(cite=cite):
                    self.assertEqual(_unresolved(root, cite), [cite])


class TestSpecCitations(unittest.TestCase):
    """Regressions guarded: a scenario that does not exist accepted, a
    scenario looked up under the wrong capability, or the main specs ignored
    when the change's delta does not hold it."""

    def test_a_scenario_in_the_change_delta_resolves(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(_unresolved(_tree(tmp), "spec:checkout#Expired card is declined"), [])

    def test_a_scenario_in_the_main_specs_resolves(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(_unresolved(_tree(tmp), "spec:orders#Duplicate order is rejected"), [])

    def test_case_and_whitespace_are_ignored(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(
                _unresolved(_tree(tmp), "spec:checkout#expired   CARD is  declined"), [])

    def test_unknown_scenarios_are_returned(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            cases = [
                "spec:checkout#Card is refunded",       # no such scenario
                "spec:orders#Expired card is declined",  # another capability's
                "spec:shipping#Parcel is sent",          # no such capability
            ]
            for cite in cases:
                with self.subTest(cite=cite):
                    self.assertEqual(_unresolved(root, cite), [cite])


class TestResultShape(unittest.TestCase):
    """Regressions guarded: the unresolved ones reported out of order or
    mixed with the resolved ones, which makes the refusal name the wrong
    citation."""

    def test_no_citations_means_nothing_unresolved(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(_unresolved(_tree(tmp)), [])

    def test_only_the_unresolved_come_back_in_input_order(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = _tree(tmp)
            got = _unresolved(
                root, "src/zzz.py", "src/api.py:1", "spec:checkout#Nope", "src/api.py:99", HELD)
            self.assertEqual(got, ["src/zzz.py", "spec:checkout#Nope", "src/api.py:99"])


if __name__ == "__main__":
    unittest.main()
