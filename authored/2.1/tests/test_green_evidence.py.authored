"""A `green` defect is backed by a recorded passing run (change
`checkable-disputes`, design D2, D5 and D6; the green-defect requirement and
the in-flight green scenario).

`gates tests defect --kind green` claims the task's placed tests pass before
anything is implemented. The claim is a fact about a run, so under a cited
governing handoff the shim looks in the ledger for a passing run of the
task's oracle gate recorded after the latest `tests-placed` row carrying the
task, and refuses without one, naming the gate. A task whose governing
handoff predates the check records `green` defects as before. (The `--cite`
refusal for `green` is task 1.2's, in `tests/test_cited_defects.py`.)

Real git through `_dispute_fixture.DisputeRepo`, whose `unit` gate passes
or fails on request: the evidence is a ledger row a real run writes.

Stdlib only, per `zero-dep-shim`. Run with: python3 -m unittest discover -s tests
"""

from __future__ import annotations

import tempfile
import unittest

from _dispute_fixture import authored_repo
from _lock_fixture import TEST_V1

GREEN = "its placed tests passed before any implementation"


def _green(repo, task="1.1"):
    return repo.defect(task, "green", GREEN)


class TestGreenNeedsAPassingRun(unittest.TestCase):
    """Regression guarded: a `green` defect recorded on the agent's word,
    with no passing run of the task's oracle gate in the ledger to back it."""

    def test_refused_when_the_only_run_since_placement_failed(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)
            repo.place("1.1")
            repo.unit("1.1", passing=False)

            r = _green(repo)

            self.assertEqual(r.returncode, 1, r.stdout + r.stderr)
            self.assertIn("unit", r.stderr)  # the gate is named
            self.assertEqual(repo.rows_of("test-defect"), [])

    def test_recorded_when_a_passing_run_follows_the_placement(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)
            repo.place("1.1")
            repo.unit("1.1", passing=False)
            repo.unit("1.1", passing=True)

            r = _green(repo)

            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
            (row,) = repo.rows_of("test-defect")
            self.assertEqual((row["task"], row["kind"], row["detail"], row["cites"]),
                             ("1.1", "green", GREEN, None))

    def test_refused_before_the_tests_are_placed(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)

            r = _green(repo)

            self.assertEqual(r.returncode, 1, r.stdout + r.stderr)
            self.assertEqual(repo.rows_of("test-defect"), [])

    def test_a_passing_run_for_another_task_does_not_count(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)
            repo.place("1.1")
            repo.unit("1.1", passing=False)
            repo.place("1.2")
            repo.unit("1.2", passing=True)

            r = _green(repo, "1.1")

            self.assertEqual(r.returncode, 1, r.stdout + r.stderr)
            self.assertEqual(repo.rows_of("test-defect"), [])


class TestOnlyTheLatestPlacementCounts(unittest.TestCase):
    """Regression guarded: a passing run from before a re-placement standing
    in for the tests now placed, which may be different tests."""

    def _re_placed(self, tmp):
        repo = authored_repo(tmp)
        repo.place("1.1")
        repo.unit("1.1", passing=True)
        repo.restore_held("1.1", TEST_V1)
        self.assertEqual(repo.handoff("--task", "1.1").returncode, 0)
        repo.must("tests", "place", "1.1")
        self.assertEqual(len([r for r in repo.rows_of("tests-placed") if r.get("task") == "1.1"]), 2)
        return repo

    def test_a_passing_run_before_the_latest_placement_does_not_count(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = self._re_placed(tmp)

            r = _green(repo)

            self.assertEqual(r.returncode, 1, r.stdout + r.stderr)
            self.assertEqual(repo.rows_of("test-defect"), [])

    def test_a_passing_run_after_the_latest_placement_counts(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = self._re_placed(tmp)
            repo.unit("1.1", passing=True)

            r = _green(repo)

            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
            self.assertEqual(len(repo.rows_of("test-defect")), 1)


class TestAnEarlierHandoffKeepsGreenAsBefore(unittest.TestCase):
    """Regression guarded: the upgrade breaking an in-flight change, whose
    governing handoff predates the check, by refusing a `green` defect it
    could always record."""

    def test_a_green_defect_under_an_earlier_handoff_needs_no_passing_run(self):
        with tempfile.TemporaryDirectory() as tmp:
            repo = authored_repo(tmp)
            repo.predate_handoffs()
            repo.place("1.1")
            repo.unit("1.1", passing=False)

            r = _green(repo)

            self.assertEqual(r.returncode, 0, r.stdout + r.stderr)
            self.assertEqual(len(repo.rows_of("test-defect")), 1)


if __name__ == "__main__":
    unittest.main()
